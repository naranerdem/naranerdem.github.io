{
  "name": "naranerdem.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && wrangler deploy --env=\"\"",
    "deploy:cloudflare:staging": "npm run build && wrangler deploy --env staging",
    "seed:catalog:staging": "node scripts/seed-staging-catalog.mjs",
    "seed:calendar:staging": "node scripts/seed-staging-calendar.mjs",
    "seed:operational-defaults": "node scripts/import-operational-defaults.mjs",
    "export:private-config": "node scripts/export-private-config.mjs",
    "import:private-config": "node scripts/import-private-config.mjs",
    "cleanup:registration:staging": "node scripts/cleanup-staging-registration-tests.mjs",
    "staff:create": "node scripts/staff-provision.mjs",
    "test:d1:local": "node scripts/d1-local-smoke.mjs",
    "test:api": "npm run build && node scripts/api-worker-test.mjs",
    "test:auth": "npm run build && node scripts/auth-worker-test.mjs",
    "test:staff-auth": "npm run build && node scripts/staff-auth-test.mjs",
    "test:staff-action-menus": "node scripts/staff-action-menus-test.mjs",
    "test:private-config": "node scripts/private-program-config-test.mjs",
    "test:staff:program-calendar": "node scripts/staff-program-calendar-test.mjs",
    "test:staff-calendar": "node scripts/staff-program-calendar-test.mjs",
    "test:attendance": "npm run build && node scripts/course-attendance-test.mjs",
    "test:attendance-ui": "node scripts/attendance-optimistic-test.mjs",
    "test:makeups": "npm run build && node scripts/course-makeup-test.mjs",
    "test:day-changes": "npm run build && node scripts/day-changes-test.mjs",
    "test:staff-reports": "node scripts/staff-reports-test.mjs",
    "test:reports": "npm run test:staff-reports",
    "test:registration": "node scripts/registration-hold-test.mjs",
    "test:calendar": "node scripts/calendar-domain-test.mjs",
    "test:schedule:preview": "npm run build && node scripts/schedule-preview-test.mjs",
    "test:offering-guidance": "node scripts/offering-guidance-test.mjs",
    "test:register:prototype": "npm run build && node scripts/register-prototype-test.mjs && node scripts/register-state-test.mjs && node scripts/registration-draft-test.mjs"
  },
  "dependencies": {
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
