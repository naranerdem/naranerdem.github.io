---
import { contact } from "../content/contact";
import { siteIdentity } from "../content/homepage";
import { registrationFormCopy, registrationPrototype } from "../content/registration";
import { rulesContent } from "../content/rules";
import "../styles/global.css";

const registrationData = { registrationFormCopy, rulesContent };
const formCopy = registrationFormCopy;
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={registrationPrototype.description} />
    <title>{registrationPrototype.title} | {siteIdentity.name}</title>
  </head>
  <body class="register-page" data-registration-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/" aria-label="Нүүр хуудас">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span>
          <strong>{siteIdentity.name}</strong>
          <span>{siteIdentity.shortProgramLabel}</span>
        </span>
      </a>
      <nav class="top-nav" aria-label="Бүртгэлийн туслах цэс">
        <a href="/">Нүүр</a>
        <a href={contact.facebook.href} target="_blank" rel="noreferrer">Facebook</a>
      </nav>
    </header>

    <main class="register-shell">
      <section class="prototype-hero" aria-labelledby="register-title">
        <p id="registration-environment-notice" class="prototype-notice">{registrationPrototype.notice}</p>
        <div class="register-title-row">
          <h1 id="register-title">Бүртгэлийн мэдээлэл</h1>
          <p id="registration-progress" class="registration-progress">1 / 4 · {formCopy.progress.information}</p>
        </div>
      </section>

      <aside id="registration-draft-notice" class="draft-notice" hidden aria-live="polite">
        <div>
          <strong>{formCopy.draft.title}</strong>
          <p>{formCopy.draft.help}</p>
        </div>
        <div class="draft-actions">
          <button type="button" class="button secondary" id="restore-registration-draft">{formCopy.draft.restore}</button>
          <button type="button" class="text-button" id="discard-registration-draft">{formCopy.draft.discard}</button>
        </div>
      </aside>

      <section id="registration-booting" class="registration-booting" role="status" aria-live="polite">
        <p>{formCopy.messages.booting}</p>
      </section>

      <form id="registration-form" class="registration-form" novalidate hidden>
        <p id="information-error" class="form-error" role="alert" hidden>{formCopy.messages.requiredError}</p>

        <section class="form-section" aria-labelledby="guardian-title">
          <h2 id="guardian-title">{formCopy.guardian.title}</h2>
          <div class="compact-fields guardian-fields">
            <label class="field-wide">
              <span>{formCopy.guardian.name} <span class="required-marker" aria-hidden="true">*</span></span>
              <input id="guardian-name" name="guardianName" autocomplete="name" required />
            </label>
            <label>
              <span>{formCopy.guardian.relationship} <span class="required-marker" aria-hidden="true">*</span></span>
              <select id="guardian-relationship" name="guardianRelationship" required>
                <option value="">{formCopy.selectPlaceholder}</option>
                {formCopy.guardian.relationshipOptions.map((option) => <option>{option}</option>)}
              </select>
              <small>{formCopy.guardian.relationshipHelp}</small>
            </label>
            <label>
              <span>{formCopy.guardian.email} <span class="required-marker" aria-hidden="true">*</span></span>
              <input id="guardian-email" name="guardianEmail" type="email" inputmode="email" autocomplete="email" required />
              <small>{formCopy.guardian.emailHelp}</small>
            </label>
            <label>
              <span>{formCopy.guardian.primaryPhone} <span class="required-marker" aria-hidden="true">*</span></span>
              <input id="guardian-phone" name="guardianPhone" type="tel" inputmode="tel" autocomplete="tel" required />
            </label>
            <label>
              <span>{formCopy.guardian.secondaryPhone}</span>
              <input id="guardian-secondary-phone" name="guardianSecondaryPhone" type="tel" inputmode="tel" autocomplete="tel" />
            </label>
            <label>
              <span>{formCopy.guardian.facebook}</span>
              <input id="guardian-facebook" name="guardianFacebook" autocomplete="off" />
              <small>{formCopy.guardian.facebookHelp}</small>
            </label>
            <label class="field-wide">
              <span>{formCopy.guardian.homeAddress} <span class="required-marker" aria-hidden="true">*</span></span>
              <textarea id="guardian-address" name="guardianAddress" rows="2" required></textarea>
              <small>{formCopy.guardian.homeAddressHelp}</small>
            </label>
          </div>
        </section>

        <section class="form-section" aria-labelledby="children-title">
          <h2 id="children-title" class="visually-hidden">{formCopy.child.title}</h2>
          <div id="children-list" class="children-list"></div>
        </section>

        <div class="form-actions">
          <button class="button primary" type="submit">{formCopy.buttons.continueToRules}</button>
        </div>
      </form>

      <section id="review-panel" class="review-panel" aria-labelledby="review-title" hidden>
        <div class="register-title-row">
          <div>
            <h2 id="review-title">{formCopy.review.title}</h2>
            <p id="review-help">{formCopy.review.help}</p>
          </div>
          <p class="registration-progress">4 / 4 · {formCopy.progress.review}</p>
        </div>
        <div id="review-summary" class="review-summary"></div>
        <div id="registration-turnstile" class="turnstile-area" hidden>
          <div id="turnstile-widget"></div>
          <p id="turnstile-message" class="catalog-message" role="status"></p>
        </div>
        <div class="form-actions review-actions">
          <button class="button secondary" type="button" id="edit-information">{formCopy.buttons.edit}</button>
          <button class="button primary" type="button" id="finish-prototype">{formCopy.buttons.finish}</button>
        </div>
        <p id="prototype-complete" class="prototype-complete" role="status" hidden>{formCopy.messages.prototypeComplete}</p>
      </section>

      <section id="registration-result" class="registration-result" aria-live="polite" hidden>
        <h2 id="registration-result-title"></h2>
        <div id="registration-result-body"></div>
      </section>
    </main>

    <dialog id="guardian-rules-dialog" class="rules-dialog" aria-labelledby="guardian-rules-title">
      <div class="dialog-content">
        <div class="dialog-header">
          <h2 id="guardian-rules-title">{rulesContent.parent.title}</h2>
          <button class="icon-text-button" type="button" data-close-dialog="guardian-rules-dialog">{formCopy.buttons.close}</button>
        </div>
        <div id="guardian-rules-body"><p>{rulesContent.parent.acknowledgement}</p><ul>{rulesContent.parent.summary.map((item) => <li>{item}</li>)}</ul></div>
        <div class="dialog-actions">
          <button class="button secondary" type="button" data-close-dialog="guardian-rules-dialog">{formCopy.buttons.close}</button>
          <button class="button primary" type="button" id="acknowledge-guardian">{formCopy.buttons.acknowledgeGuardian}</button>
        </div>
      </div>
    </dialog>

    <dialog id="student-rules-dialog" class="rules-dialog" aria-labelledby="student-rules-title">
      <div class="dialog-content">
        <div class="dialog-header">
          <h2 id="student-rules-title">{rulesContent.student.title}</h2>
          <button class="icon-text-button" type="button" data-close-dialog="student-rules-dialog">{formCopy.buttons.close}</button>
        </div>
        <div id="student-rules-body"><p>{rulesContent.student.acknowledgement}</p><ul>{rulesContent.student.summary.map((item) => <li>{item}</li>)}</ul></div>
        <div class="dialog-actions">
          <button class="button secondary" type="button" data-close-dialog="student-rules-dialog">{formCopy.buttons.close}</button>
          <button class="button primary" type="button" id="acknowledge-student">{formCopy.buttons.acknowledgeStudent}</button>
        </div>
      </div>
    </dialog>

    <script id="registration-data" type="application/json" is:inline set:html={JSON.stringify(registrationData)} />
    <script is:inline type="module">
      import {
        applyStageRecommendation,
        classSelectionIssue,
        initialStageSelection,
        nextWaitlistSelection,
        restrictStageSelection,
        userStageSelection,
      } from "/scripts/registration-state.js";
      import {
        REGISTRATION_DRAFT_KEY,
        createRegistrationDraft,
        readRegistrationDraft,
      } from "/scripts/registration-draft.js";

      const registrationData = JSON.parse(document.getElementById("registration-data").textContent);
      const formCopy = registrationData.registrationFormCopy;
      const form = document.getElementById("registration-form");
      const childrenList = document.getElementById("children-list");
      const errorBox = document.getElementById("information-error");
      const progress = document.getElementById("registration-progress");
      const reviewPanel = document.getElementById("review-panel");
      const reviewSummary = document.getElementById("review-summary");
      const completeMessage = document.getElementById("prototype-complete");
      const finishButton = document.getElementById("finish-prototype");
      const environmentNotice = document.getElementById("registration-environment-notice");
      const turnstileArea = document.getElementById("registration-turnstile");
      const turnstileWidget = document.getElementById("turnstile-widget");
      const turnstileMessage = document.getElementById("turnstile-message");
      const resultPanel = document.getElementById("registration-result");
      const resultTitle = document.getElementById("registration-result-title");
      const resultBody = document.getElementById("registration-result-body");
      const draftNotice = document.getElementById("registration-draft-notice");
      const bootingPanel = document.getElementById("registration-booting");
      const restoreDraftButton = document.getElementById("restore-registration-draft");
      const discardDraftButton = document.getElementById("discard-registration-draft");
      const guardianDialog = document.getElementById("guardian-rules-dialog");
      const studentDialog = document.getElementById("student-rules-dialog");
      const stageLabels = formCopy.child.stageLabels;
      const initialStage = initialStageSelection(window.location.search);
      let childCount = 0;
      let catalog = null;
      let catalogState = "loading";
      let parentAcknowledged = false;
      let studentAcknowledged = false;
      let returnFocusTo = null;
      let storedDraft = null;
      let runtimeConfig = { environment: "production", writeEnabled: false, turnstileSiteKey: null };
      let runtimeRules = { parentRulesVersion: registrationData.rulesContent.parent.version, studentRulesVersion: registrationData.rulesContent.student.version };
      let turnstileToken = "";
      let turnstileWidgetId = null;

      function escapeText(value) {
        return String(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function requiredMarker() {
        return '<span class="required-marker" aria-hidden="true">*</span>';
      }

      function childCards() {
        return Array.from(childrenList.querySelectorAll("[data-child-card]"));
      }

      function readStoredDraft() {
        try {
          const draft = readRegistrationDraft(window.localStorage.getItem(REGISTRATION_DRAFT_KEY));
          if (!draft) window.localStorage.removeItem(REGISTRATION_DRAFT_KEY);
          return draft;
        } catch {
          return null;
        }
      }

      function discardStoredDraft() {
        try {
          window.localStorage.removeItem(REGISTRATION_DRAFT_KEY);
        } catch {}
        storedDraft = null;
        draftNotice.hidden = true;
      }

      function saveDraft() {
        try {
          const fields = Array.from(form.elements)
            .filter((control) => control.name && !control.disabled)
            .filter((control) => !["radio", "checkbox"].includes(control.type) || control.checked)
            .map((control) => [control.name, control.value]);
          window.localStorage.setItem(
            REGISTRATION_DRAFT_KEY,
            JSON.stringify(createRegistrationDraft(fields, childCards().length)),
          );
        } catch {}
      }

      function optionHtml(option) {
        if (typeof option === "string") return `<option value="${escapeText(option)}">${escapeText(option)}</option>`;
        return `<option value="${escapeText(option.value)}">${escapeText(option.label)}</option>`;
      }

      function catalogStages() {
        if (!catalog) return new Set(Object.keys(stageLabels));
        return new Set(catalog.academicYears.flatMap((year) => year.classSessions).map((session) => session.stageCode));
      }

      function stageOptions() {
        const stages = catalogStages();
        return Object.entries(stageLabels)
          .filter(([value]) => stages.has(value))
          .map(([value, label]) => `<option value="${value}">${escapeText(label)}</option>`)
          .join("");
      }

      function recommendedStage(card) {
        const returning = card.querySelector("[data-child-returning]:checked")?.value || "";
        const previous = card.querySelector("[data-child-previous-stage]").value;
        if (returning !== "yes") return "";
        if (previous === "stage_1") return "stage_2";
        if (previous === "stage_2") return "stage_3";
        return "";
      }

      function updateRecommendation(card) {
        const suggestion = recommendedStage(card);
        const stage = card.querySelector("[data-child-stage]");
        const selection = applyStageRecommendation(
          { value: stage.value, source: card.dataset.stageSource || "none" },
          suggestion,
          catalogStages(),
        );
        stage.value = selection.value;
        card.dataset.stageSource = selection.source;
      }

      function updateStageOptions(card) {
        const stage = card.querySelector("[data-child-stage]");
        const selected = restrictStageSelection(
          { value: stage.value, source: card.dataset.stageSource || "none" },
          catalogStages(),
        );
        stage.innerHTML = `<option value="">${escapeText(formCopy.selectPlaceholder)}</option>${stageOptions()}`;
        stage.value = selected.value;
        card.dataset.stageSource = selected.source;
        if (!selected.value) {
          delete card.dataset.selectedClassId;
          delete card.dataset.waitlistClassId;
          delete card.dataset.paymentPlanCode;
        }
        updateRecommendation(card);
      }

      function sessionForId(id) {
        if (!catalog) return null;
        return catalog.academicYears.flatMap((year) => year.classSessions).find((session) => session.id === id) || null;
      }

      function classText(session) {
        return `${session.weekday} ${session.startTime}–${session.endTime}`;
      }

      function sessionsForStage(stage) {
        if (!catalog || !stage) return [];
        return catalog.academicYears
          .flatMap((year) => year.classSessions)
          .filter((session) => session.stageCode === stage);
      }

      function setCatalogMessage(card, message, isError = false) {
        const status = card.querySelector("[data-catalog-message]");
        status.textContent = message;
        status.classList.toggle("field-message-error", isError);
      }

      function formatMnt(amount) { return `${new Intl.NumberFormat("en-US").format(amount)} ₮`; }
      function formatLocalDate(value) { if (!value) return ""; const date = new Date(`${value}T00:00:00Z`); return `${date.getUTCMonth() + 1}-р сарын ${date.getUTCDate()}`; }

      function renderPaymentChoices(card, session) {
        const target = card.querySelector("[data-payment-choice]");
        if (!target) return;
        if (!session || session.availability !== "available" || !session.paymentOptions?.length) {
          target.hidden = true; target.innerHTML = ""; delete card.dataset.paymentPlanCode; return;
        }
        const options = session.paymentOptions;
        const selected = options.some((option) => option.code === card.dataset.paymentPlanCode)
          ? card.dataset.paymentPlanCode : "single";
        card.dataset.paymentPlanCode = selected;
        if (options.length === 1) {
          target.hidden = false;
          target.innerHTML = `<p class="payment-summary"><strong>Төлбөр: ${escapeText(formatMnt(options[0].initialAmountMnt))}</strong><input type="hidden" data-child-payment-plan value="single"></p>`;
          return;
        }
        target.hidden = false;
        target.innerHTML = `<fieldset class="payment-options"><legend>Төлбөрийн хэлбэр ${requiredMarker()}</legend>${options.map((option) => `<label><input type="radio" name="child-${card.dataset.childIndex}-payment-plan" data-child-payment-plan value="${escapeText(option.code)}" required ${option.code === selected ? "checked" : ""}><span><strong>${option.code === "single" ? "Нэг удаа төлөх" : "2 хувааж төлөх"} — ${escapeText(formatMnt(option.totalAmountMnt))}</strong>${option.code === "two_installment" ? `<small>Эхний төлбөр ${escapeText(formatMnt(option.initialAmountMnt))}<br>Дараагийн төлбөр ${escapeText(formatMnt(option.secondAmountMnt))} · ${escapeText(formatLocalDate(option.secondDueOn))}</small>` : ""}</span></label>`).join("")}</fieldset>`;
        target.querySelectorAll("[data-child-payment-plan]").forEach((input) => input.addEventListener("change", () => { card.dataset.paymentPlanCode = input.value; saveDraft(); }));
      }

      function renderClasses(card) {
        const stage = card.querySelector("[data-child-stage]").value;
        const target = card.querySelector("[data-class-options]");
        const fieldset = card.querySelector("[data-class-choice]");
        const selected = card.querySelector("[data-child-class]:checked")?.value || card.dataset.selectedClassId || "";
        const selectedWaitlist = card.querySelector("[data-child-waitlist]:checked")?.value || card.dataset.waitlistClassId || "";
        target.innerHTML = "";
        setCatalogMessage(card, "");

        if (!stage) {
          fieldset.hidden = true;
          renderPaymentChoices(card, null);
          return;
        }
        fieldset.hidden = false;
        if (!catalog) {
          renderPaymentChoices(card, null);
          setCatalogMessage(card, catalogState === "loading" ? formCopy.classChoice.loading : formCopy.classChoice.unavailable);
          return;
        }

        const sessions = sessionsForStage(stage);
        if (!sessions.length) {
          renderPaymentChoices(card, null);
          setCatalogMessage(card, formCopy.classChoice.noSessions);
          return;
        }

        sessions.forEach((session) => {
          const option = document.createElement("div");
          option.className = `class-option ${session.availability}`;
          if (session.availability === "available") {
            option.innerHTML = `
              <label>
                <input type="radio" name="child-${card.dataset.childIndex}-class" value="${escapeText(session.id)}" data-child-class ${selected === session.id ? "checked" : ""}>
                <span><strong>${escapeText(classText(session))}</strong><small>${escapeText(formCopy.classChoice.remainingSeats.replace("{count}", session.remainingSeats))}</small></span>
              </label>
            `;
          } else if (session.availability === "full") {
            option.innerHTML = `
              <strong>${escapeText(classText(session))}</strong>
              <b>${escapeText(formCopy.classChoice.full)}</b>
              ${session.activeHoldCount > 0 ? `<small>${escapeText(formCopy.classChoice.activeHolds.replace("{count}", session.activeHoldCount))}</small>` : ""}
              <label class="waitlist-choice"><input type="checkbox" name="child-${card.dataset.childIndex}-waitlist" value="${escapeText(session.id)}" data-child-waitlist ${selectedWaitlist === session.id ? "checked" : ""}><span>${escapeText(formCopy.buttons.joinWaitlist)}</span></label>
            `;
          } else {
            option.innerHTML = `<strong>${escapeText(classText(session))}</strong><small>${escapeText(formCopy.classChoice.unavailableSession)}</small>`;
          }
          target.append(option);
        });

        const waitlistOnlyButton = document.createElement("button");
        waitlistOnlyButton.type = "button";
        waitlistOnlyButton.className = "text-button waitlist-only-button";
        waitlistOnlyButton.textContent = formCopy.buttons.waitlistOnly;
        waitlistOnlyButton.hidden = !(target.querySelector("[data-child-class]:checked") && target.querySelector("[data-child-waitlist]:checked"));
        target.append(waitlistOnlyButton);
        const updateWaitlistOnlyButton = () => {
          waitlistOnlyButton.hidden = !(target.querySelector("[data-child-class]:checked") && target.querySelector("[data-child-waitlist]:checked"));
        };
        waitlistOnlyButton.addEventListener("click", () => {
          target.querySelectorAll("[data-child-class]").forEach((input) => { input.checked = false; });
          delete card.dataset.selectedClassId;
          delete card.dataset.paymentPlanCode;
          renderPaymentChoices(card, null);
          updateWaitlistOnlyButton();
          setCatalogMessage(card, "");
          saveDraft();
        });

        target.querySelectorAll("[data-child-waitlist]").forEach((input) => {
          input.addEventListener("change", () => {
            if (input.checked) {
              target.querySelectorAll("[data-child-waitlist]").forEach((other) => {
                if (other !== input) other.checked = false;
              });
              card.dataset.waitlistClassId = nextWaitlistSelection(card.dataset.waitlistClassId || "", input.value, true);
            } else {
              const next = nextWaitlistSelection(card.dataset.waitlistClassId || "", input.value, false);
              if (next) card.dataset.waitlistClassId = next;
              else delete card.dataset.waitlistClassId;
            }
            updateWaitlistOnlyButton();
            setCatalogMessage(card, "");
            saveDraft();
          });
        });
        target.querySelectorAll("[data-child-class]").forEach((input) => {
          input.addEventListener("change", () => {
            card.dataset.selectedClassId = input.value;
            delete card.dataset.paymentPlanCode;
            renderPaymentChoices(card, sessionForId(input.value));
            updateWaitlistOnlyButton();
            setCatalogMessage(card, "");
            saveDraft();
          });
        });
        renderPaymentChoices(card, sessionForId(selected));
      }

      function updatePreviousStageVisibility(card) {
        const returning = card.querySelector("[data-child-returning]:checked")?.value || "";
        const field = card.querySelector("[data-previous-stage-field]");
        const previous = card.querySelector("[data-child-previous-stage]");
        const visible = returning === "yes";
        field.hidden = !visible;
        previous.disabled = !visible;
        previous.required = visible;
        if (!visible) previous.value = "";
      }

      function refreshChildHeadings() {
        childCards().forEach((card, position) => {
          card.querySelector("[data-child-heading]").textContent = `${formCopy.child.cardTitle} ${position + 1}`;
        });
      }

      function renderChild(index, surname = "") {
        const card = document.createElement("article");
        card.className = "child-entry";
        card.dataset.childCard = "";
        card.dataset.childIndex = String(index);
        card.innerHTML = `
          <div class="child-entry-heading">
            <h3 data-child-heading>${formCopy.child.cardTitle} ${childCards().length + 1}</h3>
            <div class="child-entry-actions">
              ${index === 0 ? `<button class="text-button add-child-button" type="button" data-add-child>${formCopy.buttons.addChild}</button>` : `<button class="text-button" type="button" data-remove-child>${formCopy.buttons.removeChild}</button>`}
            </div>
          </div>
          <div class="compact-fields child-fields">
            <label><span>${formCopy.child.surname} ${requiredMarker()}</span><input name="child-${index}-surname" data-child-surname value="${escapeText(surname)}" required></label>
            <label><span>${formCopy.child.name} ${requiredMarker()}</span><input name="child-${index}-name" data-child-name required></label>
            <label><span>${formCopy.child.grade} ${requiredMarker()}</span><select name="child-${index}-grade" data-child-grade required><option value="">${formCopy.selectPlaceholder}</option>${formCopy.child.gradeOptions.map(optionHtml).join("")}</select></label>
            <label><span>${formCopy.child.gender} ${requiredMarker()}</span><select name="child-${index}-gender" data-child-gender required><option value="">${formCopy.selectPlaceholder}</option>${formCopy.child.genderOptions.map(optionHtml).join("")}</select></label>
            <label><span>${formCopy.child.dob} ${requiredMarker()}</span><input name="child-${index}-dob" data-child-dob type="date" required></label>
            <label><span>${formCopy.child.school}</span><input name="child-${index}-school" data-child-school></label>
            <fieldset class="returning-field field-wide" data-returning-field>
              <legend>${formCopy.child.returning} ${requiredMarker()}</legend>
              <div class="segmented-choice">
                ${formCopy.child.returningOptions.map((option) => `<label><input type="radio" name="child-${index}-returning" value="${escapeText(option.value)}" data-child-returning required><span>${escapeText(option.label)}</span></label>`).join("")}
              </div>
            </fieldset>
            <label data-previous-stage-field hidden><span>${formCopy.child.previousStage} ${requiredMarker()}</span><select name="child-${index}-previous-stage" data-child-previous-stage disabled><option value="">${formCopy.selectPlaceholder}</option>${formCopy.child.previousStageOptions.map(optionHtml).join("")}</select></label>
            <label><span>${formCopy.child.code}</span><input name="child-${index}-code" data-child-code autocomplete="off" placeholder="${formCopy.child.codePlaceholder}"></label>
          </div>
          <div class="class-picker">
            <label class="stage-field"><span>${formCopy.child.stage} ${requiredMarker()}</span><select name="child-${index}-stage" data-child-stage required><option value="">${formCopy.selectPlaceholder}</option>${stageOptions()}</select></label>
            <fieldset class="class-choice-fieldset" data-class-choice hidden>
              <legend>${formCopy.classChoice.title} ${requiredMarker()}</legend>
              <div class="class-options" data-class-options></div>
              <p class="catalog-message" data-catalog-message aria-live="polite" tabindex="-1"></p>
            </fieldset>
            <div data-payment-choice hidden></div>
          </div>
        `;
        childrenList.append(card);
        const stage = card.querySelector("[data-child-stage]");
        stage.value = initialStage.value;
        card.dataset.stageSource = initialStage.source;
        card.querySelector("[data-returning-field]").addEventListener("change", () => {
          updatePreviousStageVisibility(card);
          updateRecommendation(card);
          renderClasses(card);
        });
        card.querySelector("[data-child-previous-stage]").addEventListener("change", () => {
          updateRecommendation(card);
          renderClasses(card);
        });
          stage.addEventListener("change", () => {
          const selection = userStageSelection(stage.value);
          card.dataset.stageSource = selection.source;
          stage.value = selection.value;
          delete card.dataset.selectedClassId;
          delete card.dataset.waitlistClassId;
          delete card.dataset.paymentPlanCode;
          renderClasses(card);
        });
        card.querySelector("[data-add-child]")?.addEventListener("click", () => {
          const firstSurname = childCards()[0]?.querySelector("[data-child-surname]")?.value || "";
          childCount += 1;
          renderChild(childCount, firstSurname);
          saveDraft();
        });
        card.querySelector("[data-remove-child]")?.addEventListener("click", () => {
          card.remove();
          refreshChildHeadings();
          saveDraft();
        });
        updatePreviousStageVisibility(card);
        refreshChildHeadings();
        renderClasses(card);
      }

      function focusVisibleControl(control) {
        if (!control || control.disabled || control.closest("[hidden]")) return;
        control.focus();
        control.scrollIntoView({ block: "center", behavior: "smooth" });
      }

      function firstVisibleInvalidControl() {
        return Array.from(form.querySelectorAll(":invalid"))
          .find((control) => !control.disabled && !control.closest("[hidden]"));
      }

      function issueMessage(issue) {
        if (issue.code === "catalog_loading") return formCopy.classChoice.loading;
        if (issue.code === "catalog_unavailable") return formCopy.classChoice.unavailable;
        if (issue.code === "no_sessions") return formCopy.classChoice.noSessions;
        if (issue.code === "waitlist_required") return formCopy.classChoice.waitlistRequired;
        return formCopy.classChoice.selectRequired;
      }

      function validateInformation() {
        errorBox.hidden = true;
        if (!form.checkValidity()) {
          errorBox.hidden = false;
          const invalid = firstVisibleInvalidControl();
          const card = invalid?.closest("[data-child-card]");
          if (invalid?.matches("[data-child-class]") && card) {
            setCatalogMessage(card, formCopy.classChoice.selectRequired, true);
          }
          focusVisibleControl(invalid);
          return false;
        }
        for (const card of childCards()) {
          const stage = card.querySelector("[data-child-stage]").value;
          const issue = classSelectionIssue({
            catalogState,
            stage,
            sessions: sessionsForStage(stage),
            selectedClassId: card.querySelector("[data-child-class]:checked")?.value || "",
            selectedWaitlistId: card.querySelector("[data-child-waitlist]:checked")?.value || "",
          });
          if (issue) {
            errorBox.hidden = false;
            setCatalogMessage(card, issueMessage(issue), true);
            const target = issue.focusTarget === "stage"
              ? card.querySelector("[data-child-stage]")
              : issue.focusTarget === "class-options"
                ? card.querySelector("[data-child-class]")
                : card.querySelector("[data-catalog-message]");
            focusVisibleControl(target);
            return false;
          }
        }
        return true;
      }

      function value(selector) {
        return form.querySelector(selector)?.value.trim() || formCopy.messages.notSelected;
      }

      function availabilityText(session) {
        if (!session) return formCopy.classChoice.unavailable;
        if (session.availability === "available") return formCopy.classChoice.remainingSeats.replace("{count}", session.remainingSeats);
        if (session.availability === "full") return formCopy.classChoice.full;
        return formCopy.classChoice.unavailableSession;
      }

      function renderReview() {
        const children = childCards().map((card, index) => {
          const classId = card.querySelector("[data-child-class]:checked")?.value;
          const waitlistId = card.querySelector("[data-child-waitlist]:checked")?.value;
          const session = sessionForId(classId);
          const waitlist = sessionForId(waitlistId);
          const code = card.querySelector("[data-child-code]").value.trim();
          const plan = session?.paymentOptions?.find((option) => option.code === selectedPaymentPlanCode(card));
          return `<li><strong>${escapeText(`${card.querySelector("[data-child-surname]").value} ${card.querySelector("[data-child-name]").value}`.trim() || `${formCopy.child.cardTitle} ${index + 1}`)}</strong><span>${escapeText(stageLabels[card.querySelector("[data-child-stage]").value] || formCopy.messages.notSelected)}</span>${session ? `<span>${escapeText(formCopy.review.selectedClassHeading)}: ${escapeText(`${classText(session)} · ${availabilityText(session)}`)}</span>` : ""}${plan ? `<span>Төлбөр: ${escapeText(plan.code === "single" ? "Нэг удаа төлөх" : "2 хувааж төлөх")} · ${escapeText(formatMnt(plan.initialAmountMnt))}${plan.secondAmountMnt ? `; дараагийн ${escapeText(formatMnt(plan.secondAmountMnt))} · ${escapeText(formatLocalDate(plan.secondDueOn))}` : ""}</span>` : ""}${waitlist ? `<span>${escapeText(formCopy.review.waitlistHeading)}: ${escapeText(classText(waitlist))}</span>` : ""}${code ? `<span>${escapeText(formCopy.review.codeHeading)}: ${escapeText(code)}</span>` : ""}</li>`;
        }).join("");
        reviewSummary.innerHTML = `
          <section><h3>${escapeText(formCopy.review.guardianHeading)}</h3><p>${escapeText(value("#guardian-name"))} · ${escapeText(value("#guardian-phone"))}<br>${escapeText(value("#guardian-email"))}</p></section>
          <section><h3>${escapeText(formCopy.review.childHeading)}</h3><ul>${children}</ul></section>
          <section><h3>${escapeText(formCopy.review.acknowledgementHeading)}</h3><p>${escapeText(formCopy.review.guardianAcknowledged)}<br>${escapeText(formCopy.review.studentAcknowledged)}</p></section>
        `;
      }

      function loadTurnstileScript() {
        if (window.turnstile) return Promise.resolve(window.turnstile);
        return new Promise((resolve, reject) => {
          const existing = document.querySelector("script[data-turnstile-script]");
          if (existing) {
            existing.addEventListener("load", () => resolve(window.turnstile), { once: true });
            existing.addEventListener("error", reject, { once: true });
            return;
          }
          const script = document.createElement("script");
          script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
          script.async = true;
          script.defer = true;
          script.dataset.turnstileScript = "true";
          script.addEventListener("load", () => resolve(window.turnstile), { once: true });
          script.addEventListener("error", reject, { once: true });
          document.head.append(script);
        });
      }

      async function renderTurnstile() {
        if (!runtimeConfig.writeEnabled || !runtimeConfig.turnstileSiteKey) return;
        turnstileArea.hidden = false;
        try {
          const turnstile = await loadTurnstileScript();
          if (turnstileWidgetId !== null) {
            turnstile.reset(turnstileWidgetId);
            return;
          }
          turnstileWidgetId = turnstile.render(turnstileWidget, {
            sitekey: runtimeConfig.turnstileSiteKey,
            action: "registration_submit",
            callback(token) {
              turnstileToken = token;
              turnstileMessage.textContent = "";
            },
            "expired-callback"() {
              turnstileToken = "";
              turnstileMessage.textContent = formCopy.messages.turnstileRequired;
            },
            "error-callback"() {
              turnstileToken = "";
              turnstileMessage.textContent = formCopy.messages.turnstileRequired;
            },
          });
        } catch {
          turnstileMessage.textContent = formCopy.messages.turnstileRequired;
        }
      }

      function registrationPayload() {
        const genderValue = (value) => value === "Эмэгтэй" ? "female" : "male";
        return {
          guardian: {
            fullName: value("#guardian-name"),
            relationship: value("#guardian-relationship"),
            primaryPhone: value("#guardian-phone"),
            secondaryPhone: form.querySelector("#guardian-secondary-phone").value.trim(),
            email: value("#guardian-email"),
            facebookName: form.querySelector("#guardian-facebook").value.trim(),
            homeAddress: value("#guardian-address"),
          },
          children: childCards().map((card) => ({
            surname: card.querySelector("[data-child-surname]").value.trim(),
            givenName: card.querySelector("[data-child-name]").value.trim(),
            gender: genderValue(card.querySelector("[data-child-gender]").value),
            dateOfBirth: card.querySelector("[data-child-dob]").value,
            currentGrade: card.querySelector("[data-child-grade]").value,
            currentSchool: card.querySelector("[data-child-school]").value.trim(),
            returningStatus: card.querySelector("[data-child-returning]:checked")?.value === "yes" ? "returning" : "new",
            previousStageCode: card.querySelector("[data-child-previous-stage]").value || undefined,
            selectedStageCode: card.querySelector("[data-child-stage]").value,
            selectedClassSessionId: card.querySelector("[data-child-class]:checked")?.value || undefined,
            preferredWaitlistClassSessionId: card.querySelector("[data-child-waitlist]:checked")?.value || undefined,
            codeInput: card.querySelector("[data-child-code]").value.trim(),
            paymentPlanCode: selectedPaymentPlanCode(card) || undefined,
          })),
          parentRulesAcknowledged: parentAcknowledged,
          studentRulesAcknowledged: studentAcknowledged,
          parentRulesVersion: runtimeRules.parentRulesVersion,
          studentRulesVersion: runtimeRules.studentRulesVersion,
          turnstileToken,
        };
      }

      function formatDeadline(value) {
        if (!value) return "";
        const date = new Date(value);
        const hour = String(date.getHours()).padStart(2, "0");
        const minute = String(date.getMinutes()).padStart(2, "0");
        return `${date.getMonth() + 1}-р сарын ${date.getDate()}, ${hour}:${minute}`;
      }

      function selectedPaymentPlanCode(card) {
        return card.querySelector('[data-child-payment-plan]:checked, input[type="hidden"][data-child-payment-plan]')?.value || "";
      }

      function showResult(title, bodyHtml) {
        bootingPanel.hidden = true;
        form.hidden = true;
        reviewPanel.hidden = true;
        draftNotice.hidden = true;
        resultTitle.textContent = title;
        resultBody.innerHTML = bodyHtml;
        resultPanel.hidden = false;
        progress.textContent = runtimeConfig.writeEnabled ? "Бүртгэлийн төлөв" : progress.textContent;
        resultTitle.focus?.();
        resultPanel.scrollIntoView({ block: "start" });
      }

      function classStatusText(child) {
        const parts = [];
        if (child.canonicalEnrollmentStatus === "confirmed") parts.push(`<strong>Бүртгэл баталгаажлаа</strong>`);
        if (child.selectedClassLabel) {
          parts.push(`<strong>${escapeText(child.selectedClassLabel)}</strong> · ${escapeText(`${child.selectedClassWeekday} ${child.selectedClassStartTime}–${child.selectedClassEndTime}`)}`);
        }
        if (child.waitlistClassLabel && child.waitlistStatus) {
          parts.push(`Хүлээлгийн жагсаалт: <strong>${escapeText(child.waitlistClassLabel)}</strong> · ${escapeText(`${child.waitlistClassWeekday} ${child.waitlistClassStartTime}–${child.waitlistClassEndTime}`)}`);
        }
        return parts.join("<br>");
      }

      async function showVerifiedStatus(alreadyVerified = false) {
        try {
          const response = await fetch("/api/registration/status", { headers: { Accept: "application/json" }, credentials: "same-origin" });
          if (!response.ok) throw new Error("status unavailable");
          const status = await response.json();
          if (!catalog) await loadCatalog();
          const hasPaymentHold = status.children.some((child) => child.holdType === "initial_payment" && child.holdStatus === "active");
          const hasConfirmedEnrollment = status.children.some((child) => child.canonicalEnrollmentStatus === "confirmed");
          const paymentRequest = status.children.find((child) => child.paymentRequestId)?.paymentRequestId || "";
          const paymentReference = status.children.find((child) => child.paymentReference)?.paymentReference || "";
          const parentClaimed = status.children.some((child) => child.parentPaymentClaimed);
          const seatUnavailable = status.status === "seat_unavailable" || status.children.some((child) => child.status === "seat_unavailable");
          const children = status.children.map((child) => {
            const alternatives = child.status === "seat_unavailable"
              ? sessionsForStage(child.selectedStageCode).filter((session) => session.availability === "available")
              : [];
            const payment = child.canonicalEnrollmentStatus === "confirmed"
              ? `<span>Төлбөр орсон${child.laterInstallmentAmountMnt ? `<br>Дараагийн төлбөр: <strong>${escapeText(formatMnt(child.laterInstallmentAmountMnt))}</strong> · ${escapeText(formatDeadline(child.laterInstallmentDueAt))}` : ""}</span>`
              : child.initialPaymentAmountMnt ? `<span>Одоо төлөх: <strong>${escapeText(formatMnt(child.initialPaymentAmountMnt))}</strong>${child.secondPaymentAmountMnt ? `<br>Дараагийн төлбөр: ${escapeText(formatMnt(child.secondPaymentAmountMnt))} · ${escapeText(formatLocalDate(child.secondPaymentDueOn))}` : ""}</span>` : "";
            const facebook = child.canonicalEnrollmentStatus === "confirmed" && child.offeringFacebookGroupUrl
              ? `<a class="text-button" href="${escapeText(child.offeringFacebookGroupUrl)}" rel="noopener noreferrer" target="_blank">Facebook бүлэг</a>` : "";
            return `<li><strong>${escapeText(`${child.surname} ${child.givenName}`)}</strong><span>${classStatusText(child)}</span>${child.holdDeadlineAt && child.canonicalEnrollmentStatus !== "confirmed" ? `<span>Төлбөрийн хугацаа: ${escapeText(formatDeadline(child.holdDeadlineAt))}</span>` : ""}${payment}${facebook}${alternatives.length ? `<span>Одоогоор сул суудалтай: ${alternatives.map((session) => escapeText(classText(session))).join(", ")}</span>` : ""}${child.status === "seat_unavailable" && !child.waitlistStatus ? `<button class="button secondary join-original-waitlist" type="button" data-child-id="${escapeText(child.id)}">${escapeText(formCopy.buttons.joinWaitlist)}</button>` : ""}</li>`;
          }).join("");
          showResult(hasConfirmedEnrollment ? "Бүртгэл баталгаажлаа" : status.verifiedAt ? (alreadyVerified ? formCopy.messages.alreadyVerifiedTitle : formCopy.messages.verifiedTitle) : "Бүртгэлийн мэдээллийг хүлээн авлаа.", `
            ${hasPaymentHold ? `<p class="status-emphasis">${escapeText(formCopy.messages.paymentHold)}</p>` : ""}
            ${seatUnavailable ? `<p class="form-error">${escapeText(formCopy.messages.seatLost)}</p>` : ""}
            <ul class="status-children">${children}</ul>
            ${hasPaymentHold && status.paymentCollection ? `<section class="payment-instructions"><h3>Шилжүүлгийн мэдээлэл</h3><p>${escapeText(status.paymentCollection.bankName)}<br>${escapeText(status.paymentCollection.accountHolderName)}${status.paymentCollection.iban ? `<br><strong>IBAN: ${escapeText(status.paymentCollection.iban)}</strong>` : ""}<br><strong>${escapeText(status.paymentCollection.accountNumber)}</strong>${status.paymentCollection.transferInstruction ? `<br>${escapeText(status.paymentCollection.transferInstruction)}` : ""}</p>${paymentReference ? `<p>Гүйлгээний утга: <strong id="payment-reference">${escapeText(paymentReference)}</strong> <button id="copy-payment-reference" class="text-button" type="button">Хуулах</button></p>` : ""}<p class="staff-muted">Бид төлбөр банканд орсныг шалгаж баталгаажуулна. Баталгаажуулалт ихэвчлэн 12–24 цагийн дотор хийгдэнэ.</p><p>И-мэйлээ баталгаажуулбал бүртгэлийн мэдээлэл, төлөвийн мэдэгдлийг и-мэйлээр авах боломжтой.</p>${paymentRequest ? `<button id="claim-payment" class="button secondary" type="button" ${parentClaimed ? "disabled" : ""}>${parentClaimed ? "Төлбөр хийснээ мэдэгдсэн" : "Төлбөр хийснээ мэдэгдэх"}</button><p id="payment-claim-message" class="catalog-message" role="status"></p>` : ""}</section>` : ""}
          `);
          document.getElementById("copy-payment-reference")?.addEventListener("click", async () => {
            try { await navigator.clipboard.writeText(paymentReference); } catch { /* selection remains visible for manual copy */ }
          });
          document.getElementById("claim-payment")?.addEventListener("click", async (event) => {
            const button = event.currentTarget;
            const message = document.getElementById("payment-claim-message");
            button.disabled = true;
            try {
              const response = await fetch("/api/registration/status/payment-claim", {
                method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" },
                credentials: "same-origin", body: JSON.stringify({ paymentRequestId: paymentRequest }),
              });
              if (!response.ok) throw new Error("claim unavailable");
              message.textContent = "Таны мэдэгдлийг тэмдэглэлээ. Энэ нь төлбөр баталгаажсан гэсэн үг биш юм.";
              button.textContent = "Төлбөр хийсэн гэж мэдэгдсэн";
            } catch {
              button.disabled = false;
              message.textContent = formCopy.messages.submitFailed;
            }
          });
          resultBody.querySelectorAll(".join-original-waitlist").forEach((button) => {
            button.addEventListener("click", async () => {
              button.disabled = true;
              try {
                const response = await fetch("/api/registration/status/waitlist", {
                  method: "POST",
                  headers: { "Content-Type": "application/json", Accept: "application/json" },
                  credentials: "same-origin",
                  body: JSON.stringify({ childId: button.dataset.childId }),
                });
                if (!response.ok) throw new Error("waitlist unavailable");
                await showVerifiedStatus(true);
              } catch {
                button.textContent = formCopy.messages.submitFailed;
              } finally {
                button.disabled = false;
              }
            });
          });
          const newRegistration = '<div class="status-actions"><button id="start-new-registration" class="button secondary" type="button">Өөр хүүхэд бүртгүүлэх</button></div>';
          resultBody.insertAdjacentHTML("beforeend", newRegistration);
          document.getElementById("start-new-registration")?.addEventListener("click", startNewRegistration);
          discardStoredDraft();
        } catch {
          showResult(alreadyVerified ? formCopy.messages.alreadyVerifiedTitle : formCopy.messages.verifiedTitle, `<p>${escapeText(formCopy.messages.submitFailed)}</p>`);
        }
      }

      function showDialog(dialog) {
        returnFocusTo = document.activeElement;
        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");
      }

      function closeDialog(dialog) {
        if (typeof dialog.close === "function") dialog.close();
        else dialog.removeAttribute("open");
      }

      function showReview() {
        renderReview();
        bootingPanel.hidden = true;
        form.hidden = true;
        reviewPanel.hidden = false;
        progress.textContent = `4 / 4 · ${formCopy.progress.review}`;
        reviewPanel.querySelector("h2")?.focus();
        renderTurnstile();
      }

      document.querySelectorAll("[data-close-dialog]").forEach((button) => {
        button.addEventListener("click", () => closeDialog(document.getElementById(button.dataset.closeDialog)));
      });
      [guardianDialog, studentDialog].forEach((dialog) => {
        dialog.addEventListener("close", () => {
          if (!guardianDialog.open && !studentDialog.open) returnFocusTo?.focus?.();
        });
      });
      guardianDialog.addEventListener("cancel", () => { parentAcknowledged = parentAcknowledged; });
      studentDialog.addEventListener("cancel", () => { studentAcknowledged = studentAcknowledged; });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!validateInformation()) return;
        saveDraft();
        progress.textContent = `2 / 4 · ${formCopy.progress.guardianRules}`;
        showDialog(guardianDialog);
      });
      document.getElementById("acknowledge-guardian").addEventListener("click", () => {
        parentAcknowledged = true;
        closeDialog(guardianDialog);
        progress.textContent = `3 / 4 · ${formCopy.progress.studentRules}`;
        showDialog(studentDialog);
      });
      document.getElementById("acknowledge-student").addEventListener("click", () => {
        studentAcknowledged = true;
        closeDialog(studentDialog);
        if (parentAcknowledged && studentAcknowledged) showReview();
      });
      document.getElementById("edit-information").addEventListener("click", () => {
        reviewPanel.hidden = true;
        form.hidden = false;
        completeMessage.hidden = true;
        progress.textContent = `1 / 4 · ${formCopy.progress.information}`;
        turnstileToken = "";
        document.getElementById("guardian-name").focus();
      });
      finishButton.addEventListener("click", async () => {
        if (!runtimeConfig.writeEnabled) {
          completeMessage.hidden = false;
          discardStoredDraft();
          return;
        }
        if (!turnstileToken) {
          turnstileMessage.textContent = formCopy.messages.turnstileRequired;
          turnstileArea.scrollIntoView({ block: "center" });
          return;
        }
        finishButton.disabled = true;
        finishButton.textContent = formCopy.messages.submitting;
        turnstileMessage.textContent = "";
        try {
          const response = await fetch("/api/registration/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            credentials: "same-origin",
            body: JSON.stringify(registrationPayload()),
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result?.error?.message || formCopy.messages.submitFailed);
          discardStoredDraft();
          await showVerifiedStatus(false);
        } catch (caught) {
          turnstileMessage.textContent = caught.message || formCopy.messages.submitFailed;
          turnstileToken = "";
          window.turnstile?.reset(turnstileWidgetId);
        } finally {
          finishButton.disabled = false;
          finishButton.textContent = formCopy.buttons.submitRegistration;
        }
      });
      form.addEventListener("input", saveDraft);
      form.addEventListener("change", saveDraft);

      function restoreDraft(draft) {
        const values = new Map(draft.fields);
        childrenList.replaceChildren();
        childCount = 0;
        renderChild(0, values.get("child-0-surname") || "");
        const safeChildCount = Math.min(draft.childCount, 8);
        for (let index = 1; index < safeChildCount; index += 1) {
          childCount += 1;
          renderChild(childCount, values.get(`child-${childCount}-surname`) || "");
        }
        for (const [name, savedValue] of values) {
          Array.from(form.elements).filter((control) => control.name === name).forEach((control) => {
            if (["radio", "checkbox"].includes(control.type)) control.checked = control.value === savedValue;
            else control.value = savedValue;
          });
        }
        childCards().forEach((card) => {
          updatePreviousStageVisibility(card);
          const stage = card.querySelector("[data-child-stage]");
          if (stage.value) card.dataset.stageSource = "user";
          card.dataset.selectedClassId = values.get(`child-${card.dataset.childIndex}-class`) || "";
          card.dataset.waitlistClassId = values.get(`child-${card.dataset.childIndex}-waitlist`) || "";
          renderClasses(card);
        });
        discardStoredDraft();
      }

      function showRegistrationForm() {
        bootingPanel.hidden = true;
        resultPanel.hidden = true;
        reviewPanel.hidden = true;
        form.hidden = false;
        document.body.dataset.registrationSurface = "form";
        if (storedDraft) draftNotice.hidden = false;
      }
      function startNewRegistration() {
        form.reset();
        parentAcknowledged = false;
        studentAcknowledged = false;
        childrenList.replaceChildren();
        childCount = 0;
        renderChild(childCount, "");
        childCards().forEach((card) => { updateStageOptions(card); renderClasses(card); });
        showRegistrationForm();
        window.history.replaceState({}, "", "/register/");
      }
      restoreDraftButton.addEventListener("click", () => storedDraft && restoreDraft(storedDraft));
      discardDraftButton.addEventListener("click", discardStoredDraft);
      async function loadCatalog() {
        try {
          const response = await fetch("/api/registration/catalog", { headers: { Accept: "application/json" } });
          if (!response.ok) throw new Error("Catalog unavailable");
          const payload = await response.json();
          if (!Array.isArray(payload.academicYears)) throw new Error("Invalid catalog");
          catalog = payload;
          catalogState = "available";
        } catch {
          catalog = null;
          catalogState = "unavailable";
        }
        childCards().forEach((card) => { updateStageOptions(card); renderClasses(card); });
      }

      async function loadBootstrap() {
        try {
          const response = await fetch("/api/registration/bootstrap", { headers: { Accept: "application/json" } });
          if (!response.ok) throw new Error("Bootstrap unavailable");
          const payload = await response.json();
          if (!Array.isArray(payload?.catalog?.academicYears)) throw new Error("Invalid bootstrap");
          runtimeConfig = payload.config;
          catalog = payload.catalog;
          const guardian = (payload.courseRules || []).find((rule) => rule.code === "guardian"); const student = (payload.courseRules || []).find((rule) => rule.code === "student");
          if (guardian && student) {
            runtimeRules = { parentRulesVersion: guardian.versionId, studentRulesVersion: student.versionId };
            document.getElementById("guardian-rules-title").textContent = guardian.title;
            document.getElementById("student-rules-title").textContent = student.title;
            document.getElementById("guardian-rules-body").innerHTML = guardian.bodyText.split(/\n\s*\n/).map((paragraph) => `<p>${paragraph.replace(/[&<>]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[character])}</p>`).join("");
            document.getElementById("student-rules-body").innerHTML = student.bodyText.split(/\n\s*\n/).map((paragraph) => `<p>${paragraph.replace(/[&<>]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[character])}</p>`).join("");
          }
          catalogState = "available";
          if (runtimeConfig.writeEnabled) {
            environmentNotice.textContent = formCopy.messages.stagingNotice;
            environmentNotice.classList.add("staging-notice");
            finishButton.textContent = formCopy.buttons.submitRegistration;
            document.getElementById("review-help").textContent = formCopy.review.stagingHelp;
          }
        } catch {
          catalog = null;
          catalogState = "unavailable";
        }
        childCards().forEach((card) => { updateStageOptions(card); renderClasses(card); });
      }

      renderChild(childCount, "");
      storedDraft = readStoredDraft();
      async function settleInitialSurface() {
        await loadBootstrap();
        const status = new URLSearchParams(window.location.search).get("status");
        if (runtimeConfig.writeEnabled && (status === "confirmed" || status === "already-verified")) {
          document.body.dataset.registrationSurface = "verified";
          await showVerifiedStatus(status === "already-verified");
          return;
        } else if (runtimeConfig.writeEnabled) {
          try {
            const response = await fetch("/api/registration/status", { headers: { Accept: "application/json" }, credentials: "same-origin" });
            if (response.ok) {
              document.body.dataset.registrationSurface = "verified";
              await showVerifiedStatus(false);
              return;
            }
          } catch {
            // A temporary status lookup failure must still let a parent use the form.
          }
        }
        showRegistrationForm();
      }
      settleInitialSurface();
    </script>
  </body>
</html>
