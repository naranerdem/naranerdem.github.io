---
import { siteIdentity } from "../content/homepage";
import "../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Наран Эрдэм" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/images/naran-erdem-logo.jpg" />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
    <title>Ажилтны хэсэг | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/" aria-label="Нүүр хуудас">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span>
          <strong>{siteIdentity.name}</strong>
          <span>Ажилтны хэсэг</span>
        </span>
      </a>
    </header>

    <main class="staff-shell" aria-live="polite">
      <section id="staff-booting" class="staff-state">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1>Түр хүлээнэ үү</h1>
        <p class="staff-muted">Нэвтрэх төлөвийг шалгаж байна.</p>
      </section>

      <section id="staff-login" class="staff-state" hidden aria-labelledby="staff-login-title">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1 id="staff-login-title">Нэвтрэх</h1>
        <p class="staff-muted">Бүртгэлтэй и-мэйл хаягаар нэг удаагийн баталгаажуулах холбоос авна.</p>
        <form id="staff-login-form" class="staff-login-form">
          <label for="staff-email">И-мэйл хаяг</label>
          <input id="staff-email" name="email" type="email" inputmode="email" autocomplete="email" required />
          <div id="staff-turnstile" class="turnstile-widget" aria-label="Аюулгүй байдлын шалгалт"></div>
          <p id="staff-form-error" class="staff-error" role="alert" hidden></p>
          <button class="button primary" type="submit">Нэвтрэх холбоос авах</button>
        </form>
      </section>

      <section id="staff-waiting" class="staff-state" hidden aria-labelledby="staff-waiting-title">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1 id="staff-waiting-title">И-мэйлээ шалгана уу</h1>
        <p class="staff-muted">Хэрэв энэ хаяг идэвхтэй ажилтны бүртгэлтэй бол баталгаажуулах холбоос илгээгдэнэ.</p>
        <p class="staff-wait-note">Холбоосоо нээсний дараа энэ цонх автоматаар нэвтэрнэ.</p>
        <button id="staff-try-again" class="button secondary" type="button">Өөр хаягаар оролдох</button>
      </section>

      <section id="staff-approved" class="staff-state" hidden aria-labelledby="staff-approved-title">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1 id="staff-approved-title">Нэвтрэх хүсэлт баталгаажлаа.</h1>
        <p class="staff-muted">Нэвтрэх гэж байсан цонх эсвэл Наран Эрдэм апп руугаа буцна уу.</p>
        <a class="button primary" href="/staff/">Наран Эрдэм рүү очих</a>
      </section>

      <section id="staff-attempt-expired" class="staff-state" hidden aria-labelledby="staff-attempt-expired-title">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1 id="staff-attempt-expired-title">Нэвтрэх хүсэлтийн хугацаа дууссан байна</h1>
        <p class="staff-muted">Шинэ нэвтрэх холбоос авна уу.</p>
        <button id="staff-restart" class="button primary" type="button">Дахин эхлэх</button>
      </section>

      <section id="staff-link-error" class="staff-state" hidden aria-labelledby="staff-link-error-title">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1 id="staff-link-error-title">Холбоос хүчингүй байна</h1>
        <p class="staff-muted">Холбоос ашиглагдсан эсвэл хугацаа нь дууссан байна.</p>
        <button id="staff-new-link" class="button primary" type="button">Шинэ холбоос авах</button>
      </section>

      <section id="staff-home" class="staff-state" hidden aria-labelledby="staff-home-title">
        <p class="eyebrow">Ажилтны хэсэг</p>
        <h1 id="staff-home-title">Сайн байна уу</h1>
        <p id="staff-welcome" class="staff-muted"></p>
        <nav id="staff-tool-links" aria-label="Ажиллах хэрэгсэл" hidden>
          <section class="staff-tool-section" data-tool-section aria-labelledby="staff-daily-title">
            <p class="eyebrow">Өдөр тутмын ажил</p>
            <h2 id="staff-daily-title">Өнөөдөр</h2>
            <div class="staff-tool-grid staff-tool-grid-daily">
              <a class="staff-tool-link staff-tool-primary" data-capability="attendance.view" href="/staff/attendance/"><strong>Ирц</strong><span>Өнөөдрийн хичээл, сурагчдын ирц</span></a>
              <a class="staff-tool-link" data-capability="makeup.view" href="/staff/makeups/"><strong>Нөхөх хичээл</strong><span>Тасалсан хичээлийг шийдэх, товлох</span></a>
              <a class="staff-tool-link" data-capability="calendar.manage" href="/staff/day-changes/"><strong>Өдрийн өөрчлөлт</strong><span>Хичээл цуцлах, орлуулах өдөр, нэмэлт өдөр</span></a>
              <a class="staff-tool-link" data-capability="payment.view" href="/staff/payments/"><strong>Бүртгэл, төлбөр</strong><span id="staff-payment-summary">Бүртгэл, эхний төлбөр, хүлээлгийн жагсаалт</span></a>
            </div>
          </section>
          <section id="staff-setup-section" class="staff-tool-section staff-tool-section-secondary" data-tool-section aria-labelledby="staff-setup-title">
            <p class="eyebrow">Сургалтын тохиргоо</p>
            <h2 id="staff-setup-title">Сургалт ба хуваарь</h2>
            <div class="staff-tool-grid">
              <a class="staff-tool-link" data-capability="calendar.manage" href="/staff/offerings/"><strong>Сургалт, арга хэмжээ</strong><span>Жилийн болон зуны сургалт, нэг удаагийн арга хэмжээ</span></a>
              <a class="staff-tool-link" data-capability="program.manage" href="/staff/programs/"><strong>Хөтөлбөр</strong><span>Хичээлүүдийг бэлтгэх</span></a>
              <a class="staff-tool-link" data-capability="calendar.manage" href="/staff/schedule/"><strong>Хуваарь</strong><span>Анги, цаг, огноотой хуваарь</span></a>
              <a class="staff-tool-link" data-capability="calendar.manage" href="/staff/holidays/"><strong>Амралтын хуваарь</strong><span>Жилийн амралтын хугацаа</span></a>
              <a id="staff-registration-link" class="staff-tool-link" data-capability="registration.manage" href="/staff/registration-windows/"><strong>Бүртгэлийн хугацаа</strong><span>Нийтийн бүртгэлийг нээх, хаах</span></a>
              <a id="staff-information-link" class="staff-tool-link" data-capability="content.manage" href="/staff/info/"><strong>Мэдээлэл</strong><span>Төв, төлбөр, журам</span></a>
            </div>
          </section>
          <section class="staff-tool-section staff-tool-section-secondary" data-tool-section aria-labelledby="staff-admin-title">
            <p class="eyebrow">Удирдлага</p>
            <h2 id="staff-admin-title">Ерөнхий удирдлага</h2>
            <div class="staff-tool-grid">
              <a class="staff-tool-link" data-capability="admin.staff.manage" href="/staff/team/"><strong>Ажилтнууд</strong><span>Нэвтрэх эрх, үүрэг, идэвхтэй төлөв</span></a>
              <a class="staff-tool-link" data-capability="admin.settings.manage" href="/staff/settings/"><strong>Тохиргоо</strong><span>Ерөнхий, ховор тохиргоо</span></a>
            </div>
          </section>
          <p id="staff-no-tools" class="staff-empty" hidden>Таны эрхэд тохирох өдөр тутмын хэрэгсэл одоогоор нэмэгдээгүй байна.</p>
        </nav>
      </section>
    </main>

    <script is:inline type="module">
      const states = [...document.querySelectorAll(".staff-state")];
      const loginForm = document.getElementById("staff-login-form");
      const emailInput = document.getElementById("staff-email");
      const formError = document.getElementById("staff-form-error");
      const welcome = document.getElementById("staff-welcome");
      const toolLinks = document.getElementById("staff-tool-links");
      let pollTimer = 0;
      let polling = false;
      let staffLoginConfig = { emailLoginEnabled: false, turnstileSiteKey: null };
      let staffTurnstileWidget = null;

      function stopPolling() {
        window.clearTimeout(pollTimer);
        pollTimer = 0;
        polling = false;
      }

      function show(id) {
        for (const state of states) state.hidden = state.id !== id;
        document.body.dataset.staffSurface = id.replace("staff-", "");
        if (id !== "staff-waiting") stopPolling();
      }

      function showStaffLogin() {
        show("staff-login");
        void prepareStaffLogin();
      }

      async function waitForTurnstile() {
        for (let attempt = 0; attempt < 40; attempt += 1) {
          if (window.turnstile) return window.turnstile;
          await new Promise((resolve) => window.setTimeout(resolve, 100));
        }
        return null;
      }

      async function prepareStaffLogin() {
        try {
          const response = await fetch("/api/staff/auth/config", { headers: { Accept: "application/json" }, credentials: "same-origin" });
          if (!response.ok) throw new Error("staff login config unavailable");
          staffLoginConfig = await response.json();
        } catch {
          staffLoginConfig = { emailLoginEnabled: false, turnstileSiteKey: null };
        }
        if (!staffLoginConfig.emailLoginEnabled || !staffLoginConfig.turnstileSiteKey) return false;
        const turnstile = await waitForTurnstile();
        if (!turnstile) return false;
        if (staffTurnstileWidget === null) {
          staffTurnstileWidget = turnstile.render("#staff-turnstile", {
            sitekey: staffLoginConfig.turnstileSiteKey,
            action: "staff_login_start",
          });
        }
        return true;
      }

      async function showAuthenticated(session) {
        welcome.textContent = `${session.displayName}, таны нэвтрэх эрх баталгаажлаа.`;
        const capabilities = session.capabilities || [];
        for (const link of toolLinks.querySelectorAll("[data-capability]")) {
          link.hidden = !capabilities.includes(link.dataset.capability);
        }
        let teacherPreferences = null;
        if ((session.roles || []).includes("teacher")) {
          try {
            const response = await fetch("/api/staff/dashboard-preferences", { credentials: "same-origin", headers: { Accept: "application/json" } });
            if (response.ok) {
              const preferences = await response.json();
              teacherPreferences = preferences;
              if (preferences.showSetupSection) {
                document.getElementById("staff-registration-link").hidden ||= !preferences.showRegistration;
                document.getElementById("staff-information-link").hidden ||= !preferences.showInformation;
              }
            }
          } catch { /* Presentation defaults remain visible when preferences cannot load. */ }
        }
        let visibleSections = 0;
        for (const section of toolLinks.querySelectorAll("[data-tool-section]")) {
          section.hidden = section.id === "staff-setup-section" && teacherPreferences && !teacherPreferences.showSetupSection
            ? true : !section.querySelector("[data-capability]:not([hidden])");
          if (!section.hidden) visibleSections += 1;
        }
        document.getElementById("staff-no-tools").hidden = visibleSections > 0;
        toolLinks.hidden = false;
        show("staff-home");
        updatePaymentSummary(session.capabilities || []);
      }

      async function updatePaymentSummary(capabilities) {
        if (!capabilities.includes("payment.view")) return;
        const node = document.getElementById("staff-payment-summary");
        if (!node) return;
        try {
          const response = await fetch("/api/staff/payments", { credentials: "same-origin", headers: { Accept: "application/json" } });
          if (!response.ok) return;
          const data = await response.json();
          const now = new Date(data.now).getTime();
          const overduePayments = new Set((data.items || []).filter((item) => Number(item.expectedAmountMnt) > Number(item.allocatedAmountMnt)
            && new Date(item.remainingPaymentDueAt || item.paymentDueAt).getTime() < now).map((item) => item.installmentId));
          const overdueOffers = new Set((data.waitlistOffers || []).filter((item) => item.status === "active"
            && new Date(item.respondByAt).getTime() < now).map((item) => item.id));
          const parts = [];
          if (overduePayments.size) parts.push(`${overduePayments.size} төлбөр шалгах шаардлагатай`);
          if (overdueOffers.size) parts.push(`${overdueOffers.size} хүлээлгийн саналын хугацаа хэтэрсэн`);
          if (!parts.length) return;
          node.textContent = parts.join(" · ");
          node.classList.add("staff-payment-summary-urgent");
        } catch {
          // The dashboard remains useful if the optional summary cannot load.
        }
      }

      async function readSession() {
        const response = await fetch("/api/staff/session", {
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        if (!response.ok) throw new Error("session unavailable");
        return response.json();
      }

      async function claimAttempt() {
        const response = await fetch("/api/staff/auth/attempt/claim", {
          method: "POST",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        if (!response.ok) throw new Error("attempt unavailable");
        return response.json();
      }

      function schedulePoll() {
        if (document.visibilityState !== "visible" || document.body.dataset.staffSurface !== "waiting") return;
        window.clearTimeout(pollTimer);
        pollTimer = window.setTimeout(pollAttempt, 4000);
      }

      async function pollAttempt() {
        if (polling || document.visibilityState !== "visible" || document.body.dataset.staffSurface !== "waiting") return;
        polling = true;
        try {
          const attempt = await claimAttempt();
          if (attempt.state === "authenticated") {
            const session = await readSession();
            if (session.authenticated) await showAuthenticated(session);
            else show("staff-login");
            return;
          }
          if (attempt.state === "expired" || attempt.state === "claimed") {
            show("staff-attempt-expired");
            return;
          }
          if (attempt.state === "none") {
            show("staff-login");
            return;
          }
        } catch {
          // A short network failure should not discard the pending request.
        } finally {
          polling = false;
        }
        schedulePoll();
      }

      function waitForApproval() {
        show("staff-waiting");
        schedulePoll();
      }

      async function bootstrap() {
        const token = new URLSearchParams(window.location.hash.slice(1)).get("token") || "";
        window.history.replaceState(null, "", window.location.pathname);
        if (token) {
          try {
            const response = await fetch("/api/staff/auth/verify", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              credentials: "same-origin",
              body: JSON.stringify({ token }),
            });
            if (!response.ok) throw new Error("verification failed");
            const result = await response.json();
            if (!result.claimed) {
              show("staff-approved");
              return;
            }
          } catch {
            show("staff-link-error");
            return;
          }
        }
        try {
          const session = await readSession();
          if (session.authenticated) {
            await showAuthenticated(session);
            return;
          }
          const attempt = await claimAttempt();
          if (attempt.state === "pending") waitForApproval();
          else if (attempt.state === "expired" || attempt.state === "claimed") show("staff-attempt-expired");
          else {
            showStaffLogin();
          }
        } catch {
          showStaffLogin();
          formError.textContent = "Нэвтрэх хэсгийг одоогоор нээж чадсангүй. Дахин оролдоно уу.";
          formError.hidden = false;
        }
      }

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!loginForm.reportValidity()) return;
        formError.hidden = true;
        if (!await prepareStaffLogin()) {
          formError.textContent = "Нэвтрэх хамгаалалтын шалгалтыг одоогоор нээж чадсангүй. Дахин оролдоно уу.";
          formError.hidden = false;
          return;
        }
        const turnstileToken = window.turnstile?.getResponse(staffTurnstileWidget) || "";
        if (!turnstileToken) {
          formError.textContent = "Хамгаалалтын шалгалтыг дахин хийнэ үү.";
          formError.hidden = false;
          return;
        }
        const button = loginForm.querySelector("button[type='submit']");
        button.disabled = true;
        try {
          const response = await fetch("/api/staff/auth/start", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ email: emailInput.value, turnstileToken }),
          });
          if (!response.ok) throw new Error("start failed");
          waitForApproval();
        } catch {
          formError.textContent = "Хүсэлтийг одоогоор илгээж чадсангүй. Дахин оролдоно уу.";
          formError.hidden = false;
          } finally {
            if (staffTurnstileWidget !== null) window.turnstile?.reset(staffTurnstileWidget);
            button.disabled = false;
        }
      });

      document.getElementById("staff-try-again").addEventListener("click", showStaffLogin);
      document.getElementById("staff-new-link").addEventListener("click", showStaffLogin);
      document.getElementById("staff-restart").addEventListener("click", showStaffLogin);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && document.body.dataset.staffSurface === "waiting") {
          pollAttempt();
        } else {
          window.clearTimeout(pollTimer);
        }
      });
      window.addEventListener("hashchange", bootstrap);
      bootstrap();
    </script>
  </body>
</html>
