---
import { siteIdentity } from "../content/homepage";
import "../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#073aaf" />
    <title>Суудлын санал | {siteIdentity.name}</title>
  </head>
  <body>
    <main class="register-shell">
      <a class="brand-link" href="/"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Туршилт сургалтын лаборатори</span></span></a>
      <section class="registration-form" aria-live="polite">
        <p class="eyebrow">Хүлээлгийн жагсаалт</p><h1>Түр хүлээнэ үү</h1><p id="offer-message">Саналын мэдээллийг шалгаж байна.</p>
        <div id="offer-actions" hidden></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      const message = document.querySelector("#offer-message"); const actions = document.querySelector("#offer-actions");
      const token = new URLSearchParams(location.hash.slice(1)).get("token") || "";
      async function request(payload) { const response = await fetch("/api/waitlist-offer", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ token, ...payload }) }); const body = await response.json().catch(() => null); if (!response.ok) throw new Error(body?.error?.message || "Саналын мэдээллийг авч чадсангүй."); return body; }
      function localDate(value) { const parts = Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Ulaanbaatar", year: "numeric", month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(new Date(value)).filter((part) => part.type !== "literal").map((part) => [part.type, part.value])); return `${parts.year} оны ${Number(parts.month)}-р сарын ${Number(parts.day)}-ний ${parts.hour}:${parts.minute} цаг`; }
      function paymentSummary(status) { const payment = status.paymentCollection; const children = (status.children || []).filter((child) => child.holdType === "initial_payment" && child.holdStatus === "active"); if (!payment || !children.length) return "<p>Төлбөрийн мэдээллийг авч чадсангүй. Дахин ачаална уу.</p>"; return children.map((child) => `<section class="payment-instructions"><h2>Төлбөрийн мэдээлэл</h2><p><strong>${child.surname || ""} ${child.givenName || ""}</strong><br>${child.selectedClassLabel || ""} · ${child.selectedClassWeekday || ""} ${child.selectedClassStartTime || ""}–${child.selectedClassEndTime || ""}</p><p>Одоо төлөх дүн: <strong>${new Intl.NumberFormat("en-US").format(Number(child.initialPaymentAmountMnt || 0))} ₮</strong><br>Хугацаа: <strong>${localDate(child.holdDeadlineAt)}</strong></p><p>${payment.bankName}<br><strong>${payment.accountNumber}</strong><br>${payment.accountHolderName}${payment.iban ? `<br><strong>IBAN: ${payment.iban}</strong>` : ""}${payment.transferInstruction ? `<br>${payment.transferInstruction}` : ""}</p><p>Гүйлгээний утга: <strong>${child.paymentReference || ""}</strong></p></section>`).join(""); }
      function show(offer) { const date = localDate(offer.respondByAt); message.innerHTML = offer.converted ? paymentSummary(offer.paymentStatus) : `<strong>Танд суудал гарлаа</strong><br>${offer.childName}<br>${offer.classLabel} · ${offer.weekday} ${offer.startTime}–${offer.endTime}<br>${offer.overdue ? "Хариу өгөх хугацаа өнгөрсөн боловч суудлыг одоогоор танд хадгалж байна." : `Шийдвэрээ ${date} хүртэл мэдэгдэнэ үү.`}`; actions.hidden = false; actions.innerHTML = offer.converted ? "" : offer.awaitingTransfer ? "<p>Таны сонголтыг тэмдэглэлээ. Шилжүүлгийн дараагийн алхмыг багштай ярилцана уу.</p>" : `<label>Төлбөрийн хэлбэр<select id="plan"><option value="single">Нэг удаа</option><option value="two_installment">Хоёр хувааж</option></select></label><div class="registration-actions"><button class="button secondary" id="decline" type="button">Татгалзах</button><button class="button primary" id="accept" type="button">Зөвшөөрөх</button></div>`; document.querySelector("#decline")?.addEventListener("click", async () => { if (!confirm("Энэ саналаас татгалзах уу?")) return; await request({ action: "decline" }); message.textContent = "Татгалзсаныг тэмдэглэлээ."; actions.hidden = true; }); document.querySelector("#accept")?.addEventListener("click", async () => { await request({ action: "accept", paymentPlanCode: document.querySelector("#plan").value }); show(await request({ action: "view" })); }); }
      (async () => { if (!token) throw new Error("Саналын холбоос дутуу байна."); show(await request({ action: "view" })); })().catch((error) => { message.textContent = error.message || "Энэ санал хүчингүй эсвэл идэвхгүй болсон байна."; });
    </script>
  </body>
</html>
