---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Нөхөх хичээл | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Нөхөх хичээл</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Нөхөх хичээл</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1>Нөхөх хичээл</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <section aria-labelledby="makeup-open-title">
          <div class="staff-section-heading"><div><h2 id="makeup-open-title">Шийдэх зүйл</h2><p class="staff-muted">Хичээл дууссаны дараах таслалтыг багш шийднэ.</p></div></div>
          <div id="makeup-open-list" class="staff-makeup-list"></div>
        </section>
        <section id="makeup-detail" class="staff-makeup-detail" hidden></section>
        <section aria-labelledby="makeup-scheduled-title" class="staff-makeup-scheduled-section">
          <h2 id="makeup-scheduled-title">Товлосон</h2>
          <div id="makeup-scheduled-list" class="staff-makeup-list"></div>
        </section>
        <section aria-labelledby="makeup-review-title" class="staff-makeup-scheduled-section">
          <h2 id="makeup-review-title">Ирц шалгах</h2>
          <div id="makeup-review-list" class="staff-makeup-list"></div>
        </section>
        <section aria-labelledby="makeup-history-title" class="staff-makeup-scheduled-section">
          <h2 id="makeup-history-title">Түүх</h2>
          <details><summary>Өмнөх шийдвэр, нөхөх оролдлогууд</summary><div id="makeup-history-list" class="staff-makeup-list"></div></details>
        </section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, formatDate, getCourseMakeups, hasMakeupAccess, postCourseMakeupAction } from "../../scripts/staff-setup.js";

      const state = { data: null, selected: null, pending: false, specialPreview: null };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const sourceAttrs = (entry) => `data-enrollment="${escape(entry.enrollmentId)}" data-class="${escape(entry.classSessionId)}" data-lesson="${escape(entry.curriculumLessonId)}"`;
      const sourceFrom = (node) => ({ enrollmentId: node.dataset.enrollment, classSessionId: node.dataset.class, curriculumLessonId: node.dataset.lesson });

      async function refresh() {
        state.data = await getCourseMakeups(state.selected);
        if (state.selected && !state.data.selected) state.selected = null;
        render();
      }

      function renderOpen() {
        const container = q("#makeup-open-list");
        const entries = state.data.unresolved || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Одоогоор шийдэх нөхөх хичээл алга.</p>`; return; }
        const groups = new Map();
        for (const entry of entries) {
          const key = entry.curriculumLessonId;
          const group = groups.get(key) || { title: `${entry.programTitle} · ${entry.lessonSequence}. ${entry.lessonTitle}`, entries: [] };
          group.entries.push(entry); groups.set(key, group);
        }
        container.innerHTML = [...groups.values()].map((group) => `<details class="staff-makeup-group" open><summary class="staff-makeup-group-heading"><strong>${escape(group.title)}</strong><span>${group.entries.length} сурагч</span></summary>${group.entries.map((entry) => `<article class="staff-makeup-row"><div><strong>${escape(entry.studentName)}</strong><p>${escape(entry.classLabel)} · ${escape(formatDate(entry.sourceLocalDate))}${entry.hasAbsenceNotice ? ` · <span class="staff-attendance-notice">Мэдэгдсэн</span>` : ""}</p></div><div class="staff-inline-actions"><button class="button secondary" type="button" data-open-makeup ${sourceAttrs(entry)}>Нөхөх</button><button class="button secondary" type="button" data-no-makeup ${sourceAttrs(entry)}>Нөхөхгүй</button></div></article>`).join("")}</details>`).join("");
      }

      function renderDetail() {
        const container = q("#makeup-detail");
        const selected = state.data.selected;
        if (!selected) { container.hidden = true; container.innerHTML = ""; return; }
        const source = selected.source;
        const sameLessonSources = state.data.unresolved.filter((entry) => entry.curriculumLessonId === source.curriculumLessonId);
        const normal = selected.normalTargets.length
          ? selected.normalTargets.map((target) => `<article class="staff-makeup-target"><div><strong>${escape(formatDate(target.localDate))} · ${escape(target.startTime)}–${escape(target.endTime)}</strong><p>${escape(target.classLabel)} · Сул суудал: ${target.remainingCapacity}</p></div><button class="button secondary" type="button" data-assign-normal="${escape(target.classSessionId)}">Энд нөхөх</button></article>`).join("")
          : `<p class="staff-empty">Тохирох энгийн анги одоогоор алга.</p>`;
        const special = selected.specialTargets.map((target) => `<article class="staff-makeup-target"><div><strong>${escape(formatDate(target.localDate))} · ${escape(target.startTime)}–${escape(target.endTime)}</strong><p>Тусгай нөхөх хичээл · Сул суудал: ${target.remainingCapacity}</p></div><button class="button secondary" type="button" data-assign-special="${escape(target.id)}">Энд нөхөх</button></article>`).join("");
        container.hidden = false;
        container.innerHTML = `<div class="staff-section-heading"><div><p class="eyebrow">${escape(source.studentName)}</p><h2>${source.lessonSequence}. ${escape(source.lessonTitle)}</h2><p>${escape(source.classLabel)} · ${escape(formatDate(source.sourceLocalDate))}</p></div><button id="close-makeup" class="button secondary" type="button">Хаах</button></div><div class="staff-makeup-targets"><h3>Тохирох анги</h3>${normal}${special}</div><details class="staff-schedule-changes"><summary>Тусгай нөхөх хичээл үүсгэх</summary><form id="special-makeup-form" class="staff-makeup-special-form"><fieldset><legend>Энэ хичээлд орох сурагч</legend>${sameLessonSources.map((entry) => `<label><input type="checkbox" name="source" value="${escape(`${entry.enrollmentId}|${entry.classSessionId}|${entry.curriculumLessonId}`)}" ${entry.enrollmentId === source.enrollmentId && entry.classSessionId === source.classSessionId ? "checked" : ""} />${escape(entry.studentName)}</label>`).join("")}</fieldset><div class="staff-form-grid"><label>Өдөр<input name="localDate" type="date" required /></label><label>Эхлэх цаг<input name="startTime" type="time" required /></label><label>Багтаамж<input name="capacity" type="number" min="1" max="100" value="${Math.max(1, sameLessonSources.length)}" required /></label></div><label>Тэмдэглэл<textarea name="note" rows="2"></textarea></label><button class="button primary" type="submit">Үүсгэж товлох</button></form></details>`;
      }

      function renderScheduled() {
        const container = q("#makeup-scheduled-list");
        const entries = state.data.scheduled || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Товлосон нөхөх хичээл алга.</p>`; return; }
        const specialGroups = new Map();
        const normal = [];
        for (const entry of entries) {
          if (entry.targetKind === "special") {
            const group = specialGroups.get(entry.targetSpecialOccurrenceId) || { ...entry, students: [] };
            group.students.push({ name: entry.studentName, assignmentId: entry.assignmentId }); specialGroups.set(entry.targetSpecialOccurrenceId, group);
          } else normal.push(entry);
        }
        const reconciliationForm = (entry) => entry.state === "reconciliation" ? `<details class="staff-makeup-reconciliation"><summary>Хяналтыг дуусгах</summary><form data-reconcile-form><input type="hidden" name="caseId" value="${escape(entry.caseId)}" /><label>Тайлбар<textarea name="note" rows="2" required></textarea></label><button class="button secondary" type="submit">Хяналтыг батлах</button></form></details>` : "";
        const normalMarkup = normal.map((entry) => `<article class="staff-makeup-row"><div><strong>${escape(entry.studentName)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}</strong><p>${entry.state === "scheduled" ? `${escape(formatDate(entry.targetLocalDate))} · ${escape(entry.targetStartTime)}–${escape(entry.targetEndTime)} · ${escape(entry.targetOfferingTitle || "")}` : entry.state === "reconciliation" ? "Өмнөх ирц засагдсан тул хяналт шаардлагатай" : "Дахин товлох шаардлагатай"}</p>${reconciliationForm(entry)}</div><div class="staff-inline-actions"><button class="staff-text-action" type="button" data-cancel-assignment="${escape(entry.assignmentId)}">Буцаах</button></div></article>`).join("");
        const specialMarkup = [...specialGroups.values()].map((entry) => `<article class="staff-makeup-row"><div><strong>Тусгай · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}</strong><p>${escape(formatDate(entry.targetLocalDate))} · ${escape(entry.targetStartTime)}–${escape(entry.targetEndTime)}</p><ul class="staff-makeup-student-list">${entry.students.map((student) => `<li>${escape(student.name)} <button class="staff-text-action" type="button" data-cancel-assignment="${escape(student.assignmentId)}">Буцаах</button></li>`).join("")}</ul>${reconciliationForm(entry)}</div><div class="staff-inline-actions"><button class="staff-text-action" type="button" data-open-special-reschedule="${escape(entry.targetSpecialOccurrenceId)}">Өдөр, цаг өөрчлөх</button><button class="staff-text-action" type="button" data-cancel-special="${escape(entry.targetSpecialOccurrenceId)}">Хичээл цуцлах</button></div></article>`).join("");
        container.innerHTML = normalMarkup + specialMarkup;
      }

      function renderReview() {
        const container = q("#makeup-review-list");
        const entries = state.data.attendanceReview || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Ирц шалгах нөхөх хичээл алга.</p>`; return; }
        container.innerHTML = entries.map((entry) => `<article class="staff-makeup-row"><div><strong>${escape(entry.studentName)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}</strong><p>${escape(formatDate(entry.targetLocalDate))} · ${escape(entry.targetStartTime)}–${escape(entry.targetEndTime)} · Ирцийг тэмдэглээгүй</p><p class="staff-muted">Эх таслалт: ${escape(entry.sourceClassLabel || "")} · ${escape(formatDate(entry.sourceLocalDate))}</p></div><a class="button secondary" href="/staff/attendance/?date=${encodeURIComponent(entry.targetLocalDate)}&occurrence=${encodeURIComponent(entry.targetKind === "special" ? entry.targetSpecialOccurrenceId : entry.targetSlotId)}">Ирц нээх</a></article>`).join("");
      }

      function renderHistory() {
        const container = q("#makeup-history-list");
        const entries = state.data.history || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Өмнөх нөхөх хичээлийн түүх алга.</p>`; return; }
        container.innerHTML = entries.map((entry) => `<article class="staff-makeup-row"><div><strong>${escape(entry.studentName)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}</strong><p>${entry.decision === "no_makeup" ? "Нөхөхгүй" : `${escape(formatDate(entry.targetLocalDate))} · ${escape(entry.targetStartTime || "")}–${escape(entry.targetEndTime || "")}`}${entry.destinationAttendanceStatus ? ` · ${escape(({ present: "Ирсэн", late: "Хоцорсон", absent: "Ирээгүй" })[entry.destinationAttendanceStatus])}` : ""}</p><p class="staff-muted">Эх таслалт: ${escape(entry.sourceClassLabel || entry.classLabel || "")} · ${escape(formatDate(entry.sourceLocalDate))}</p></div>${entry.resolutionId && entry.decision === "no_makeup" ? `<button class="button secondary" type="button" data-reopen-no-makeup="${escape(entry.resolutionId)}">Дахин нээх</button>` : ""}</article>`).join("");
      }

      function renderSpecialPreview() {
        const preview = state.specialPreview;
        const container = q("#makeup-detail");
        if (!preview) return;
        container.hidden = false;
        container.innerHTML = `<div class="staff-section-heading"><div><p class="eyebrow">Тусгай нөхөх хичээл</p><h2>Өдөр, цаг өөрчлөх</h2><p>${escape(formatDate(preview.old.localDate))} · ${escape(preview.old.startTime)}–${escape(preview.old.endTime)} → ${escape(formatDate(preview.next.localDate))} · ${escape(preview.next.startTime)}–${escape(preview.next.endTime)}</p><p class="staff-muted">${preview.attendees.length} сурагчийн тов, эх таслалтын холбоос хэвээр үлдэнэ.</p></div><button id="close-makeup" class="button secondary" type="button">Болих</button></div><div class="staff-inline-actions"><button id="confirm-special-reschedule" class="button primary" type="button">Өөрчлөлтийг батлах</button><button id="edit-special-reschedule" class="button secondary" type="button">Засах</button></div>`;
      }

      function render() { renderOpen(); renderDetail(); renderScheduled(); renderReview(); renderHistory(); if (state.specialPreview) state.specialPreview.form ? renderSpecialRescheduleForm() : renderSpecialPreview(); }

      async function mutate(action, payload, success) {
        if (state.pending) return;
        state.pending = true; message("");
        try { await postCourseMakeupAction(action, payload); state.selected = null; state.specialPreview = null; await refresh(); message(success, true); }
        catch (error) { message(error.message || "Хадгалж чадсангүй."); }
        finally { state.pending = false; }
      }

      q("#tool-app").addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button || button.type === "submit" || state.pending) return;
        if (button.id === "close-makeup") { state.selected = null; state.specialPreview = null; refresh(); return; }
        if (button.matches("[data-open-makeup]")) { state.selected = sourceFrom(button); refresh().then(() => q("#makeup-detail").scrollIntoView({ behavior: "smooth", block: "start" })); return; }
        if (button.matches("[data-no-makeup]")) { mutate("makeup.no-makeup", sourceFrom(button), "Нөхөхгүй гэж тэмдэглэлээ."); return; }
        if (button.dataset.reopenNoMakeup) { mutate("makeup.no-makeup-reopen", { resolutionId: button.dataset.reopenNoMakeup }, "Дахин шийдэхээр нээлээ."); return; }
        const source = state.data.selected?.source;
        if (button.dataset.assignNormal && source) { mutate("makeup.assign-normal", { ...source, targetClassSessionId: button.dataset.assignNormal }, "Нөхөх хичээлийг товлолоо."); return; }
        if (button.dataset.assignSpecial && source) { mutate("makeup.assign-special", { ...source, specialOccurrenceId: button.dataset.assignSpecial }, "Нөхөх хичээлийг товлолоо."); return; }
        if (button.dataset.cancelAssignment) { mutate("makeup.assignment-cancel", { assignmentId: button.dataset.cancelAssignment }, "Товыг буцаалаа."); return; }
        if (button.dataset.openSpecialReschedule) { state.specialPreview = { form: true, specialOccurrenceId: button.dataset.openSpecialReschedule }; renderSpecialRescheduleForm(); return; }
        if (button.id === "edit-special-reschedule") { state.specialPreview = { form: true, specialOccurrenceId: state.specialPreview.specialOccurrenceId }; renderSpecialRescheduleForm(); return; }
        if (button.id === "confirm-special-reschedule") { const preview = state.specialPreview; preview.operationId ||= crypto.randomUUID(); mutate("makeup.special-reschedule", { specialOccurrenceId: preview.specialOccurrenceId, expectedUpdatedAt: preview.expectedUpdatedAt, localDate: preview.next.localDate, startTime: preview.next.startTime, endTime: preview.next.endTime, operationId: preview.operationId }, "Тусгай нөхөх хичээлийн өдөр, цагийг өөрчиллөө."); return; }
        if (button.dataset.cancelSpecial) { mutate("makeup.special-cancel", { specialOccurrenceId: button.dataset.cancelSpecial }, "Тусгай нөхөх хичээлийг цуцаллаа."); }
      });

      function renderSpecialRescheduleForm() {
        const container = q("#makeup-detail"); const draft = state.specialPreview;
        const current = (state.data?.scheduled || []).find((entry) => entry.targetSpecialOccurrenceId === draft.specialOccurrenceId);
        container.hidden = false;
        container.innerHTML = `<form id="special-reschedule-form" class="staff-makeup-special-form"><div class="staff-section-heading"><div><p class="eyebrow">Тусгай нөхөх хичээл</p><h2>Өдөр, цаг өөрчлөх</h2><p class="staff-muted">Хичээл, үргэлжлэх хугацаа, товлосон сурагчид хэвээр үлдэнэ.</p></div><button id="close-makeup" class="button secondary" type="button">Болих</button></div><input type="hidden" name="specialOccurrenceId" value="${escape(draft.specialOccurrenceId)}" /><div class="staff-form-grid"><label>Өдөр<input name="localDate" type="date" value="${escape(current?.targetLocalDate || "")}" required /></label><label>Эхлэх цаг<input name="startTime" type="time" value="${escape(current?.targetStartTime || "")}" required /></label><label>Дуусах цаг<input name="endTime" type="time" value="${escape(current?.targetEndTime || "")}" required /></label></div><button class="button primary" type="submit">Урьдчилан харах</button></form>`;
      }

      q("#tool-app").addEventListener("submit", (event) => {
        if (!(["special-makeup-form", "special-reschedule-form"].includes(event.target.id) || event.target.matches("[data-reconcile-form]"))) return;
        event.preventDefault();
        const form = new FormData(event.target);
        if (event.target.matches("[data-reconcile-form]")) {
          mutate("makeup.case-reconcile", { caseId: form.get("caseId"), note: form.get("note") }, "Хяналтыг дуусгалаа.");
          return;
        }
        if (event.target.id === "special-reschedule-form") {
          postCourseMakeupAction("makeup.special-reschedule-preview", { specialOccurrenceId: form.get("specialOccurrenceId"), localDate: form.get("localDate"), startTime: form.get("startTime"), endTime: form.get("endTime") }).then((preview) => { state.specialPreview = preview; render(); }).catch((error) => message(error.message || "Урьдчилан харах боломжгүй."));
          return;
        }
        const sources = form.getAll("source").map((value) => { const [enrollmentId, classSessionId, curriculumLessonId] = String(value).split("|"); return { enrollmentId, classSessionId, curriculumLessonId }; });
        mutate("makeup.special-create", { sources, localDate: form.get("localDate"), startTime: form.get("startTime"), capacity: Number(form.get("capacity")), note: form.get("note") }, "Тусгай нөхөх хичээлийг товлолоо.");
      });

      (async () => { if (!(await hasMakeupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
