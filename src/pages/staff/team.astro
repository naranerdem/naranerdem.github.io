---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Ажилтнууд | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-team-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Ажилтны хэсэг</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="team-booting" class="staff-state"><p class="eyebrow">Удирдлага</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="team-denied" class="staff-state" hidden><p class="eyebrow">Ажилтнууд</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="team-app" class="staff-state" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Удирдлага</p><h1>Ажилтнууд</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <div class="staff-section-heading"><p class="staff-muted">Нэвтрэх и-мэйл, эрх, идэвхтэй төлөвийг удирдана.</p><button id="team-add" class="button primary" type="button">Ажилтан нэмэх</button></div>
        <p id="team-message" class="staff-error" role="status" hidden></p>
        <form id="team-form" class="staff-team-form" hidden>
          <input id="team-id" type="hidden" />
          <div class="staff-form-grid">
            <label>Нэр <input id="team-name" type="text" autocomplete="name" maxlength="120" required /></label>
            <label id="team-email-field">Үндсэн и-мэйл <input id="team-email" type="email" inputmode="email" autocomplete="email" maxlength="254" required /></label>
            <label>Эрх
              <select id="team-role" required>
                <option value="teacher">Багш</option>
                <option value="accountant">Нягтлан</option>
                <option value="admin">Админ</option>
              </select>
            </label>
          </div>
          <div class="staff-inline-actions"><button id="team-form-cancel" class="button secondary" type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div>
        </form>
        <div id="team-list" class="staff-team-list"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      const state = { accounts: [], addingEmailAccountId: "" };
      const q = (selector) => document.querySelector(selector);
      const escape = (value) => String(value ?? "").replace(/[&<>\"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
      const roleLabel = (role) => ({ admin: "Админ", teacher: "Багш", accountant: "Нягтлан" })[role] || role;
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state")) node.hidden = node.id !== id; document.body.dataset.staffTeamSurface = id.replace("team-", ""); };
      const message = (text = "", success = false) => { const node = q("#team-message"); node.textContent = text; node.classList.toggle("staff-success", success); node.hidden = !text; };

      async function request(method, body) {
        const response = await fetch("/api/staff/team", {
          method,
          headers: body ? { "Content-Type": "application/json", Accept: "application/json" } : { Accept: "application/json" },
          credentials: "same-origin",
          body: body ? JSON.stringify(body) : undefined,
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result?.error?.message || "Ажилтны мэдээллийг хадгалж чадсангүй.");
        return result;
      }

      function closeForm() {
        q("#team-form").hidden = true;
        q("#team-form").reset();
        q("#team-id").value = "";
        q("#team-email-field").hidden = false;
        q("#team-email").required = true;
      }

      function openForm(account = null) {
        message();
        q("#team-id").value = account?.id || "";
        q("#team-name").value = account?.displayName || "";
        q("#team-email").value = "";
        q("#team-email-field").hidden = Boolean(account);
        q("#team-email").required = !account;
        q("#team-role").value = account?.roles?.[0] || "teacher";
        q("#team-form").hidden = false;
        q("#team-name").focus();
      }

      function render() {
        q("#team-list").innerHTML = state.accounts.length ? state.accounts.map((account) => {
          const emails = (account.emails || []).map((email) => `<li><span>${escape(email.email)}${email.isPrimary ? ` <strong class="staff-primary-email">Үндсэн</strong>` : ""}</span><span class="staff-team-email-actions">${email.isPrimary ? "" : `<button class="staff-text-action" type="button" data-primary-email="${escape(email.id)}" data-account="${escape(account.id)}">Үндсэн болгох</button><button class="staff-text-action danger-text" type="button" data-remove-email="${escape(email.id)}" data-account="${escape(account.id)}">Хасах</button>`}</span></li>`).join("");
          const adding = state.addingEmailAccountId === account.id
            ? `<form class="staff-team-email-form" data-email-form="${escape(account.id)}"><label>Шинэ и-мэйл <input type="email" inputmode="email" autocomplete="email" maxlength="254" required data-new-email /></label><div class="staff-inline-actions"><button class="button secondary" type="button" data-cancel-email>Болих</button><button class="button primary" type="submit">Нэмэх</button></div></form>`
            : (account.emails || []).length < 3 ? `<button class="staff-text-action" type="button" data-add-email="${escape(account.id)}">+ Имэйл нэмэх</button>` : `<p class="staff-muted staff-team-email-limit">3 и-мэйл бүртгэлтэй</p>`;
          return `<article class="staff-team-row ${account.status === "disabled" ? "disabled" : ""}"><div class="staff-team-summary"><strong>${escape(account.displayName)}</strong><p>${escape(roleLabel(account.roles[0]))} · ${account.status === "active" ? "Идэвхтэй" : "Идэвхгүй"}${account.isTest ? " · Тест" : ""}${account.activeSessionCount ? ` · ${account.activeSessionCount} нэвтэрсэн төхөөрөмж` : ""}</p><div class="staff-team-emails"><span>Имэйл</span><ul>${emails}</ul>${adding}</div></div><div class="staff-team-actions"><button class="button secondary" type="button" data-edit="${escape(account.id)}">Нэр, эрх засах</button><button class="button secondary" type="button" data-status="${escape(account.id)}" data-next-status="${account.status === "active" ? "disabled" : "active"}">${account.status === "active" ? "Идэвхгүй болгох" : "Идэвхжүүлэх"}</button><button class="staff-text-action" type="button" data-revoke="${escape(account.id)}">Бүх төхөөрөмжөөс гаргах</button></div></article>`;
        }).join("") : `<p class="staff-empty">Ажилтан бүртгэгдээгүй байна.</p>`;
      }

      async function refresh() {
        const result = await request("GET");
        state.accounts = result.accounts || [];
        render();
      }

      q("#team-add").onclick = () => openForm();
      q("#team-form-cancel").onclick = closeForm;
      q("#team-form").onsubmit = async (event) => {
        event.preventDefault();
        if (!event.currentTarget.reportValidity()) return;
        const button = event.currentTarget.querySelector("button[type='submit']");
        button.disabled = true;
        try {
          const payload = { displayName: q("#team-name").value, role: q("#team-role").value };
          const staffAccountId = q("#team-id").value;
          const result = staffAccountId
            ? await request("PUT", { action: "update", staffAccountId, ...payload })
            : await request("POST", { ...payload, email: q("#team-email").value });
          if (result.reauthenticationRequired) { location.assign("/staff/"); return; }
          closeForm();
          await refresh();
          message("Ажилтны мэдээллийг хадгаллаа.", true);
        } catch (error) { message(error.message); }
        finally { button.disabled = false; }
      };

      q("#team-list").onclick = async (event) => {
        const button = event.target.closest("button");
        if (!button) return;
        if (button.dataset.addEmail) { state.addingEmailAccountId = button.dataset.addEmail; render(); q("[data-new-email]")?.focus(); return; }
        if (button.dataset.cancelEmail !== undefined) { state.addingEmailAccountId = ""; render(); return; }
        const accountId = button.dataset.account || button.dataset.edit || button.dataset.status || button.dataset.revoke;
        const account = state.accounts.find((entry) => entry.id === accountId);
        if (!account) return;
        if (button.dataset.edit) { openForm(account); return; }
        if (button.dataset.primaryEmail) {
          button.disabled = true;
          try { await request("PUT", { action: "email-primary", staffAccountId: account.id, emailId: button.dataset.primaryEmail }); await refresh(); message("Үндсэн и-мэйлийг шинэчиллээ.", true); }
          catch (error) { message(error.message); }
          finally { button.disabled = false; }
          return;
        }
        if (button.dataset.removeEmail) {
          if (!window.confirm("Энэ и-мэйлээр дахин нэвтрэх боломжгүй болно. Хасах уу?")) return;
          button.disabled = true;
          try { await request("PUT", { action: "email-remove", staffAccountId: account.id, emailId: button.dataset.removeEmail }); await refresh(); message("И-мэйлийг хаслаа.", true); }
          catch (error) { message(error.message); }
          finally { button.disabled = false; }
          return;
        }
        const disabling = button.dataset.nextStatus === "disabled";
        const prompt = button.dataset.revoke
          ? `${account.displayName}-ийг бүх төхөөрөмжөөс гаргах уу?`
          : disabling ? `${account.displayName}-ийн нэвтрэх эрхийг идэвхгүй болгох уу?` : "Энэ ажилтны нэвтрэх эрхийг идэвхжүүлэх үү?";
        if (!window.confirm(prompt)) return;
        button.disabled = true;
        try {
          const result = button.dataset.revoke
            ? await request("PUT", { action: "revoke-sessions", staffAccountId: account.id })
            : await request("PUT", { action: "status", staffAccountId: account.id, status: button.dataset.nextStatus });
          if (result.reauthenticationRequired) { location.assign("/staff/"); return; }
          await refresh();
          message(button.dataset.revoke ? "Бүх нэвтэрсэн төхөөрөмжөөс гаргалаа." : "Ажилтны төлөвийг шинэчиллээ.", true);
        } catch (error) { message(error.message); }
        finally { button.disabled = false; }
      };

      q("#team-list").onsubmit = async (event) => {
        const form = event.target.closest("[data-email-form]");
        if (!form) return;
        event.preventDefault();
        if (!form.reportValidity()) return;
        const button = form.querySelector("button[type='submit']");
        button.disabled = true;
        try {
          await request("PUT", { action: "email-add", staffAccountId: form.dataset.emailForm, email: form.querySelector("[data-new-email]").value });
          state.addingEmailAccountId = "";
          await refresh();
          message("Нэвтрэх и-мэйл нэмлээ.", true);
        } catch (error) { message(error.message); }
        finally { button.disabled = false; }
      };

      (async () => {
        const response = await fetch("/api/staff/session", { credentials: "same-origin" });
        const session = await response.json();
        if (!session.authenticated || !(session.capabilities || []).includes("admin.staff.manage")) { show("team-denied"); return; }
        await refresh();
        show("team-app");
      })().catch(() => show("team-denied"));
    </script>
  </body>
</html>
