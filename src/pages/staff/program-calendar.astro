---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Хөтөлбөр ба хуваарь | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-program-calendar-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Хөтөлбөр ба хуваарь</span></span>
      </a>
    </header>

    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="program-booting" class="staff-state">
        <p class="eyebrow">Хөтөлбөр ба хуваарь</p>
        <h1>Түр хүлээнэ үү</h1>
        <p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p>
      </section>
      <section id="program-denied" class="staff-state" hidden>
        <p class="eyebrow">Хөтөлбөр ба хуваарь</p>
        <h1>Энэ хэсгийг нээх эрх алга</h1>
        <a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a>
      </section>
      <section id="program-app" hidden>
        <div class="staff-page-heading">
          <div><p class="eyebrow">Хичээлийн жил</p><h1>Хөтөлбөр ба хуваарь</h1></div>
          <a class="staff-back-link" href="/staff/">Буцах</a>
        </div>
        <p id="program-message" class="staff-error" role="status" hidden></p>
        <label class="staff-year-picker">Хичээлийн жил <select id="year-select"></select></label>

        <section class="staff-operation-section" aria-labelledby="program-section-title">
          <div class="staff-section-heading"><div><p class="eyebrow">1. Хөтөлбөр</p><h2 id="program-section-title">Шат тус бүрийн хичээл</h2></div><label>Шат <select id="program-stage"></select></label></div>
          <div id="program-editor"></div>
        </section>

        <section class="staff-operation-section" aria-labelledby="class-section-title">
          <div class="staff-section-heading"><div><p class="eyebrow">2. Анги</p><h2 id="class-section-title">Анги, цаг</h2></div></div>
          <form id="class-form" class="staff-compact-form">
            <input id="class-id" type="hidden" /><input id="class-updated" type="hidden" />
            <label>Шат <select id="class-stage" required></select></label>
            <label>Ангийн нэр <input id="class-label" required maxlength="160" placeholder="Жишээ: Бямба гаригийн өглөө" /></label>
            <label>Гараг <select id="class-weekday" required></select></label>
            <label>Эхлэх цаг <input id="class-start" type="time" required /></label>
            <label>Дуусах цаг <input id="class-end" type="time" required /></label>
            <label>Суудлын тоо <input id="class-capacity" type="number" min="1" max="80" required /></label>
            <label>Төлөв <select id="class-status"><option value="draft">Ноорог</option><option value="available">Нээлттэй</option><option value="closed">Хаалттай</option><option value="cancelled">Цуцалсан</option></select></label>
            <label class="staff-wide">Facebook бүлгийн холбоос <input id="class-facebook" type="url" inputmode="url" placeholder="Байхгүй бол хоосон үлдээнэ" /></label>
            <div class="staff-form-actions staff-wide"><button id="class-reset" class="button secondary" type="button">Шинээр оруулах</button><button class="button primary" type="submit">Ангийг хадгалах</button></div>
          </form>
          <div id="class-list" class="staff-record-list"></div>
        </section>

        <section class="staff-operation-section" aria-labelledby="break-section-title">
          <div class="staff-section-heading"><div><p class="eyebrow">3. Завсарлага</p><h2 id="break-section-title">Нийт завсарлага</h2></div></div>
          <form id="break-form" class="staff-compact-form">
            <input id="break-id" type="hidden" /><input id="break-updated" type="hidden" />
            <label>Нэр <input id="break-label" required maxlength="160" placeholder="Жишээ: Өвлийн амралт" /></label>
            <label>Эхлэх өдөр <input id="break-start" type="date" required /></label>
            <label>Дуусах өдөр <input id="break-end" type="date" required /></label>
            <label class="staff-check"><input id="break-exclude" type="checkbox" checked /> Ердийн хичээлийн өдрийг алгасах</label>
            <label class="staff-wide">Тэмдэглэл <input id="break-note" maxlength="500" /></label>
            <div class="staff-form-actions staff-wide"><button id="break-reset" class="button secondary" type="button">Шинээр оруулах</button><button class="button primary" type="submit">Завсарлага хадгалах</button></div>
          </form>
          <div id="break-list" class="staff-record-list"></div>
        </section>

        <section class="staff-operation-section" aria-labelledby="calendar-section-title">
          <div class="staff-section-heading"><div><p class="eyebrow">4. Хуваарь</p><h2 id="calendar-section-title">Ангийн календарь</h2></div><label>Анги <select id="calendar-class"></select></label></div>
          <div id="calendar-editor"></div>
        </section>
      </section>
    </main>

    <script is:inline type="module">
      const state = { data: null, yearId: "", stage: "stage_1", selectedClassId: "" };
      const q = (selector) => document.querySelector(selector);
      const escape = (value) => String(value ?? "").replace(/[&<>\"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
      const stageLabel = (stage) => ({ stage_1: "1-р шат", stage_2: "2-р шат", stage_3: "3-р шат" })[stage] || stage;
      const show = (id) => { ["program-booting", "program-denied", "program-app"].forEach((item) => q(`#${item}`).hidden = item !== id); document.body.dataset.programCalendarSurface = id.replace("program-", ""); };
      function message(value = "", success = false) { const node = q("#program-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; if (value) node.scrollIntoView({ block: "nearest" }); }
      async function request(action, payload = {}) {
        const response = await fetch("/api/staff/program-calendar", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ action, ...payload }) });
        if (!response.ok) { const body = await response.json().catch(() => null); throw new Error(body?.error?.message || "Хадгалж чадсангүй."); }
      }
      async function refresh(success = "") {
        const response = await fetch("/api/staff/program-calendar", { credentials: "same-origin", headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("өгөгдөл unavailable");
        state.data = await response.json();
        const years = state.data.years || [];
        if (!years.some((year) => year.id === state.yearId)) state.yearId = years.find((year) => year.isCurrent)?.id || years[0]?.id || "";
        const classes = currentClasses(); if (!classes.some((entry) => entry.id === state.selectedClassId)) state.selectedClassId = classes[0]?.id || "";
        render(); message(success, Boolean(success));
      }
      const currentPrograms = () => (state.data?.programs || []).filter((program) => program.academicYearId === state.yearId);
      const currentClasses = () => (state.data?.classes || []).filter((entry) => entry.academicYearId === state.yearId);
      const currentBreaks = () => (state.data?.breaks || []).filter((entry) => entry.academicYearId === state.yearId && entry.status === "active");
      function fillSelect(node, values, selected, label) { node.innerHTML = values.map((value) => `<option value="${escape(value.id ?? value)}" ${String(value.id ?? value) === String(selected) ? "selected" : ""}>${escape(label(value))}</option>`).join(""); }
      function render() {
        const years = state.data.years || []; fillSelect(q("#year-select"), years, state.yearId, (year) => year.label);
        const stages = state.data.stages || ["stage_1", "stage_2", "stage_3"]; [q("#program-stage"), q("#class-stage")].forEach((node) => fillSelect(node, stages, state.stage, stageLabel));
        fillSelect(q("#class-weekday"), state.data.weekdays || [], "Бямба", (weekday) => weekday);
        renderProgram(); renderClasses(); renderBreaks(); renderCalendar();
      }
      function renderProgram() {
        const container = q("#program-editor"); const programs = currentPrograms().filter((entry) => entry.stageCode === state.stage); const draft = programs.find((entry) => entry.status === "draft"); const published = programs.find((entry) => entry.status === "published");
        if (!draft) { container.innerHTML = `<div class="staff-empty"><p>${published ? `Одоогийн хөтөлбөр: <strong>${escape(published.displayName)}</strong>, ${published.lessons.length} хичээл.` : "Энэ шатанд хэвлэгдсэн хөтөлбөр алга."}</p><div class="staff-inline-actions">${published ? "" : `<button class="button primary" data-program-create>Ноорог эхлүүлэх</button>`}<button class="button secondary" data-program-copy ${published ? "" : ""}>Өмнөх хөтөлбөрөөс хуулах</button></div></div>`;
          container.querySelector("[data-program-create]")?.addEventListener("click", async () => { const name = window.prompt("Хөтөлбөрийн нэр", `${stageLabel(state.stage)}-ийн хөтөлбөр`); if (!name) return; await run(() => request("program.create", { academicYearId: state.yearId, stageCode: state.stage, displayName: name }), "Ноорог үүслээ."); });
          container.querySelector("[data-program-copy]")?.addEventListener("click", () => run(() => request("program.copy-previous", { academicYearId: state.yearId, stageCode: state.stage }), "Өмнөх хөтөлбөрөөс ноорог хууллаа.")); return; }
        const rows = draft.lessons.map((lesson, index) => `<li data-lesson-id="${escape(lesson.id)}"><span class="staff-order">${index + 1}</span><input class="lesson-title" value="${escape(lesson.title)}" maxlength="160" aria-label="${index + 1}-р хичээлийн нэр" /><button type="button" class="staff-icon-button" data-up title="Дээш зөөх" aria-label="Дээш зөөх">↑</button><button type="button" class="staff-icon-button" data-down title="Доош зөөх" aria-label="Доош зөөх">↓</button><button type="button" class="staff-icon-button" data-remove title="Хасах" aria-label="Хасах">×</button></li>`).join("");
        container.innerHTML = `<form id="program-draft-form" class="staff-program-form"><p class="staff-draft-label">Ноорог ${draft.revisionNumber}${published ? ` · Одоогийн хэвлэгдсэн хувилбар: ${escape(published.displayName)}` : ""}</p><label>Хөтөлбөрийн нэр <input id="program-name" value="${escape(draft.displayName)}" maxlength="160" required /></label><ol id="lesson-list" class="staff-lesson-list">${rows}</ol><button id="lesson-add" class="button secondary" type="button">Хичээл нэмэх</button><div class="staff-form-actions"><button class="button secondary" type="submit">Ноорог хадгалах</button><button id="program-publish" class="button primary" type="button">Хэвлэх</button></div></form>`;
        const list = q("#lesson-list");
        const bindRows = () => list.querySelectorAll("li").forEach((row) => { row.querySelector("[data-up]").onclick = () => { const previous = row.previousElementSibling; if (previous) list.insertBefore(row, previous); }; row.querySelector("[data-down]").onclick = () => { const next = row.nextElementSibling; if (next) list.insertBefore(next, row); }; row.querySelector("[data-remove]").onclick = () => { if (list.children.length > 1) row.remove(); else message("Хөтөлбөр дор хаяж нэг хичээлтэй байна."); }; });
        bindRows(); q("#lesson-add").onclick = () => { const row = document.createElement("li"); row.innerHTML = `<span class="staff-order">+</span><input class="lesson-title" maxlength="160" aria-label="Шинэ хичээлийн нэр" required /><button type="button" class="staff-icon-button" data-up title="Дээш зөөх" aria-label="Дээш зөөх">↑</button><button type="button" class="staff-icon-button" data-down title="Доош зөөх" aria-label="Доош зөөх">↓</button><button type="button" class="staff-icon-button" data-remove title="Хасах" aria-label="Хасах">×</button>`; list.append(row); bindRows(); row.querySelector("input").focus(); };
        q("#program-draft-form").onsubmit = (event) => { event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity()) return; const lessons = [...list.children].map((row) => ({ id: row.dataset.lessonId || undefined, title: row.querySelector(".lesson-title").value })); run(() => request("program.save", { programId: draft.id, expectedUpdatedAt: draft.updatedAt, displayName: q("#program-name").value, lessons }), "Ноорог хадгалагдлаа."); };
        q("#program-publish").onclick = () => { if (window.confirm("Энэ хөтөлбөрийг хэвлэх үү? Хэвлэсний дараа хичээлүүдийг шууд засахгүй.")) run(() => request("program.publish", { programId: draft.id, expectedUpdatedAt: draft.updatedAt }), "Хөтөлбөр хэвлэгдлээ."); };
      }
      function resetClass() { q("#class-form").reset(); q("#class-id").value = ""; q("#class-updated").value = ""; q("#class-stage").value = state.stage; q("#class-weekday").value = "Бямба"; q("#class-capacity").value = "12"; q("#class-status").value = "draft"; }
      function renderClasses() { const classes = currentClasses(); q("#class-list").innerHTML = classes.length ? classes.map((entry) => `<article><div><strong>${escape(entry.displayLabel)}</strong><p>${stageLabel(entry.stageCode)} · ${escape(entry.weekday)} ${escape(entry.startTime)}–${escape(entry.endTime)} · ${entry.capacity} суудал · ${entry.status === "available" ? "Нээлттэй" : entry.status === "closed" ? "Хаалттай" : entry.status === "cancelled" ? "Цуцалсан" : "Ноорог"}</p></div><button class="button secondary" data-class="${escape(entry.id)}" type="button">Засах</button></article>`).join("") : `<p class="staff-empty">Анги оруулаагүй байна.</p>`; q("#class-list").querySelectorAll("[data-class]").forEach((button) => button.onclick = () => { const entry = classes.find((item) => item.id === button.dataset.class); q("#class-id").value = entry.id; q("#class-updated").value = entry.updatedAt; q("#class-stage").value = entry.stageCode; q("#class-label").value = entry.displayLabel; q("#class-weekday").value = entry.weekday; q("#class-start").value = entry.startTime; q("#class-end").value = entry.endTime; q("#class-capacity").value = entry.capacity; q("#class-status").value = entry.status === "full" ? "available" : entry.status; q("#class-facebook").value = entry.facebookGroupUrl || ""; q("#class-form").scrollIntoView({ behavior: "smooth", block: "start" }); }); }
      function resetBreak() { q("#break-form").reset(); q("#break-id").value = ""; q("#break-updated").value = ""; q("#break-exclude").checked = true; }
      function renderBreaks() { const breaks = currentBreaks(); q("#break-list").innerHTML = breaks.length ? breaks.map((entry) => `<article><div><strong>${escape(entry.label)}</strong><p>${entry.startsOn}–${entry.endsOn}${entry.excludesHabitualSlots ? " · Ердийн хичээлийг алгасна" : ""}</p></div><div class="staff-inline-actions"><button class="button secondary" data-break-edit="${escape(entry.id)}" type="button">Засах</button><button class="button secondary" data-break-archive="${escape(entry.id)}" type="button">Архивлах</button></div></article>`).join("") : `<p class="staff-empty">Завсарлага оруулаагүй байна.</p>`; q("#break-list").querySelectorAll("[data-break-edit]").forEach((button) => button.onclick = () => { const entry = breaks.find((item) => item.id === button.dataset.breakEdit); q("#break-id").value = entry.id; q("#break-updated").value = entry.updatedAt; q("#break-label").value = entry.label; q("#break-start").value = entry.startsOn; q("#break-end").value = entry.endsOn; q("#break-exclude").checked = Boolean(entry.excludesHabitualSlots); q("#break-note").value = entry.sourceNote || ""; }); q("#break-list").querySelectorAll("[data-break-archive]").forEach((button) => button.onclick = () => { const entry = breaks.find((item) => item.id === button.dataset.breakArchive); if (window.confirm("Энэ завсарлагыг архивлах уу?")) run(() => request("break.archive", { breakId: entry.id, expectedUpdatedAt: entry.updatedAt }), "Завсарлагыг архивлалаа."); }); }
      function renderCalendar() { const classes = currentClasses(); fillSelect(q("#calendar-class"), classes, state.selectedClassId, (entry) => `${stageLabel(entry.stageCode)} · ${entry.weekday} ${entry.startTime} · ${entry.displayLabel}`); const container = q("#calendar-editor"); const current = classes.find((entry) => entry.id === state.selectedClassId); if (!current) { container.innerHTML = `<p class="staff-empty">Эхлээд анги, цаг оруулна уу.</p>`; return; } const revisions = (state.data.revisions || []).filter((entry) => entry.classSessionId === current.id); const draft = revisions.find((entry) => entry.status === "draft"); const published = revisions.find((entry) => entry.status === "published"); const programs = currentPrograms().filter((entry) => entry.stageCode === current.stageCode && entry.status === "published");
        if (!draft) { container.innerHTML = `<div class="staff-empty">${published ? `<p>Хэвлэгдсэн хуваарь: ${published.slots.length} огноо.</p><button class="button primary" data-change-draft>Өөрчлөх</button>` : `<p>Энэ ангид хэвлэгдсэн хуваарь алга.</p><form id="calendar-generate" class="staff-compact-form"><label>Хөтөлбөр <select id="calendar-program" required>${programs.map((program) => `<option value="${escape(program.id)}">${escape(program.displayName)}</option>`).join("")}</select></label><label>Эхний боломжит өдөр <input id="calendar-first-date" type="date" required /></label><button class="button primary" type="submit" ${programs.length ? "" : "disabled"}>Календарь үүсгэх</button></form>${programs.length ? "" : "<p>Эхлээд энэ шатны хөтөлбөрийг хэвлэнэ үү.</p>"}`}</div>`; container.querySelector("[data-change-draft]")?.addEventListener("click", () => { if (window.confirm("Хэвлэгдсэн хуваариас шинэ ноорог үүсгэх үү?")) run(() => request("calendar.change-draft", { classSessionId: current.id }), "Өөрчлөх ноорог үүслээ."); }); container.querySelector("#calendar-generate")?.addEventListener("submit", (event) => { event.preventDefault(); const form = event.currentTarget; if (form.reportValidity()) run(() => request("calendar.generate", { classSessionId: current.id, programId: q("#calendar-program").value, firstCandidateDate: q("#calendar-first-date").value }), "Календарийн ноорог үүслээ."); }); return; }
        const lessons = currentPrograms().find((entry) => entry.id === draft.programId)?.lessons || []; const slots = draft.slots.map((slot) => `<li><span><strong>${escape(slot.localDate)} ${escape(slot.startTime)}</strong><br /><small>${slot.status === "scheduled" ? `${slot.lessonSequence}. ${escape(slot.lessonTitle)}` : slot.status === "cancelled" ? `Цуцалсан: ${slot.cancelledLessonSequence}. ${escape(slot.cancelledLessonTitle)}` : `Хичээлгүй өдөр${slot.reasonLabel ? `: ${escape(slot.reasonLabel)}` : ""}`}</small></span>${slot.status === "scheduled" && (slot.lessonSequence || 0) > draft.lockedThroughSequence ? `<button class="button secondary" data-cancel-slot="${escape(slot.id)}" type="button">Цуцлах</button>` : ""}</li>`).join("");
        container.innerHTML = `<div class="staff-calendar-draft"><p class="staff-draft-label">Ноорог ${draft.revisionNumber} · ${draft.slots.length} тэмдэглэсэн өдөр · Баталсан: ${draft.lockedThroughSequence}/${lessons.length} хичээл</p><div class="staff-calendar-actions"><form id="calendar-override" class="staff-compact-form"><label>Өдөр <input id="override-date" type="date" required /></label><label>Өөрчлөлт <select id="override-kind"><option value="exclude">Тухайн өдрийн хичээлийг алгасах</option><option value="restore">Завсарлага дунд хичээл оруулах</option></select></label><label class="staff-wide">Шалтгаан <input id="override-reason" maxlength="160" /></label><button class="button secondary staff-wide" type="submit">Өдрийн өөрчлөлт хадгалах</button></form><form id="calendar-extra" class="staff-compact-form"><label>Нэмэлт өдөр <input id="extra-date" type="date" required /></label><label>Эхлэх цаг <input id="extra-start" type="time" required /></label><label>Дуусах цаг <input id="extra-end" type="time" required /></label><label class="staff-wide">Тайлбар <input id="extra-reason" maxlength="160" /></label><button class="button secondary staff-wide" type="submit">Нэмэлт хичээл оруулах</button></form></div><form id="calendar-lock" class="staff-lock-form"><label>Дууссан гэж батлах хичээл <select id="lock-through">${Array.from({ length: lessons.length + 1 }, (_, number) => `<option value="${number}" ${number === draft.lockedThroughSequence ? "selected" : ""}>${number === 0 ? "Одоогоор батлаагүй" : `${number}-р хичээл хүртэл`}</option>`).join("")}</select></label><label class="staff-check"><input id="lock-confirm" type="checkbox" /> Энэ хүртэлх хичээлүүд дууссаныг баталж байна.</label><button class="button secondary" type="submit">Батлах</button></form><ol class="staff-calendar-list">${slots}</ol><div class="staff-form-actions"><button id="calendar-publish" class="button primary" type="button">Хуваарь хэвлэх</button></div></div>`;
        q("#calendar-override").onsubmit = (event) => { event.preventDefault(); const form = event.currentTarget; if (form.reportValidity()) run(() => request("calendar.change", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, kind: q("#override-kind").value, localDate: q("#override-date").value, reasonLabel: q("#override-reason").value }), "Өдрийн өөрчлөлтийг хадгаллаа."); };
        q("#calendar-extra").onsubmit = (event) => { event.preventDefault(); const form = event.currentTarget; if (form.reportValidity()) run(() => request("calendar.change", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, kind: "extra", localDate: q("#extra-date").value, startTime: q("#extra-start").value, endTime: q("#extra-end").value, reasonLabel: q("#extra-reason").value }), "Нэмэлт хичээлийг орууллаа."); };
        q("#calendar-lock").onsubmit = (event) => { event.preventDefault(); const sequence = Number(q("#lock-through").value); if (sequence > draft.lockedThroughSequence && !q("#lock-confirm").checked) { message("Дууссан хичээлийг батлахын тулд зөвшөөрнө үү."); return; } run(() => request("calendar.lock", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, lockedThroughSequence: sequence }), "Дууссан хичээлийг баталлаа."); };
        container.querySelectorAll("[data-cancel-slot]").forEach((button) => button.onclick = () => { const replacementDate = window.prompt("Нөхөх өдөр (хоосон үлдвэл сүүлд нь шилжинэ)"); let replacement; if (replacementDate) { const startTime = window.prompt("Нөхөх хичээлийн эхлэх цаг (ЖЖ:MM)"); const endTime = window.prompt("Нөхөх хичээлийн дуусах цаг (ЖЖ:MM)"); if (!startTime || !endTime) return; replacement = { localDate: replacementDate, startTime, endTime }; } if (window.confirm("Энэ ирээдүйн хичээлийг цуцлах уу? Дараах хичээлүүд дахин тооцогдоно.")) run(() => request("calendar.cancel", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, slotId: button.dataset.cancelSlot, replacement }), "Цуцлалтыг ноорогт орууллаа."); });
        q("#calendar-publish").onclick = () => { if (window.confirm("Энэ огноотой хуваарийг хэвлэх үү? Хэвлэсний дараа шууд засахгүй.")) run(() => request("calendar.publish", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt }), "Хуваарь хэвлэгдлээ."); };
      }
      async function run(work, success) { message(""); try { await work(); await refresh(success); } catch (caught) { message(caught.message || "Хадгалж чадсангүй."); } }
      q("#year-select").onchange = (event) => { state.yearId = event.target.value; state.selectedClassId = ""; render(); };
      q("#program-stage").onchange = (event) => { state.stage = event.target.value; q("#class-stage").value = state.stage; renderProgram(); };
      q("#calendar-class").onchange = (event) => { state.selectedClassId = event.target.value; renderCalendar(); };
      q("#class-reset").onclick = resetClass; q("#break-reset").onclick = resetBreak;
      q("#class-form").onsubmit = (event) => { event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity()) return; run(() => request("class.save", { id: q("#class-id").value || undefined, expectedUpdatedAt: q("#class-updated").value || undefined, academicYearId: state.yearId, stageCode: q("#class-stage").value, displayLabel: q("#class-label").value, weekday: q("#class-weekday").value, startTime: q("#class-start").value, endTime: q("#class-end").value, capacity: Number(q("#class-capacity").value), status: q("#class-status").value, facebookGroupUrl: q("#class-facebook").value }), "Ангийг хадгаллаа."); };
      q("#break-form").onsubmit = (event) => { event.preventDefault(); const form = event.currentTarget; if (!form.reportValidity()) return; run(() => request("break.save", { id: q("#break-id").value || undefined, expectedUpdatedAt: q("#break-updated").value || undefined, academicYearId: state.yearId, label: q("#break-label").value, startsOn: q("#break-start").value, endsOn: q("#break-end").value, excludesHabitualSlots: q("#break-exclude").checked, sourceNote: q("#break-note").value }), "Завсарлагыг хадгаллаа."); };
      async function bootstrap() { try { const session = await (await fetch("/api/staff/session", { credentials: "same-origin" })).json(); if (!session.authenticated || !(session.capabilities || []).includes("calendar.manage") || !(session.capabilities || []).includes("program.manage")) { show("program-denied"); return; } await refresh(); show("program-app"); resetClass(); resetBreak(); } catch { show("program-denied"); } }
      bootstrap();
    </script>
  </body>
</html>
