---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Хөтөлбөр | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Хөтөлбөр</span></span></a></header>
    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Хөтөлбөр</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Хөтөлбөр</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Заах хичээлүүд</p><h1>Хөтөлбөр</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <p class="staff-muted">Шатуудын үндсэн хөтөлбөрийг энд засварлана.</p>
        <div id="program-create"></div>
        <div id="program-list" class="staff-offering-list"></div>
        <section id="program-editor" class="staff-operation-section" hidden></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { createStaffActionMenuController } from "../../scripts/staff-action-menus.js";
      import { buildProgramReport, copyReportToClipboard, printReport } from "../../scripts/staff-reports.js";
      import { escape, getOverview, hasSetupAccess, postOverviewAction, stageLabel } from "../../scripts/staff-setup.js";

      const params = new URLSearchParams(location.search);
      const state = { data: null, familyId: params.get("program") || params.get("family") || "", creating: false, edit: false, publicEdit: false, longDescriptionEdit: false, editingLessonId: "", insertingBeforeLessonId: "", appendingLesson: false, discarding: false };
      const q = (selector) => document.querySelector(selector);
      const actionMenus = createStaffActionMenuController(document);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const families = () => (state.data?.programFamilies || []).filter((family) => family.status === "active");
      const selected = () => families().find((family) => family.id === state.familyId);
      const label = (family) => family.kind === "annual_course" ? stageLabel(family.annualStageCode) : family.displayName;
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") { state.data = await getOverview(); if (state.familyId && !selected()) state.familyId = ""; render(); message(success, Boolean(success)); }
      function rows(program) { return (program?.lessons || []).map((lesson) => `<li><span class="staff-order">${lesson.sequenceNumber}</span><span>${escape(lesson.title)}</span></li>`).join(""); }
      function renderCreate() {
        const box = q("#program-create"); if (!state.creating) { box.innerHTML = ""; return; }
        box.innerHTML = `<section class="staff-operation-section"><h2>Зуны хөтөлбөр</h2><form id="summer-create" class="staff-compact-form"><label class="staff-wide">Нэр <input id="summer-name" required maxlength="160" placeholder="Зуны сургалтын нэр" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" data-cancel type="button">Болих</button><button class="button primary" type="submit">Үүсгэх</button></div></form></section>`;
        q("[data-cancel]").onclick = () => { state.creating = false; renderCreate(); };
        q("#summer-create").onsubmit = (event) => { event.preventDefault(); if (event.currentTarget.reportValidity()) run(() => postOverviewAction("program.create-summer", { displayName: q("#summer-name").value }), "Зуны хөтөлбөр үүслээ."); };
      }
      function renderList() {
        const annual = families().filter((family) => family.kind === "annual_course"); const summer = families().filter((family) => family.kind === "summer_course");
        const familyRow = (family) => { const current = family.currentProgram; return `<article class="staff-offering-row"><div><span class="staff-kind-label">${family.kind === "annual_course" ? "Жилийн сургалт" : "Зуны хөтөлбөр"}</span><h2>${escape(label(family))}</h2><p>${current ? `${current.lessons.length} хичээл` : "Хичээл оруулаагүй байна"}</p></div><button class="button secondary" type="button" data-open="${escape(family.id)}">Нээх</button></article>`; };
        q("#program-list").innerHTML = `${annual.length ? `<section class="staff-offering-group"><h2>Жилийн сургалт</h2>${annual.map(familyRow).join("")}</section>` : ""}<section class="staff-offering-group"><h2>Зуны хөтөлбөр</h2>${summer.map(familyRow).join("") || `<p class="staff-empty">Зуны хөтөлбөр оруулаагүй байна.</p>`}<button id="add-summer" class="button secondary" type="button">Зуны хөтөлбөр нэмэх</button></section>`;
        q("#add-summer").onclick = () => { state.creating = true; renderCreate(); q("#summer-name")?.focus(); };
        q("#program-list").querySelectorAll("[data-open]").forEach((button) => button.onclick = () => { state.familyId = button.dataset.open; state.edit = false; history.replaceState(null, "", `?program=${encodeURIComponent(state.familyId)}`); renderEditor(); q("#program-editor").scrollIntoView({ behavior: "smooth", block: "start" }); });
      }
      function titleEditor(lesson) {
        return `<li class="staff-lesson-row staff-lesson-edit-row"><span class="staff-order">${lesson.sequenceNumber}</span><form class="staff-lesson-inline-form" data-title-form="${escape(lesson.id)}"><input data-lesson-title required maxlength="200" value="${escape(lesson.title)}" aria-label="${lesson.sequenceNumber}-р хичээлийн нэр" /><div class="staff-inline-actions"><button class="button secondary" data-title-cancel type="button">Болих</button><button class="button primary" type="submit">OK</button></div></form></li>`;
      }
      function insertEditor(beforeLessonId = "") {
        return `<li class="staff-lesson-insert-row"><span aria-hidden="true"></span><form class="staff-lesson-inline-form" data-insert-form="${escape(beforeLessonId)}"><label>Шинэ хичээлийн нэр <input data-insert-title required maxlength="200" /></label><div class="staff-inline-actions"><button class="button secondary" data-insert-cancel type="button">Болих</button><button class="button primary" type="submit">Оруулах</button></div></form></li>`;
      }
      function lessonRow(lesson, index, lessonCount) {
        if (state.editingLessonId === lesson.id) return titleEditor(lesson);
        const actions = `<details class="staff-lesson-menu" data-staff-action-menu><summary aria-label="${lesson.sequenceNumber}-р хичээлийн үйлдэл" title="Үйлдэл">⋯</summary><div class="staff-lesson-menu-actions"><button type="button" data-staff-action-menu-item data-insert-before="${escape(lesson.id)}">Өмнө нь хичээл оруулах</button>${index > 0 ? `<button type="button" data-staff-action-menu-item data-move="up" data-lesson="${escape(lesson.id)}">Дээш зөөх</button>` : ""}${index < lessonCount - 1 ? `<button type="button" data-staff-action-menu-item data-move="down" data-lesson="${escape(lesson.id)}">Доош зөөх</button>` : ""}<button type="button" data-staff-action-menu-item data-delete="${escape(lesson.id)}">Хасах</button></div></details>`;
        return `<li class="staff-lesson-row"><span class="staff-order">${lesson.sequenceNumber}</span><button class="staff-lesson-title" type="button" data-edit-title="${escape(lesson.id)}">${escape(lesson.title)}</button>${actions}</li>`;
      }
      function lessonRows(program) {
        const lessons = program.lessons || [];
        return lessons.map((lesson, index) => `${state.insertingBeforeLessonId === lesson.id ? insertEditor(lesson.id) : ""}${lessonRow(lesson, index, lessons.length)}`).join("") + (state.appendingLesson ? insertEditor() : "");
      }
      function clearInlineEditor() { state.editingLessonId = ""; state.insertingBeforeLessonId = ""; state.appendingLesson = false; }
      function gradeRange(family) { const min = family.recommendedGradeMin; const max = family.recommendedGradeMax; if (!min && !max) return ""; if (min && max) return min === max ? `${min}-р анги` : `${min}–${max}-р анги`; return `${min || max}-р анги`; }
      function hasSavedProgramChanges(family) {
        const draft = family.draftProgram; const current = family.currentProgram;
        if (!draft) return false;
        if (!current) return Boolean(draft.displayName || draft.lessons.length);
        return draft.displayName !== current.displayName
          || draft.lessons.length !== current.lessons.length
          || draft.lessons.some((lesson, index) => lesson.title !== current.lessons[index]?.title);
      }
      function discardProgram(family) {
        const action = family.currentProgram ? "program.discard" : "program.delete-summer";
        const payload = family.currentProgram
          ? { programFamilyId: family.id, expectedUpdatedAt: family.draftProgram?.updatedAt || "" }
          : { programFamilyId: family.id };
        return run(async () => {
          await postOverviewAction(action, payload);
          state.discarding = false; state.edit = false; state.familyId = "";
          history.replaceState(null, "", location.pathname);
        }, "Өөрчлөлтийг устгалаа.");
      }
      function renderEditor() {
        actionMenus.close();
        const family = selected(); const box = q("#program-editor"); if (!family) { box.hidden = true; return; } box.hidden = false;
        const program = state.edit ? family.draftProgram : family.currentProgram;
        if (!program) {
          box.innerHTML = family.kind === "summer_course" && family.draftProgram
            ? `<p class="staff-empty">Хичээл оруулаагүй байна.</p><button id="program-edit" class="button secondary" type="button">Засах</button>`
            : `<p class="staff-empty">Хичээл оруулаагүй байна.</p>`;
          q("#program-edit")?.addEventListener("click", () => { state.edit = true; renderEditor(); });
          return;
        }
        if (!state.edit) {
          const publicInfo = state.publicEdit ? `<form id="program-public-form" class="staff-compact-form"><label>Зөвлөмжит анги <span class="compact-fields"><input id="program-grade-min" inputmode="numeric" placeholder="Доод" value="${escape(family.recommendedGradeMin || "")}" /><input id="program-grade-max" inputmode="numeric" placeholder="Дээд" value="${escape(family.recommendedGradeMax || "")}" /></span></label><label class="staff-wide">Товч тайлбар <textarea id="program-short" rows="3">${escape(family.publicShortDescription || "")}</textarea></label><div class="staff-form-actions staff-wide"><button id="program-public-cancel" class="button secondary" type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div></form>` : `<section class="staff-program-public-summary">${gradeRange(family) ? `<p><strong>Зөвлөмжит анги:</strong> ${escape(gradeRange(family))}</p>` : ""}${family.publicShortDescription ? `<p>${escape(family.publicShortDescription)}</p>` : ""}<div class="staff-inline-actions"><button id="program-public-edit" class="button secondary" type="button">Засах</button><button id="program-long-description" class="button secondary" type="button">Дэлгэрэнгүй</button></div></section>`;
          const longDescription = state.longDescriptionEdit ? `<dialog id="program-long-dialog" class="rules-dialog" open><form id="program-long-form" class="staff-compact-form"><div class="dialog-heading"><h2>${escape(label(family))}</h2></div><label class="staff-wide">Дэлгэрэнгүй тайлбар <textarea id="program-long" rows="16">${escape(family.publicLongDescription || "")}</textarea></label><div class="staff-form-actions staff-wide"><button id="program-long-cancel" class="button secondary" type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div></form></dialog>` : "";
          box.innerHTML = `<div class="staff-section-heading"><div><span class="staff-kind-label">${escape(family.kind === "annual_course" ? "Жилийн сургалт" : "Зуны хөтөлбөр")}</span><h2>${escape(label(family))}</h2></div><div class="staff-inline-actions"><button id="program-close" class="button secondary" type="button">Хаах</button></div></div><p>${program.lessons.length} хичээл</p>${publicInfo}${longDescription}<div class="staff-section-heading"><h3>Хичээлийн жагсаалт</h3><button id="program-edit" class="button secondary" type="button">Засах</button></div><div class="staff-report-actions"><button id="program-print" class="button secondary" type="button">Хэвлэх / PDF</button><button id="program-copy" class="button secondary" type="button">Excel-д хуулах</button></div><ol class="staff-program-preview">${rows(program)}</ol>${family.history?.length ? `<details><summary>Өмнөх хувилбарууд</summary><ul class="staff-program-preview">${family.history.map((entry) => `<li><span>${escape(entry.displayName)}</span><span>${entry.lessons.length} хичээл${entry.offeringCount ? ` · ${entry.offeringCount} сургалт ашиглаж байна` : ""}</span></li>`).join("")}</ul></details>` : ""}`;
          q("#program-close").onclick = () => { state.familyId = ""; state.edit = false; state.publicEdit = false; state.longDescriptionEdit = false; history.replaceState(null, "", location.pathname); renderEditor(); };
          q("#program-edit").onclick = () => run(async () => { await postOverviewAction("program.edit", { programFamilyId: family.id }); state.edit = true; });
          q("#program-public-edit")?.addEventListener("click", () => { state.publicEdit = true; renderEditor(); });
          q("#program-public-cancel")?.addEventListener("click", () => { state.publicEdit = false; renderEditor(); });
          q("#program-long-description")?.addEventListener("click", () => { state.longDescriptionEdit = true; renderEditor(); });
          q("#program-long-cancel")?.addEventListener("click", () => { state.longDescriptionEdit = false; renderEditor(); });
          q("#program-public-form")?.addEventListener("submit", (event) => { event.preventDefault(); run(async () => { await postOverviewAction("program.public-information.save", { programFamilyId: family.id, expectedUpdatedAt: family.updatedAt, recommendedGradeMin: q("#program-grade-min").value, recommendedGradeMax: q("#program-grade-max").value, publicShortDescription: q("#program-short").value, publicLongDescription: family.publicLongDescription || "" }); state.publicEdit = false; }, "Нийтийн мэдээллийг хадгаллаа."); });
          q("#program-long-form")?.addEventListener("submit", (event) => { event.preventDefault(); run(async () => { await postOverviewAction("program.public-information.save", { programFamilyId: family.id, expectedUpdatedAt: family.updatedAt, recommendedGradeMin: family.recommendedGradeMin || "", recommendedGradeMax: family.recommendedGradeMax || "", publicShortDescription: family.publicShortDescription || "", publicLongDescription: q("#program-long").value }); state.longDescriptionEdit = false; }, "Дэлгэрэнгүй тайлбарыг хадгаллаа."); });
          const report = () => buildProgramReport(family, program, label(family));
          q("#program-print").onclick = () => printReport(report());
          q("#program-copy").onclick = async () => { try { await copyReportToClipboard(report()); message("Excel-д хуулах хүснэгтийг хууллаа.", true); } catch { message("Хүснэгтийг хуулж чадсангүй."); } };
          return;
        }
        const dirty = hasSavedProgramChanges(family);
        const discardPanel = state.discarding ? `<section class="staff-discard-confirm"><p>Хадгалаагүй өөрчлөлтүүдийг устгах уу?</p><div class="staff-form-actions"><button class="button primary" id="program-keep-editing" type="button">Үргэлжлүүлэн засах</button><button class="button danger" id="program-discard" type="button">Өөрчлөлтийг устгах</button></div></section>` : "";
        box.innerHTML = `<section id="program-form" class="staff-program-form"><div class="staff-section-heading"><div><span class="staff-kind-label">${escape(label(family))}</span><h2>Хичээл засах</h2></div></div>${family.kind === "summer_course" ? `<label>Хөтөлбөрийн нэр <input id="program-name" value="${escape(program.displayName)}" maxlength="160" required /></label>` : ""}<ol id="lesson-list" class="staff-lesson-list">${lessonRows(program)}</ol><div class="staff-inline-actions"><button id="lesson-add" class="button secondary" type="button">Хичээл нэмэх</button></div>${discardPanel || `<div class="staff-form-actions"><button class="button secondary" data-close-editor type="button">Болих</button><button id="program-save" class="button primary" type="button" ${dirty ? "" : "disabled"}>Хадгалах</button></div>`}</section>${family.kind === "summer_course" ? `<div class="staff-danger-zone"><button class="button danger" id="summer-delete" type="button">Хөтөлбөрийг устгах</button></div>` : ""}`;
        q("#program-keep-editing")?.addEventListener("click", () => { state.discarding = false; renderEditor(); });
        q("#program-discard")?.addEventListener("click", () => discardProgram(family));
        q("[data-close-editor]")?.addEventListener("click", () => {
          if (state.editingLessonId || state.insertingBeforeLessonId || state.appendingLesson) { clearInlineEditor(); renderEditor(); return; }
          if (dirty) { state.discarding = true; renderEditor(); return; }
          if (family.draftProgram) { discardProgram(family); return; }
          state.edit = false; renderEditor();
        });
        if (family.kind === "summer_course") q("#program-name").onchange = () => run(() => postOverviewAction("program.rename", { programId: program.id, expectedUpdatedAt: program.updatedAt, displayName: q("#program-name").value }), "Нэрийг хадгаллаа.");
        q("#lesson-list").querySelectorAll("[data-edit-title]").forEach((button) => button.onclick = () => { state.editingLessonId = button.dataset.editTitle; state.insertingBeforeLessonId = ""; state.appendingLesson = false; renderEditor(); q("[data-lesson-title]")?.focus(); });
        q("#lesson-list").querySelectorAll("[data-title-cancel]").forEach((button) => button.onclick = () => { clearInlineEditor(); renderEditor(); });
        q("#lesson-list").querySelectorAll("[data-title-form]").forEach((form) => form.onsubmit = (event) => { event.preventDefault(); if (event.currentTarget.reportValidity()) run(() => postOverviewAction("program.lesson.rename", { programId: program.id, expectedUpdatedAt: program.updatedAt, lessonId: form.dataset.titleForm, title: form.querySelector("[data-lesson-title]").value }), "Хичээлийг хадгаллаа."); });
        q("#lesson-list").querySelectorAll("[data-insert-before]").forEach((button) => button.onclick = () => { state.insertingBeforeLessonId = button.dataset.insertBefore; state.editingLessonId = ""; state.appendingLesson = false; renderEditor(); q("[data-insert-title]")?.focus(); });
        q("#lesson-list").querySelectorAll("[data-insert-cancel]").forEach((button) => button.onclick = () => { clearInlineEditor(); renderEditor(); });
        q("#lesson-list").querySelectorAll("[data-insert-form]").forEach((form) => form.onsubmit = (event) => { event.preventDefault(); if (event.currentTarget.reportValidity()) run(() => postOverviewAction("program.lesson.insert", { programId: program.id, expectedUpdatedAt: program.updatedAt, beforeLessonId: form.dataset.insertForm || undefined, title: form.querySelector("[data-insert-title]").value }), "Хичээл орууллаа."); });
        q("#lesson-list").querySelectorAll("[data-move]").forEach((button) => button.onclick = () => run(() => postOverviewAction("program.lesson.move", { programId: program.id, expectedUpdatedAt: program.updatedAt, lessonId: button.dataset.lesson, direction: button.dataset.move }), "Дарааллыг шинэчиллээ."));
        q("#lesson-list").querySelectorAll("[data-delete]").forEach((button) => button.onclick = () => { if (window.confirm("Энэ хичээлийг хасах уу?")) run(() => postOverviewAction("program.lesson.delete", { programId: program.id, expectedUpdatedAt: program.updatedAt, lessonId: button.dataset.delete }), "Хичээлийг хаслаа."); });
        q("#lesson-add").onclick = () => { state.appendingLesson = true; state.editingLessonId = ""; state.insertingBeforeLessonId = ""; renderEditor(); q("[data-insert-title]")?.focus(); };
        q("#program-save")?.addEventListener("click", () => run(async () => { await postOverviewAction("program.publish", { programId: program.id, expectedUpdatedAt: program.updatedAt }); state.edit = false; }, "Хөтөлбөрийг хадгаллаа."));
        q("#summer-delete")?.addEventListener("click", () => { if (window.confirm("Энэ зуны хөтөлбөрийг устгах уу? Өмнөх сургалт ашигласан бол идэвхтэй жагсаалтаас л хасна.")) run(() => postOverviewAction("program.delete-summer", { programFamilyId: family.id }), "Зуны хөтөлбөрийг устгалаа."); });
      }
      function render() { renderCreate(); renderList(); renderEditor(); }
      async function run(work, success = "") { message(); try { await work(); state.creating = false; state.discarding = false; clearInlineEditor(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      (async () => { if (!(await hasSetupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
