---
import { siteIdentity } from "../../../content/homepage";
import "../../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Хэрэглээ, хамгаалалт | {siteIdentity.name}</title></head>
  <body class="staff-page" data-usage-protection-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Хэрэглээ, хамгаалалт</span></span></a></header>
    <main class="staff-shell staff-settings-shell" aria-live="polite">
      <section id="usage-booting" class="staff-state"><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="usage-denied" class="staff-state" hidden><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/settings/">Тохиргоо руу буцах</a></section>
      <section id="usage-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Админы хяналт</p><h1>Хэрэглээ, хамгаалалт</h1></div><a class="staff-back-link" href="/staff/settings/">Тохиргоо руу буцах</a></div>
        <p id="usage-message" class="staff-error" role="status" hidden></p>
        <section id="usage-status" class="staff-operation-section"></section>
        <section class="staff-operation-section"><h2>Ажиглалтын бодлого</h2><p class="staff-muted">Энэ хувилбар хэмжүүрээр автоматаар зогсоохгүй. Доорх түр зогсолтуудыг зөвхөн админ хадгалсан үед дараагийн ажлын ээлж эхлэхээс өмнө шалгана.</p><form id="usage-policy-form" class="staff-compact-form"><label>CPU-хязгаарын анхааруулах тоо <input id="usage-warning-count" type="number" min="0" max="100000" step="1" required /></label><fieldset id="usage-pauses"><legend>Түр зогсоох арын ажил</legend><label><input type="checkbox" name="reminders" /> Сануулга</label><label><input type="checkbox" name="waitlist" /> Хүлээлгийн жагсаалт</label><label><input type="checkbox" name="internalNotices" /> Дотоод мэдэгдлийн дахин оролдлого</label><label><input type="checkbox" name="recovery" /> Тасалдсан ажиллагааны сэргээх ажил</label></fieldset><p class="staff-muted">Төлбөрийн 0 минутын баталгаажуулалт болон эхэлсэн санхүүгийн гүйлгээг энэ бодлого зогсоохгүй.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Бодлогыг хадгалах</button></div></form></section>
        <section class="staff-operation-section"><h2>Яаралтай арга хэмжээ</h2><p class="staff-muted">Аппын түр зогсолт нь Worker дуудагдахаас өмнө хаадаг edge хамгаалалт биш. Яаралтай тохиолдолд Cloudflare dashboard дээр custom domain, workers.dev болон preview/version URL-уудыг тус тус шалгаж, шаардлагатай route эсвэл Cron trigger-ийг гараар зогсооно. Энэ нь сарын төлбөрийн хатуу дээд хязгаар батлахгүй.</p></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #usage-app")) node.hidden = node.id !== id; document.body.dataset.usageProtectionSurface = id.replace("usage-", ""); };
      const message = (text = "", success = false) => { const node = q("#usage-message"); node.textContent = text; node.classList.toggle("staff-success", success); node.hidden = !text; };
      const stamp = (value) => value ? new Intl.DateTimeFormat("mn-MN", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "Тодорхойгүй";
      const number = (value) => value == null ? "Боломжгүй" : Number(value).toLocaleString("mn-MN");
      let data = null;
      function render() {
        const collector = data.collector; const usage = data.usage;
        q("#usage-status").innerHTML = `<h2>${data.environment === "production" ? "Production" : "Staging"} хэрэглээ</h2><dl class="usage-protection-grid"><div><dt>Коллектор</dt><dd>${collector.configured ? "Тохируулсан" : "Тохируулаагүй"}</dd></div><div><dt>Сүүлийн оролдлого</dt><dd>${stamp(collector.attemptedAt)}</dd></div><div><dt>Хэмжсэн хугацаа</dt><dd>${collector.periodStartsAt ? `${stamp(collector.periodStartsAt)} – ${stamp(collector.periodEndsAt)}` : "Тодорхойгүй"}</dd></div><div><dt>Төлөв</dt><dd>${collector.status}${collector.sampled ? " · түүвэр" : ""}</dd></div><div><dt>Worker invocation</dt><dd>${number(usage?.workerInvocations)}</dd></div><div><dt>Worker алдаа</dt><dd>${number(usage?.workerErrors)}</dd></div><div><dt>CPU-хязгаарын алдаа</dt><dd>${number(usage?.cpuLimitErrors)}${usage?.cpuWarning ? " · анхааруулга" : ""}</dd></div><div><dt>D1 мөрийн хэрэглээ</dt><dd>${usage?.d1RowsRead == null ? "Энэ collector-оор боломжгүй" : `${number(usage.d1RowsRead)} / ${number(usage.d1RowsWritten)}`}</dd></div></dl><p class="staff-muted">Эх сурвалж: ${collector.source}. ${collector.detailCode === "cpu_and_d1_not_exposed" ? "Энэ хязгаарлагдмал API хариу CPU болон D1 мөрийн тоог өгөөгүй; түүвэрлэлтийн мэдээлэл ч байхгүй." : collector.detailCode === "token_not_configured" ? "Cloudflare Analytics read token тохируулаагүй тул хэмжүүр таамаглаагүй." : "Хариу боломжгүй эсвэл хуучирсан байж болно."} Бодлогын уншилт warm isolate дээр 60 секунд хүртэл хоцорч болно.</p>`;
        const scripts = usage?.workerVersions?.length ? usage.workerVersions.map((entry) => entry.scriptName).join(", ") : "Энэ collector-оор боломжгүй";
        q("#usage-status").insertAdjacentHTML("beforeend", `<p class="staff-muted">Worker скрипт: ${scripts}. Энэ нь зөвхөн ${data.environment} cache; нөгөө орчин өөрийн cache-аа тусдаа хадгална.</p>`);
        q("#usage-warning-count").value = data.policy.warningCpuErrorCount;
        for (const [key, value] of Object.entries(data.policy.pauses)) q(`#usage-pauses [name="${key}"]`).checked = value;
      }
      async function load() { const response = await fetch("/api/staff/usage-protection", { credentials: "same-origin", cache: "no-store" }); if (!response.ok) throw new Error("Хэрэглээний мэдээллийг авч чадсангүй."); data = await response.json(); render(); }
      async function boot() { const session = await fetch("/api/staff/session", { credentials: "same-origin" }).then((response) => response.ok ? response.json() : null); if (!session?.authenticated || !(session.capabilities || []).includes("admin.settings.manage")) return show("usage-denied"); await load(); show("usage-app"); }
      q("#usage-policy-form").addEventListener("submit", async (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const button = event.currentTarget.querySelector("button"); button.disabled = true; button.textContent = "Хадгалж байна…"; try { const pauses = Object.fromEntries(["reminders", "waitlist", "internalNotices", "recovery"].map((key) => [key, q(`#usage-pauses [name="${key}"]`).checked])); const response = await fetch("/api/staff/usage-protection", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ warningCpuErrorCount: Number(q("#usage-warning-count").value), pauses, expectedUpdatedAt: data.policy.updatedAt }) }); const body = await response.json().catch(() => null); if (!response.ok) throw new Error(body?.error?.message || "Бодлогыг хадгалж чадсангүй."); data = body; render(); message("Бодлогыг хадгаллаа.", true); } catch (error) { message(error.message || "Бодлогыг хадгалж чадсангүй."); } finally { button.disabled = false; button.textContent = "Бодлогыг хадгалах"; } });
      boot().catch((error) => { show("usage-app"); message(error.message || "Хэрэглээний мэдээллийг авч чадсангүй."); });
    </script>
  </body>
</html>
