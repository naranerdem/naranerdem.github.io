---
import { siteIdentity } from "../../../content/homepage";
import "../../../styles/global.css";
---

<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Usage &amp; protection | {siteIdentity.name}</title></head>
  <body class="staff-page" data-usage-protection-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Staff area"><img class="brand-logo" src={siteIdentity.logo.src} alt="Naran Erdem logo" /><span><strong>{siteIdentity.name}</strong><span>Usage &amp; protection</span></span></a></header>
    <main class="staff-shell staff-settings-shell" aria-live="polite">
      <section id="usage-booting" class="staff-state"><h1>Just a moment</h1><p class="staff-muted">Checking your access.</p></section>
      <section id="usage-denied" class="staff-state" hidden><h1>You do not have access to this page</h1><a class="button secondary" href="/staff/settings/">Back to settings</a></section>
      <section id="usage-error" class="staff-state" hidden><h1>Usage information could not be loaded</h1><p id="usage-load-error" class="staff-error" role="status"></p><button id="usage-retry" class="button secondary" type="button">Try again</button></section>
      <section id="usage-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">ADMIN CONTROLS</p><h1>Usage &amp; protection</h1></div><a class="staff-back-link" href="/staff/settings/">Back to settings</a></div>
        <p id="usage-message" class="staff-error" role="status" hidden></p>
        <section id="usage-status" class="staff-operation-section"></section>
        <section class="staff-operation-section"><h2>Observation policy</h2><p class="staff-muted">This version does not stop work automatically from these metrics. Saved pauses are checked only before the next background-work unit begins.</p><form id="usage-policy-form" class="staff-compact-form"><label class="usage-warning-field">Worker error warning threshold <input id="usage-warning-count" type="number" min="0" max="100000" step="1" required /><small>Total general Worker errors in the rolling 24-hour window. A separate CPU-limit failure count is not currently available.</small></label><fieldset id="usage-public-protection"><legend>Public request protection</legend><label>Protection preset <select id="usage-public-preset"><option value="normal">Normal</option><option value="heightened">Heightened</option></select></label><p id="usage-public-scope" class="staff-muted"></p><label><input id="usage-pause-registrations" type="checkbox" /> Pause new public registrations</label><label><input id="usage-pause-messages" type="checkbox" /> Pause anonymous message and link requests</label><p class="staff-muted">These controls affect new requests after the cached policy refreshes, normally within 60 seconds. They do not interrupt an operation already in progress.</p></fieldset><fieldset id="usage-pauses"><legend>Pause background jobs</legend><label><input type="checkbox" name="reminders" /> Payment reminders</label><label><input type="checkbox" name="waitlist" /> Waitlist recovery</label><label><input type="checkbox" name="internalNotices" /> Internal notification retries</label><label><input type="checkbox" name="recovery" /> Interrupted-operation recovery</label></fieldset><p class="staff-muted">Zero-minute payment confirmation and financial operations already in progress are not paused by this policy.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Save policy</button></div></form></section>
        <section class="staff-operation-section"><h2>Emergency procedure</h2><p class="staff-muted">An application pause does not block a Worker before it is invoked at the edge. In an emergency, review the custom domain, workers.dev address, and preview/version URLs separately in the Cloudflare dashboard, then stop the necessary route or Cron trigger manually. This does not guarantee a monthly spending cap.</p></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #usage-app")) node.hidden = node.id !== id; document.body.dataset.usageProtectionSurface = id.replace("usage-", ""); };
      const message = (text = "", success = false) => { const node = q("#usage-message"); node.textContent = text; node.classList.toggle("staff-success", success); node.hidden = !text; };
      const stamp = (value, timeZone) => value ? new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", timeZoneName: "short", ...(timeZone ? { timeZone } : {}) }).format(new Date(value)) : "Unknown";
      const number = (value) => value == null ? "Unavailable" : Number(value).toLocaleString("en-CA");
      const collectorStatus = (value) => ({ available: "Available", unavailable: "Unavailable", failed: "Failed", stale: "Stale", unknown: "No snapshot yet" }[value] || "Unknown");
      const collectorSource = (value) => value === "unavailable" ? "Not configured" : value === "cloudflare_graphql_workers" ? "Cloudflare Account Analytics" : "Unknown";
      const publicScopes = {
        normal: "Registration submission: 6 requests per IP / minute. Registration data: 60 / minute. Anonymous message and link requests: 4 / minute.",
        heightened: "Registration submission: 2 requests per IP / minute. Registration data: 20 / minute. Anonymous message and link requests: 1 / minute.",
      };
      let data = null;
      function render() {
        const collector = data.collector; const usage = data.usage;
        const d1Window = usage?.d1PeriodStartsAt ? `${stamp(usage.d1PeriodStartsAt, "UTC")} – ${stamp(usage.d1PeriodEndsAt, "UTC")}` : "Unavailable";
        const outcomes = usage?.workerOutcomes || [];
        const sampling = collector.sampled ? "Cloudflare marked this response as sampled." : "Cloudflare did not report sampling information.";
        const detail = collector.detailCode === "cpu_not_exposed"
          ? "A separate CPU-limit failure count was not returned. D1 totals cover the last completed UTC day; Worker metrics cover the rolling 24-hour window."
          : collector.detailCode === "cpu_not_exposed_d1_unavailable"
            ? "Worker metrics were returned, but D1 analytics were unavailable. A separate CPU-limit failure count is also unavailable."
            : collector.detailCode === "token_not_configured"
              ? "The Cloudflare Analytics read token is not configured, so no metrics are estimated."
              : collector.detailCode === "configuration_incomplete"
                ? "The collector configuration is incomplete, so no metrics are estimated."
                : "The response may be unavailable or stale.";
        q("#usage-status").innerHTML = `<h2>${data.environment === "production" ? "Production" : "Staging"} usage</h2><p class="staff-muted">Times are shown in your browser time zone unless they are explicitly labelled UTC.</p><dl class="usage-protection-grid"><div><dt>Collector</dt><dd>${collector.configured ? "Configured" : "Not configured"}</dd></div><div><dt>Last successful update</dt><dd>${stamp(collector.observedAt)}</dd></div><div><dt>Rolling 24-hour Worker window</dt><dd>${collector.periodStartsAt ? `${stamp(collector.periodStartsAt)} – ${stamp(collector.periodEndsAt)}` : "Unknown"}</dd></div><div><dt>Status</dt><dd>${collectorStatus(collector.status)}${collector.sampled ? " · sampled" : " · sampling information unavailable"}</dd></div><div><dt>Worker invocations</dt><dd>${number(usage?.workerInvocations)}</dd></div><div><dt>Worker errors</dt><dd>${number(usage?.workerErrors)}${usage?.workerErrorWarning ? " · warning" : ""}</dd></div><div><dt>CPU-limit failures</dt><dd>Not separately available</dd></div><div><dt>D1 rows read / written</dt><dd>${usage?.d1RowsRead == null ? "Unavailable" : `${number(usage.d1RowsRead)} / ${number(usage.d1RowsWritten)}`}<small>Last completed UTC day: ${d1Window}</small></dd></div></dl><details class="usage-technical"><summary>Technical details</summary><p class="staff-muted">Source: ${collectorSource(collector.source)}. Last attempt: ${stamp(collector.attemptedAt)}. ${detail} ${sampling} Policy reads can take up to 60 seconds to propagate through a warm isolate.</p><p class="staff-muted">Worker scripts: ${outcomes.length ? outcomes.map((entry) => `${entry.scriptName}${entry.status ? ` (${entry.status})` : ""}`).join(", ") : "Unavailable from this collector"}. Cloudflare’s CPU P50/P99 values are per-invocation percentiles, not total CPU consumption.</p></details>`;
        q("#usage-warning-count").value = data.policy.warningWorkerErrorCount;
        for (const [key, value] of Object.entries(data.policy.pauses)) q(`#usage-pauses [name="${key}"]`).checked = value;
        q("#usage-public-preset").value = data.policy.publicProtection.preset;
        q("#usage-pause-registrations").checked = data.policy.publicProtection.pauseNewRegistrations;
        q("#usage-pause-messages").checked = data.policy.publicProtection.pauseAnonymousMessages;
        q("#usage-public-scope").textContent = publicScopes[data.policy.publicProtection.preset];
      }
      async function load() { const response = await fetch("/api/staff/usage-protection", { credentials: "same-origin", cache: "no-store" }); if (!response.ok) throw new Error("Usage information could not be loaded."); data = await response.json(); render(); }
      async function boot() { const session = await fetch("/api/staff/session", { credentials: "same-origin" }).then((response) => response.ok ? response.json() : null); if (!session?.authenticated || !(session.capabilities || []).includes("admin.settings.manage")) return show("usage-denied"); await load(); show("usage-app"); }
      q("#usage-warning-count").addEventListener("input", (event) => { const input = event.currentTarget; const value = Number(input.value); input.setCustomValidity(Number.isInteger(value) && value >= 0 && value <= 100000 ? "" : "Enter a whole-number warning threshold from 0 to 100,000."); });
      q("#usage-public-preset").addEventListener("change", (event) => { q("#usage-public-scope").textContent = publicScopes[event.currentTarget.value]; });
      q("#usage-policy-form").addEventListener("submit", async (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const button = event.currentTarget.querySelector("button"); button.disabled = true; button.textContent = "Saving…"; try { const pauses = Object.fromEntries(["reminders", "waitlist", "internalNotices", "recovery"].map((key) => [key, q(`#usage-pauses [name="${key}"]`).checked])); const publicProtection = { preset: q("#usage-public-preset").value, pauseNewRegistrations: q("#usage-pause-registrations").checked, pauseAnonymousMessages: q("#usage-pause-messages").checked }; const response = await fetch("/api/staff/usage-protection", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ warningWorkerErrorCount: Number(q("#usage-warning-count").value), pauses, publicProtection, expectedUpdatedAt: data.policy.updatedAt }) }); const body = await response.json().catch(() => null); if (!response.ok) throw new Error(body?.error?.code === "conflict" ? "This policy changed elsewhere. Reload the page and review it again." : "The policy could not be saved. Review the values and try again."); data = body; render(); message("Policy saved.", true); } catch (error) { message(error.message || "The policy could not be saved."); } finally { button.disabled = false; button.textContent = "Save policy"; } });
      q("#usage-retry").addEventListener("click", () => { show("usage-booting"); boot().catch((error) => { q("#usage-load-error").textContent = error.message || "Usage information could not be loaded."; show("usage-error"); }); });
      boot().catch((error) => { q("#usage-load-error").textContent = error.message || "Usage information could not be loaded."; show("usage-error"); });
    </script>
  </body>
</html>
