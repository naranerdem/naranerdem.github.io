---
import { siteIdentity } from "../../../content/homepage";
import "../../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Тохиргоо | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Тохиргоо</span></span></a></header>
    <main class="staff-shell staff-settings-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Тохиргоо</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Тохиргоо</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Жилийн бэлтгэл</p><h1>Тохиргоо</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <label class="staff-year-picker">Хичээлийн жил <select id="year-select"></select></label>
        <section class="staff-operation-section" aria-labelledby="facebook-title"><div class="staff-section-heading"><div><h2 id="facebook-title">Facebook бүлэг</h2><p class="staff-muted">Шат бүрт нэг холбоос хадгална.</p></div></div><form id="facebook-form" class="staff-settings-list"></form></section>
        <a id="auth-link" class="staff-settings-link" href="/staff/settings/auth/" hidden>Нэвтрэх хугацааны тохиргоо</a>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { currentYearId, escape, fillSelect, getOverview, hasSetupAccess, postOverviewAction, stageLabel } from "../../../scripts/staff-setup.js";

      const state = { data: null, yearId: "", canManageAuth: false };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") { state.data = await getOverview(); state.yearId = currentYearId(state.data, state.yearId); render(); message(success, Boolean(success)); }
      function render() {
        fillSelect(q("#year-select"), state.data.years || [], state.yearId, (year) => year.label);
        const settings = state.data.stageSettings || [];
        q("#facebook-form").innerHTML = (state.data.stages || []).map((stage) => {
          const setting = settings.find((entry) => entry.academicYearId === state.yearId && entry.stageCode === stage);
          return `<div class="staff-setting-row" data-stage="${escape(stage)}" data-updated="${escape(setting?.updatedAt || "")}"><label>${stageLabel(stage)} <input type="url" inputmode="url" maxlength="500" placeholder="https://facebook.com/groups/..." value="${escape(setting?.facebookGroupUrl || "")}" /></label><button class="button secondary" type="submit">Хадгалах</button></div>`;
        }).join("");
        q("#auth-link").hidden = !state.canManageAuth;
      }
      q("#facebook-form").addEventListener("submit", (event) => {
        const button = event.submitter;
        const row = button?.closest(".staff-setting-row");
        if (!row) return;
        event.preventDefault();
        const input = row.querySelector("input");
        if (!input.reportValidity()) return;
        run(() => postOverviewAction("stage-setting.save", { academicYearId: state.yearId, stageCode: row.dataset.stage, facebookGroupUrl: input.value, expectedUpdatedAt: row.dataset.updated || undefined }), "Facebook бүлгийн холбоосыг хадгаллаа.");
      });
      async function run(work, success) { message(); try { await work(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      q("#year-select").onchange = (event) => { state.yearId = event.target.value; render(); };
      (async () => {
        if (!(await hasSetupAccess())) { show("tool-denied"); return; }
        const session = await (await fetch("/api/staff/session", { credentials: "same-origin" })).json();
        state.canManageAuth = (session.capabilities || []).includes("admin.settings.manage");
        await refresh(); show("tool-app");
      })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
