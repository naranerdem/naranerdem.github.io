---
import { siteIdentity } from "../../../content/homepage";
import "../../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Тохиргоо | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Тохиргоо</span></span></a></header>
    <main class="staff-shell staff-settings-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Тохиргоо</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Тохиргоо</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Ажлын тохиргоо</p><h1>Тохиргоо</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <section id="annual-start-setting" class="staff-operation-section" hidden></section>
        <section id="payment-confirmation-grace-setting" class="staff-operation-section" hidden></section>
        <section id="initial-payment-deadline-setting" class="staff-operation-section" hidden></section>
        <section id="discount-policy-setting" class="staff-operation-section" hidden></section>
        <section id="historical-family-discount-adoption" class="staff-operation-section" hidden></section>
        <section id="historical-settlement-incident-reconciliation" class="staff-operation-section" hidden></section>
        <section id="payment-reminder-setting" class="staff-operation-section" hidden></section>
        <section id="waitlist-offer-response-setting" class="staff-operation-section" hidden></section>
        <section id="public-font-setting" class="staff-operation-section" hidden></section>
        <section id="public-seat-count-threshold-setting" class="staff-operation-section" hidden></section>
        <section id="email-archive-bcc-setting" class="staff-operation-section" hidden></section>
        <section id="public-qr-setting" class="staff-operation-section" hidden></section>
        <section id="teacher-dashboard-setting" class="staff-operation-section" hidden></section>
        <a id="auth-link" class="staff-settings-link" href="/staff/settings/auth/" hidden>Нэвтрэх хугацааны тохиргоо</a>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { getOverview, hasSetupAccess, postOverviewAction } from "../../../scripts/staff-setup.js";

      const state = { data: null, canManageAuth: false, historicalFamilyAdoption: { registrationDraftId: "", preview: null, result: null, operationId: "", reason: "", confirmPrompt: false, previewing: false, confirming: false }, historicalSettlementIncident: { registrationDraftId: "", childIds: ["", ""], preview: null, result: null, operationId: "", reason: "", confirmPrompt: false, previewing: false, confirming: false } };
      const q = (selector) => document.querySelector(selector);
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>\"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
      const formatMnt = (value) => `${Number(value || 0).toLocaleString("mn-MN")} ₮`;
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function postHistoricalFamilyAdoption(action, payload) {
        const response = await fetch("/api/staff/payments", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ action, ...payload }) });
        const body = await response.json().catch(() => null);
        if (!response.ok) throw new Error(body?.error?.message || "Хүсэлтийг хадгалж чадсангүй.");
        return body;
      }
      async function refresh(success = "") { state.data = await getOverview(); if (state.canManageAuth) { const response = await fetch("/api/staff/settings/email-archive-bcc", { credentials: "same-origin", cache: "no-store" }); if (response.ok) state.data.emailArchiveBccSetting = (await response.json()).setting; } render(); message(success, Boolean(success)); }
      function render() {
        q("#auth-link").hidden = !state.canManageAuth;
        const annualStart = q("#annual-start-setting"); const setting = state.data?.annualCourseStartDefault;
        annualStart.hidden = !state.canManageAuth || !setting;
        annualStart.innerHTML = annualStart.hidden ? "" : `<details><summary>Жилийн сургалтын эхлэх өдрийн анхны утга</summary><form id="annual-start-form" class="staff-compact-form staff-settings-secondary"><label>Сар <input id="annual-start-month" type="number" min="1" max="12" required value="${setting.month}" /></label><label>Өдөр <input id="annual-start-day" type="number" min="1" max="31" required value="${setting.day}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#annual-start-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("annual-course-start-default.save", { month: Number(q("#annual-start-month").value), day: Number(q("#annual-start-day").value), expectedUpdatedAt: setting.updatedAt }), "Жилийн сургалтын эхлэх өдрийн анхны утгыг хадгаллаа."); });
        const grace = q("#payment-confirmation-grace-setting"); const graceSetting = state.data?.paymentConfirmationGrace;
        grace.hidden = !state.canManageAuth || !graceSetting;
        grace.innerHTML = grace.hidden ? "" : `<details><summary>Төлбөр баталгаажуулах засварын хугацаа</summary><form id="payment-grace-form" class="staff-compact-form staff-settings-secondary"><label>Минут <input id="payment-grace-minutes" type="number" min="1" max="60" required value="${graceSetting.graceMinutes}" /></label><p class="staff-muted">Шинэ утга нь дараагийн баталгаажуулалтад үйлчилнэ.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#payment-grace-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("payment-confirmation-grace.save", { graceMinutes: Number(q("#payment-grace-minutes").value), expectedUpdatedAt: graceSetting.updatedAt }), "Засварын хугацааг хадгаллаа."); });
        const deadline = q("#initial-payment-deadline-setting"); const deadlineSetting = state.data?.initialPaymentDeadline;
        deadline.hidden = !state.canManageAuth || !deadlineSetting;
        deadline.innerHTML = deadline.hidden ? "" : `<details><summary>Бүртгүүлсний дараах төлбөр хийх хугацаа</summary><form id="initial-payment-deadline-form" class="staff-compact-form staff-settings-secondary"><label>Минут <input id="initial-payment-deadline-minutes" type="number" min="1" max="10080" required value="${deadlineSetting.deadlineMinutes}" /></label><p class="staff-muted">1440 минут = 24 цаг. Шинэ утга нь дараагийн бүртгэлд үйлчилнэ.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#initial-payment-deadline-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("initial-payment-deadline.save", { deadlineMinutes: Number(q("#initial-payment-deadline-minutes").value), expectedUpdatedAt: deadlineSetting.updatedAt }), "Төлбөр хийх хугацааг хадгаллаа."); });
        const discounts = q("#discount-policy-setting"); const discountPolicy = state.data?.discountPolicySetting;
        discounts.hidden = !state.canManageAuth || !discountPolicy;
        discounts.innerHTML = discounts.hidden ? "" : `<details><summary>Хөнгөлөлтийн хувь</summary><form id="discount-policy-form" class="staff-compact-form staff-settings-secondary"><label>Нэг гэр бүлийн хүүхэд (%) <input id="discount-family-percent" type="number" min="0" max="100" step="0.01" required value="${discountPolicy.familyMultiChildBasisPoints / 100}" /></label><label>Урилгаар бүртгүүлсэн хүүхэд (%) <input id="discount-referred-percent" type="number" min="0" max="100" step="0.01" required value="${discountPolicy.referredChildBasisPoints / 100}" /></label><label class="staff-wide">Амжилттай урилга (%) <input id="discount-referrer-percent" type="number" min="0" max="100" step="0.01" required value="${discountPolicy.referrerBasisPoints / 100}" /></label><p class="staff-muted">Шинэ хөнгөлөлтөд үйлчилнэ. Өмнө олгосон дүн өөрчлөгдөхгүй.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#discount-policy-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("discount-policy.save", { familyMultiChildBasisPoints: Math.round(Number(q("#discount-family-percent").value) * 100), referredChildBasisPoints: Math.round(Number(q("#discount-referred-percent").value) * 100), referrerBasisPoints: Math.round(Number(q("#discount-referrer-percent").value) * 100), expectedUpdatedAt: discountPolicy.updatedAt }), "Хөнгөлөлтийн хувийг хадгаллаа."); });
        const historical = q("#historical-family-discount-adoption"); const historicalState = state.historicalFamilyAdoption;
        historical.hidden = !state.canManageAuth;
        const historicalClassification = { earned: "Хөнгөлөлт баталгаажна", provisional: "Нөхцөл хүлээж байна", qualification_failed: "Тусад нь хянах", reconciliation_review: "Тусад нь хянах", already_adopted: "Өмнө нь шинэчилсэн" };
        const historicalRows = (historicalState.preview?.rows || []).map((row) => `<li><strong>${escapeHtml(row.childName)}</strong> · ${escapeHtml(row.classLabel)} · ${escapeHtml(historicalClassification[row.classification] || row.classification)}<br><span class="staff-muted">Хөнгөлөлтгүй төлбөр ${formatMnt(row.baseAmountMnt)} · Хөнгөлөлтийн дараах төлбөр ${formatMnt(row.baseAmountMnt - row.awardAmountMnt)} · Бодитоор төлсөн дүн ${formatMnt(row.cashReceivedMnt ?? row.cashMnt)} · Төлбөрт хуваарилсан дүн ${formatMnt(row.cashMnt)}${Number(row.attributableCashExcessMnt || 0) > 0 ? ` · Илүү төлсөн дүн ${formatMnt(row.attributableCashExcessMnt)}` : ""} · Төлөх үлдэгдэл ${formatMnt(row.currentRequestedMnt)}</span></li>`).join("");
        const alreadyAdopted = historicalState.preview?.rows?.length && historicalState.preview.rows.every((row) => row.classification === "already_adopted");
        historical.innerHTML = historical.hidden ? "" : `<details ${historicalState.preview || historicalState.previewing || historicalState.confirming || historicalState.confirmPrompt ? "open" : ""}><summary>Өмнөх гэр бүлийн хөнгөлөлтийг хянах</summary><p class="staff-muted">Зөвхөн нэг өмнөх бүртгэлийг UUID-аар сонгож шалгана. Төлбөрийн баримт, суудал, бүртгэлийн түүх өөрчлөгдөхгүй.</p><form id="historical-family-preview-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide">Бүртгэлийн UUID <input id="historical-family-registration-id" inputmode="text" pattern="[0-9a-fA-F-]{36}" required value="${escapeHtml(historicalState.registrationDraftId)}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit" ${historicalState.previewing ? "disabled" : ""}>${historicalState.previewing ? "Шалгаж байна…" : "Урьдчилан харах"}</button></div></form>${historicalState.preview ? `<section class="staff-settings-secondary" aria-live="polite"><h2>Хяналтын үр дүн</h2><ul>${historicalRows}</ul>${alreadyAdopted ? `<p class="staff-success">Энэ бүртгэл өмнө нь шинэчилсэн байна.</p>` : `<form id="historical-family-confirm-form" class="staff-compact-form"><label class="staff-wide">Шалтгаан <textarea id="historical-family-reason" rows="2" maxlength="400" required>${escapeHtml(historicalState.reason)}</textarea></label>${historicalState.confirmPrompt ? `<p class="staff-muted">Сонгосон бүртгэлийг шинэ нөхцөлт дүрмээр шинэчлэх үү? Төлбөрийн баримт, суудал, бүртгэлийн түүх хадгалагдана.</p><div class="staff-form-actions staff-wide"><button id="historical-family-cancel-confirmation" class="button secondary" type="button">Болих</button><button class="button primary" type="submit" ${historicalState.confirming ? "disabled" : ""}>${historicalState.confirming ? "Шинэчилж байна…" : "Баталгаажуулах"}</button></div>` : `<p class="staff-muted">Баталгаажуулснаар дээрх нөхцөлт төлөв хадгалагдана. Хуучин баримт, бүртгэл устахгүй.</p><div class="staff-form-actions staff-wide"><button class="button primary" type="submit">Шинэчлэхийг баталгаажуулах</button></div>`}</form>`}</section>` : ""}${historicalState.result ? `<p class="staff-success">Шинэчлэлт дууслаа: ${historicalState.result.adopted} мөр, тусад нь шалгах ${historicalState.result.reconciliationReview} мөр.</p>` : ""}</details>`;
        q("#historical-family-preview-form")?.addEventListener("submit", async (event) => { event.preventDefault(); const registrationDraftId = q("#historical-family-registration-id").value.trim(); if (!event.currentTarget.reportValidity()) return; historicalState.registrationDraftId = registrationDraftId; historicalState.operationId = ""; historicalState.reason = ""; historicalState.confirmPrompt = false; historicalState.previewing = true; historicalState.preview = null; historicalState.result = null; render(); try { historicalState.preview = await postHistoricalFamilyAdoption("conditional-family.historical-adoption-preview", { registrationDraftId }); } catch (error) { message(error.message || "Өмнөх хөнгөлөлтийг шалгаж чадсангүй."); } finally { historicalState.previewing = false; render(); } });
        q("#historical-family-cancel-confirmation")?.addEventListener("click", () => { historicalState.confirmPrompt = false; render(); });
        q("#historical-family-confirm-form")?.addEventListener("submit", async (event) => { event.preventDefault(); const reason = q("#historical-family-reason").value.trim(); if (!reason || !historicalState.preview || historicalState.confirming) return; historicalState.reason = reason; if (!historicalState.confirmPrompt) { historicalState.confirmPrompt = true; render(); return; } historicalState.operationId ||= crypto.randomUUID(); historicalState.confirming = true; render(); try { historicalState.result = await postHistoricalFamilyAdoption("conditional-family.adopt-historical-awards", { registrationDraftId: historicalState.registrationDraftId, reviewFingerprint: historicalState.preview.reviewFingerprint, reason, operationId: historicalState.operationId }); historicalState.preview = await postHistoricalFamilyAdoption("conditional-family.historical-adoption-preview", { registrationDraftId: historicalState.registrationDraftId }); historicalState.confirmPrompt = false; } catch (error) { message(error.message || "Өмнөх хөнгөлөлтийг шинэчилж чадсангүй."); } finally { historicalState.confirming = false; render(); } });
        const incident = q("#historical-settlement-incident-reconciliation"); const incidentState = state.historicalSettlementIncident;
        incident.hidden = !state.canManageAuth;
        const incidentLabels = { award_credit_missing: "Кредитийн үлдэгдэл дутуу", review_missing: "Төлбөрийн хяналт дутуу", reconciled: "Засагдсан" };
        const incidentRows = (incidentState.preview?.rows || incidentState.result?.rows || []).map((row) => `<li><code>${escapeHtml(row.childId)}</code> · ${escapeHtml(incidentLabels[row.state] || row.state)}</li>`).join("");
        const incidentAlreadyReconciled = Boolean(incidentState.preview?.alreadyReconciled);
        incident.innerHTML = incident.hidden ? "" : `<details ${incidentState.preview || incidentState.previewing || incidentState.confirming || incidentState.confirmPrompt ? "open" : ""}><summary>Түүхэн төлбөрийн хяналтын алдааг засах</summary><p class="staff-muted">Зөвхөн сонгосон хоёр хүүхдийн өмнөх хяналтыг шалгана. Төлбөрийн баримт, суудал, бүртгэлийн түүхийг хадгална.</p><form id="historical-incident-preview-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide">Бүртгэлийн UUID <input id="historical-incident-registration-id" inputmode="text" pattern="[0-9a-fA-F-]{36}" required value="${escapeHtml(incidentState.registrationDraftId)}" /></label><label class="staff-wide">Эхний хүүхдийн UUID <input id="historical-incident-child-a" inputmode="text" pattern="[0-9a-fA-F-]{36}" required value="${escapeHtml(incidentState.childIds[0])}" /></label><label class="staff-wide">Хоёр дахь хүүхдийн UUID <input id="historical-incident-child-b" inputmode="text" pattern="[0-9a-fA-F-]{36}" required value="${escapeHtml(incidentState.childIds[1])}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit" ${incidentState.previewing ? "disabled" : ""}>${incidentState.previewing ? "Шалгаж байна…" : "Урьдчилан харах"}</button></div></form>${incidentState.preview ? `<section class="staff-settings-secondary" aria-live="polite"><h2>Хяналтын үр дүн</h2><ul>${incidentRows}</ul>${incidentAlreadyReconciled ? `<p class="staff-success">Энэ түүхэн хяналтын засвар өмнө нь дууссан байна${incidentState.preview.operationId ? ` · Үйлдэл: ${escapeHtml(incidentState.preview.operationId)}` : ""}.</p>` : `<form id="historical-incident-confirm-form" class="staff-compact-form"><label class="staff-wide">Шалтгаан <textarea id="historical-incident-reason" rows="2" maxlength="500" required>${escapeHtml(incidentState.reason)}</textarea></label>${incidentState.confirmPrompt ? `<p class="staff-muted">Зөвхөн дээрх хоёр хүүхдийн засварыг баталгаажуулах уу? Шинэ төлбөр, и-мэйл эсвэл суудал үүсгэхгүй.</p><div class="staff-form-actions staff-wide"><button id="historical-incident-cancel-confirmation" class="button secondary" type="button">Болих</button><button class="button primary" type="submit" ${incidentState.confirming ? "disabled" : ""}>${incidentState.confirming ? "Засаж байна…" : "Баталгаажуулах"}</button></div>` : `<div class="staff-form-actions staff-wide"><button class="button primary" type="submit">Засварыг баталгаажуулах</button></div>`}</form>`}</section>` : ""}${incidentState.result ? `<p class="staff-success">Түүхэн хяналтын засвар дууслаа.</p>` : ""}</details>`;
        q("#historical-incident-preview-form")?.addEventListener("submit", async (event) => { event.preventDefault(); const registrationDraftId = q("#historical-incident-registration-id").value.trim(); const childIds = [q("#historical-incident-child-a").value.trim(), q("#historical-incident-child-b").value.trim()]; if (!event.currentTarget.reportValidity() || childIds[0] === childIds[1]) return; Object.assign(incidentState, { registrationDraftId, childIds, preview: null, result: null, operationId: "", reason: "", confirmPrompt: false, previewing: true }); render(); try { incidentState.preview = await postHistoricalFamilyAdoption("conditional-family.historical-incident-reconciliation-preview", { registrationDraftId, childIds }); } catch (error) { message(error.message || "Түүхэн хяналтын алдааг шалгаж чадсангүй."); } finally { incidentState.previewing = false; render(); } });
        q("#historical-incident-cancel-confirmation")?.addEventListener("click", () => { incidentState.confirmPrompt = false; render(); });
        q("#historical-incident-confirm-form")?.addEventListener("submit", async (event) => { event.preventDefault(); const reason = q("#historical-incident-reason").value.trim(); if (!reason || !incidentState.preview || incidentState.confirming) return; incidentState.reason = reason; if (!incidentState.confirmPrompt) { incidentState.confirmPrompt = true; render(); return; } incidentState.operationId ||= crypto.randomUUID(); incidentState.confirming = true; render(); try { incidentState.result = await postHistoricalFamilyAdoption("conditional-family.reconcile-historical-incident", { registrationDraftId: incidentState.registrationDraftId, childIds: incidentState.childIds, reviewFingerprint: incidentState.preview.reviewFingerprint, reason, operationId: incidentState.operationId }); incidentState.preview = await postHistoricalFamilyAdoption("conditional-family.historical-incident-reconciliation-preview", { registrationDraftId: incidentState.registrationDraftId, childIds: incidentState.childIds }); incidentState.confirmPrompt = false; } catch (error) { message(error.message || "Түүхэн хяналтын алдааг засаж чадсангүй."); } finally { incidentState.confirming = false; render(); } });
        const reminder = q("#payment-reminder-setting"); const reminderSetting = state.data?.paymentReminderSetting;
        reminder.hidden = !state.canManageAuth || !reminderSetting;
        reminder.innerHTML = reminder.hidden ? "" : `<details><summary>Төлбөрийн сануулга</summary><form id="payment-reminder-form" class="staff-compact-form staff-settings-secondary"><label>Эхний төлбөрийн сануулга — <input id="initial-reminder-lead-minutes" type="number" min="1" max="10080" required value="${reminderSetting.initialReminderLeadMinutes}" /> минутын өмнө</label><small>360 минут = 6 цаг</small><label>Дараагийн төлбөрийн сануулга — <input id="later-reminder-lead-minutes" type="number" min="1" max="43200" required value="${reminderSetting.laterReminderLeadMinutes}" /> минутын өмнө</label><small>4320 минут = 3 хоног</small><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#payment-reminder-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("payment-reminder-setting.save", { initialReminderLeadMinutes: Number(q("#initial-reminder-lead-minutes").value), laterReminderLeadMinutes: Number(q("#later-reminder-lead-minutes").value), expectedUpdatedAt: reminderSetting.updatedAt }), "Төлбөрийн сануулгын хугацааг хадгаллаа."); });
        const waitlistResponse = q("#waitlist-offer-response-setting"); const waitlistSetting = state.data?.waitlistOfferResponseSetting;
        waitlistResponse.hidden = !state.canManageAuth || !waitlistSetting;
        waitlistResponse.innerHTML = waitlistResponse.hidden ? "" : `<details><summary>Хүлээлгийн саналын хариу өгөх хугацаа</summary><form id="waitlist-offer-response-form" class="staff-compact-form staff-settings-secondary"><label>Минут <input id="waitlist-offer-response-minutes" type="number" min="1" max="10080" required value="${waitlistSetting.responseMinutes}" /></label><p class="staff-muted">1440 минут = 24 цаг. Шинэ утга нь дараагийн саналд үйлчилнэ.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#waitlist-offer-response-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("waitlist-offer-response-setting.save", { responseMinutes: Number(q("#waitlist-offer-response-minutes").value), expectedUpdatedAt: waitlistSetting.updatedAt }), "Саналын хариу өгөх хугацааг хадгаллаа."); });
        const font = q("#public-font-setting"); const fontSetting = state.data?.publicSiteFont;
        font.hidden = !state.canManageAuth || !fontSetting;
        font.innerHTML = font.hidden ? "" : `<details><summary>Нийтийн хуудасны фонт</summary><form id="public-font-form" class="staff-compact-form staff-settings-secondary"><label><select id="public-font"><option value="sans" ${fontSetting.font === "sans" ? "selected" : ""}>Sans — одоогийн</option><option value="serif" ${fontSetting.font === "serif" ? "selected" : ""}>Serif — Times New Roman</option></select></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#public-font-form")?.addEventListener("submit", (event) => { event.preventDefault(); run(() => postOverviewAction("public-site-font.save", { font: q("#public-font").value, expectedUpdatedAt: fontSetting.updatedAt }), "Нийтийн хуудасны фонтыг хадгаллаа."); });
        const archive = q("#email-archive-bcc-setting"); const archiveSetting = state.data?.emailArchiveBccSetting;
        archive.hidden = !state.canManageAuth || !archiveSetting;
        archive.innerHTML = archive.hidden ? "" : `<details><summary>И-мэйлийн дотоод хуулбар</summary><form id="email-archive-bcc-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide">Админы хуулбар<textarea id="email-archive-bcc-admin-recipients" rows="4" placeholder="name@example.com">${escapeHtml((archiveSetting.adminRecipients || []).join("\\n"))}</textarea></label><label class="staff-wide">Багшийн хуулбар<textarea id="email-archive-bcc-teacher-recipients" rows="4" placeholder="name@example.com">${escapeHtml((archiveSetting.teacherRecipients || []).join("\\n"))}</textarea></label><p class="staff-muted">Хаягуудыг таслал эсвэл шинэ мөрөөр тусгаарлана. Текстэн &quot;\\n&quot; биш, бодит шинэ мөр ашиглана уу. Давхардахгүй хаяг хоёр жагсаалтад нийлээд ихдээ 5 байна.</p><p class="staff-muted">Админд аюулгүй үйл ажиллагааны мэдэгдлүүд, багшид анхны бүртгэлийн мэдэгдэл хуулбарлагдана. Нэвтрэх, баталгаажуулах, үйлдлийн холбоостой и-мэйл хуулбарлагдахгүй.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#email-archive-bcc-form")?.addEventListener("submit", (event) => { event.preventDefault(); const entries = (selector) => q(selector).value.split(/[\r\n,]+/).map((value) => value.trim()).filter(Boolean); run(() => postOverviewAction("email-archive-bcc.save", { adminRecipients: entries("#email-archive-bcc-admin-recipients"), teacherRecipients: entries("#email-archive-bcc-teacher-recipients"), expectedUpdatedAt: archiveSetting.updatedAt }), "И-мэйлийн дотоод хуулбарыг хадгаллаа."); });
        const seatThreshold = q("#public-seat-count-threshold-setting"); const seatThresholdSetting = state.data?.publicSeatCountThreshold;
        seatThreshold.hidden = !state.canManageAuth || !seatThresholdSetting;
        seatThreshold.innerHTML = seatThreshold.hidden ? "" : `<details><summary>Үлдсэн суудлын тоог харуулах босго</summary><form id="public-seat-count-threshold-form" class="staff-compact-form staff-settings-secondary"><label>Босго <input id="public-seat-count-threshold" type="number" min="0" max="1000" step="1" value="${seatThresholdSetting.remainingSeatThreshold == null ? "" : seatThresholdSetting.remainingSeatThreshold}" placeholder="Одоогийн горим: бүх тоог харуулна" /></label><p class="staff-muted">0 бол тоог огт харуулахгүй. 2 бол 2 эсвэл түүнээс цөөн суудал үлдсэн үед бодит тоог харуулна. Хоосон орхивол одоогийн адил бүх боломжтой ангийн тоог харуулна.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#public-seat-count-threshold-form")?.addEventListener("submit", (event) => { event.preventDefault(); const raw = q("#public-seat-count-threshold").value.trim(); if (raw && !event.currentTarget.reportValidity()) return; run(() => postOverviewAction("public-seat-count-threshold.save", { remainingSeatThreshold: raw === "" ? null : Number(raw), expectedUpdatedAt: seatThresholdSetting.updatedAt }), "Суудлын тоо харуулах босгыг хадгаллаа."); });
        const qr = q("#public-qr-setting"); const qrSettings = state.data?.publicQrRedirectSettings;
        qr.hidden = !state.canManageAuth || !qrSettings;
        qr.innerHTML = qr.hidden ? "" : `<details><summary>QR холбоос</summary><form id="public-qr-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide">Наран Эрдэм <input id="public-qr-n" type="url" inputmode="url" required value="${escapeHtml(qrSettings.nDestinationUrl)}" /></label><label class="staff-wide">Цэнэг <input id="public-qr-t" type="url" inputmode="url" required value="${escapeHtml(qrSettings.tDestinationUrl)}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#public-qr-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("public-qr-redirect-settings.save", { expectedUpdatedAt: qrSettings.updatedAt, nDestinationUrl: q("#public-qr-n").value, tDestinationUrl: q("#public-qr-t").value }), "QR холбоосыг хадгаллаа."); });
        const dashboard = q("#teacher-dashboard-setting"); const preferences = state.data?.teacherDashboardPreferences;
        dashboard.hidden = !state.canManageAuth || !preferences;
        dashboard.innerHTML = dashboard.hidden ? "" : `<details><summary>Багшийн нүүр хуудас</summary><form id="teacher-dashboard-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide"><input id="show-setup-section" type="checkbox" ${preferences.showSetupSection ? "checked" : ""} /> Сургалтын тохиргоо хэсгийг харуулах</label><label class="staff-wide"><input id="show-registration" type="checkbox" ${preferences.showRegistration ? "checked" : ""} /> Бүртгэл товчийг харуулах</label><label class="staff-wide"><input id="show-information" type="checkbox" ${preferences.showInformation ? "checked" : ""} /> Мэдээлэл товчийг харуулах</label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#teacher-dashboard-form")?.addEventListener("submit", (event) => { event.preventDefault(); run(() => postOverviewAction("teacher-dashboard-preferences.save", { expectedUpdatedAt: preferences.updatedAt, showSetupSection: q("#show-setup-section").checked, showRegistration: q("#show-registration").checked, showInformation: q("#show-information").checked }), "Багшийн нүүр хуудасны тохиргоог хадгаллаа."); });
      }
      async function run(work, success) { message(); try { await work(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      (async () => {
        if (!(await hasSetupAccess())) { show("tool-denied"); return; }
        const session = await (await fetch("/api/staff/session", { credentials: "same-origin" })).json();
        state.canManageAuth = (session.capabilities || []).includes("admin.settings.manage");
        await refresh(); show("tool-app");
      })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
