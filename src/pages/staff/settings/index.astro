---
import { siteIdentity } from "../../../content/homepage";
import "../../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Тохиргоо | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Тохиргоо</span></span></a></header>
    <main class="staff-shell staff-settings-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Тохиргоо</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Тохиргоо</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Ажлын тохиргоо</p><h1>Тохиргоо</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <section id="annual-start-setting" class="staff-operation-section" hidden></section>
        <section id="payment-collection-setting" class="staff-operation-section" hidden></section>
        <section id="payment-confirmation-grace-setting" class="staff-operation-section" hidden></section>
        <section id="public-qr-setting" class="staff-operation-section" hidden></section>
        <section id="teacher-dashboard-setting" class="staff-operation-section" hidden></section>
        <a id="auth-link" class="staff-settings-link" href="/staff/settings/auth/" hidden>Нэвтрэх хугацааны тохиргоо</a>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { getOverview, hasSetupAccess, postOverviewAction } from "../../../scripts/staff-setup.js";

      const state = { data: null, canManageAuth: false };
      const q = (selector) => document.querySelector(selector);
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>\"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") { state.data = await getOverview(); render(); message(success, Boolean(success)); }
      function render() {
        q("#auth-link").hidden = !state.canManageAuth;
        const annualStart = q("#annual-start-setting"); const setting = state.data?.annualCourseStartDefault;
        annualStart.hidden = !state.canManageAuth || !setting;
        annualStart.innerHTML = annualStart.hidden ? "" : `<details><summary>Жилийн сургалтын эхлэх өдрийн анхны утга</summary><form id="annual-start-form" class="staff-compact-form staff-settings-secondary"><label>Сар <input id="annual-start-month" type="number" min="1" max="12" required value="${setting.month}" /></label><label>Өдөр <input id="annual-start-day" type="number" min="1" max="31" required value="${setting.day}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#annual-start-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("annual-course-start-default.save", { month: Number(q("#annual-start-month").value), day: Number(q("#annual-start-day").value), expectedUpdatedAt: setting.updatedAt }), "Жилийн сургалтын эхлэх өдрийн анхны утгыг хадгаллаа."); });
        const payment = q("#payment-collection-setting"); const details = state.data?.paymentCollectionSettings;
        payment.hidden = !details;
        if (details) {
          payment.innerHTML = state.canManageAuth
            ? `<details><summary>Банкны шилжүүлгийн мэдээлэл</summary><form id="payment-collection-form" class="staff-compact-form staff-settings-secondary"><label>Банкны нэр <input id="payment-bank-name" required value="${escapeHtml(details.bankName || "")}" /></label><label>Данс эзэмшигч <input id="payment-account-holder" required value="${escapeHtml(details.accountHolderName || "")}" /></label><label class="staff-wide">Дансны дугаар <input id="payment-account-number" required inputmode="numeric" value="${escapeHtml(details.accountNumber || "")}" /></label><label class="staff-wide">Шилжүүлгийн тайлбар <input id="payment-instruction" maxlength="500" value="${escapeHtml(details.transferInstruction || "")}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`
            : `<details><summary>Банкны шилжүүлгийн мэдээлэл</summary><p>${details.complete ? `${escapeHtml(details.bankName)} · ${escapeHtml(details.accountHolderName)} · ${escapeHtml(details.accountNumber)}` : "Банкны шилжүүлгийн мэдээлэл тохируулаагүй байна."}</p>${details.transferInstruction ? `<p>${escapeHtml(details.transferInstruction)}</p>` : ""}</details>`;
        }
        q("#payment-collection-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("payment-collection-settings.save", { expectedUpdatedAt: details.updatedAt, bankName: q("#payment-bank-name").value, accountHolderName: q("#payment-account-holder").value, accountNumber: q("#payment-account-number").value, transferInstruction: q("#payment-instruction").value }), "Банкны шилжүүлгийн мэдээллийг хадгаллаа."); });
        const grace = q("#payment-confirmation-grace-setting"); const graceSetting = state.data?.paymentConfirmationGrace;
        grace.hidden = !state.canManageAuth || !graceSetting;
        grace.innerHTML = grace.hidden ? "" : `<details><summary>Төлбөр баталгаажуулах засварын хугацаа</summary><form id="payment-grace-form" class="staff-compact-form staff-settings-secondary"><label>Минут <input id="payment-grace-minutes" type="number" min="1" max="60" required value="${graceSetting.graceMinutes}" /></label><p class="staff-muted">Шинэ утга нь дараагийн баталгаажуулалтад үйлчилнэ.</p><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#payment-grace-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("payment-confirmation-grace.save", { graceMinutes: Number(q("#payment-grace-minutes").value), expectedUpdatedAt: graceSetting.updatedAt }), "Засварын хугацааг хадгаллаа."); });
        const qr = q("#public-qr-setting"); const qrSettings = state.data?.publicQrRedirectSettings;
        qr.hidden = !state.canManageAuth || !qrSettings;
        qr.innerHTML = qr.hidden ? "" : `<details><summary>QR холбоос</summary><form id="public-qr-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide">Наран Эрдэм <input id="public-qr-n" type="url" inputmode="url" required value="${escapeHtml(qrSettings.nDestinationUrl)}" /></label><label class="staff-wide">Цэнэг <input id="public-qr-t" type="url" inputmode="url" required value="${escapeHtml(qrSettings.tDestinationUrl)}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#public-qr-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("public-qr-redirect-settings.save", { expectedUpdatedAt: qrSettings.updatedAt, nDestinationUrl: q("#public-qr-n").value, tDestinationUrl: q("#public-qr-t").value }), "QR холбоосыг хадгаллаа."); });
        const dashboard = q("#teacher-dashboard-setting"); const preferences = state.data?.teacherDashboardPreferences;
        dashboard.hidden = !state.canManageAuth || !preferences;
        dashboard.innerHTML = dashboard.hidden ? "" : `<details><summary>Багшийн нүүр хуудас</summary><form id="teacher-dashboard-form" class="staff-compact-form staff-settings-secondary"><label class="staff-wide"><input id="show-setup-section" type="checkbox" ${preferences.showSetupSection ? "checked" : ""} /> Сургалтын тохиргоо хэсгийг харуулах</label><label class="staff-wide"><input id="show-registration" type="checkbox" ${preferences.showRegistration ? "checked" : ""} /> Бүртгэл товчийг харуулах</label><label class="staff-wide"><input id="show-information" type="checkbox" ${preferences.showInformation ? "checked" : ""} /> Мэдээлэл товчийг харуулах</label><div class="staff-form-actions staff-wide"><button class="button secondary" type="submit">Хадгалах</button></div></form></details>`;
        q("#teacher-dashboard-form")?.addEventListener("submit", (event) => { event.preventDefault(); run(() => postOverviewAction("teacher-dashboard-preferences.save", { expectedUpdatedAt: preferences.updatedAt, showSetupSection: q("#show-setup-section").checked, showRegistration: q("#show-registration").checked, showInformation: q("#show-information").checked }), "Багшийн нүүр хуудасны тохиргоог хадгаллаа."); });
      }
      async function run(work, success) { message(); try { await work(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      (async () => {
        if (!(await hasSetupAccess())) { show("tool-denied"); return; }
        const session = await (await fetch("/api/staff/session", { credentials: "same-origin" })).json();
        state.canManageAuth = (session.capabilities || []).includes("admin.settings.manage");
        await refresh(); show("tool-app");
      })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
