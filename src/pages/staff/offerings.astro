---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Сургалт, арга хэмжээ | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Сургалт, арга хэмжээ</span></span></a></header>
    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Сургалт, арга хэмжээ</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Сургалт, арга хэмжээ</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Бүртгэлд санал болгох зүйлс</p><h1>Сургалт, арга хэмжээ</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <div class="staff-section-heading"><p class="staff-muted">Жилийн сургалт, зуны сургалт, нэг удаагийн арга хэмжээг энд бэлтгэнэ.</p><button id="add-offering" class="button primary" type="button">Шинэ сургалт / арга хэмжээ</button></div>
        <div id="offering-editor" class="staff-offering-editor"></div>
        <div id="offering-list" class="staff-offering-list"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, getOverview, hasSetupAccess, postOverviewAction, stageLabel } from "../../scripts/staff-setup.js";

      const state = { data: null, editingId: "", creatingKind: "", editingBreakId: "" };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const kindLabel = (kind) => ({ annual_course: "Жилийн сургалт", summer_course: "Зуны сургалт", event: "Арга хэмжээ" })[kind] || "";
      const chargeLabel = (mode) => mode === "free" ? "Үнэгүй" : "Төлбөртэй";
      const formatDate = (value) => value ? `${Number(value.slice(5, 7))}-р сарын ${Number(value.slice(8, 10))}` : "";
      const offerings = () => (state.data?.offerings || []).filter((entry) => entry.status === "active");
      const occurrenceFor = (offeringId) => (state.data?.eventOccurrences || []).find((entry) => entry.offeringId === offeringId);
      const breaksFor = (offeringId) => (state.data?.offeringBreaks || []).filter((entry) => entry.offeringId === offeringId);
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") { state.data = await getOverview(); render(); message(success, Boolean(success)); }
      function periodText(entry) { const occurrence = occurrenceFor(entry.id); return entry.kind === "event" ? (occurrence ? `${formatDate(occurrence.localDate)} · ${occurrence.startTime}–${occurrence.endTime}` : "Огноо оруулаагүй") : `${formatDate(entry.startsOn)} – ${formatDate(entry.endsOn)}`; }
      function programLabel(program) { return program.programKind === "annual_course" ? `${program.displayName} · ${stageLabel(program.stageCode)} · ${program.academicYearLabel || ""}` : program.displayName; }
      function selectablePrograms(kind, entry) {
        const attached = new Set(offerings().filter((item) => item.id !== entry?.id).map((item) => item.curriculumProgramId).filter(Boolean));
        return (state.data?.programs || []).filter((program) => program.status === "published" && program.programKind === kind && !attached.has(program.id));
      }
      function courseProgramField(entry, kind) {
        const programs = selectablePrograms(kind, entry);
        if (!programs.length && !entry) return `<p class="staff-empty staff-wide">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`;
        return `<label class="staff-wide">Хөтөлбөр <select id="offering-program" required><option value="">Сонгоно уу</option>${programs.map((program) => `<option value="${escape(program.id)}" ${program.id === entry?.curriculumProgramId ? "selected" : ""}>${escape(programLabel(program))}</option>`).join("")}</select></label>`;
      }
      function courseFields(entry, kind) {
        const selected = (state.data?.programs || []).find((program) => program.id === entry?.curriculumProgramId);
        const startsOn = entry?.startsOn || (kind === "annual_course" ? selected?.academicYearStartsOn || "" : "");
        const endsOn = entry?.endsOn || (kind === "annual_course" ? selected?.academicYearEndsOn || "" : "");
        return `<div id="program-summary" class="staff-muted staff-wide" ${kind === "annual_course" && selected ? "" : "hidden"}>${kind === "annual_course" && selected ? `${escape(stageLabel(selected.stageCode))} · ${escape(selected.academicYearLabel || "")}` : ""}</div><label>Төлөвлөсөн эхлэх өдөр <input id="offering-starts" type="date" required value="${escape(startsOn)}" /></label><label>Төлөвлөсөн дуусах өдөр <input id="offering-ends" type="date" required value="${escape(endsOn)}" /></label><label class="staff-wide">Facebook бүлгийн холбоос <input id="offering-facebook" type="url" inputmode="url" value="${escape(entry?.facebookGroupUrl || "")}" /></label>`;
      }
      function annualForm(entry) { if (!entry && !selectablePrograms("annual_course", entry).length) return `<p class="staff-empty">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`; return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="annual_course" />${courseProgramField(entry, "annual_course")}${courseFields(entry, "annual_course")}${formActions()}</form>`; }
      function summerForm(entry) { if (!entry && !selectablePrograms("summer_course", entry).length) return `<p class="staff-empty">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`; return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="summer_course" /><label class="staff-wide">Нэр <input id="offering-title" maxlength="160" required value="${escape(entry?.title || "")}" placeholder="Зуны сургалт" /></label>${courseProgramField(entry, "summer_course")}${courseFields(entry, "summer_course")}${formActions()}</form>`; }
      function eventForm(entry) {
        const occurrence = entry ? occurrenceFor(entry.id) : null;
        return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="event-updated" type="hidden" value="${escape(occurrence?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="event" /><label class="staff-wide">Арга хэмжээний нэр <input id="offering-title" maxlength="160" required value="${escape(entry?.title || "")}" /></label><label>Өдөр <input id="event-date" type="date" required value="${escape(occurrence?.localDate || "")}" /></label><label>Суудлын тоо <input id="event-capacity" type="number" min="1" max="500" required value="${escape(occurrence?.capacity || "12")}" /></label><label>Эхлэх цаг <input id="event-start" type="time" required value="${escape(occurrence?.startTime || "20:00")}" /></label><label>Дуусах цаг <input id="event-end" type="time" required value="${escape(occurrence?.endTime || "22:30")}" /></label><label>Төлбөр <select id="offering-charge"><option value="free" ${entry?.chargeMode !== "paid" ? "selected" : ""}>Үнэгүй</option><option value="paid" ${entry?.chargeMode === "paid" ? "selected" : ""}>Төлбөртэй</option></select></label><label class="staff-wide">Facebook бүлгийн холбоос <input id="offering-facebook" type="url" inputmode="url" value="${escape(entry?.facebookGroupUrl || "")}" /></label><label class="staff-wide">Тайлбар <textarea id="offering-note" rows="3" maxlength="1000">${escape(entry?.note || "")}</textarea></label>${entry ? `<label class="staff-check staff-wide"><input id="event-open" type="checkbox" ${occurrence?.registrationOpen ? "checked" : ""} /> Бүртгэл нээлттэй</label>` : `<p class="staff-muted staff-wide">Шинэ арга хэмжээний бүртгэл анх хаалттай байна.</p>`}${formActions()}${entry ? `<div class="staff-danger-zone staff-wide"><p>Бүртгэл ашиглаагүй арга хэмжээг л устгана.</p><button class="button danger" data-event-delete type="button">Арга хэмжээ устгах</button></div>` : ""}</form>`;
      }
      function formActions() { return `<div class="staff-form-actions staff-wide"><button class="button secondary" data-cancel type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div>`; }
      function breakEditor(entry, offeringId) { return `<form id="offering-break-form" class="staff-compact-form"><label class="staff-wide">Завсарлагын нэр <input id="offering-break-label" required maxlength="160" value="${escape(entry?.label || "")}" /></label><label>Эхлэх өдөр <input id="offering-break-start" type="date" required value="${escape(entry?.startsOn || "")}" /></label><label>Дуусах өдөр <input id="offering-break-end" type="date" required value="${escape(entry?.endsOn || "")}" /></label><label class="staff-wide">Тэмдэглэл <input id="offering-break-note" maxlength="500" value="${escape(entry?.note || "")}" /></label><div class="staff-form-actions staff-wide"><button data-break-cancel class="button secondary" type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div></form>`; }
      function breakSection(entry) {
        if (!entry || entry.kind === "event") return "";
        const breaks = breaksFor(entry.id); const editing = breaks.find((item) => item.id === state.editingBreakId);
        return `<section class="staff-operation-section"><div class="staff-section-heading"><div><h3>Сургалтын завсарлага</h3><p class="staff-muted">Энэ сургалтын бүх ангид хичээл орохгүй.</p></div><button class="button secondary" data-add-break type="button">Завсарлага нэмэх</button></div>${state.editingBreakId ? breakEditor(editing, entry.id) : ""}<div class="staff-record-list">${breaks.length ? breaks.map((item) => `<article><div><strong>${escape(item.label)}</strong><p>${formatDate(item.startsOn)} – ${formatDate(item.endsOn)}${item.note ? ` · ${escape(item.note)}` : ""}</p></div><div class="staff-inline-actions"><button class="button secondary" type="button" data-break-edit="${escape(item.id)}">Засах</button><button class="button secondary" type="button" data-break-remove="${escape(item.id)}">Устгах</button></div></article>`).join("") : `<p class="staff-empty">Завсарлага оруулаагүй байна.</p>`}</div></section>`;
      }
      function renderList() {
        const groups = ["annual_course", "summer_course", "event"].map((kind) => {
          const entries = offerings().filter((entry) => entry.kind === kind); if (!entries.length) return "";
          return `<section class="staff-offering-group"><h2>${kindLabel(kind)}</h2>${entries.map((entry) => `<article class="staff-offering-row"><div><span class="staff-kind-label">${kindLabel(entry.kind)}</span><h3>${escape(entry.title)}</h3><p>${escape(periodText(entry))} · ${chargeLabel(entry.chargeMode)}</p>${entry.kind !== "event" ? `<p>Хөтөлбөр: ${escape(entry.programName || "")}</p>` : ""}</div><div class="staff-inline-actions">${entry.kind !== "event" ? `<a class="button secondary" href="/staff/programs/?program=${encodeURIComponent(entry.curriculumProgramId)}">Хөтөлбөр</a>` : ""}${entry.kind !== "event" ? `<a class="button secondary" href="/staff/schedule/?offering=${encodeURIComponent(entry.id)}">Хуваарь</a>` : ""}<button class="button secondary" type="button" data-edit-offering="${escape(entry.id)}">Засах</button></div></article>`).join("")}</section>`;
        }).join("");
        q("#offering-list").innerHTML = groups || `<p class="staff-empty">Сургалт, арга хэмжээ оруулаагүй байна.</p>`;
        q("#offering-list").querySelectorAll("[data-edit-offering]").forEach((button) => button.onclick = () => { state.editingId = button.dataset.editOffering; state.creatingKind = ""; state.editingBreakId = ""; renderEditor(); q("#offering-editor").scrollIntoView({ behavior: "smooth", block: "start" }); });
      }
      function syncCourseProgram(kind) {
        const select = q("#offering-program"); const program = (state.data?.programs || []).find((item) => item.id === select?.value); const summary = q("#program-summary");
        if (summary) { summary.hidden = !program || kind !== "annual_course"; summary.textContent = program && kind === "annual_course" ? `${stageLabel(program.stageCode)} · ${program.academicYearLabel || ""}` : ""; }
        if (program && kind === "annual_course") { if (!q("#offering-starts").value) q("#offering-starts").value = program.academicYearStartsOn || ""; if (!q("#offering-ends").value) q("#offering-ends").value = program.academicYearEndsOn || ""; }
      }
      function renderEditor() {
        const container = q("#offering-editor"); const entry = offerings().find((item) => item.id === state.editingId);
        if (!entry && !state.creatingKind) { container.innerHTML = ""; return; }
        if (!entry && state.creatingKind === "choose") { container.innerHTML = `<section class="staff-operation-section"><h2>Төрлөө сонгоно уу</h2><div class="staff-kind-choices"><button class="button secondary" data-kind="annual_course" type="button">Жилийн сургалт</button><button class="button secondary" data-kind="summer_course" type="button">Зуны сургалт</button><button class="button secondary" data-kind="event" type="button">Арга хэмжээ</button></div><button class="button secondary" data-cancel type="button">Болих</button></section>`; container.querySelectorAll("[data-kind]").forEach((button) => button.onclick = () => { state.creatingKind = button.dataset.kind; renderEditor(); }); container.querySelector("[data-cancel]").onclick = closeEditor; return; }
        const kind = entry?.kind || state.creatingKind;
        container.innerHTML = `<section class="staff-operation-section"><div class="staff-section-heading"><div><span class="staff-kind-label">${kindLabel(kind)}</span><h2>${entry ? "Мэдээлэл засах" : "Шинээр нэмэх"}</h2></div></div>${kind === "annual_course" ? annualForm(entry) : kind === "summer_course" ? summerForm(entry) : eventForm(entry)}</section>${breakSection(entry)}`;
        container.querySelector("[data-cancel]")?.addEventListener("click", closeEditor);
        container.querySelector("#offering-form")?.addEventListener("submit", saveOffering);
        if (kind !== "event") { q("#offering-program")?.addEventListener("change", () => syncCourseProgram(kind)); syncCourseProgram(kind); }
        container.querySelector("[data-event-delete]")?.addEventListener("click", () => { if (entry && window.confirm("Энэ арга хэмжээг устгах уу?")) run(() => postOverviewAction("offering-event.delete", { offeringId: entry.id, expectedUpdatedAt: entry.updatedAt }), "Арга хэмжээг устгалаа."); });
        container.querySelector("[data-add-break]")?.addEventListener("click", () => { state.editingBreakId = "new"; renderEditor(); q("#offering-break-label").focus(); });
        container.querySelector("[data-break-cancel]")?.addEventListener("click", () => { state.editingBreakId = ""; renderEditor(); });
        container.querySelectorAll("[data-break-edit]").forEach((button) => button.onclick = () => { state.editingBreakId = button.dataset.breakEdit; renderEditor(); q("#offering-break-label").focus(); });
        container.querySelectorAll("[data-break-remove]").forEach((button) => button.onclick = () => { const item = breaksFor(entry.id).find((breakEntry) => breakEntry.id === button.dataset.breakRemove); if (item && window.confirm("Энэ завсарлагыг устгах уу?")) run(() => postOverviewAction("offering-break.remove", { breakId: item.id, expectedUpdatedAt: item.updatedAt }), "Завсарлагыг устгалаа."); });
        container.querySelector("#offering-break-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const saved = breaksFor(entry.id).find((item) => item.id === state.editingBreakId); run(() => postOverviewAction("offering-break.save", { id: saved?.id, expectedUpdatedAt: saved?.updatedAt, offeringId: entry.id, label: q("#offering-break-label").value, startsOn: q("#offering-break-start").value, endsOn: q("#offering-break-end").value, note: q("#offering-break-note").value }), "Завсарлагыг хадгаллаа."); });
      }
      function closeEditor() { state.editingId = ""; state.creatingKind = ""; state.editingBreakId = ""; renderEditor(); }
      function saveOffering(event) { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const kind = q("#offering-kind").value; const id = q("#offering-id").value; const payload = { action: "offering.save", id: id || undefined, expectedUpdatedAt: q("#offering-updated").value || undefined, kind, title: q("#offering-title")?.value, curriculumProgramId: q("#offering-program")?.value, startsOn: q("#offering-starts")?.value, endsOn: q("#offering-ends")?.value, facebookGroupUrl: q("#offering-facebook")?.value || "" }; if (kind === "event") Object.assign(payload, { eventExpectedUpdatedAt: q("#event-updated").value || undefined, eventDate: q("#event-date").value, eventStartTime: q("#event-start").value, eventEndTime: q("#event-end").value, eventCapacity: Number(q("#event-capacity").value), eventRegistrationOpen: Boolean(q("#event-open")?.checked), chargeMode: q("#offering-charge").value, note: q("#offering-note").value }); run(() => postOverviewAction(payload.action, payload), id ? "Мэдээллийг хадгаллаа." : "Шинээр нэмлээ. Бүртгэл анх хаалттай байна."); }
      async function run(work, success) { message(); try { await work(); state.editingBreakId = ""; closeEditor(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      function render() { renderList(); renderEditor(); }
      q("#add-offering").onclick = () => { state.editingId = ""; state.creatingKind = "choose"; state.editingBreakId = ""; renderEditor(); };
      (async () => { if (!(await hasSetupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
