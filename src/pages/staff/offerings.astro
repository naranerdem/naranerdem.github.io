---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Сургалт, арга хэмжээ | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Сургалт, арга хэмжээ</span></span></a></header>
    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Сургалт, арга хэмжээ</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Сургалт, арга хэмжээ</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Бүртгэлд санал болгох зүйлс</p><h1>Сургалт, арга хэмжээ</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <p class="staff-muted">Жилийн сургалт, зуны сургалт, нэг удаагийн арга хэмжээг энд бэлтгэнэ.</p>
        <div id="offering-list" class="staff-offering-list"></div>
        <div class="staff-section-heading"><button id="add-offering" class="button primary" type="button">Шинэ сургалт / арга хэмжээ</button></div>
        <div id="offering-editor" class="staff-offering-editor"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, getOverview, hasSetupAccess, postOverviewAction, stageLabel } from "../../scripts/staff-setup.js";

      const params = new URLSearchParams(location.search);
      const state = { data: null, editingId: params.get("offering") || "", creatingKind: "", editingClass: "", initialClasses: [], creationDraft: {}, confirmingCourseDelete: false };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const kindLabel = (kind) => ({ annual_course: "Жилийн сургалт", summer_course: "Зуны сургалт", event: "Арга хэмжээ" })[kind] || "";
      const chargeLabel = (mode) => mode === "free" ? "Үнэгүй" : "Төлбөртэй";
      const formatDate = (value) => value ? `${Number(value.slice(5, 7))}-р сарын ${Number(value.slice(8, 10))}` : "";
      const offerings = () => (state.data?.offerings || []).filter((entry) => entry.status === "active");
      const classes = (offeringId) => (state.data?.classes || []).filter((entry) => entry.offeringId === offeringId);
      const occurrenceFor = (offeringId) => (state.data?.eventOccurrences || []).find((entry) => entry.offeringId === offeringId);
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") { state.data = await getOverview(); render(); message(success, Boolean(success)); }
      function periodText(entry) { const occurrence = occurrenceFor(entry.id); return entry.kind === "event" ? (occurrence ? `${formatDate(occurrence.localDate)} · ${occurrence.startTime}–${occurrence.endTime}` : "Огноо оруулаагүй") : entry.kind === "annual_course" ? formatDate(entry.startsOn) : `${formatDate(entry.startsOn)} – ${formatDate(entry.endsOn)}`; }
      const programFamilies = () => (state.data?.programFamilies || []).filter((family) => family.status === "active");
      const selectableFamilies = (kind) => programFamilies().filter((family) => family.kind === kind && family.currentProgram);
      function courseProgramField(entry, kind) {
        if (entry) return `<p class="staff-muted staff-wide">${kind === "annual_course" ? `Шат: ${escape(stageLabel(entry.stageCode))}` : `Хөтөлбөр: ${escape(entry.programFamilyName || entry.programName || "")}`}</p>`;
        const families = selectableFamilies(kind);
        if (!families.length) return `<p class="staff-empty staff-wide">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`;
        if (kind === "annual_course") {
          const selected = entry?.stageCode || state.creationDraft.annualStageCode || "";
          return `<label class="staff-wide">Шат <select id="offering-annual-stage" required><option value="">Сонгоно уу</option>${families.map((family) => `<option value="${escape(family.annualStageCode)}" ${family.annualStageCode === selected ? "selected" : ""}>${escape(stageLabel(family.annualStageCode))}</option>`).join("")}</select></label>`;
        }
        const selected = entry?.programFamilyId || state.creationDraft.programFamilyId || "";
        return `<label class="staff-wide">Хөтөлбөр <select id="offering-program-family" required><option value="">Сонгоно уу</option>${families.map((family) => `<option value="${escape(family.id)}" ${family.id === selected ? "selected" : ""}>${escape(family.displayName)}</option>`).join("")}</select></label>`;
      }
      function annualDefaultDate() {
        const year = (state.data?.years || []).find((entry) => entry.isCurrent && entry.startsOn && entry.endsOn);
        const setting = state.data?.annualCourseStartDefault || { month: 10, day: 1 };
        if (year) return `${year.startsOn.slice(0, 4)}-${String(setting.month).padStart(2, "0")}-${String(setting.day).padStart(2, "0")}`;
        const today = new Date(); const month = String(setting.month).padStart(2, "0"); const day = String(setting.day).padStart(2, "0");
        const candidate = `${today.getFullYear()}-${month}-${day}`;
        return candidate >= today.toISOString().slice(0, 10) ? candidate : `${today.getFullYear() + 1}-${month}-${day}`;
      }
      function captureCreationDraft() {
        if (state.editingId || !["annual_course", "summer_course"].includes(state.creatingKind)) return;
        const value = (selector) => q(selector)?.value;
        state.creationDraft = {
          ...state.creationDraft,
          title: value("#offering-title") ?? state.creationDraft.title ?? "",
          annualStageCode: value("#offering-annual-stage") ?? state.creationDraft.annualStageCode ?? "",
          programFamilyId: value("#offering-program-family") ?? state.creationDraft.programFamilyId ?? "",
          startsOn: value("#offering-starts") ?? state.creationDraft.startsOn ?? "",
          endsOn: value("#offering-ends") ?? state.creationDraft.endsOn ?? "",
          defaultClassDurationMinutes: value("#offering-duration") ?? state.creationDraft.defaultClassDurationMinutes ?? "",
          facebookGroupUrl: value("#offering-facebook") ?? state.creationDraft.facebookGroupUrl ?? "",
        };
        state.initialClasses = state.initialClasses.map((entry, index) => ({
          recurrenceKind: value(`[data-initial-recurrence="${index}"]`) || entry.recurrenceKind,
          weeklyWeekday: value(`[data-initial-weekday="${index}"]`) || entry.weeklyWeekday,
          startTime: value(`[data-initial-start="${index}"]`) || entry.startTime,
          capacity: Number(value(`[data-initial-capacity="${index}"]`) || entry.capacity),
        }));
      }
      function courseFields(entry, kind) {
        const startsOn = entry?.startsOn || state.creationDraft.startsOn || (kind === "annual_course" ? annualDefaultDate() : "");
        const duration = entry?.defaultClassDurationMinutes || state.creationDraft.defaultClassDurationMinutes || (kind === "annual_course" && entry?.stageCode === "stage_3" ? 105 : 80);
        const facebook = `<label class="staff-wide">Facebook бүлгийн холбоос <input id="offering-facebook" type="url" inputmode="url" value="${escape(entry?.facebookGroupUrl || state.creationDraft.facebookGroupUrl || "")}" /><small>Хоосон орхиж болно.</small></label>`;
        const durationField = `<label>Хичээлийн үргэлжлэх хугацаа (минут) <input id="offering-duration" type="number" min="15" max="360" required value="${duration}" /></label>`;
        if (kind === "annual_course") return `<label>Эхлэх өдөр <input id="offering-starts" type="date" required value="${escape(startsOn)}" /></label>${durationField}${facebook}`;
        return `<label>Төлөвлөсөн эхлэх өдөр <input id="offering-starts" type="date" required value="${escape(startsOn)}" /></label><label>Төлөвлөсөн дуусах өдөр <input id="offering-ends" type="date" required value="${escape(entry?.endsOn || state.creationDraft.endsOn || "")}" /></label>${durationField}${facebook}`;
      }
      function initialClassEditor(kind) {
        if (state.editingId) return "";
        const rows = state.initialClasses.map((entry, index) => `<div class="staff-form-grid staff-wide"><label>Давтамж <select data-initial-recurrence="${index}"><option value="weekly" ${entry.recurrenceKind === "weekly" ? "selected" : ""}>7 хоног бүр</option><option value="weekdays" ${entry.recurrenceKind === "weekdays" ? "selected" : ""}>Ажлын өдрүүдэд</option><option value="daily" ${entry.recurrenceKind === "daily" ? "selected" : ""}>Өдөр бүр</option></select></label><label data-initial-weekday-wrap="${index}" ${entry.recurrenceKind === "weekly" ? "" : "hidden"}>Гараг <select data-initial-weekday="${index}">${(state.data.weekdays || []).map((weekday) => `<option value="${escape(weekday)}" ${entry.weeklyWeekday === weekday ? "selected" : ""}>${escape(weekday)}</option>`).join("")}</select></label><label>Эхлэх цаг <input data-initial-start="${index}" type="time" required value="${escape(entry.startTime)}" /></label><label>Суудлын тоо <input data-initial-capacity="${index}" type="number" min="1" max="80" required value="${entry.capacity}" /></label><button class="staff-text-action" type="button" data-remove-initial-class="${index}">Хасах</button></div>`).join("");
        return `<section class="staff-operation-section staff-wide"><div class="staff-section-heading"><h2>Ангиуд</h2></div>${rows}<button id="add-initial-class" class="button secondary" type="button">Анги нэмэх</button></section>`;
      }
      function courseDeleteControl(entry) { if (!entry?.canDelete) return ""; return `<div class="staff-danger-zone staff-wide">${state.confirmingCourseDelete ? `<p>Энэ сургалт ашиглагдаагүй тул ангиуд болон тохиргооны хамт бүрмөсөн устна.</p><div class="staff-form-actions"><button class="button secondary" data-course-delete-cancel type="button">Болих</button><button class="button danger" data-course-delete-confirm type="button">Сургалтыг устгах</button></div>` : `<p>Энэ сургалт анги, хуваарь, бүртгэлд ашиглагдаагүй үед л устгах боломжтой.</p><button class="button danger" data-course-delete type="button">Сургалт устгах</button>`}</div>`; }
      function annualForm(entry) { if (!entry && !selectableFamilies("annual_course").length) return `<p class="staff-empty">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`; return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="annual_course" />${courseProgramField(entry, "annual_course")}${courseFields(entry, "annual_course")}${initialClassEditor("annual_course")}${formActions()}${courseDeleteControl(entry)}</form>`; }
      function summerForm(entry) { if (!entry && !selectableFamilies("summer_course").length) return `<p class="staff-empty">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`; return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="summer_course" /><label class="staff-wide">Нэр <input id="offering-title" maxlength="160" required value="${escape(entry?.title || "")}" placeholder="Зуны сургалт" /></label>${courseProgramField(entry, "summer_course")}${courseFields(entry, "summer_course")}${initialClassEditor("summer_course")}${formActions()}${courseDeleteControl(entry)}</form>`; }
      function eventForm(entry) {
        const occurrence = entry ? occurrenceFor(entry.id) : null;
        return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="event-updated" type="hidden" value="${escape(occurrence?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="event" /><label class="staff-wide">Арга хэмжээний нэр <input id="offering-title" maxlength="160" required value="${escape(entry?.title || "")}" /></label><label>Өдөр <input id="event-date" type="date" required value="${escape(occurrence?.localDate || "")}" /></label><label>Суудлын тоо <input id="event-capacity" type="number" min="1" max="500" required value="${escape(occurrence?.capacity || "12")}" /></label><label>Эхлэх цаг <input id="event-start" type="time" required value="${escape(occurrence?.startTime || "20:00")}" /></label><label>Дуусах цаг <input id="event-end" type="time" required value="${escape(occurrence?.endTime || "22:30")}" /></label><label>Төлбөр <select id="offering-charge"><option value="free" ${entry?.chargeMode !== "paid" ? "selected" : ""}>Үнэгүй</option><option value="paid" ${entry?.chargeMode === "paid" ? "selected" : ""}>Төлбөртэй</option></select></label><label class="staff-wide">Facebook бүлгийн холбоос <input id="offering-facebook" type="url" inputmode="url" value="${escape(entry?.facebookGroupUrl || "")}" /><small>Хоосон орхиж болно.</small></label><label class="staff-wide">Тайлбар <textarea id="offering-note" rows="3" maxlength="1000">${escape(entry?.note || "")}</textarea></label>${entry ? `<label class="staff-check staff-wide"><input id="event-open" type="checkbox" ${occurrence?.registrationOpen ? "checked" : ""} /> Бүртгэл нээлттэй</label>` : `<p class="staff-muted staff-wide">Шинэ арга хэмжээний бүртгэл анх хаалттай байна.</p>`}${formActions()}${entry ? `<div class="staff-danger-zone staff-wide"><p>Бүртгэл ашиглаагүй арга хэмжээг л устгана.</p><button class="button danger" data-event-delete type="button">Арга хэмжээ устгах</button></div>` : ""}</form>`;
      }
      function formActions() { return `<div class="staff-form-actions staff-wide"><button class="button secondary" data-cancel type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div>`; }
      function classForm(entry, offering) {
        const recurrence = entry?.recurrenceKind || (offering.kind === "summer_course" ? "daily" : "weekly");
        const firstDate = entry?.firstDate || offering.startsOn || "";
        return `<form id="class-form" class="staff-compact-form"><input id="class-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="class-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><label>Давтамж <select id="class-recurrence"><option value="weekly" ${recurrence === "weekly" ? "selected" : ""}>7 хоног бүр</option><option value="weekdays" ${recurrence === "weekdays" ? "selected" : ""}>Ажлын өдрүүдэд</option><option value="daily" ${recurrence === "daily" ? "selected" : ""}>Өдөр бүр</option></select></label><label id="weekly-field">Гараг <select id="class-weekday">${(state.data.weekdays || []).map((weekday) => `<option value="${escape(weekday)}" ${entry?.weeklyWeekday === weekday || (!entry && weekday === "Бямба") ? "selected" : ""}>${escape(weekday)}</option>`).join("")}</select></label><label>Эхлэх өдөр <input id="class-first" type="date" required value="${escape(firstDate)}" /></label><label>Эхлэх цаг <input id="class-start" type="time" required value="${escape(entry?.startTime || "10:00")}" /></label>${entry ? `<p class="staff-muted">Дуусах цаг: ${escape(entry.endTime)}</p>` : ""}<label>Суудлын тоо <input id="class-capacity" type="number" min="1" max="80" required value="${escape(entry?.capacity || "12")}" /></label>${entry ? `<label class="staff-check"><input id="class-open" type="checkbox" ${entry.registrationOpen ? "checked" : ""} /> Бүртгэл нээлттэй</label>` : `<p class="staff-muted">Шинэ ангийн бүртгэл анх хаалттай байна.</p>`}<div class="staff-form-actions staff-wide"><button class="button secondary" data-class-cancel type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div>${entry?.canDelete ? `<div class="staff-danger-zone staff-wide"><p>Энэ анги хуваарь, бүртгэлд ашиглагдаагүй байна.</p><button class="button danger" data-class-delete type="button">Анги устгах</button></div>` : ""}</form>`;
      }
      function updateRecurrenceField() { const weekly = q("#class-recurrence")?.value === "weekly"; const field = q("#weekly-field"); const select = q("#class-weekday"); if (field) field.hidden = !weekly; if (select) select.disabled = !weekly; }
      function classManagement(entry) {
        const offeringClasses = classes(entry.id); const editing = offeringClasses.find((item) => item.id === state.editingClass);
        return `<section class="staff-operation-section" aria-labelledby="classes-title"><div class="staff-section-heading"><div><h2 id="classes-title">Ангиуд</h2><p class="staff-muted">${escape(entry.title)}</p></div><button class="button secondary" type="button" data-add-class>Анги нэмэх</button></div><div id="class-editor">${state.editingClass ? classForm(editing, entry) : ""}</div><div id="class-list" class="staff-record-list">${offeringClasses.length ? offeringClasses.map((item) => `<article><div><strong>${escape(item.displayLabel)}</strong><p>${({ weekly: "7 хоног бүр", weekdays: "Ажлын өдрүүдэд", daily: "Өдөр бүр" })[item.recurrenceKind] || ""} · ${escape(item.startTime)}–${escape(item.endTime)} · ${item.capacity} суудал · ${item.registrationOpen ? "Бүртгэл нээлттэй" : "Бүртгэл хаалттай"}</p></div><button class="button secondary" type="button" data-class-edit="${escape(item.id)}">Засах</button></article>`).join("") : `<p class="staff-empty">Анги оруулаагүй байна.</p>`}</div></section>`;
      }
      function pricingSection(entry) {
        const enabled = Boolean(entry.twoInstallmentEnabled);
        return `<section class="staff-operation-section" aria-labelledby="pricing-title"><div class="staff-section-heading"><div><h2 id="pricing-title">Төлбөрийн нөхцөл</h2><p class="staff-muted">Шинэ бүртгэлд үйлчилнэ.</p></div></div><form id="pricing-form" class="staff-compact-form"><input id="pricing-updated" type="hidden" value="${escape(entry.pricingUpdatedAt || "")}" /><label>Нэг удаа төлөх <input id="pricing-single" type="number" min="1" step="1" inputmode="numeric" required value="${escape(entry.oneTimeAmountMnt || "")}" /> ₮</label><label class="staff-check staff-wide"><input id="pricing-two-enabled" type="checkbox" ${enabled ? "checked" : ""} /> 2 хувааж төлөх</label><div id="pricing-two-fields" class="staff-form-grid staff-wide" ${enabled ? "" : "hidden"}><label>Эхний төлбөр <input id="pricing-first" type="number" min="1" step="1" inputmode="numeric" value="${escape(entry.firstInstallmentAmountMnt || "")}" /> ₮</label><label>Хоёр дахь төлбөр <input id="pricing-second" type="number" min="1" step="1" inputmode="numeric" value="${escape(entry.secondInstallmentAmountMnt || "")}" /> ₮</label><label class="staff-wide">Хоёр дахь төлбөрийн хугацаа <input id="pricing-due" type="date" value="${escape(entry.secondInstallmentDueOn || "")}" /></label></div><div class="staff-form-actions staff-wide"><button class="button primary" type="submit">Хадгалах</button></div></form></section>`;
      }
      function renderList() {
        const groups = ["annual_course", "summer_course", "event"].map((kind) => {
          const entries = offerings().filter((entry) => entry.kind === kind); if (!entries.length) return "";
          return `<section class="staff-offering-group"><h2>${kindLabel(kind)}</h2>${entries.map((entry) => `<article class="staff-offering-row"><div><span class="staff-kind-label">${kindLabel(entry.kind)}</span><h3>${escape(entry.title)}</h3><p>${escape(periodText(entry))} · ${chargeLabel(entry.chargeMode)}</p>${entry.kind !== "event" ? `<p>Хөтөлбөр: ${escape(entry.programFamilyName || entry.programName || "")}</p>` : ""}</div><div class="staff-inline-actions">${entry.kind !== "event" ? `<a class="button secondary" href="/staff/programs/?family=${encodeURIComponent(entry.programFamilyId)}">Хөтөлбөр</a>` : ""}${entry.kind !== "event" ? `<a class="button secondary" href="/staff/schedule/?offering=${encodeURIComponent(entry.id)}">Хуваарь</a>` : ""}<button class="button secondary" type="button" data-edit-offering="${escape(entry.id)}">Засах</button></div></article>`).join("")}</section>`;
        }).join("");
        q("#offering-list").innerHTML = groups || `<p class="staff-empty">Сургалт, арга хэмжээ оруулаагүй байна.</p>`;
        q("#offering-list").querySelectorAll("[data-edit-offering]").forEach((button) => button.onclick = () => { state.editingId = button.dataset.editOffering; state.creatingKind = ""; state.editingClass = ""; state.confirmingCourseDelete = false; history.replaceState(null, "", `?offering=${encodeURIComponent(state.editingId)}`); renderEditor(); q("#offering-editor").scrollIntoView({ behavior: "smooth", block: "start" }); });
      }
      function renderEditor() {
        const container = q("#offering-editor"); const entry = offerings().find((item) => item.id === state.editingId);
        if (!entry && !state.creatingKind) { container.innerHTML = ""; return; }
        if (!entry && state.creatingKind === "choose") { container.innerHTML = `<section class="staff-operation-section"><h2>Төрлөө сонгоно уу</h2><div class="staff-kind-choices"><button class="button secondary" data-kind="annual_course" type="button">Жилийн сургалт</button><button class="button secondary" data-kind="summer_course" type="button">Зуны сургалт</button><button class="button secondary" data-kind="event" type="button">Арга хэмжээ</button></div><button class="button secondary" data-cancel type="button">Болих</button></section>`; container.querySelectorAll("[data-kind]").forEach((button) => button.onclick = () => { state.creatingKind = button.dataset.kind; renderEditor(); }); container.querySelector("[data-cancel]").onclick = closeEditor; return; }
        const kind = entry?.kind || state.creatingKind;
        container.innerHTML = `<section class="staff-operation-section"><div class="staff-section-heading"><div><span class="staff-kind-label">${kindLabel(kind)}</span><h2>${entry ? "Мэдээлэл засах" : "Шинээр нэмэх"}</h2></div></div>${kind === "annual_course" ? annualForm(entry) : kind === "summer_course" ? summerForm(entry) : eventForm(entry)}</section>${entry && kind !== "event" ? `${classManagement(entry)}${pricingSection(entry)}` : ""}`;
        container.querySelector("[data-cancel]")?.addEventListener("click", closeEditor);
        container.querySelector("#offering-form")?.addEventListener("submit", saveOffering);
        container.querySelector("#pricing-two-enabled")?.addEventListener("change", (event) => {
          const enabled = event.currentTarget.checked; const fields = q("#pricing-two-fields"); fields.hidden = !enabled;
          fields.querySelectorAll("input").forEach((input) => { input.disabled = !enabled; input.required = enabled; });
        });
        container.querySelector("#pricing-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const enabled = q("#pricing-two-enabled").checked; runPricing(() => postOverviewAction("offering-course-pricing.save", { offeringId: entry.id, expectedUpdatedAt: q("#pricing-updated").value || null, oneTimeAmountMnt: Number(q("#pricing-single").value), twoInstallmentEnabled: enabled, firstInstallmentAmountMnt: enabled ? Number(q("#pricing-first").value) : null, secondInstallmentAmountMnt: enabled ? Number(q("#pricing-second").value) : null, secondInstallmentDueOn: enabled ? q("#pricing-due").value : null }), "Төлбөрийн нөхцөлийг хадгаллаа."); });
        container.querySelector("[data-event-delete]")?.addEventListener("click", () => { if (entry && window.confirm("Энэ арга хэмжээг устгах уу?")) run(() => postOverviewAction("offering-event.delete", { offeringId: entry.id, expectedUpdatedAt: entry.updatedAt }), "Арга хэмжээг устгалаа."); });
        container.querySelector("[data-course-delete]")?.addEventListener("click", () => { state.confirmingCourseDelete = true; renderEditor(); });
        container.querySelector("[data-course-delete-cancel]")?.addEventListener("click", () => { state.confirmingCourseDelete = false; renderEditor(); });
        container.querySelector("[data-course-delete-confirm]")?.addEventListener("click", () => { if (entry) run(() => postOverviewAction("offering-course.delete", { offeringId: entry.id, expectedUpdatedAt: entry.updatedAt }), "Сургалт болон ашиглагдаагүй ангиудыг устгалаа."); });
        container.querySelector("#add-initial-class")?.addEventListener("click", () => {
          captureCreationDraft();
          state.initialClasses.push({ recurrenceKind: kind === "summer_course" ? "daily" : "weekly", weeklyWeekday: "Бямба", startTime: "10:00", capacity: 12 });
          renderEditor();
        });
        container.querySelectorAll("[data-remove-initial-class]").forEach((button) => button.onclick = () => {
          captureCreationDraft();
          state.initialClasses.splice(Number(button.dataset.removeInitialClass), 1); renderEditor();
        });
        container.querySelectorAll("[data-initial-recurrence]").forEach((select) => select.onchange = () => {
          captureCreationDraft();
          state.initialClasses[Number(select.dataset.initialRecurrence)].recurrenceKind = select.value; renderEditor();
        });
        container.querySelectorAll("[data-initial-weekday]").forEach((select) => select.onchange = () => { state.initialClasses[Number(select.dataset.initialWeekday)].weeklyWeekday = select.value; });
        container.querySelectorAll("[data-initial-start]").forEach((input) => input.onchange = () => { state.initialClasses[Number(input.dataset.initialStart)].startTime = input.value; });
        container.querySelectorAll("[data-initial-capacity]").forEach((input) => input.onchange = () => { state.initialClasses[Number(input.dataset.initialCapacity)].capacity = Number(input.value); });
        container.querySelector("#offering-annual-stage")?.addEventListener("change", (event) => {
          if (!entry) q("#offering-duration").value = event.currentTarget.value === "stage_3" ? "105" : "80";
          captureCreationDraft();
        });
        container.querySelector("[data-add-class]")?.addEventListener("click", () => { state.editingClass = "new"; renderEditor(); q("#class-recurrence")?.focus(); });
        container.querySelector("[data-class-cancel]")?.addEventListener("click", () => { state.editingClass = ""; renderEditor(); });
        container.querySelector("#class-recurrence")?.addEventListener("change", updateRecurrenceField); updateRecurrenceField();
        container.querySelectorAll("[data-class-edit]").forEach((button) => button.onclick = () => { state.editingClass = button.dataset.classEdit; renderEditor(); q("#class-recurrence")?.focus(); });
        container.querySelector("[data-class-delete]")?.addEventListener("click", () => { const selected = classes(entry.id).find((item) => item.id === state.editingClass); if (selected && window.confirm(`${selected.displayLabel} ангийг бүрмөсөн устгах уу?`)) runClass(() => postOverviewAction("class.delete", { classSessionId: selected.id, expectedUpdatedAt: selected.updatedAt }), "Ангийг устгалаа."); });
        container.querySelector("#class-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const id = q("#class-id").value; runClass(() => postOverviewAction("class.save", { id: id || undefined, expectedUpdatedAt: q("#class-updated").value || undefined, offeringId: entry.id, recurrenceKind: q("#class-recurrence").value, firstDate: q("#class-first").value, lastDate: undefined, weeklyWeekday: q("#class-weekday").disabled ? null : q("#class-weekday").value, startTime: q("#class-start").value, endTime: q("#class-end")?.value, capacity: Number(q("#class-capacity").value), registrationOpen: Boolean(q("#class-open")?.checked) }), id ? "Ангийг хадгаллаа." : "Ангийг үүслээ. Бүртгэл анх хаалттай байна."); });
      }
      function closeEditor() { state.editingId = ""; state.creatingKind = ""; state.editingClass = ""; state.initialClasses = []; state.creationDraft = {}; state.confirmingCourseDelete = false; history.replaceState(null, "", location.pathname); renderEditor(); }
      function saveOffering(event) { event.preventDefault(); captureCreationDraft(); if (!event.currentTarget.reportValidity()) return; const kind = q("#offering-kind").value; const id = q("#offering-id").value; const payload = { action: "offering.save", id: id || undefined, expectedUpdatedAt: q("#offering-updated").value || undefined, kind, title: q("#offering-title")?.value, annualStageCode: q("#offering-annual-stage")?.value, programFamilyId: q("#offering-program-family")?.value, startsOn: q("#offering-starts")?.value, endsOn: q("#offering-ends")?.value, defaultClassDurationMinutes: Number(q("#offering-duration")?.value), initialClasses: id ? undefined : state.initialClasses, facebookGroupUrl: q("#offering-facebook")?.value || "" }; if (kind === "event") Object.assign(payload, { eventExpectedUpdatedAt: q("#event-updated").value || undefined, eventDate: q("#event-date").value, eventStartTime: q("#event-start").value, eventEndTime: q("#event-end").value, eventCapacity: Number(q("#event-capacity").value), eventRegistrationOpen: Boolean(q("#event-open")?.checked), chargeMode: q("#offering-charge").value, note: q("#offering-note").value }); run(() => postOverviewAction(payload.action, payload), id ? "Мэдээллийг хадгаллаа." : "Шинээр нэмлээ. Бүртгэл анх хаалттай байна."); }
      async function run(work, success) { message(); try { await work(); closeEditor(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      async function runPricing(work, success) { message(); try { await work(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      async function runClass(work, success) {
        message();
        try {
          await work();
          state.editingClass = "";
          await refresh(success);
        } catch (error) {
          // Never leave a failed local edit looking like a saved class value.
          state.editingClass = "";
          try { await refresh(); } catch { render(); }
          message(`Ангийн мэдээлэл хадгалагдсангүй. ${error.message || "Дахин оролдоно уу."}`);
        }
      }
      function render() { renderList(); renderEditor(); }
      q("#add-offering").onclick = () => { state.editingId = ""; state.creationDraft = {}; state.creatingKind = "choose"; renderEditor(); };
      (async () => { if (!(await hasSetupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
