---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Сургалт, арга хэмжээ | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Сургалт, арга хэмжээ</span></span></a></header>
    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Сургалт, арга хэмжээ</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Сургалт, арга хэмжээ</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Бүртгэлд санал болгох зүйлс</p><h1>Сургалт, арга хэмжээ</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <div class="staff-section-heading"><p class="staff-muted">Жилийн сургалт, зуны сургалт, нэг удаагийн арга хэмжээг энд бэлтгэнэ.</p><button id="add-offering" class="button primary" type="button">Шинэ сургалт / арга хэмжээ</button></div>
        <div id="offering-editor" class="staff-offering-editor"></div>
        <div id="offering-list" class="staff-offering-list"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, getOverview, hasSetupAccess, postOverviewAction, stageLabel } from "../../scripts/staff-setup.js";

      const state = { data: null, editingId: "", creatingKind: "" };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const kindLabel = (kind) => ({ annual_course: "Жилийн сургалт", summer_course: "Зуны сургалт", event: "Арга хэмжээ" })[kind] || "";
      const chargeLabel = (mode) => mode === "free" ? "Үнэгүй" : "Төлбөртэй";
      const formatDate = (value) => value ? `${Number(value.slice(5, 7))}-р сарын ${Number(value.slice(8, 10))}` : "";
      const offerings = () => (state.data?.offerings || []).filter((entry) => entry.status === "active");
      const occurrenceFor = (offeringId) => (state.data?.eventOccurrences || []).find((entry) => entry.offeringId === offeringId);
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") { state.data = await getOverview(); render(); message(success, Boolean(success)); }
      function periodText(entry) { const occurrence = occurrenceFor(entry.id); return entry.kind === "event" ? (occurrence ? `${formatDate(occurrence.localDate)} · ${occurrence.startTime}–${occurrence.endTime}` : "Огноо оруулаагүй") : entry.kind === "annual_course" ? formatDate(entry.startsOn) : `${formatDate(entry.startsOn)} – ${formatDate(entry.endsOn)}`; }
      const programFamilies = () => (state.data?.programFamilies || []).filter((family) => family.status === "active");
      const selectableFamilies = (kind) => programFamilies().filter((family) => family.kind === kind && family.currentProgram);
      function courseProgramField(entry, kind) {
        if (entry) return `<p class="staff-muted staff-wide">${kind === "annual_course" ? `Шат: ${escape(stageLabel(entry.stageCode))}` : `Хөтөлбөр: ${escape(entry.programFamilyName || entry.programName || "")}`}</p>`;
        const families = selectableFamilies(kind);
        if (!families.length) return `<p class="staff-empty staff-wide">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`;
        if (kind === "annual_course") return `<label class="staff-wide">Шат <select id="offering-annual-stage" required><option value="">Сонгоно уу</option>${families.map((family) => `<option value="${escape(family.annualStageCode)}">${escape(stageLabel(family.annualStageCode))}</option>`).join("")}</select></label>`;
        return `<label class="staff-wide">Хөтөлбөр <select id="offering-program-family" required><option value="">Сонгоно уу</option>${families.map((family) => `<option value="${escape(family.id)}">${escape(family.displayName)}</option>`).join("")}</select></label>`;
      }
      function annualDefaultDate() {
        const year = (state.data?.years || []).find((entry) => entry.isCurrent && entry.startsOn && entry.endsOn);
        const setting = state.data?.annualCourseStartDefault || { month: 10, day: 1 };
        return year ? `${year.startsOn.slice(0, 4)}-${String(setting.month).padStart(2, "0")}-${String(setting.day).padStart(2, "0")}` : "";
      }
      function courseFields(entry, kind) {
        const startsOn = entry?.startsOn || (kind === "annual_course" ? annualDefaultDate() : "");
        const facebook = `<label class="staff-wide">Facebook бүлгийн холбоос <input id="offering-facebook" type="url" inputmode="url" value="${escape(entry?.facebookGroupUrl || "")}" /><small>Хоосон орхиж болно.</small></label>`;
        if (kind === "annual_course") return `<label>Эхлэх өдөр <input id="offering-starts" type="date" required value="${escape(startsOn)}" /></label>${facebook}`;
        return `<label>Төлөвлөсөн эхлэх өдөр <input id="offering-starts" type="date" required value="${escape(startsOn)}" /></label><label>Төлөвлөсөн дуусах өдөр <input id="offering-ends" type="date" required value="${escape(entry?.endsOn || "")}" /></label>${facebook}`;
      }
      function annualForm(entry) { if (!entry && !selectableFamilies("annual_course").length) return `<p class="staff-empty">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`; return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="annual_course" />${courseProgramField(entry, "annual_course")}${courseFields(entry, "annual_course")}${formActions()}</form>`; }
      function summerForm(entry) { if (!entry && !selectableFamilies("summer_course").length) return `<p class="staff-empty">Эхлээд <a href="/staff/programs/">Хөтөлбөр</a> хэсэгт хөтөлбөр бэлтгэнэ үү.</p>`; return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="summer_course" /><label class="staff-wide">Нэр <input id="offering-title" maxlength="160" required value="${escape(entry?.title || "")}" placeholder="Зуны сургалт" /></label>${courseProgramField(entry, "summer_course")}${courseFields(entry, "summer_course")}${formActions()}</form>`; }
      function eventForm(entry) {
        const occurrence = entry ? occurrenceFor(entry.id) : null;
        return `<form id="offering-form" class="staff-compact-form"><input id="offering-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="offering-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><input id="event-updated" type="hidden" value="${escape(occurrence?.updatedAt || "")}" /><input id="offering-kind" type="hidden" value="event" /><label class="staff-wide">Арга хэмжээний нэр <input id="offering-title" maxlength="160" required value="${escape(entry?.title || "")}" /></label><label>Өдөр <input id="event-date" type="date" required value="${escape(occurrence?.localDate || "")}" /></label><label>Суудлын тоо <input id="event-capacity" type="number" min="1" max="500" required value="${escape(occurrence?.capacity || "12")}" /></label><label>Эхлэх цаг <input id="event-start" type="time" required value="${escape(occurrence?.startTime || "20:00")}" /></label><label>Дуусах цаг <input id="event-end" type="time" required value="${escape(occurrence?.endTime || "22:30")}" /></label><label>Төлбөр <select id="offering-charge"><option value="free" ${entry?.chargeMode !== "paid" ? "selected" : ""}>Үнэгүй</option><option value="paid" ${entry?.chargeMode === "paid" ? "selected" : ""}>Төлбөртэй</option></select></label><label class="staff-wide">Facebook бүлгийн холбоос <input id="offering-facebook" type="url" inputmode="url" value="${escape(entry?.facebookGroupUrl || "")}" /><small>Хоосон орхиж болно.</small></label><label class="staff-wide">Тайлбар <textarea id="offering-note" rows="3" maxlength="1000">${escape(entry?.note || "")}</textarea></label>${entry ? `<label class="staff-check staff-wide"><input id="event-open" type="checkbox" ${occurrence?.registrationOpen ? "checked" : ""} /> Бүртгэл нээлттэй</label>` : `<p class="staff-muted staff-wide">Шинэ арга хэмжээний бүртгэл анх хаалттай байна.</p>`}${formActions()}${entry ? `<div class="staff-danger-zone staff-wide"><p>Бүртгэл ашиглаагүй арга хэмжээг л устгана.</p><button class="button danger" data-event-delete type="button">Арга хэмжээ устгах</button></div>` : ""}</form>`;
      }
      function formActions() { return `<div class="staff-form-actions staff-wide"><button class="button secondary" data-cancel type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div>`; }
      function renderList() {
        const groups = ["annual_course", "summer_course", "event"].map((kind) => {
          const entries = offerings().filter((entry) => entry.kind === kind); if (!entries.length) return "";
          return `<section class="staff-offering-group"><h2>${kindLabel(kind)}</h2>${entries.map((entry) => `<article class="staff-offering-row"><div><span class="staff-kind-label">${kindLabel(entry.kind)}</span><h3>${escape(entry.title)}</h3><p>${escape(periodText(entry))} · ${chargeLabel(entry.chargeMode)}</p>${entry.kind !== "event" ? `<p>Хөтөлбөр: ${escape(entry.programFamilyName || entry.programName || "")}</p>` : ""}</div><div class="staff-inline-actions">${entry.kind !== "event" ? `<a class="button secondary" href="/staff/programs/?family=${encodeURIComponent(entry.programFamilyId)}">Хөтөлбөр</a>` : ""}${entry.kind !== "event" ? `<a class="button secondary" href="/staff/schedule/?offering=${encodeURIComponent(entry.id)}">Хуваарь</a>` : ""}<button class="button secondary" type="button" data-edit-offering="${escape(entry.id)}">Засах</button></div></article>`).join("")}</section>`;
        }).join("");
        q("#offering-list").innerHTML = groups || `<p class="staff-empty">Сургалт, арга хэмжээ оруулаагүй байна.</p>`;
        q("#offering-list").querySelectorAll("[data-edit-offering]").forEach((button) => button.onclick = () => { state.editingId = button.dataset.editOffering; state.creatingKind = ""; renderEditor(); q("#offering-editor").scrollIntoView({ behavior: "smooth", block: "start" }); });
      }
      function renderEditor() {
        const container = q("#offering-editor"); const entry = offerings().find((item) => item.id === state.editingId);
        if (!entry && !state.creatingKind) { container.innerHTML = ""; return; }
        if (!entry && state.creatingKind === "choose") { container.innerHTML = `<section class="staff-operation-section"><h2>Төрлөө сонгоно уу</h2><div class="staff-kind-choices"><button class="button secondary" data-kind="annual_course" type="button">Жилийн сургалт</button><button class="button secondary" data-kind="summer_course" type="button">Зуны сургалт</button><button class="button secondary" data-kind="event" type="button">Арга хэмжээ</button></div><button class="button secondary" data-cancel type="button">Болих</button></section>`; container.querySelectorAll("[data-kind]").forEach((button) => button.onclick = () => { state.creatingKind = button.dataset.kind; renderEditor(); }); container.querySelector("[data-cancel]").onclick = closeEditor; return; }
        const kind = entry?.kind || state.creatingKind;
        container.innerHTML = `<section class="staff-operation-section"><div class="staff-section-heading"><div><span class="staff-kind-label">${kindLabel(kind)}</span><h2>${entry ? "Мэдээлэл засах" : "Шинээр нэмэх"}</h2></div></div>${kind === "annual_course" ? annualForm(entry) : kind === "summer_course" ? summerForm(entry) : eventForm(entry)}</section>`;
        container.querySelector("[data-cancel]")?.addEventListener("click", closeEditor);
        container.querySelector("#offering-form")?.addEventListener("submit", saveOffering);
        container.querySelector("[data-event-delete]")?.addEventListener("click", () => { if (entry && window.confirm("Энэ арга хэмжээг устгах уу?")) run(() => postOverviewAction("offering-event.delete", { offeringId: entry.id, expectedUpdatedAt: entry.updatedAt }), "Арга хэмжээг устгалаа."); });
      }
      function closeEditor() { state.editingId = ""; state.creatingKind = ""; renderEditor(); }
      function saveOffering(event) { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const kind = q("#offering-kind").value; const id = q("#offering-id").value; const payload = { action: "offering.save", id: id || undefined, expectedUpdatedAt: q("#offering-updated").value || undefined, kind, title: q("#offering-title")?.value, annualStageCode: q("#offering-annual-stage")?.value, programFamilyId: q("#offering-program-family")?.value, startsOn: q("#offering-starts")?.value, endsOn: q("#offering-ends")?.value, facebookGroupUrl: q("#offering-facebook")?.value || "" }; if (kind === "event") Object.assign(payload, { eventExpectedUpdatedAt: q("#event-updated").value || undefined, eventDate: q("#event-date").value, eventStartTime: q("#event-start").value, eventEndTime: q("#event-end").value, eventCapacity: Number(q("#event-capacity").value), eventRegistrationOpen: Boolean(q("#event-open")?.checked), chargeMode: q("#offering-charge").value, note: q("#offering-note").value }); run(() => postOverviewAction(payload.action, payload), id ? "Мэдээллийг хадгаллаа." : "Шинээр нэмлээ. Бүртгэл анх хаалттай байна."); }
      async function run(work, success) { message(); try { await work(); closeEditor(); await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      function render() { renderList(); renderEditor(); }
      q("#add-offering").onclick = () => { state.editingId = ""; state.creatingKind = "choose"; renderEditor(); };
      (async () => { if (!(await hasSetupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
