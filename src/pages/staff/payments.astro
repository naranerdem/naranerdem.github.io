---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Бүртгэл, төлбөр | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Бүртгэл, төлбөр</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Бүртгэл, төлбөр</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1 class="staff-payment-page-title">Бүртгэл, төлбөр</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <div id="payment-list" class="staff-payment-list"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, formatDate } from "../../scripts/staff-setup.js";
      const state = { data: null, openId: "", pendingId: "", detailId: "", openWaitlistId: "", openOfferId: "", openRecentOfferId: "" };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const mnt = (value) => `${new Intl.NumberFormat("en-US").format(Number(value || 0))} ₮`;
      const localParts = (value) => Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Ulaanbaatar", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(new Date(value)).filter((part) => part.type !== "literal").map((part) => [part.type, part.value]));
      const localDateTime = (value) => { const parts = localParts(value); return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}`; };
      const localLabel = (value) => { const parts = localParts(value); return `${parts.month}-р сарын ${parts.day}, ${parts.hour}:${parts.minute}`; };
      function dueText(item) {
        const minutes = Math.floor((new Date(state.data.now).getTime() - new Date(item.paymentDueAt).getTime()) / 60000);
        if (minutes <= 0) return `Төлөх хугацаа: ${localLabel(item.paymentDueAt)}`;
        if (minutes < 60) return `Хугацаа ${minutes} минутын өмнө дууссан`;
        if (minutes < 24 * 60) return `Хугацаа ${Math.floor(minutes / 60)} цагийн өмнө дууссан`;
        return `${Math.floor(minutes / (24 * 60))} өдөр шалгагдаагүй`;
      }
      function itemMarkup(item) {
        const remaining = Number(item.expectedAmountMnt) - Number(item.allocatedAmountMnt);
        const discountLabels = { family_multi_child: "Нэг гэр бүлийн хүүхэд", referral_referred: "Урилгаар бүртгүүлсэн", referral_referrer: "Амжилттай урилга" };
        const discounts = (item.discounts || []).map((award) => `<p class="staff-muted">${escape(discountLabels[award.awardType] || "Хөнгөлөлт")} · ${Number(award.basisPoints || 0) / 100}% · ${escape(mnt(award.awardAmountMnt))}${award.creditAmountMnt ? ` · Кредит ${escape(mnt(award.creditAmountMnt))}` : ""}${award.status === "reversed" ? " · Буцаасан" : ""}${state.data?.canManageDiscounts && award.status === "active" ? ` <button class="text-button" type="button" data-discount-reverse="${escape(award.id)}">Буцаах</button>` : ""}</p>`).join("");
        const open = state.openId === item.installmentId;
        const effectiveDue = item.remainingPaymentDueAt || item.paymentDueAt;
        const overdue = remaining > 0 && new Date(effectiveDue) < new Date(state.data.now);
        const pending = state.pendingId === item.installmentId;
        const tentative = item.tentativePaymentId ? `<p class="staff-muted"><button class="text-button" type="button" data-payment-undo="${escape(item.tentativePaymentId)}">Буцаах</button></p>` : "";
        const approvedSeat = Boolean(item.seatConfirmationApproved);
        const cancellationNotice = Number(item.allocatedAmountMnt) > 0
          ? `<p class="staff-muted"><strong>${escape(mnt(item.allocatedAmountMnt))}</strong> төлөгдсөн. Бүртгэл цуцлагдсан ч төлбөрийн түүх устахгүй; буцаалт эсвэл кредитийг тусад нь шийднэ.</p>`
          : `<p class="staff-muted">Суудал шууд чөлөөлөгдөнө. Төлбөрийн түүх устахгүй.</p>`;
        const cancellation = state.data?.canCancelRegistrations ? `<details class="staff-payment-release"><summary>Бүртгэлийг цуцлах</summary>${cancellationNotice}<form data-registration-cancel-form="${escape(item.registrationDraftChildId)}"><label>Шалтгаан<select name="reason" required><option value="guardian_request">Эцэг эхийн хүсэлтээр</option><option value="payment_overdue">Төлбөр хугацаандаа хийгдээгүй</option><option value="other">Бусад</option></select></label><label data-cancellation-note hidden>Тайлбар<textarea name="note" rows="2" maxlength="500"></textarea></label><div class="staff-inline-actions"><button class="button danger" type="submit">Бүртгэлийг цуцлах</button></div></form></details>` : "";
        const ownReferral = state.data?.canManageReferrals && item.ownReferralCode
          ? `<p><strong>Найзаа урих код</strong><br><code>${escape(item.ownReferralCode)}</code> <button class="text-button" type="button" data-referral-copy="${escape(item.ownReferralCode)}">Хуулах</button></p>` : "";
        const usedReferral = state.data?.canManageReferrals && item.usedReferralCode
          ? `<p class="staff-muted">Энэ бүртгэлд ашигласан урилгын код: ${escape(item.usedReferralCode)}</p>` : "";
        const remainingDeadlineControls = item.remainingPaymentDueAt
          ? `<p class="staff-muted" data-existing-remaining-deadline>Үлдсэн төлбөрийн хугацаа: ${escape(localLabel(item.remainingPaymentDueAt))}</p><label class="staff-check staff-wide" data-remaining-deadline-change hidden><input name="changeRemainingDueAt" type="checkbox" /><span>Үлдсэн төлбөрийн хугацааг өөрчлөх</span></label><label class="staff-wide" data-remaining-deadline hidden>Үлдсэн төлбөрийн хугацаа<input name="remainingDueAt" type="datetime-local" /></label>`
          : `<label class="staff-wide" data-remaining-deadline hidden>Үлдсэн төлбөрийн хугацаа<input name="remainingDueAt" type="datetime-local" /></label>`;
        const seatApprovalControl = approvedSeat
          ? `<p class="staff-muted">Суудал баталгаажсан</p>`
          : `<label class="staff-check" data-partial-seat hidden><input name="approveSeat" type="checkbox" /><span>Суудлыг баталгаажуулах</span></label>`;
        const identityReview = item.identityResolutionStatus === "needs_identity_review"
          ? `<p class="staff-muted">Хүүхдийн бүртгэлийг баталгаажуулах шаардлагатай</p>` : "";
        return `<article class="staff-payment-item ${overdue ? "is-overdue" : ""}">
          <div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}–${escape(item.endTime)}</p>
          <p><strong>${escape(remaining > 0 ? mnt(remaining) : item.laterAmountMnt ? "Эхний төлбөр баталгаажсан" : "Төлбөр баталгаажсан")}</strong>${remaining > 0 ? " үлдсэн" : ""}</p>${remaining > 0 ? `<p>${escape(dueText({ ...item, paymentDueAt: effectiveDue }))}</p>` : ""}
          ${item.laterAmountMnt ? `<p class="staff-muted">Дараагийн төлбөр: ${escape(mnt(item.laterAmountMnt))} · ${escape(localLabel(item.laterDueAt))}</p>` : ""}${ownReferral}${usedReferral}
          ${item.parentClaimed ? `<p class="staff-muted">Эцэг эх төлсөн гэж мэдэгдсэн</p>` : ""}
          ${approvedSeat ? `<p class="staff-muted">Суудал баталгаажсан</p>` : ""}${identityReview}</div>
          <div class="staff-payment-actions"><button class="text-button" type="button" data-payment-detail="${escape(item.installmentId)}">Нээх</button></div>
          ${open ? `${remaining > 0 ? `<form class="staff-payment-form" data-payment-form="${escape(item.installmentId)}"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: ${escape(item.primaryPhone || "")}</p>${discounts}<p>${item.parentClaimed ? "Эцэг эх төлсөн гэж мэдэгдсэн" : ""}</p><p>Гүйлгээний утга: <strong>${escape(item.transferDescription || item.paymentReference)}</strong></p>${ownReferral}${usedReferral}<label>Орсон дүн<input name="amount" type="number" min="1" max="${escape(remaining)}" step="1" value="${escape(remaining)}" required /></label><label>Төрөл<select name="source"><option value="staff_manual_bank">Дансаар</option><option value="staff_manual_cash">Бэлнээр</option></select></label><label class="staff-wide">Орсон хугацаа<input name="receivedAt" type="datetime-local" value="${localDateTime(new Date())}" required /></label>${seatApprovalControl}${remainingDeadlineControls}<div class="staff-inline-actions staff-wide"><button class="button secondary" type="button" data-payment-cancel>Болих</button><button class="button primary" type="submit">Төлбөр орсон</button><button class="text-button" type="button" data-payment-checked="${escape(item.paymentRequestId)}">Одоогоор олдсонгүй</button></div></form>` : `<div class="staff-payment-form"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: ${escape(item.primaryPhone || "")}</p>${discounts}${ownReferral}${usedReferral}<p>Гүйлгээний утга: <strong>${escape(item.transferDescription || item.paymentReference)}</strong></p><p>Эхний төлбөр: <strong>${escape(mnt(item.allocatedAmountMnt))}</strong></p><p>${item.parentClaimed ? "Эцэг эх төлсөн гэж мэдэгдсэн" : ""}</p><button class="button secondary" type="button" data-payment-cancel>Хаах</button></div>`}${tentative}` : ""}
          ${overdue && !item.seatConfirmationApproved && remaining > 0 ? `<details class="staff-payment-release"><summary>Суудал чөлөөлөх</summary><p>${item.parentClaimed ? "Асран хамгаалагч төлбөр хийсэн гэж мэдэгдсэн. Банкны орлогыг дахин шалгана уу." : "Энэ үйлдлээр суудал шууд сулрана."}</p><button class="button danger" type="button" data-payment-release="${escape(item.paymentRequestId)}">Суудлыг чөлөөлөх</button></details>` : ""}${cancellation}
        </article>`;
      }
      function cancelledMarkup(item) { let reason = ""; try { reason = JSON.parse(item.cancellationMetadata || "{}").reason || ""; } catch {} const labels = { guardian_request: "Эцэг эхийн хүсэлтээр", payment_overdue: "Төлбөр хугацаандаа хийгдээгүй", other: "Бусад" }; return `<article class="staff-payment-item"><div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel || "")} · ${escape(item.weekday || "")} ${escape(item.startTime || "")}–${escape(item.endTime || "")}</p><p><strong>Бүртгэл цуцлагдсан</strong>${reason ? ` · ${escape(labels[reason] || reason)}` : ""}</p>${item.cancelledAt ? `<p class="staff-muted">${escape(localLabel(item.cancelledAt))}</p>` : ""}</div></article>`; }
      function promotionMarkup(item) {
        const pending = state.pendingId === item.childId;
        const candidates = item.candidates || [];
        const candidateActions = candidates.map((candidate) => `<button class="button secondary" type="button" data-promotion-existing="${escape(candidate.id)}" data-promotion-child="${escape(item.childId)}" ${pending ? "disabled" : ""}>Энэ хүүхэд мөн</button><p class="staff-muted">${escape(candidate.name)} · ${escape(formatDate(candidate.dateOfBirth))}</p>`).join("");
        const actions = item.guardianResolutionStatus !== "resolved"
          ? `<p class="staff-muted">Асран хамгаалагчийн мэдээллийг админаар шалгуулна уу.</p>`
          : `<div class="staff-promotion-actions">${candidateActions}${candidates.length ? "" : `<p class="staff-muted">Өмнөх бүртгэл системээс олдсонгүй.</p>`}<button class="text-button" type="button" data-promotion-new="${escape(item.childId)}" ${pending ? "disabled" : ""}>Хүүхдийн бүртгэл үүсгэх</button></div>`;
        return `<article class="staff-payment-item staff-promotion-item">
          <div><strong>${escape(item.childName)}</strong><p>${escape(formatDate(item.dateOfBirth))} · ${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}–${escape(item.endTime)}</p><p>${item.returningStatus === "returning" ? "Өмнө сурч байсан" : "Шинэ хүүхэд"}</p>
          <p><strong>Төлбөр баталгаажсан</strong></p><p>Бүртгэлийг баталгаажуулах шаардлагатай</p>${actions}</div>
        </article>`;
      }
      function creditMarkup(item) { const discount = item.creditKind === "discount"; return `<article class="staff-payment-item"><div><strong>${escape(item.guardianName || "")}</strong><p>${escape(item.childNames || "")}</p><p><strong>${escape(mnt(item.availableAmountMnt))}</strong> ${discount ? "хөнгөлөлтийн кредит" : "кредит / буцаалт"}</p>${discount ? `<p class="staff-muted">${escape(({ family_multi_child: "Нэг гэр бүлийн хүүхэд", referral_referred: "Урилгаар бүртгүүлсэн", referral_referrer: "Амжилттай урилга" })[item.awardType] || "Хөнгөлөлт")}</p>` : ""}</div>${discount ? "" : `<div class="staff-payment-actions"><button class="text-button" type="button" data-credit-refund="${escape(item.id)}">Буцаан төлсөн</button></div>`}</article>`; }
      function recentResponseMarkup(item) { const accepted = item.status === "converted"; const open = state.openRecentOfferId === item.id; return `<article class="staff-payment-item"><div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}–${escape(item.endTime)}</p><p><strong>${accepted ? "Зөвшөөрсөн" : "Татгалзсан"}</strong> · ${escape(localLabel(item.resolvedAt))}</p></div><div class="staff-payment-actions"><button class="text-button" type="button" data-recent-offer="${escape(item.id)}">Нээх</button></div>${open ? `<div class="staff-payment-form"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: <a href="tel:${escape(item.primaryPhone || "")}">${escape(item.primaryPhone || "")}</a></p><button class="text-button" type="button" data-recent-offer-close>Дэлгэрэнгүйг хаах</button></div>` : ""}</article>`; }
      function waitlistMarkup(item) { const open = state.openWaitlistId === item.id; return `<article class="staff-payment-item"><div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel)}</p><p class="staff-muted">Хүлээлтэд ${item.fifoPosition}-рт</p></div><div class="staff-payment-actions"><button class="text-button" type="button" data-waitlist-detail="${escape(item.id)}">Нээх</button></div>${open ? `<div class="staff-payment-form"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: ${escape(item.primaryPhone || "")}</p><p>И-мэйл: ${escape(item.email || "")}</p>${item.guardianFacebookName ? `<p>Facebook: ${escape(item.guardianFacebookName)}</p>` : ""}${item.childFacebookName ? `<p>Хүүхдийн Facebook: ${escape(item.childFacebookName)}</p>` : ""}<p>Хүлээлтэд орсон: ${escape(localLabel(item.createdAt))}</p><p>Энэ ангид ${item.fifoPosition}-рт байна.</p><button class="text-button" type="button" data-waitlist-close>Дэлгэрэнгүйг хаах</button></div>` : ""}</article>`; }
      function offerMarkup(item) { const open = state.openOfferId === item.id; const overdue = item.status === "active" && new Date(item.respondByAt) < new Date(state.data.now); const title = item.status === "awaiting_transfer" ? "Шилжүүлэг хүлээж байна" : overdue ? "Хариу хүлээж буй санал" : "Хариу хүлээж буй санал"; const responseTarget = overdue ? "Хариу өгөхийг хүссэн хугацаа өнгөрсөн ч санал хадгалагдаж байна." : `Боломжтой бол хариу өгөх: ${localLabel(item.respondByAt)}`; return `<article class="staff-payment-item ${overdue ? "is-overdue" : ""}"><div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel)}</p><p><strong>${title}</strong></p><p class="staff-muted">${escape(responseTarget)}</p></div><div class="staff-payment-actions"><button class="text-button" type="button" data-offer-detail="${escape(item.id)}">Нээх</button></div>${open ? `<div class="staff-payment-form"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: <a href="tel:${escape(item.primaryPhone || "")}">${escape(item.primaryPhone || "")}</a></p><p>И-мэйл: ${escape(item.email || "")}</p>${item.guardianFacebookName ? `<p>Facebook: ${escape(item.guardianFacebookName)}</p>` : ""}${item.childFacebookName ? `<p>Хүүхдийн Facebook: ${escape(item.childFacebookName)}</p>` : ""}${item.hasBackupEnrollment ? "<p>Өөр ангийн баталгаатай бүртгэл хэвээр байна.</p>" : ""}${item.contactLastAt ? `<p class="staff-muted">Сүүлд холбогдсон: ${escape(localLabel(item.contactLastAt))} · ${escape(item.contactLastChannel || "")}</p>` : ""}<div class="staff-inline-actions"><button class="button secondary" type="button" data-offer-contact="phone" data-offer-id="${escape(item.id)}">Холбогдсон</button><button class="button secondary" type="button" data-offer-copy="${escape(item.id)}">Messenger текст хуулах</button></div>${item.status === "active" ? `<label>Хариу өгөх шинэ хугацаа<input data-offer-extend-input="${escape(item.id)}" type="datetime-local" value="${escape(localDateTime(item.respondByAt))}" /></label><div class="staff-inline-actions"><button class="button secondary" type="button" data-offer-extend="${escape(item.id)}">Хугацаа сунгах</button><button class="button secondary" type="button" data-offer-accept="${escape(item.id)}">Зөвшөөрснийг тэмдэглэх</button><button class="button secondary" type="button" data-offer-decline="${escape(item.id)}">Татгалзсаныг тэмдэглэх</button></div><details><summary>Саналыг хаах</summary><p class="staff-muted">Энэ нь асран хамгаалагч татгалзсан гэсэн тэмдэглэл биш.</p><label>Шалтгаан<select data-offer-close-reason="${escape(item.id)}"><option value="Холбогдож чадсангүй">Холбогдож чадсангүй</option><option value="Бусад">Бусад</option></select></label><button class="button danger" type="button" data-offer-close-action="${escape(item.id)}">Саналыг хаах</button></details>` : ""}<button class="text-button" type="button" data-offer-close>Дэлгэрэнгүйг хаах</button></div>` : ""}</article>`; }
      function render() {
        const list = q("#payment-list"); const items = state.data?.items || []; const promotionItems = state.data?.promotionItems || [];
        const sections = ["Төлбөр хүлээж байна", "Хугацаа хэтэрсэн", "Хэсэгчлэн төлсөн", "Төлбөр баталгаажсан", "Кредит / буцаалт", "Хүлээлгийн жагсаалт", "Шалгах шаардлагатай"];
        const groups = Object.fromEntries(sections.map((title) => [title, []]));
        for (const item of items) { const remaining = Number(item.expectedAmountMnt) - Number(item.allocatedAmountMnt); const due = new Date(item.remainingPaymentDueAt || item.paymentDueAt) < new Date(state.data.now); const group = remaining <= 0 ? "Төлбөр баталгаажсан" : due ? "Хугацаа хэтэрсэн" : item.seatConfirmationApproved ? "Хэсэгчлэн төлсөн" : "Төлбөр хүлээж байна"; groups[group].push(item); }
        for (const item of promotionItems) groups["Шалгах шаардлагатай"].push(item);
        for (const item of state.data?.credits || []) groups["Кредит / буцаалт"].push({ ...item, credit: true });
        for (const item of state.data?.waitlistItems || []) groups["Хүлээлгийн жагсаалт"].push({ ...item, waitlist: true });
        for (const item of state.data?.waitlistOffers || []) groups["Хүлээлгийн жагсаалт"].push({ ...item, offer: true });
        const capacity = (state.data?.capacity || []).map((item) => { const review = Number(item.identityReviewCount || 0); const awaiting = Math.max(Number(item.reservedInitialPaymentCount || 0) - review, 0); return `<div class="staff-payment-item"><div><strong>${escape(item.classLabel)}</strong><p>${item.capacity} суудал · Баталгаажсан ${item.confirmedCount} · Төлбөр хүлээж буй ${awaiting}${review ? ` · Шалгах ${review}` : ""} · Санал ${item.offeredWaitlistCount} · Сул ${item.freeSeats} · Хүлээлт ${item.waitlistCount}</p></div></div>`; }).join("") || "<p class=\"staff-empty\">Одоогоор анги байхгүй</p>";
        const itemHtml = (item) => item.credit ? creditMarkup(item) : item.offer ? offerMarkup(item) : item.waitlist ? waitlistMarkup(item) : item.installmentId ? itemMarkup(item) : promotionMarkup(item);
        const ordinarySection = (title) => `<section class="staff-operation-section"><h2>${title}</h2>${groups[title].length ? groups[title].map(itemHtml).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}</section>`;
        const offers = groups["Хүлээлгийн жагсаалт"].filter((item) => item.offer); const waiting = groups["Хүлээлгийн жагсаалт"].filter((item) => item.waitlist);
        const overdueOffers = offers.filter((item) => item.status === "active" && new Date(item.respondByAt) < new Date(state.data.now));
        const awaitingOffers = offers.filter((item) => item.status === "active" && !overdueOffers.includes(item));
        const transferOffers = offers.filter((item) => item.status === "awaiting_transfer");
        const recent = state.data?.recentWaitlistResponses || [];
        const waitlistSection = `<section class="staff-operation-section"><h2>Хүлээлгийн жагсаалт</h2>${recent.length ? `<h3>Саяхны хариу</h3>${recent.map(recentResponseMarkup).join("")}` : ""}<h3>Хугацаа хэтэрсэн санал</h3>${overdueOffers.length ? overdueOffers.map(itemHtml).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}<h3>Хариу хүлээж буй санал</h3>${awaitingOffers.length ? awaitingOffers.map(itemHtml).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}<h3>Дараалалд хүлээж байна</h3>${waiting.length ? waiting.map(itemHtml).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}<h3>Шилжүүлэг хүлээж байна</h3>${transferOffers.length ? transferOffers.map(itemHtml).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}</section>`;
        list.innerHTML = `<section class="staff-operation-section"><h2>Суудлын байдал</h2>${capacity}</section>` + sections.map((title) => title === "Хүлээлгийн жагсаалт" ? waitlistSection : ordinarySection(title)).join("") + `<section class="staff-operation-section"><h2>Цуцлагдсан бүртгэл</h2>${(state.data?.cancelledItems || []).length ? state.data.cancelledItems.map(cancelledMarkup).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}</section>`;
      }
      async function refresh(success = "") { const response = await fetch("/api/staff/payments", { credentials: "same-origin" }); if (!response.ok) throw new Error("Төлбөрийн жагсаалтыг авч чадсангүй."); state.data = await response.json(); render(); if (success) message(success, true); }
      async function post(payload) { const response = await fetch("/api/staff/payments", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, credentials: "same-origin", body: JSON.stringify(payload) }); const body = await response.json().catch(() => null); if (!response.ok) throw new Error(body?.error?.message || "Төлбөрийн мэдээллийг хадгалж чадсангүй."); return body; }
      async function copyMessengerText(text) {
        try {
          if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(text); return; }
        } catch {}
        const field = document.createElement("textarea");
        field.value = text; field.setAttribute("readonly", ""); field.style.position = "fixed"; field.style.opacity = "0";
        document.body.append(field); field.select();
        const copied = document.execCommand?.("copy"); field.remove();
        if (!copied) throw new Error("Messenger текстийг хуулж чадсангүй. Дахин оролдоно уу.");
      }
      async function messengerTextForOffer(offerId) {
        const result = await post({ action: "waitlist-offer.reissue-link", offerId });
        const item = (state.data.waitlistOffers || []).find((entry) => entry.id === offerId);
        if (!item) throw new Error("Саналын мэдээлэл олдсонгүй.");
        return `${item.childName}-д ${item.classLabel} ангид суудал гарлаа. Боломжтой бол эндээс сонголтоо мэдэгдэнэ үү: ${result.url}`;
      }
      async function copyMessengerOffer(offerId) {
        const text = messengerTextForOffer(offerId);
        if (navigator.clipboard?.write && typeof ClipboardItem !== "undefined") {
          try {
            // Start the clipboard write within the original tap; its content can
            // resolve after the server returns the freshly issued opaque link.
            await navigator.clipboard.write([new ClipboardItem({ "text/plain": text.then((value) => new Blob([value], { type: "text/plain" })) })]);
            await text;
            return;
          } catch {
            await copyMessengerText(await text);
            return;
          }
        }
        await copyMessengerText(await text);
      }
      q("#payment-list").addEventListener("click", async (event) => {
        const target = event.target.closest("button"); if (!target || target.disabled) return;
        if (target.dataset.paymentDetail) { state.openId = target.dataset.paymentDetail; render(); return; }
        if (target.dataset.waitlistDetail) { state.openWaitlistId = target.dataset.waitlistDetail; render(); return; }
        if (target.dataset.offerDetail) { state.openOfferId = target.dataset.offerDetail; render(); return; }
        if (target.dataset.recentOffer) { state.openRecentOfferId = target.dataset.recentOffer; render(); return; }
        if (target.matches("[data-recent-offer-close]")) { state.openRecentOfferId = ""; render(); return; }
        if (target.matches("[data-offer-close]")) { state.openOfferId = ""; render(); return; }
        if (target.matches("[data-waitlist-close]")) { state.openWaitlistId = ""; render(); return; }
        if (target.matches("[data-payment-cancel]")) { state.openId = ""; render(); return; }
        if (target.dataset.referralCopy) { try { await copyMessengerText(target.dataset.referralCopy); message("Хууллаа.", true); } catch (error) { message(error.message || "Урилгын кодыг хуулж чадсангүй."); } return; }
        if (target.dataset.paymentChecked) { try { await post({ action: "payment.checked-not-found", paymentRequestId: target.dataset.paymentChecked }); await refresh("Шалгаснаа тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.paymentUndo) { try { await post({ action: "payment.undo-tentative", receivedPaymentId: target.dataset.paymentUndo }); await refresh("Тэмдэглэлийг буцаалаа."); } catch (error) { message(error.message); } return; }
        if (target.dataset.creditRefund) { if (!confirm("Буцаан төлсөн гэж тэмдэглэх үү?")) return; try { await post({ action: "payment-credit.refund", creditId: target.dataset.creditRefund }); await refresh("Буцаан төлсөн гэж тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.paymentRelease) { if (!confirm("Суудлыг суллах уу? Дараа нь өөр бүртгэл авч болно.")) return; try { await post({ action: "payment.release-seat", paymentRequestId: target.dataset.paymentRelease }); state.openId = ""; await refresh("Суудлыг суллалаа."); } catch (error) { message(error.message); } }
        if (target.dataset.discountReverse) { const reason = prompt("Хөнгөлөлтийг буцаах шалтгаан"); if (!reason) return; try { await post({ action: "discount-award.reverse", awardId: target.dataset.discountReverse, reason }); await refresh("Хөнгөлөлтийг буцаалаа."); } catch (error) { message(error.message); } return; }
        if (target.dataset.offerContact) { try { await post({ action: "waitlist-offer.contact", offerId: target.dataset.offerId, channel: target.dataset.offerContact }); await refresh("Холбогдсоныг тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.offerExtend) { const input = q(`[data-offer-extend-input="${target.dataset.offerExtend}"]`); try { await post({ action: "waitlist-offer.extend", offerId: target.dataset.offerExtend, respondByAt: new Date(input.value).toISOString() }); await refresh("Хугацааг сунгалаа."); } catch (error) { message(error.message); } return; }
        if (target.dataset.offerCopy) { try { await copyMessengerOffer(target.dataset.offerCopy); message("Хууллаа", true); } catch (error) { message(error.message || "Messenger текстийг хуулж чадсангүй."); } return; }
        if (target.dataset.offerDecline) { if (!confirm("Татгалзсаныг тэмдэглээд дараагийн гэр бүлд санал болгох уу?")) return; try { await post({ action: "waitlist-offer.decline", offerId: target.dataset.offerDecline, source: "staff_phone" }); await refresh("Татгалзсаныг тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.offerCloseAction) { if (!confirm("Саналыг хаагаад дараагийн гэр бүлд санал болгох уу?")) return; const reason = q(`[data-offer-close-reason="${target.dataset.offerCloseAction}"]`).value; try { await post({ action: "waitlist-offer.close", offerId: target.dataset.offerCloseAction, reason }); await refresh("Саналыг хаалаа."); } catch (error) { message(error.message); } return; }
        if (target.dataset.offerAccept) { const two = confirm("Хоёр хувааж төлөх тохиролцоо хийсэн бол OK дарна уу. Үгүй бол Cancel дарж нэг удаагийн төлбөрөөр үргэлжлүүлнэ."); try { await post({ action: "waitlist-offer.accept", offerId: target.dataset.offerAccept, paymentPlanCode: two ? "two_installment" : "single", source: "staff_phone" }); await refresh("Сонголтыг тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.promotionExisting) { if (!confirm("Энэ хүүхдийг өмнөх бүртгэлтэй холбож баталгаажуулах уу?")) return; state.pendingId = target.dataset.promotionChild; render(); try { await post({ action: "promotion.use-existing-student", draftChildId: target.dataset.promotionChild, studentId: target.dataset.promotionExisting }); await refresh("Бүртгэл баталгаажлаа."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); } }
        if (target.dataset.promotionNew) { if (!confirm("Шинэ хүүхдийн бүртгэл үүсгэж баталгаажуулах уу?")) return; state.pendingId = target.dataset.promotionNew; render(); try { await post({ action: "promotion.create-new-student", draftChildId: target.dataset.promotionNew }); await refresh("Бүртгэл баталгаажлаа."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); } }
      });
      q("#payment-list").addEventListener("submit", async (event) => {
        const form = event.target;
        if (form.matches("[data-registration-cancel-form]")) {
          event.preventDefault();
          const reason = form.elements.reason.value; const note = form.elements.note.value;
          if (reason === "other" && !note.trim()) { message("Бусад шалтгааны тайлбарыг оруулна уу."); return; }
          const childId = form.dataset.registrationCancelForm; state.pendingId = childId; render();
          try { const result = await post({ action: "registration.cancel", registrationDraftChildId: childId, reason, note }); state.openId = ""; await refresh(result.idempotent ? "Бүртгэл өмнө нь цуцлагдсан байна." : "Бүртгэл цуцлагдаж, суудал чөлөөлөгдлөө."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); }
          return;
        }
        if (!form.matches("[data-payment-form]")) return; event.preventDefault();
        const item = state.data.items.find((entry) => entry.installmentId === form.dataset.paymentForm); if (!item) return;
        const receivedAt = new Date(form.elements.receivedAt.value).toISOString(); const amountMnt = Number(form.elements.amount.value); const source = form.elements.source.value;
        state.pendingId = item.installmentId; render();
        const approveSeat = Boolean(form.elements.approveSeat?.checked); const remainingDueAt = form.elements.remainingDueAt.value ? new Date(form.elements.remainingDueAt.value).toISOString() : undefined;
        try { await post({ action: "payment.record", paymentRequestId: item.paymentRequestId, allocations: [{ installmentId: item.installmentId, amountMnt }], source, receivedAt, approveSeatConfirmation: approveSeat, remainingPaymentDueAt: remainingDueAt, idempotencyKey: `manual:${item.paymentRequestId}:${item.installmentId}:${source}:${receivedAt}:${amountMnt}` }); state.openId = ""; await refresh("Төлбөрийн баримтыг тэмдэглэлээ."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); }
      });
      function updateRemainingDeadline(form) { const partial = Number(form.elements.amount.value) < Number(form.elements.amount.max); const seat = form.querySelector("[data-partial-seat]"); const alreadyApproved = !seat; const change = form.querySelector("[data-remaining-deadline-change]"); const deadline = form.querySelector("[data-remaining-deadline]"); if (seat) seat.hidden = !partial; if (!partial) { if (form.elements.approveSeat) form.elements.approveSeat.checked = false; if (change) { change.hidden = true; form.elements.changeRemainingDueAt.checked = false; } deadline.hidden = true; form.elements.remainingDueAt.required = false; return; } if (!alreadyApproved) { deadline.hidden = !form.elements.approveSeat.checked; form.elements.remainingDueAt.required = Boolean(form.elements.approveSeat.checked); return; } if (change) { change.hidden = false; deadline.hidden = !form.elements.changeRemainingDueAt.checked; form.elements.remainingDueAt.required = form.elements.changeRemainingDueAt.checked; return; } deadline.hidden = false; form.elements.remainingDueAt.required = true; }
      q("#payment-list").addEventListener("input", (event) => { const input = event.target; if (input.name === "amount") updateRemainingDeadline(input.closest("form")); });
      q("#payment-list").addEventListener("change", (event) => { const input = event.target;
        if (input.name === "reason") { const note = input.closest("form").querySelector("[data-cancellation-note]"); const field = note.querySelector("textarea"); note.hidden = input.value !== "other"; field.required = input.value === "other"; return; }
        if (input.name === "approveSeat" || input.name === "changeRemainingDueAt") updateRemainingDeadline(input.closest("form"));
      });
      (async () => { const session = await fetch("/api/staff/session", { credentials: "same-origin" }).then((response) => response.ok ? response.json() : null); if (!session?.authenticated || !(session.capabilities || []).includes("payment.view")) { show("tool-denied"); return; } show("tool-app"); try { await refresh(); } catch (error) { message(error.message || "Төлбөрийн жагсаалтыг авч чадсангүй."); } })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
