---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Бүртгэл, төлбөр | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Бүртгэл, төлбөр</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Бүртгэл, төлбөр</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="staff-back-link" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading staff-payment-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1 class="staff-payment-page-title">Бүртгэл, төлбөр</h1></div><div class="staff-payment-toolbar-row"><div class="staff-inline-actions staff-payment-toolbar"><button id="payment-refresh" class="button secondary" type="button">Шинэчлэх</button><button id="payment-copy" class="button secondary" type="button" aria-label="Excel-д хуулах" title="Excel-д хуулах" disabled>Бэлтгэж байна…</button><button id="payment-export" class="button secondary" type="button" aria-label="TSV файл татах" title="TSV файл татах">Татах</button></div><a class="staff-back-link" href="/staff/">Буцах</a></div></div>
        <nav class="staff-registration-intake-nav" aria-label="Бүртгэлийн үйлдэл"><a class="text-button" href="/staff/registration-intake/">Шинэ бүртгэл оруулах</a></nav>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <output id="payment-timing-diagnostics" class="staff-muted" hidden aria-live="polite"></output>
        <aside id="datetime-layout-diagnostics" class="staff-datetime-layout-diagnostics" hidden aria-live="polite">
          <details><summary>Огноо, цагийн байрлалын оношлогоо</summary><pre data-datetime-layout-output></pre><div class="staff-inline-actions"><button class="text-button" type="button" data-datetime-layout-copy>Хуулах</button><label class="staff-check"><input type="checkbox" data-datetime-layout-outlines /><span>Хүрээ харуулах</span></label></div></details>
        </aside>
        <section id="payment-copy-fallback" class="staff-copy-fallback" aria-live="polite" hidden><p>Хөтөч хуулж зөвшөөрсөнгүй. Доорх хүснэгтийг гараар хуулна уу.</p><textarea readonly aria-label="Excel-д гараар хуулах хүснэгт"></textarea></section>
        <div id="payment-list" class="staff-payment-list"></div>
        <dialog id="registration-cancel-dialog" class="rules-dialog staff-cancellation-dialog" aria-labelledby="registration-cancel-dialog-title">
          <div class="dialog-content">
            <div class="dialog-header"><h2 id="registration-cancel-dialog-title">Бүртгэлийг цуцлах</h2></div>
            <p id="registration-cancel-dialog-identity"></p>
            <p id="registration-cancel-dialog-reason" class="staff-muted"></p>
            <p id="registration-cancel-dialog-consequence"></p>
            <div class="dialog-actions"><button class="button secondary" type="button" data-registration-cancel-dismiss>Болих</button><button class="button danger" type="button" data-registration-cancel-confirm>Бүртгэлийг цуцлах</button></div>
          </div>
        </dialog>
      </section>
    </main>
    <script>
      import { initPaymentsPage } from "../../scripts/staff-payments-page.js";
      initPaymentsPage();
    </script>
  </body>
</html>
