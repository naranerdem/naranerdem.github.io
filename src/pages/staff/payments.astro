---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Бүртгэл, төлбөр | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Бүртгэл, төлбөр</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Бүртгэл, төлбөр</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1>Бүртгэл, төлбөр</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <div id="payment-list" class="staff-payment-list"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, formatDate } from "../../scripts/staff-setup.js";
      const state = { data: null, openId: "", pendingId: "", detailId: "", openWaitlistId: "" };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const mnt = (value) => `${new Intl.NumberFormat("en-US").format(Number(value || 0))} ₮`;
      const localParts = (value) => Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Ulaanbaatar", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(new Date(value)).filter((part) => part.type !== "literal").map((part) => [part.type, part.value]));
      const localDateTime = (value) => { const parts = localParts(value); return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}`; };
      const localLabel = (value) => { const parts = localParts(value); return `${parts.month}-р сарын ${parts.day}, ${parts.hour}:${parts.minute}`; };
      function dueText(item) {
        const minutes = Math.floor((new Date(state.data.now).getTime() - new Date(item.paymentDueAt).getTime()) / 60000);
        if (minutes <= 0) return `Төлөх хугацаа: ${localLabel(item.paymentDueAt)}`;
        if (minutes < 60) return `Хугацаа ${minutes} минутын өмнө дууссан`;
        if (minutes < 24 * 60) return `Хугацаа ${Math.floor(minutes / 60)} цагийн өмнө дууссан`;
        return `${Math.floor(minutes / (24 * 60))} өдөр шалгагдаагүй`;
      }
      function itemMarkup(item) {
        const remaining = Number(item.expectedAmountMnt) - Number(item.allocatedAmountMnt);
        const open = state.openId === item.installmentId;
        const effectiveDue = item.remainingPaymentDueAt || item.paymentDueAt;
        const overdue = remaining > 0 && new Date(effectiveDue) < new Date(state.data.now);
        const pending = state.pendingId === item.installmentId;
        const tentative = item.tentativePaymentId ? `<p class="staff-muted"><button class="text-button" type="button" data-payment-undo="${escape(item.tentativePaymentId)}">Буцаах</button></p>` : "";
        return `<article class="staff-payment-item ${overdue ? "is-overdue" : ""}">
          <div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}–${escape(item.endTime)}</p>
          <p><strong>${escape(remaining > 0 ? mnt(remaining) : item.laterAmountMnt ? "Эхний төлбөр баталгаажсан" : "Төлбөр баталгаажсан")}</strong>${remaining > 0 ? " үлдсэн" : ""}</p>${remaining > 0 ? `<p>${escape(dueText({ ...item, paymentDueAt: effectiveDue }))}</p>` : ""}
          ${item.laterAmountMnt ? `<p class="staff-muted">Дараагийн төлбөр: ${escape(mnt(item.laterAmountMnt))} · ${escape(localLabel(item.laterDueAt))}</p>` : ""}
          ${item.parentClaimed ? `<p class="staff-muted">Эцэг эх төлсөн гэж мэдэгдсэн</p>` : ""}
          ${item.seatConfirmationApproved ? `<p class="staff-muted">Суудал баталгаажсан</p>` : ""}</div>
          <div class="staff-payment-actions"><button class="text-button" type="button" data-payment-detail="${escape(item.installmentId)}">Нээх</button></div>
          ${open ? `${remaining > 0 ? `<form class="staff-payment-form" data-payment-form="${escape(item.installmentId)}"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: ${escape(item.primaryPhone || "")}</p><p>${item.parentClaimed ? "Эцэг эх төлсөн гэж мэдэгдсэн" : ""}</p><p>Гүйлгээний утга: <strong>${escape(item.transferDescription || item.paymentReference)}</strong></p><label>Орсон дүн<input name="amount" type="number" min="1" max="${escape(remaining)}" step="1" value="${escape(remaining)}" required /></label><label>Төрөл<select name="source"><option value="staff_manual_bank">Дансаар</option><option value="staff_manual_cash">Бэлнээр</option></select></label><label class="staff-wide">Орсон хугацаа<input name="receivedAt" type="datetime-local" value="${localDateTime(new Date())}" required /></label><label class="staff-check" data-partial-seat hidden><input name="approveSeat" type="checkbox" /><span>Суудлыг баталгаажуулах</span></label><label class="staff-wide" data-remaining-deadline hidden>Үлдсэн төлбөрийн хугацаа<input name="remainingDueAt" type="datetime-local" /></label><div class="staff-inline-actions staff-wide"><button class="button secondary" type="button" data-payment-cancel>Болих</button><button class="button primary" type="submit">Төлбөр орсон</button><button class="text-button" type="button" data-payment-checked="${escape(item.paymentRequestId)}">Одоогоор олдсонгүй</button></div></form>` : `<div class="staff-payment-form"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: ${escape(item.primaryPhone || "")}</p><p>Гүйлгээний утга: <strong>${escape(item.transferDescription || item.paymentReference)}</strong></p><p>Эхний төлбөр: <strong>${escape(mnt(item.allocatedAmountMnt))}</strong></p><p>${item.parentClaimed ? "Эцэг эх төлсөн гэж мэдэгдсэн" : ""}</p><button class="button secondary" type="button" data-payment-cancel>Хаах</button></div>`}${tentative}` : ""}
          ${overdue && !item.seatConfirmationApproved && remaining > 0 ? `<details class="staff-payment-release"><summary>Суудал чөлөөлөх</summary><p>${item.parentClaimed ? "Асран хамгаалагч төлбөр хийсэн гэж мэдэгдсэн. Банкны орлогыг дахин шалгана уу." : "Энэ үйлдлээр суудал шууд сулрана."}</p><button class="button danger" type="button" data-payment-release="${escape(item.paymentRequestId)}">Суудлыг чөлөөлөх</button></details>` : ""}
        </article>`;
      }
      function promotionMarkup(item) {
        const pending = state.pendingId === item.childId;
        const candidates = item.candidates || [];
        const candidateActions = candidates.map((candidate) => `<button class="button secondary" type="button" data-promotion-existing="${escape(candidate.id)}" data-promotion-child="${escape(item.childId)}" ${pending ? "disabled" : ""}>Энэ хүүхэд мөн</button><p class="staff-muted">${escape(candidate.name)} · ${escape(formatDate(candidate.dateOfBirth))}</p>`).join("");
        const actions = item.guardianResolutionStatus !== "resolved"
          ? `<p class="staff-muted">Асран хамгаалагчийн мэдээллийг админаар шалгуулна уу.</p>`
          : `<div class="staff-promotion-actions">${candidateActions}${candidates.length ? "" : `<p class="staff-muted">Тохирох хүүхэд олдсонгүй.</p>`}<button class="text-button" type="button" data-promotion-new="${escape(item.childId)}" ${pending ? "disabled" : ""}>Шинэ хүүхэд</button></div>`;
        return `<article class="staff-payment-item staff-promotion-item">
          <div><strong>${escape(item.childName)}</strong><p>${escape(formatDate(item.dateOfBirth))} · ${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}–${escape(item.endTime)}</p><p>${item.returningStatus === "returning" ? "Өмнө сурч байсан" : "Шинэ хүүхэд"}</p>
          <p><strong>Төлбөр баталгаажсан</strong></p><p>Бүртгэлийг баталгаажуулах шаардлагатай</p>${actions}</div>
        </article>`;
      }
      function creditMarkup(item) { return `<article class="staff-payment-item"><div><strong>${escape(item.guardianName || "")}</strong><p>${escape(item.childNames || "")}</p><p><strong>${escape(mnt(item.availableAmountMnt))}</strong> кредит / буцаалт</p></div><div class="staff-payment-actions"><button class="text-button" type="button" data-credit-refund="${escape(item.id)}">Буцаан төлсөн</button></div></article>`; }
      function waitlistMarkup(item) { const open = state.openWaitlistId === item.id; return `<article class="staff-payment-item"><div><strong>${escape(item.childName)}</strong><p>${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}–${escape(item.endTime)}</p><p class="staff-muted">Хүлээлтэд ${item.fifoPosition}-рт</p></div><div class="staff-payment-actions"><button class="text-button" type="button" data-waitlist-detail="${escape(item.id)}">Нээх</button></div>${open ? `<div class="staff-payment-form"><p>Асран хамгаалагч: ${escape(item.guardianName || "")}</p><p>Утас: ${escape(item.primaryPhone || "")}</p><p>И-мэйл: ${escape(item.email || "")}</p>${item.guardianFacebookName ? `<p>Facebook: ${escape(item.guardianFacebookName)}</p>` : ""}${item.childFacebookName ? `<p>Хүүхдийн Facebook: ${escape(item.childFacebookName)}</p>` : ""}<p>Хүлээлтэд орсон: ${escape(localLabel(item.createdAt))}</p><p>Энэ ангид ${item.fifoPosition}-рт байна.</p><button class="button secondary" type="button" data-waitlist-close>Хаах</button></div>` : ""}</article>`; }
      function render() {
        const list = q("#payment-list"); const items = state.data?.items || []; const promotionItems = state.data?.promotionItems || [];
        const sections = ["Төлбөр хүлээж байна", "Хугацаа хэтэрсэн", "Хэсэгчлэн төлсөн", "Төлбөр баталгаажсан", "Кредит / буцаалт", "Хүлээлгийн жагсаалт", "Шалгах шаардлагатай"];
        const groups = Object.fromEntries(sections.map((title) => [title, []]));
        for (const item of items) { const remaining = Number(item.expectedAmountMnt) - Number(item.allocatedAmountMnt); const due = new Date(item.remainingPaymentDueAt || item.paymentDueAt) < new Date(state.data.now); const group = remaining <= 0 ? "Төлбөр баталгаажсан" : due ? "Хугацаа хэтэрсэн" : item.seatConfirmationApproved ? "Хэсэгчлэн төлсөн" : "Төлбөр хүлээж байна"; groups[group].push(item); }
        for (const item of promotionItems) groups["Шалгах шаардлагатай"].push(item);
        for (const item of state.data?.credits || []) groups["Кредит / буцаалт"].push({ ...item, credit: true });
        for (const item of state.data?.waitlistItems || []) groups["Хүлээлгийн жагсаалт"].push({ ...item, waitlist: true });
        const capacity = (state.data?.capacity || []).map((item) => `<div class="staff-payment-item"><div><strong>${escape(item.classLabel)} · ${escape(item.weekday)} ${escape(item.startTime)}</strong><p>${item.capacity} суудал · Баталгаажсан ${item.confirmedCount} · Төлбөр хүлээж буй ${item.reservedInitialPaymentCount} · Сул ${item.freeSeats} · Хүлээлт ${item.waitlistCount}</p></div></div>`).join("") || "<p class=\"staff-empty\">Одоогоор анги байхгүй</p>";
        list.innerHTML = `<section class="staff-operation-section"><h2>Суудлын байдал</h2>${capacity}</section>` + sections.map((title) => `<section class="staff-operation-section"><h2>${title}</h2>${groups[title].length ? groups[title].map((item) => item.credit ? creditMarkup(item) : item.waitlist ? waitlistMarkup(item) : item.installmentId ? itemMarkup(item) : promotionMarkup(item)).join("") : "<p class=\"staff-empty\">Одоогоор байхгүй</p>"}</section>`).join("");
      }
      async function refresh(success = "") { const response = await fetch("/api/staff/payments", { credentials: "same-origin" }); if (!response.ok) throw new Error("Төлбөрийн жагсаалтыг авч чадсангүй."); state.data = await response.json(); render(); if (success) message(success, true); }
      async function post(payload) { const response = await fetch("/api/staff/payments", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, credentials: "same-origin", body: JSON.stringify(payload) }); const body = await response.json().catch(() => null); if (!response.ok) throw new Error(body?.error?.message || "Төлбөрийн мэдээллийг хадгалж чадсангүй."); return body; }
      q("#payment-list").addEventListener("click", async (event) => {
        const target = event.target.closest("button"); if (!target || target.disabled) return;
        if (target.dataset.paymentDetail) { state.openId = target.dataset.paymentDetail; render(); return; }
        if (target.dataset.waitlistDetail) { state.openWaitlistId = target.dataset.waitlistDetail; render(); return; }
        if (target.matches("[data-waitlist-close]")) { state.openWaitlistId = ""; render(); return; }
        if (target.matches("[data-payment-cancel]")) { state.openId = ""; render(); return; }
        if (target.dataset.paymentChecked) { try { await post({ action: "payment.checked-not-found", paymentRequestId: target.dataset.paymentChecked }); await refresh("Шалгаснаа тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.paymentUndo) { try { await post({ action: "payment.undo-tentative", receivedPaymentId: target.dataset.paymentUndo }); await refresh("Тэмдэглэлийг буцаалаа."); } catch (error) { message(error.message); } return; }
        if (target.dataset.creditRefund) { if (!confirm("Буцаан төлсөн гэж тэмдэглэх үү?")) return; try { await post({ action: "payment-credit.refund", creditId: target.dataset.creditRefund }); await refresh("Буцаан төлсөн гэж тэмдэглэлээ."); } catch (error) { message(error.message); } return; }
        if (target.dataset.paymentRelease) { if (!confirm("Суудлыг суллах уу? Дараа нь өөр бүртгэл авч болно.")) return; try { await post({ action: "payment.release-seat", paymentRequestId: target.dataset.paymentRelease }); state.openId = ""; await refresh("Суудлыг суллалаа."); } catch (error) { message(error.message); } }
        if (target.dataset.promotionExisting) { if (!confirm("Энэ хүүхдийг өмнөх бүртгэлтэй холбож баталгаажуулах уу?")) return; state.pendingId = target.dataset.promotionChild; render(); try { await post({ action: "promotion.use-existing-student", draftChildId: target.dataset.promotionChild, studentId: target.dataset.promotionExisting }); await refresh("Бүртгэл баталгаажлаа."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); } }
        if (target.dataset.promotionNew) { if (!confirm("Шинэ хүүхдийн бүртгэл үүсгэж баталгаажуулах уу?")) return; state.pendingId = target.dataset.promotionNew; render(); try { await post({ action: "promotion.create-new-student", draftChildId: target.dataset.promotionNew }); await refresh("Бүртгэл баталгаажлаа."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); } }
      });
      q("#payment-list").addEventListener("submit", async (event) => {
        const form = event.target; if (!form.matches("[data-payment-form]")) return; event.preventDefault();
        const item = state.data.items.find((entry) => entry.installmentId === form.dataset.paymentForm); if (!item) return;
        const receivedAt = new Date(form.elements.receivedAt.value).toISOString(); const amountMnt = Number(form.elements.amount.value); const source = form.elements.source.value;
        state.pendingId = item.installmentId; render();
        const approveSeat = form.elements.approveSeat.checked; const remainingDueAt = form.elements.remainingDueAt.value ? new Date(form.elements.remainingDueAt.value).toISOString() : undefined;
        try { await post({ action: "payment.record", paymentRequestId: item.paymentRequestId, allocations: [{ installmentId: item.installmentId, amountMnt }], source, receivedAt, approveSeatConfirmation: approveSeat, remainingPaymentDueAt: remainingDueAt, idempotencyKey: `manual:${item.paymentRequestId}:${item.installmentId}:${source}:${receivedAt}:${amountMnt}` }); state.openId = ""; await refresh("Төлбөрийн баримтыг тэмдэглэлээ."); } catch (error) { message(error.message); } finally { state.pendingId = ""; render(); }
      });
      q("#payment-list").addEventListener("input", (event) => { const input = event.target; if (input.name !== "amount") return; const form = input.closest("form"); const partial = Number(input.value) < Number(input.max); const seat = form.querySelector("[data-partial-seat]"); seat.hidden = !partial; if (!partial) { form.elements.approveSeat.checked = false; form.querySelector("[data-remaining-deadline]").hidden = true; form.elements.remainingDueAt.required = false; } });
      q("#payment-list").addEventListener("change", (event) => { const input = event.target; if (input.name !== "approveSeat") return; const deadline = input.closest("form").querySelector("[data-remaining-deadline]"); deadline.hidden = !input.checked; deadline.querySelector("input").required = input.checked; });
      (async () => { const session = await fetch("/api/staff/session", { credentials: "same-origin" }).then((response) => response.ok ? response.json() : null); if (!session?.authenticated || !(session.capabilities || []).includes("payment.view")) { show("tool-denied"); return; } show("tool-app"); try { await refresh(); } catch (error) { message(error.message || "Төлбөрийн жагсаалтыг авч чадсангүй."); } })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
