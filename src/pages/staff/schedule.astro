---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Хуваарь | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Хуваарь</span></span></a></header>
    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Хуваарь</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Хуваарь</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Огноотой хуваарь</p><h1>Хуваарь</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <label class="staff-year-picker">Сургалт, арга хэмжээ <select id="offering-select"></select></label>
        <div id="schedule-content"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, fillSelect, formatDate, getOverview, hasSetupAccess, postOverviewAction } from "../../scripts/staff-setup.js";

      const state = { data: null, offeringId: new URLSearchParams(location.search).get("offering") || "", selectedClassId: "", editingClass: "" };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const offerings = () => (state.data?.offerings || []).filter((entry) => entry.status === "active");
      const selectedOffering = () => offerings().find((entry) => entry.id === state.offeringId);
      const classes = () => (state.data?.classes || []).filter((entry) => entry.offeringId === state.offeringId);
      const kindLabel = (kind) => ({ annual_course: "Жилийн сургалт", summer_course: "Зуны сургалт", event: "Арга хэмжээ" })[kind] || "";
      const recurrenceLabel = (kind) => ({ weekly: "7 хоног бүр", weekdays: "Ажлын өдрүүдэд", daily: "Өдөр бүр" })[kind] || "";
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") {
        state.data = await getOverview();
        if (!offerings().some((entry) => entry.id === state.offeringId)) state.offeringId = offerings()[0]?.id || "";
        if (!classes().some((entry) => entry.id === state.selectedClassId)) state.selectedClassId = classes()[0]?.id || "";
        render(); message(success, Boolean(success));
      }
      function render() {
        fillSelect(q("#offering-select"), offerings(), state.offeringId, (entry) => `${kindLabel(entry.kind)} · ${entry.title}`);
        const offering = selectedOffering();
        if (!offering) { q("#schedule-content").innerHTML = `<p class="staff-empty">Эхлээд сургалт эсвэл арга хэмжээ нэмнэ үү.</p>`; return; }
        if (offering.kind === "event") { renderEvent(offering); return; }
        renderCourse(offering);
      }
      function renderEvent(offering) {
        const occurrence = (state.data.eventOccurrences || []).find((entry) => entry.offeringId === offering.id);
        q("#schedule-content").innerHTML = `<section class="staff-operation-section"><div class="staff-section-heading"><div><span class="staff-kind-label">Арга хэмжээ</span><h2>${escape(offering.title)}</h2></div><a class="button secondary" href="/staff/offerings/">Засах</a></div>${occurrence ? `<dl class="staff-event-summary"><div><dt>Өдөр</dt><dd>${formatDate(occurrence.localDate)}</dd></div><div><dt>Цаг</dt><dd>${escape(occurrence.startTime)}–${escape(occurrence.endTime)}</dd></div><div><dt>Суудал</dt><dd>${occurrence.capacity}</dd></div><div><dt>Төлбөр</dt><dd>${offering.chargeMode === "free" ? "Үнэгүй" : "Төлбөртэй"}</dd></div><div><dt>Бүртгэл</dt><dd>${occurrence.registrationOpen ? "Нээлттэй" : "Хаалттай"}</dd></div></dl>` : `<p class="staff-empty">Арга хэмжээний огноо оруулаагүй байна.</p>`}</section>`;
      }
      function renderCourse(offering) {
        q("#schedule-content").innerHTML = `<section class="staff-operation-section" aria-labelledby="classes-title"><div class="staff-section-heading"><div><span class="staff-kind-label">${kindLabel(offering.kind)}</span><h2 id="classes-title">${escape(offering.title)}</h2><p class="staff-muted">Хөтөлбөр: ${escape(offering.programName || "Ноорог бэлтгэж байна")}</p></div><button id="add-class" class="button primary" type="button">Анги нэмэх</button></div><div id="class-editor"></div><div id="class-list" class="staff-record-list"></div></section><section class="staff-operation-section" aria-labelledby="calendar-title"><div class="staff-section-heading"><div><h2 id="calendar-title">Хичээлийн хуваарь</h2><p class="staff-muted">Нийтэлсэн огноонууд нь бодит хуваарийн эх сурвалж болно.</p></div><label>Анги <select id="calendar-class"></select></label></div><div id="calendar-editor"></div></section>`;
        renderClasses(offering); renderCalendar(offering);
        q("#add-class").onclick = () => { state.editingClass = "new"; renderClasses(offering); q("#class-recurrence")?.focus(); };
        q("#calendar-class").onchange = (event) => { state.selectedClassId = event.target.value; renderCalendar(offering); };
      }
      function classForm(entry, offering) {
        const recurrence = entry?.recurrenceKind || (offering.kind === "summer_course" ? "daily" : "weekly");
        const firstDate = entry?.firstDate || offering.startsOn || "";
        const lastDate = entry?.lastDate || (offering.kind === "summer_course" ? offering.endsOn : "") || "";
        return `<form id="class-form" class="staff-compact-form"><input id="class-id" type="hidden" value="${escape(entry?.id || "")}" /><input id="class-updated" type="hidden" value="${escape(entry?.updatedAt || "")}" /><label>Давтамж <select id="class-recurrence"><option value="weekly" ${recurrence === "weekly" ? "selected" : ""}>7 хоног бүр</option><option value="weekdays" ${recurrence === "weekdays" ? "selected" : ""}>Ажлын өдрүүдэд</option><option value="daily" ${recurrence === "daily" ? "selected" : ""}>Өдөр бүр</option></select></label><label id="weekly-field">Гараг <select id="class-weekday">${(state.data.weekdays || []).map((weekday) => `<option value="${escape(weekday)}" ${entry?.weeklyWeekday === weekday || (!entry && weekday === "Бямба") ? "selected" : ""}>${escape(weekday)}</option>`).join("")}</select></label><label>Эхлэх өдөр <input id="class-first" type="date" required value="${escape(firstDate)}" /></label><label>Төлөвлөсөн дуусах өдөр <input id="class-last" type="date" value="${escape(lastDate)}" /></label><label>Эхлэх цаг <input id="class-start" type="time" required value="${escape(entry?.startTime || "10:00")}" /></label><label>Дуусах цаг <input id="class-end" type="time" required value="${escape(entry?.endTime || "11:20")}" /></label><label>Суудлын тоо <input id="class-capacity" type="number" min="1" max="80" required value="${escape(entry?.capacity || "12")}" /></label>${entry ? `<label class="staff-check"><input id="class-open" type="checkbox" ${entry.registrationOpen ? "checked" : ""} /> Бүртгэл нээлттэй</label>` : `<p class="staff-muted">Шинэ ангийн бүртгэл анх хаалттай байна.</p>`}<div class="staff-form-actions staff-wide"><button class="button secondary" data-class-cancel type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div>${entry?.canDelete ? `<div class="staff-danger-zone staff-wide"><p>Энэ анги хуваарь, бүртгэлд ашиглагдаагүй байна.</p><button class="button danger" data-class-delete type="button">Анги устгах</button></div>` : ""}</form>`;
      }
      function updateRecurrenceField() { const weekly = q("#class-recurrence")?.value === "weekly"; const field = q("#weekly-field"); const select = q("#class-weekday"); if (field) field.hidden = !weekly; if (select) select.disabled = !weekly; }
      function renderClasses(offering) {
        const editing = classes().find((entry) => entry.id === state.editingClass);
        q("#class-editor").innerHTML = state.editingClass ? classForm(editing, offering) : "";
        q("#class-list").innerHTML = classes().length ? classes().map((entry) => `<article><div><strong>${escape(entry.displayLabel)}</strong><p>${recurrenceLabel(entry.recurrenceKind)} · ${escape(entry.startTime)}–${escape(entry.endTime)} · ${entry.capacity} суудал · ${entry.registrationOpen ? "Бүртгэл нээлттэй" : "Бүртгэл хаалттай"}</p></div><button class="button secondary" type="button" data-class-edit="${escape(entry.id)}">Засах</button></article>`).join("") : `<p class="staff-empty">Анги оруулаагүй байна.</p>`;
        q("#class-editor form")?.addEventListener("submit", (event) => saveClass(event, offering));
        q("#class-editor [data-class-cancel]")?.addEventListener("click", () => { state.editingClass = ""; renderClasses(offering); });
        q("#class-recurrence")?.addEventListener("change", updateRecurrenceField); updateRecurrenceField();
        q("#class-editor [data-class-delete]")?.addEventListener("click", () => {
          if (editing && window.confirm(`${editing.displayLabel} ангийг бүрмөсөн устгах уу?`)) run(() => postOverviewAction("class.delete", { classSessionId: editing.id, expectedUpdatedAt: editing.updatedAt }), "Ангийг устгалаа.");
        });
        q("#class-list").querySelectorAll("[data-class-edit]").forEach((button) => button.onclick = () => { state.editingClass = button.dataset.classEdit; renderClasses(offering); q("#class-recurrence")?.focus(); });
      }
      function saveClass(event, offering) {
        event.preventDefault(); if (!event.currentTarget.reportValidity()) return;
        run(() => postOverviewAction("class.save", { id: q("#class-id").value || undefined, expectedUpdatedAt: q("#class-updated").value || undefined, offeringId: offering.id, recurrenceKind: q("#class-recurrence").value, firstDate: q("#class-first").value, lastDate: q("#class-last").value || null, weeklyWeekday: q("#class-weekday").disabled ? null : q("#class-weekday").value, startTime: q("#class-start").value, endTime: q("#class-end").value, capacity: Number(q("#class-capacity").value), registrationOpen: Boolean(q("#class-open")?.checked) }), q("#class-id").value ? "Ангийг хадгаллаа." : "Ангийг үүслээ. Бүртгэл анх хаалттай байна.");
      }
      function slotText(slot) { return slot.status === "scheduled" ? `${slot.lessonSequence}. ${escape(slot.lessonTitle)}` : slot.status === "cancelled" ? `Цуцлагдсан: ${slot.cancelledLessonSequence}. ${escape(slot.cancelledLessonTitle)}` : `Хичээлгүй${slot.reasonLabel ? `: ${escape(slot.reasonLabel)}` : ""}`; }
      function warningSummary(revision) { return (revision.warnings || []).map((warning) => warning.kind === "planned_period_overrun" ? `Анхааруулга: Хуваарь төлөвлөсөн хугацаанаас хэтэрч, ${formatDate(warning.finalLessonDate)}-нд дуусна.` : `Анхааруулга: ${warning.lessonCount} хичээл ${escape(warning.label)} хугацаанд орж байна.`).map((text) => `<p class="staff-calendar-warning">${text}</p>`).join(""); }
      function calendarRow(slot) { return `<li><span><strong>${formatDate(slot.localDate)} · ${escape(slot.startTime)}</strong><br /><small>${slotText(slot)}</small>${(slot.holidayWarnings || []).map((label) => `<br /><small class="staff-calendar-warning">Анхааруулга: ${escape(label)} хугацаанд орж байна.</small>`).join("")}</span>${slot.isHistorical ? `<span class="staff-history-label">Өнгөрсөн</span>` : ""}</li>`; }
      function renderCalendar(offering) {
        const availableClasses = classes(); fillSelect(q("#calendar-class"), availableClasses, state.selectedClassId, (entry) => entry.displayLabel);
        const container = q("#calendar-editor"); const selected = availableClasses.find((entry) => entry.id === state.selectedClassId);
        if (!selected) { container.innerHTML = `<p class="staff-empty">Эхлээд анги нэмнэ үү.</p>`; return; }
        const revisions = (state.data.revisions || []).filter((entry) => entry.classSessionId === selected.id);
        const draft = revisions.find((entry) => entry.status === "draft"); const published = revisions.find((entry) => entry.status === "published");
        if (!draft) {
          const rows = published?.slots.map(calendarRow).join("") || "";
          container.innerHTML = published ? `<div class="staff-empty"><p><strong>Нийтлэгдсэн хуваарь</strong> · ${published.slots.length} огноо</p><p>Хөтөлбөр: ${escape(offering.programName || "")}</p>${warningSummary(published)}<ol class="staff-calendar-list">${rows}</ol><button class="button primary" data-change-draft type="button">Өөрчлөх ноорог эхлүүлэх</button></div>` : `<div class="staff-empty"><p>Энэ ангид хуваарь үүсгээгүй байна.</p><p>Хөтөлбөр: <strong>${escape(offering.programName || "Бэлтгэж байна")}</strong></p>${offering.programStatus === "published" ? `<button class="button primary" id="calendar-generate" type="button">Хуваарь үүсгэх</button>` : `<p>Хуваарь үүсгэхийн өмнө хөтөлбөрөө нийтэлнэ үү.</p>`}</div>`;
          container.querySelector("[data-change-draft]")?.addEventListener("click", () => { if (window.confirm("Нийтлэгдсэн хуваариас өөрчлөх ноорог эхлүүлэх үү?")) run(() => postOverviewAction("calendar.change-draft", { classSessionId: selected.id }), "Өөрчлөх ноорог үүслээ."); });
          container.querySelector("#calendar-generate")?.addEventListener("click", () => run(() => postOverviewAction("calendar.generate", { classSessionId: selected.id }), "Хуваарийн ноорог үүслээ."));
          return;
        }
        renderDraftCalendar(container, draft, offering);
      }
      function renderDraftCalendar(container, draft, offering) {
        const rows = draft.slots.map((slot) => `<li><span><strong>${formatDate(slot.localDate)} · ${escape(slot.startTime)}</strong><br /><small>${slotText(slot)}</small>${(slot.holidayWarnings || []).map((label) => `<br /><small class="staff-calendar-warning">Анхааруулга: ${escape(label)} хугацаанд орж байна.</small>`).join("")}</span>${slot.canCancel ? `<button class="button secondary" type="button" data-cancel-slot="${escape(slot.id)}">Хичээл цуцлах</button>` : slot.isHistorical ? `<span class="staff-history-label">Өнгөрсөн</span>` : ""}</li>`).join("");
        const finalDate = [...draft.slots].filter((slot) => slot.status === "scheduled").at(-1)?.localDate;
        container.innerHTML = `<div class="staff-calendar-draft"><p class="staff-draft-label">Ноорог хуваарь · ${draft.slots.length} огноо${finalDate ? ` · Сүүлийн хичээл ${formatDate(finalDate)}` : ""}</p><p>Хөтөлбөр: <strong>${escape(offering.programName || "")}</strong></p>${warningSummary(draft)}<div class="staff-calendar-actions"><form id="calendar-date-action" class="staff-compact-form"><label>Өдөр <input id="action-date" type="date" required /></label><label>Үйлдэл <select id="action-kind"><option value="exclude">Хичээлгүй болгох</option><option value="restore">Амралтын үеэр хичээл оруулах</option></select></label><label class="staff-wide">Тэмдэглэл <input id="action-reason" maxlength="160" /></label><button class="button secondary staff-wide" type="submit">Өдрийн өөрчлөлт хадгалах</button></form><form id="calendar-extra" class="staff-compact-form"><label>Нэмэлт өдөр <input id="extra-date" type="date" required /></label><label>Эхлэх цаг <input id="extra-start" type="time" required /></label><label>Дуусах цаг <input id="extra-end" type="time" required /></label><label class="staff-wide">Тэмдэглэл <input id="extra-reason" maxlength="160" /></label><button class="button secondary staff-wide" type="submit">Нэмэлт хичээл оруулах</button></form></div><ol class="staff-calendar-list">${rows}</ol><div class="staff-form-actions"><button id="calendar-publish" class="button primary" type="button">Хуваарь нийтлэх</button></div></div>`;
        q("#calendar-date-action").onsubmit = (event) => { event.preventDefault(); if (event.currentTarget.reportValidity()) run(() => postOverviewAction("calendar.change", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, kind: q("#action-kind").value, localDate: q("#action-date").value, reasonLabel: q("#action-reason").value }), "Өдрийн өөрчлөлтийг хадгаллаа."); };
        q("#calendar-extra").onsubmit = (event) => { event.preventDefault(); if (event.currentTarget.reportValidity()) run(() => postOverviewAction("calendar.change", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, kind: "extra", localDate: q("#extra-date").value, startTime: q("#extra-start").value, endTime: q("#extra-end").value, reasonLabel: q("#extra-reason").value }), "Нэмэлт хичээлийг орууллаа."); };
        container.querySelectorAll("[data-cancel-slot]").forEach((button) => button.onclick = () => { if (window.confirm("Энэ хичээлийг цуцлах уу? Дараагийн хичээлүүдийн огноо шинэчлэгдэнэ.")) run(() => postOverviewAction("calendar.cancel", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt, slotId: button.dataset.cancelSlot }), "Цуцлалтыг ноорогт орууллаа."); });
        q("#calendar-publish").onclick = () => { if (window.confirm("Энэ огноотой хуваарийг нийтлэх үү?")) run(() => postOverviewAction("calendar.publish", { revisionId: draft.id, expectedUpdatedAt: draft.updatedAt }), "Хуваарь нийтлэгдлээ."); };
      }
      async function run(work, success) { message(); try { await work(); state.editingClass = ""; await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      q("#offering-select").onchange = (event) => { state.offeringId = event.target.value; state.selectedClassId = ""; state.editingClass = ""; history.replaceState(null, "", `?offering=${encodeURIComponent(state.offeringId)}`); render(); };
      (async () => { if (!(await hasSetupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
