---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Хуваарь | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Хуваарь</span></span></a></header>
    <main class="staff-shell staff-program-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Хуваарь</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Хуваарь</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Огноотой хуваарь</p><h1>Хуваарь</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <div id="schedule-overview"></div>
        <div id="schedule-detail"></div>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { createStaffActionMenuController } from "../../scripts/staff-action-menus.js";
      import { buildAnnualTimetableReport, buildClassScheduleReport, copyReportToClipboard, printReport } from "../../scripts/staff-reports.js";
      import { escape, formatDate, getOverview, hasSetupAccess, postOverviewAction } from "../../scripts/staff-setup.js";

      const params = new URLSearchParams(location.search);
      const state = { data: null, contextOfferingId: params.get("offering") || "", selectedClassId: params.get("class") || "", editingOfferingBreakId: "", calendarAction: null, discardingCalendar: false };
      const q = (selector) => document.querySelector(selector);
      const actionMenus = createStaffActionMenuController(document);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const offerings = () => (state.data?.offerings || []).filter((entry) => entry.status === "active" && entry.kind !== "event");
      const visibleOfferings = () => state.contextOfferingId ? offerings().filter((entry) => entry.id === state.contextOfferingId) : offerings();
      const classes = (offeringId) => (state.data?.classes || []).filter((entry) => entry.offeringId === offeringId);
      const selectedClass = () => (state.data?.classes || []).find((entry) => entry.id === state.selectedClassId);
      const selectedOffering = () => {
        const entry = selectedClass();
        return entry ? offerings().find((offering) => offering.id === entry.offeringId) : null;
      };
      const offeringBreaks = (offeringId) => (state.data?.offeringBreaks || []).filter((entry) => entry.offeringId === offeringId);
      const kindLabel = (kind) => ({ annual_course: "Жилийн сургалт", summer_course: "Зуны сургалт", event: "Арга хэмжээ" })[kind] || "";
      function message(value = "", success = false) { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; }
      async function refresh(success = "") {
        state.data = await getOverview();
        if (state.contextOfferingId && !offerings().some((entry) => entry.id === state.contextOfferingId)) state.contextOfferingId = "";
        if (state.selectedClassId && !selectedClass()) state.selectedClassId = "";
        render(); message(success, Boolean(success));
      }
      function render() {
        renderOverview();
        const offering = selectedOffering();
        if (!offering) { q("#schedule-detail").innerHTML = ""; return; }
        renderCourse(offering);
      }
      function calendarFor(classSessionId) { const revisions = (state.data?.revisions || []).filter((entry) => entry.classSessionId === classSessionId); return revisions.find((entry) => entry.status === "draft") || revisions.find((entry) => entry.status === "published") || null; }
      function calendarSpan(calendar) { const active = (calendar?.slots || []).filter((slot) => slot.status === "scheduled"); const first = active[0]; const last = active.at(-1); return calendar ? `${active.length} хичээл${first && last ? ` · ${formatDate(first.localDate)} – ${formatDate(last.localDate)}` : ""}` : "Хуваарь үүсгээгүй"; }
      function selectClass(classSessionId) { actionMenus.close(); state.selectedClassId = classSessionId; state.editingOfferingBreakId = ""; state.calendarAction = null; history.replaceState(null, "", `?class=${encodeURIComponent(classSessionId)}`); render(); q("#schedule-detail").scrollIntoView({ behavior: "smooth", block: "start" }); }
      function renderOverview() {
        const rows = visibleOfferings().map((offering) => `<section class="staff-schedule-overview-group"><div class="staff-section-heading"><div><span class="staff-kind-label">${kindLabel(offering.kind)}</span><h2>${escape(offering.title)}</h2></div></div>${classes(offering.id).length ? `<div class="staff-schedule-overview-list">${classes(offering.id).map((entry) => `<article><div><strong>${escape(entry.displayLabel)}</strong><p>${calendarSpan(calendarFor(entry.id))}</p></div><button class="button secondary" type="button" data-open-class="${escape(entry.id)}">Нээх</button></article>`).join("")}</div>` : `<p class="staff-empty">Анги оруулаагүй байна. <a href="/staff/offerings/?offering=${encodeURIComponent(offering.id)}">Сургалтаас анги нэмнэ үү.</a></p>`}</section>`).join("");
        q("#schedule-overview").innerHTML = `<section class="staff-operation-section" aria-labelledby="schedule-overview-title"><div class="staff-section-heading"><div><p class="staff-kind-label">Огноотой хуваарь</p><h2 id="schedule-overview-title">Ангиудын хуваарь</h2></div><div class="staff-report-actions"><button id="annual-schedule-print" class="button secondary" type="button">Жилийн хуваарь хэвлэх / PDF</button><button id="annual-schedule-copy" class="button secondary" type="button">Excel-д хуулах</button></div></div>${rows || `<p class="staff-empty">Эхлээд сургалт нэмнэ үү.</p>`}</section>`;
        q("#schedule-overview").querySelectorAll("[data-open-class]").forEach((button) => button.onclick = () => selectClass(button.dataset.openClass));
        q("#annual-schedule-print").onclick = () => printReport(buildAnnualTimetableReport(state.data));
        q("#annual-schedule-copy").onclick = async () => { try { await copyReportToClipboard(buildAnnualTimetableReport(state.data)); message("Excel-д хуулах хүснэгтийг хууллаа.", true); } catch { message("Хүснэгтийг хуулж чадсангүй."); } };
      }
      function renderCourse(offering) {
        q("#schedule-detail").innerHTML = `<section class="staff-operation-section" aria-labelledby="calendar-title"><div class="staff-section-heading"><div><span class="staff-kind-label">${kindLabel(offering.kind)}</span><h2 id="calendar-title">Хичээлийн хуваарь</h2></div><button id="close-calendar" class="button secondary" type="button">Хаах</button></div><div id="calendar-editor"></div></section><div id="offering-breaks"></div>`;
        renderCalendar(offering); renderOfferingBreaks(offering);
        q("#close-calendar").onclick = () => { state.selectedClassId = ""; state.editingOfferingBreakId = ""; state.calendarAction = null; history.replaceState(null, "", location.pathname); render(); };
      }
      function offeringBreakForm(entry) {
        return `<form id="offering-break-form" class="staff-compact-form"><label class="staff-wide">Нэр <input id="offering-break-label" required maxlength="160" value="${escape(entry?.label || "")}" /></label><label>Эхлэх өдөр <input id="offering-break-start" type="date" required value="${escape(entry?.startsOn || "")}" /></label><label>Дуусах өдөр <input id="offering-break-end" type="date" required value="${escape(entry?.endsOn || "")}" /></label><label class="staff-wide">Тэмдэглэл <input id="offering-break-note" maxlength="500" value="${escape(entry?.note || "")}" /></label><div class="staff-form-actions staff-wide"><button class="button secondary" data-break-cancel type="button">Болих</button><button class="button primary" type="submit">Хадгалах</button></div></form>`;
      }
      function renderOfferingBreaks(offering) {
        const container = q("#offering-breaks"); const breaks = offeringBreaks(offering.id); const editing = breaks.find((entry) => entry.id === state.editingOfferingBreakId);
        container.innerHTML = `<details class="staff-schedule-changes" ${state.editingOfferingBreakId ? "open" : ""}><summary>Тусгай өөрчлөлт</summary><div class="staff-schedule-changes-content"><p class="staff-muted">Энд оруулсан хугацаанд энэ сургалтын бүх ангид хичээл орохгүй. Нэг ангид хийх өөрчлөлтийг доорх тухайн ангийн хуваарьт оруулна.</p><button class="button secondary" data-add-offering-break type="button">Бүх ангид хичээлгүй хугацаа оруулах</button>${state.editingOfferingBreakId ? offeringBreakForm(editing) : ""}${breaks.length ? `<div class="staff-record-list">${breaks.map((entry) => `<article><div><strong>${escape(entry.label)}</strong><p>${formatDate(entry.startsOn)} – ${formatDate(entry.endsOn)}${entry.note ? ` · ${escape(entry.note)}` : ""}</p></div><div class="staff-inline-actions"><button class="button secondary" type="button" data-break-edit="${escape(entry.id)}">Засах</button><button class="button secondary" type="button" data-break-remove="${escape(entry.id)}">Устгах</button></div></article>`).join("")}</div>` : ""}</div></details>`;
        container.querySelector("[data-add-offering-break]").onclick = () => { state.editingOfferingBreakId = "new"; renderOfferingBreaks(offering); q("#offering-break-label")?.focus(); };
        container.querySelector("[data-break-cancel]")?.addEventListener("click", () => { state.editingOfferingBreakId = ""; renderOfferingBreaks(offering); });
        container.querySelectorAll("[data-break-edit]").forEach((button) => button.onclick = () => { state.editingOfferingBreakId = button.dataset.breakEdit; renderOfferingBreaks(offering); q("#offering-break-label")?.focus(); });
        container.querySelectorAll("[data-break-remove]").forEach((button) => button.onclick = () => { const entry = breaks.find((item) => item.id === button.dataset.breakRemove); if (entry && window.confirm("Энэ хичээлгүй хугацааг устгах уу?")) run(() => postOverviewAction("offering-break.remove", { breakId: entry.id, expectedUpdatedAt: entry.updatedAt }), "Хичээлгүй хугацааг устгалаа."); });
        container.querySelector("#offering-break-form")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; const saved = breaks.find((entry) => entry.id === state.editingOfferingBreakId); run(() => postOverviewAction("offering-break.save", { id: saved?.id, expectedUpdatedAt: saved?.updatedAt, offeringId: offering.id, label: q("#offering-break-label").value, startsOn: q("#offering-break-start").value, endsOn: q("#offering-break-end").value, note: q("#offering-break-note").value }), "Бүх ангид хичээлгүй хугацааг хадгаллаа."); });
      }
      function slotText(slot) { return slot.status === "scheduled" ? escape(slot.lessonTitle) : slot.status === "cancelled" ? `${escape(slot.cancelledLessonTitle)} · Хичээлгүй` : `${escape(slot.reasonLabel || "Хичээлгүй")} · Хичээлгүй`; }
      function warningSummary(revision) { return (revision.warnings || []).map((warning) => warning.kind === "planned_period_overrun" ? `Анхааруулга: Хуваарь төлөвлөсөн хугацаанаас хэтэрч, ${formatDate(warning.finalLessonDate)}-нд дуусна.` : `Анхааруулга: ${warning.lessonCount} хичээл ${escape(warning.label)} хугацаанд орж байна.`).map((text) => `<p class="staff-calendar-warning">${text}</p>`).join(""); }
      function calendarSlotKey(slot) { return `${slot.localDate}|${slot.startTime}|${slot.lessonSequence || slot.cancelledLessonSequence || ""}`; }
      function scheduledSlots(revision) { return (revision?.slots || []).filter((slot) => slot.status === "scheduled" && slot.lessonSequence); }
      function calendarSummary(revision, offering) {
        const scheduled = scheduledSlots(revision); const first = scheduled[0]; const last = scheduled.at(-1);
        return `<div class="staff-calendar-summary"><p><strong>${scheduled.length} хичээл</strong>${first && last ? ` · ${formatDate(first.localDate)} – ${formatDate(last.localDate)}` : ""}</p><p>Хөтөлбөр: <strong>${escape(offering.programName || "")}</strong></p></div>`;
      }
      function rowActions(slot) {
        const action = slot.status === "scheduled" ? "Хичээлгүй болгох" : slot.holidayWarnings?.length ? "Энэ өдөр хичээллэх" : "Хичээлтэй болгох";
        return `<details class="staff-calendar-menu" data-staff-action-menu><summary aria-label="Хуваарийн үйлдэл" title="Үйлдэл">⋯</summary><div class="staff-lesson-menu-actions"><button type="button" data-staff-action-menu-item data-calendar-action="${slot.status === "scheduled" ? "cancel" : "restore"}" data-slot-key="${escape(calendarSlotKey(slot))}">${action}</button></div></details>`;
      }
      function actionEditor(slot, revision) {
        const action = state.calendarAction;
        const consequence = "Энэ өдрөөс хойших хичээлүүдийн огноо өөрчлөгдөнө.";
        if (action.kind === "restore") return `<li class="staff-calendar-action-row"><div><strong>${formatDate(slot.localDate)}-ний хичээл хуваарьт орно.</strong><p class="staff-muted">${consequence}</p></div><div class="staff-inline-actions"><button class="button secondary" data-calendar-action-cancel type="button">Болих</button><button class="button primary" data-calendar-restore-confirm="${escape(slot.localDate)}" type="button">Хадгалах</button></div></li>`;
        return `<li class="staff-calendar-action-row"><div><strong>${formatDate(slot.localDate)}-ний хичээл хичээлгүй болно.</strong><p class="staff-muted">${consequence}</p></div><div class="staff-inline-actions"><button class="button secondary" data-calendar-action-cancel type="button">Болих</button><button class="button primary" data-calendar-cancel-confirm="${escape(slot.id)}" type="button">Хадгалах</button></div></li>`;
      }
      function calendarRow(slot, revision) {
        const action = state.calendarAction; const isActionRow = action?.slotKey === calendarSlotKey(slot);
        if (isActionRow && revision.status === "draft") return actionEditor(slot, revision);
        const number = slot.lessonSequence || slot.cancelledLessonSequence || "–";
        const editable = (slot.status === "scheduled" && !slot.isHistorical) || (slot.status === "no_class" && slot.canRestore);
        return `<li class="staff-calendar-row ${slot.status === "scheduled" ? "" : "staff-calendar-exception"}"><span class="staff-order">${number}</span><div><strong>${formatDate(slot.localDate)} · ${escape(slot.startTime)}</strong><p>${slotText(slot)}</p>${(slot.holidayWarnings || []).map((label) => `<small class="staff-calendar-warning">Анхааруулга: ${escape(label)} хугацаанд.</small>`).join("")}</div>${editable ? rowActions(slot) : slot.isHistorical ? `<span class="staff-history-label">Өнгөрсөн</span>` : ""}</li>`;
      }
      function renderCalendar(offering) {
        const availableClasses = classes(offering.id); const container = q("#calendar-editor"); const selected = availableClasses.find((entry) => entry.id === state.selectedClassId);
        if (!selected) { container.innerHTML = `<p class="staff-empty">Эхлээд анги нэмнэ үү.</p>`; return; }
        const revisions = (state.data.revisions || []).filter((entry) => entry.classSessionId === selected.id);
        const draft = revisions.find((entry) => entry.status === "draft"); const published = revisions.find((entry) => entry.status === "published");
        const calendar = draft || published;
        if (!calendar) {
          container.innerHTML = `<div class="staff-empty"><p>Энэ ангид хуваарь үүсгээгүй байна.</p><p>Хөтөлбөр: <strong>${escape(offering.programName || "Бэлтгэж байна")}</strong></p>${offering.programStatus === "published" ? `<button class="button primary" id="calendar-generate" type="button">Хуваарь үүсгэх</button>` : `<p>Хуваарь үүсгэхийн өмнө хөтөлбөрөө эхлээд хадгална уу.</p>`}</div>`;
          container.querySelector("#calendar-generate")?.addEventListener("click", () => run(() => postOverviewAction("calendar.generate", { classSessionId: selected.id }), "Хуваарь бэлэн боллоо."));
          return;
        }
        renderCalendarView(container, calendar, offering, selected, Boolean(draft));
      }
      async function beginCalendarAction(selected, draft, slotKey, kind) {
        if (!draft) {
          await postOverviewAction("calendar.change-draft", { classSessionId: selected.id });
          state.calendarAction = { slotKey, kind };
          await refresh("Хуваарийг засахад бэлэн боллоо.");
          return;
        }
        state.calendarAction = { slotKey, kind }; renderCalendar(selectedOffering());
      }
      function sameCalendarEntries(left, right, keys) {
        return left.length === right.length && left.every((entry, index) => keys.every((key) => (entry[key] ?? null) === (right[index]?.[key] ?? null)));
      }
      function hasSavedCalendarChanges(calendar) {
        if (!calendar.basedOnRevisionId) return true;
        const base = (state.data.revisions || []).find((entry) => entry.id === calendar.basedOnRevisionId);
        if (!base) return true;
        return !sameCalendarEntries(calendar.slots || [], base.slots || [], ["localDate", "startTime", "endTime", "slotSource", "status", "lessonId", "cancelledLessonSequence", "cancelledLessonTitle", "reasonLabel"])
          || !sameCalendarEntries(calendar.overrides || [], base.overrides || [], ["localDate", "behavior", "reasonLabel"]);
      }
      function renderCalendarView(container, calendar, offering, selected, editable) {
        actionMenus.close();
        const rows = calendar.slots.map((slot) => calendarRow(slot, calendar)).join("");
        const dirty = editable && hasSavedCalendarChanges(calendar);
        const calendarActions = state.discardingCalendar
          ? `<section class="staff-discard-confirm"><p>Хадгалаагүй хуваарийн өөрчлөлтүүдийг устгах уу?</p><div class="staff-form-actions"><button class="button primary" id="calendar-keep-editing" type="button">Үргэлжлүүлэн засах</button><button class="button danger" id="calendar-discard" type="button">Өөрчлөлтийг устгах</button></div></section>`
          : `<div class="staff-form-actions"><button id="calendar-close" class="button secondary" type="button">Болих</button><button id="calendar-save" class="button primary" type="button" ${dirty ? "" : "disabled"}>Хадгалах</button></div>`;
        const reportCalendar = (state.data.revisions || []).find((entry) => entry.classSessionId === selected.id && entry.status === "published");
        const reportActions = reportCalendar ? `<div class="staff-report-actions"><button id="class-schedule-print" class="button secondary" type="button">Хэвлэх / PDF</button><button id="class-schedule-copy" class="button secondary" type="button">Excel-д хуулах</button></div>` : "";
        container.innerHTML = `<div class="staff-calendar-draft">${calendarSummary(calendar, offering)}${warningSummary(calendar)}${reportActions}${editable ? `<details class="staff-calendar-extra" ${state.calendarAction?.kind === "extra" ? "open" : ""}><summary>Нэмэлт хичээл оруулах</summary><form id="calendar-extra" class="staff-compact-form"><label>Өдөр <input id="extra-date" type="date" required /></label><label>Эхлэх цаг <input id="extra-start" type="time" required /></label><label>Дуусах цаг <input id="extra-end" type="time" required /></label><label class="staff-wide">Тэмдэглэл <input id="extra-reason" maxlength="160" /></label><div class="staff-form-actions staff-wide"><button class="button primary" type="submit">Оруулах</button></div></form></details>` : ""}<ol class="staff-calendar-list">${rows}</ol>${editable ? calendarActions : ""}</div>`;
        const classReport = () => buildClassScheduleReport(offering, selected, reportCalendar);
        container.querySelector("#class-schedule-print")?.addEventListener("click", () => printReport(classReport()));
        container.querySelector("#class-schedule-copy")?.addEventListener("click", async () => { try { await copyReportToClipboard(classReport()); message("Excel-д хуулах хүснэгтийг хууллаа.", true); } catch { message("Хүснэгтийг хуулж чадсангүй."); } });
        container.querySelectorAll("[data-calendar-action]").forEach((button) => button.onclick = () => beginCalendarAction(selected, editable ? calendar : null, button.dataset.slotKey, button.dataset.calendarAction));
        container.querySelectorAll("[data-calendar-action-cancel]").forEach((button) => button.onclick = () => { state.calendarAction = null; renderCalendar(offering); });
        container.querySelector("[data-calendar-cancel-confirm]")?.addEventListener("click", (event) => run(() => postOverviewAction("calendar.cancel", { revisionId: calendar.id, expectedUpdatedAt: calendar.updatedAt, slotId: event.currentTarget.dataset.calendarCancelConfirm }), "Хичээлийг хичээлгүй болголоо."));
        container.querySelector("[data-calendar-restore-confirm]")?.addEventListener("click", (event) => run(() => postOverviewAction("calendar.change", { revisionId: calendar.id, expectedUpdatedAt: calendar.updatedAt, kind: "restore", localDate: event.currentTarget.dataset.calendarRestoreConfirm }), "Энэ өдрийг хичээлтэй болголоо."));
        container.querySelector("#calendar-extra")?.addEventListener("submit", (event) => { event.preventDefault(); if (!event.currentTarget.reportValidity()) return; run(() => postOverviewAction("calendar.change", { revisionId: calendar.id, expectedUpdatedAt: calendar.updatedAt, kind: "extra", localDate: q("#extra-date").value, startTime: q("#extra-start").value, endTime: q("#extra-end").value, reasonLabel: q("#extra-reason").value }), "Нэмэлт хичээл орууллаа."); });
        container.querySelector("#calendar-save")?.addEventListener("click", () => run(async () => { await postOverviewAction("calendar.publish", { revisionId: calendar.id, expectedUpdatedAt: calendar.updatedAt }); state.calendarAction = null; }, "Хуваарийг хадгаллаа."));
        container.querySelector("#calendar-close")?.addEventListener("click", () => {
          if (dirty) { state.discardingCalendar = true; renderCalendar(offering); return; }
          run(() => postOverviewAction("calendar.discard", { revisionId: calendar.id, expectedUpdatedAt: calendar.updatedAt }), "");
        });
        container.querySelector("#calendar-keep-editing")?.addEventListener("click", () => { state.discardingCalendar = false; renderCalendar(offering); });
        container.querySelector("#calendar-discard")?.addEventListener("click", () => run(async () => {
          await postOverviewAction("calendar.discard", { revisionId: calendar.id, expectedUpdatedAt: calendar.updatedAt });
          state.discardingCalendar = false; state.calendarAction = null;
        }, "Өөрчлөлтийг устгалаа."));
      }
      async function run(work, success) { message(); try { await work(); state.editingOfferingBreakId = ""; state.calendarAction = null; state.discardingCalendar = false; await refresh(success); } catch (error) { message(error.message || "Хадгалж чадсангүй."); } }
      (async () => { if (!(await hasSetupAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
