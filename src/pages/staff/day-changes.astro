---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Өдрийн өөрчлөлт | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Өдрийн өөрчлөлт</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Өдрийн өөрчлөлт</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1>Өдрийн өөрчлөлт</h1><p class="staff-muted">Ээлжит хичээлийг цуцлах, орлуулах цаг оруулах, дараагийн хичээлүүдийн огноог хянах</p></div><div class="staff-inline-actions"><a class="button secondary" href="/staff/makeups/">Нөхөлт</a><a class="staff-back-link" href="/staff/">Буцах</a></div></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <form id="day-date-form" class="staff-attendance-date-form"><label>Өдөр<input id="day-date" type="date" required /></label><button id="day-today" class="button secondary" type="button">Өнөөдөр</button></form>
        <section aria-labelledby="day-list-title"><h2 id="day-list-title" class="staff-list-heading">Ээлжит хичээл сонгох</h2><div id="day-list" class="staff-day-list"></div></section>
        <section id="day-operation" class="staff-day-operation"></section>
        <section id="day-confirmation" class="staff-day-confirmation" hidden></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, formatDate, getDailyChanges, hasDayChangeAccess, postDailyChange, setStaffButtonBusy } from "../../scripts/staff-setup.js";

      const state = { data: null, date: "", selectedSlotId: "", action: "", pending: "", loading: false, loadError: "", confirmation: null, operationId: "", actionValues: {}, requestEpoch: 0, feedback: null, savedUnscheduledLessons: [], savedReplacements: [], savedAutomaticEndAdditions: [] };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const busy = () => Boolean(state.pending);
      const applying = () => state.pending === "apply";
      const feedback = (placement = "form") => state.feedback && (!state.confirmation || placement === "confirmation") ? `<p class="staff-action-status ${state.feedback.tone === "error" ? "staff-action-error" : ""}" role="status" aria-live="polite">${escape(state.feedback.text)}</p>` : "";
      const clearOutcome = () => { state.feedback = null; state.savedUnscheduledLessons = []; state.savedReplacements = []; state.savedAutomaticEndAdditions = []; };
      const invalidateRequest = () => { state.requestEpoch += 1; state.pending = ""; };
      const resetReview = () => { state.confirmation = null; state.operationId = ""; clearOutcome(); };

      async function refresh(success = "") {
        const requestEpoch = state.requestEpoch;
        state.loading = true;
        state.loadError = "";
        render();
        try {
          const data = await getDailyChanges(state.date);
          if (requestEpoch !== state.requestEpoch) return;
          state.data = data;
          state.date = state.data.selectedDate;
          const entries = selectedOccurrences();
          if (!entries.some((entry) => entry.slotId === state.selectedSlotId)) {
            state.selectedSlotId = entries.find((entry) => entry.status === "scheduled")?.slotId || entries[0]?.slotId || "";
          }
          q("#day-date").value = state.date;
          const params = new URLSearchParams({ date: state.date });
          if (state.selectedSlotId) params.set("occurrence", state.selectedSlotId);
          history.replaceState(null, "", `?${params.toString()}`);
          if (success) message(success, true);
        } catch {
          if (requestEpoch !== state.requestEpoch) return;
          state.loadError = "Өдрийн хуваарийг авч чадсангүй.";
        } finally {
          if (requestEpoch === state.requestEpoch) {
            state.loading = false;
            render();
          }
        }
      }

      function selectedOccurrences() { return (state.data?.occurrences || []).filter((entry) => entry.localDate === state.date); }

      function selectedOccurrence() { return selectedOccurrences().find((entry) => entry.slotId === state.selectedSlotId) || null; }

      function reviewingSelected(entry) {
        const payload = state.confirmation?.payload;
        return Boolean(payload && ((payload.kind === "single-cancel" && payload.slotId === entry.slotId)
          || (payload.kind === "extra" && payload.sourceSlotId === entry.slotId)));
      }

      function sessionTabs(entries) {
        if (!entries.length) return `<p class="staff-empty">Энэ өдөр хичээлгүй.</p>`;
        return `<div class="staff-day-session-tabs" role="group" aria-label="Хичээлийн цаг">${entries.map((entry) => `<button type="button" class="${entry.slotId === state.selectedSlotId ? "selected" : ""}" data-day-slot="${escape(entry.slotId)}" aria-pressed="${entry.slotId === state.selectedSlotId}" ${applying() ? "disabled" : ""}>${escape(entry.startTime)}–${escape(entry.endTime)}</button>`).join("")}</div>`;
      }

      function replacementForm(entry, replacement) {
        const values = state.actionValues;
        const replacementDate = values.replacementDate || "";
        const replacementStartTime = values.replacementStartTime || entry.startTime;
        return `<form class="staff-compact-form staff-day-change-form" data-day-change-form data-change-kind="single-cancel" ${state.pending === "preview" ? 'aria-busy="true"' : ""}><p class="staff-muted">${replacement ? "Цуцлагдсан цагийн оронд нэг ээлжит цаг нэмнэ. Хичээлүүд цагийн дарааллаар товлогдоно." : "Энэ хичээлийн цагийг цуцална. Хичээлийн бүрэн дарааллыг хадгалах эцсийн шинэ өдрийг урьдчилан харна."}</p>${replacement ? `<div class="staff-day-change-fields"><label>Орлуулах өдөр<input name="replacementDate" type="date" value="${escape(replacementDate)}" required ${busy() ? "disabled" : ""} /></label><label>Эхлэх цаг<input name="replacementStartTime" type="time" value="${escape(replacementStartTime)}" required ${busy() ? "disabled" : ""} /></label></div>` : ""}<div class="staff-inline-actions staff-wide"><button class="button primary" type="submit" data-day-preview-submit ${busy() ? "disabled" : ""}>Урьдчилан харах</button><button class="button secondary" type="button" data-day-action="" ${applying() ? "disabled" : ""}>Болих</button></div>${feedback()}</form>`;
      }

      function selectedLessonWorkspace(entry) {
        if (!entry) return "";
        const blocked = entry.attendanceCount > 0;
        const reviewing = reviewingSelected(entry);
        const replacementScheduled = Boolean(entry.replacement || entry.automaticEndAddition)
          || state.savedReplacements.some((replacement) => replacement.source
            && replacement.source.classSessionId === entry.classSessionId
            && replacement.source.localDate === entry.localDate
            && replacement.source.startTime === entry.startTime
            && replacement.source.endTime === entry.endTime
            && replacement.source.curriculumLessonId === entry.curriculumLessonId);
        const automaticCompletion = Boolean(entry.automaticEndAddition)
          || state.savedAutomaticEndAdditions.some((addition) => addition.source
            && addition.source.classSessionId === entry.classSessionId
            && addition.source.localDate === entry.localDate
            && addition.source.startTime === entry.startTime
            && addition.source.endTime === entry.endTime
            && addition.source.curriculumLessonId === entry.curriculumLessonId);
        const status = entry.status === "cancelled" ? `<span class="staff-day-cancelled">Цуцалсан</span>` : blocked ? `<span class="staff-muted">Ирц тэмдэглэсэн</span>` : "";
        const makeup = entry.activeMakeupAssignmentCount ? `<p class="staff-muted">Энэ нэртэй хичээлд ${entry.activeMakeupAssignmentCount} идэвхтэй нөхөх товлолт байна. Огноо шилжвэл хичээлийн таних тэмдэг хэвээр үлдэнэ.</p>` : "";
        const controls = reviewing ? "" : entry.status === "scheduled" && !blocked
          ? `<div class="staff-day-action-choices" role="group" aria-label="Өөрчлөлтийн төрөл"><button class="staff-day-action-choice ${state.action === "single-cancel" ? "selected" : ""}" type="button" data-day-action="single-cancel" aria-pressed="${state.action === "single-cancel"}" ${applying() ? "disabled" : ""}>Энэ хичээлийг цуцлах</button><button class="staff-day-action-choice ${state.action === "single-replace" ? "selected" : ""}" type="button" data-day-action="single-replace" aria-pressed="${state.action === "single-replace"}" ${applying() ? "disabled" : ""}>Цуцлаад орлуулах цаг товлох</button></div>`
          : entry.status === "cancelled" && !replacementScheduled ? `<div class="staff-day-action-choices" role="group" aria-label="Өөрчлөлтийн төрөл"><button class="staff-day-action-choice ${state.action === "cancelled-replace" ? "selected" : ""}" type="button" data-day-action="cancelled-replace" aria-pressed="${state.action === "cancelled-replace"}" ${applying() ? "disabled" : ""}>Орлуулах ээлжит цаг оруулах</button></div>`
            : entry.status === "cancelled" ? `<p class="staff-muted">${automaticCompletion ? "Хичээлийн бүрэн дарааллыг хадгалах эцсийн ээлжит цаг автоматаар нэмэгдсэн." : "Энэ цуцлагдсан цагт орлуулах ээлжит цаг аль хэдийн товлогдсон."}${(entry.replacement || entry.automaticEndAddition)?.slotId ? "" : " Орлуулах цагийг хянаж шалгана уу."}</p>` : "";
        const form = reviewing ? "" : state.action === "single-cancel" ? replacementForm(entry, false)
          : state.action === "single-replace" ? replacementForm(entry, true)
            : state.action === "cancelled-replace" && !replacementScheduled ? `<form class="staff-compact-form staff-day-change-form" data-day-change-form data-change-kind="extra" ${state.pending === "preview" ? 'aria-busy="true"' : ""}><p class="staff-muted">Цуцлагдсан хичээлийн оронд нэг ээлжит цаг нэмнэ. Нэртэй хичээлүүд цагийн дарааллаар таарна.</p><div class="staff-day-change-fields"><label>Орлуулах өдөр<input name="localDate" type="date" value="${escape(state.actionValues.localDate || "")}" required ${busy() ? "disabled" : ""} /></label><label>Эхлэх цаг<input name="startTime" type="time" value="${escape(state.actionValues.startTime || entry.startTime)}" required ${busy() ? "disabled" : ""} /></label></div><div class="staff-inline-actions staff-wide"><button class="button primary" type="submit" data-day-preview-submit ${busy() ? "disabled" : ""}>Урьдчилан харах</button><button class="button secondary" type="button" data-day-action="" ${applying() ? "disabled" : ""}>Болих</button></div>${feedback()}</form>` : "";
        return `<article class="staff-day-selected"><div><p class="eyebrow">Сонгосон хичээл</p><h2>${escape(entry.classLabel)} · ${escape(entry.startTime)}–${escape(entry.endTime)}</h2><p>${entry.lessonSequence}. ${escape(entry.lessonTitle)} · ${escape(entry.offeringTitle)}</p>${makeup}</div>${status}${controls}${form}</article>`;
      }

      function renderDay() {
        if (state.loading || state.loadError) {
          q("#day-list").innerHTML = `<section class="staff-day-loading" role="status" aria-live="polite"><p>${state.loading ? "Ачаалж байна…" : escape(state.loadError)}</p>${state.loadError ? '<button class="button secondary" type="button" data-day-retry>Дахин оролдох</button>' : ""}</section>`;
          q("#day-operation").hidden = true;
          q("#day-operation").innerHTML = "";
          return;
        }
        const entries = selectedOccurrences();
        q("#day-list").innerHTML = `${sessionTabs(entries)}${selectedLessonWorkspace(selectedOccurrence())}`;
        const scheduled = entries.filter((entry) => entry.status === "scheduled");
        const list = scheduled.map((entry) => `<li>${escape(entry.classLabel)} · ${escape(entry.startTime)}–${escape(entry.endTime)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}</li>`).join("");
        const reviewingWhole = state.confirmation && ["day-cancel", "day-move"].includes(state.confirmation.payload.kind);
        const form = reviewingWhole ? "" : state.action === "day-cancel" ? `<form class="staff-compact-form staff-day-change-form" data-day-change-form data-change-kind="day-cancel" ${state.pending === "preview" ? 'aria-busy="true"' : ""}><p class="staff-muted">Энэ өдрийн ээлжит цагууд цуцлагдана. Анги бүрийн бүрэн дарааллыг хадгалах эцсийн шинэ өдрүүдийг урьдчилан харна.</p><div class="staff-inline-actions staff-wide"><button class="button primary" type="submit" data-day-preview-submit ${busy() ? "disabled" : ""}>Урьдчилан харах</button><button class="button secondary" type="button" data-day-action="" ${applying() ? "disabled" : ""}>Болих</button></div>${feedback()}</form>`
          : state.action === "day-move" ? `<form class="staff-compact-form staff-day-change-form" data-day-change-form data-change-kind="day-move" ${state.pending === "preview" ? 'aria-busy="true"' : ""}><p class="staff-muted">Энэ өдрийн ээлжит хичээлүүдийг цуцлаад сонгосон өдөрт орлуулна. Нэртэй хичээлүүдийн огноог урьдчилан харна.</p><div class="staff-day-change-fields"><label>Орлуулах өдөр<input name="replacementDate" type="date" value="${escape(state.actionValues.replacementDate || "")}" required ${busy() ? "disabled" : ""} /></label></div><div class="staff-inline-actions staff-wide"><button class="button primary" type="submit" data-day-preview-submit ${busy() ? "disabled" : ""}>Урьдчилан харах</button><button class="button secondary" type="button" data-day-action="" ${applying() ? "disabled" : ""}>Болих</button></div>${feedback()}</form>` : "";
        const reviewingIndividual = state.confirmation && ["single-cancel", "extra"].includes(state.confirmation.payload.kind);
        q("#day-operation").hidden = Boolean(reviewingIndividual);
        q("#day-operation").innerHTML = scheduled.length ? `<section class="staff-day-whole"><h2>Өдрийн бүх ээлжит хичээл</h2><p class="staff-muted">${scheduled.length} ээлжит хичээлийн цагт нөлөөлнө.</p><ul>${list}</ul>${reviewingWhole ? "" : `<div class="staff-day-action-choices" role="group" aria-label="Өдрийн өөрчлөлтийн төрөл"><button class="staff-day-action-choice ${state.action === "day-cancel" ? "selected" : ""}" type="button" data-day-action="day-cancel" aria-pressed="${state.action === "day-cancel"}" ${applying() ? "disabled" : ""}>Өдрийг бүхэлд нь цуцлах</button><button class="staff-day-action-choice ${state.action === "day-move" ? "selected" : ""}" type="button" data-day-action="day-move" aria-pressed="${state.action === "day-move"}" ${applying() ? "disabled" : ""}>Өдрийг цуцлаад орлуулах өдөр товлох</button></div>`}${form}</section>` : "";
      }

      function renderConfirmation() {
        const container = q("#day-confirmation");
        const confirmation = state.confirmation;
        if (!confirmation) { container.hidden = true; container.innerHTML = ""; return; }
        const individual = ["single-cancel", "extra"].includes(confirmation.payload.kind);
        (individual ? q("#day-list") : q("#day-operation")).insertAdjacentElement("afterend", container);
        const preview = confirmation.preview;
        container.hidden = false;
        const automatic = preview.automaticEndAdditions || [];
        const describeChange = (entry) => `<strong>${entry.lessonSequence}. ${escape(entry.lessonTitle)}</strong><br /><span class="staff-muted">${entry.before ? `${formatDate(entry.before.localDate)} · ${escape(entry.before.startTime)}–${escape(entry.before.endTime)}` : "Шинээр нэмнэ"} → ${entry.after ? `${formatDate(entry.after.localDate)} · ${escape(entry.after.startTime)}–${escape(entry.after.endTime)}` : entry.before ? "Товлоогүй" : "Цуцална"}</span>`;
        const byClass = new Map();
        for (const entry of preview.changes || []) { const list = byClass.get(entry.classLabel) || []; list.push(entry); byClass.set(entry.classLabel, list); }
        const compactChanges = [...byClass.entries()].map(([classLabel, entries]) => {
          const first = entries[0]; const last = entries[entries.length - 1];
          const classAdditions = automatic.filter((entry) => entry.classLabel === classLabel);
          const primary = first ? `<li>${describeChange(first)}</li>` : "";
          const final = last && last !== first ? `<p class="staff-muted">Сүүлийн өөрчлөлт: ${describeChange(last)}</p>` : "";
          const additions = classAdditions.map((entry) => `<p class="staff-muted"><strong>Шинэ ээлжит цаг:</strong> ${formatDate(entry.localDate)} · ${escape(entry.startTime)}–${escape(entry.endTime)}${entry.lessonSequence ? ` · ${entry.lessonSequence}. ${escape(entry.lessonTitle || "")}` : ""}</p>`).join("");
          const remaining = entries.slice(1, -1);
          const detail = remaining.length ? `<details><summary>Бүх өөрчлөлтийг харах (${remaining.length})</summary><ul class="staff-day-preview-list">${remaining.map((entry) => `<li>${describeChange(entry)}</li>`).join("")}</ul></details>` : "";
          return `<section class="staff-day-preview-class"><h3>${escape(classLabel)}</h3><ul class="staff-day-preview-list">${primary}</ul>${additions}${final}${detail}</section>`;
        }).join("");
        const unscheduled = preview.unscheduledLessons?.length ? `<p class="staff-calendar-warning">Дараах хичээл одоогоор товлогдоогүй: ${preview.unscheduledLessons.map((entry) => `${escape(entry.classLabel)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}`).join(", ")}.</p>` : "";
        const hasReplacement = Boolean(confirmation.payload.replacementDate);
        const intro = confirmation.payload.kind === "single-cancel" && hasReplacement
          ? `<strong>Сонгосон ээлжит хичээлийн цаг цуцлагдаж,</strong> оронд нь шинэ ээлжит цаг нэмэгдэнэ. Гэхдээ хичээлүүд цагийн дарааллаар товлогдоно.`
          : confirmation.payload.kind === "day-move"
            ? `<strong>Сонгосон өдрийн ээлжит хичээлүүд цуцлагдаж,</strong> анги бүрт сонгосон өдөр шинэ ээлжит цаг нэмэгдэнэ. Гэхдээ хичээлүүд цагийн дарааллаар товлогдоно.`
            : ["single-cancel", "day-cancel"].includes(confirmation.payload.kind)
              ? `<strong>${confirmation.payload.kind === "day-cancel" ? "Сонгосон өдрийн ээлжит хичээлүүд цуцлагдана." : "Сонгосон ээлжит хичээлийн цаг цуцлагдана."}</strong>${automatic.length ? " Хичээлийн бүрэн дарааллыг хадгалах шаардлагатай эцсийн ээлжит цаг нэмэгдэнэ." : ""}`
              : "<strong>Шинэ ээлжит хичээлийн цаг нэмэгдэнэ.</strong>";
        const destructive = ["single-cancel", "day-cancel"].includes(confirmation.payload.kind) && !confirmation.payload.replacementDate;
        const finalLabel = destructive ? (confirmation.payload.kind === "day-cancel" ? "Өдрийг цуцлах" : "Цуцлахыг баталгаажуулах")
          : confirmation.payload.kind === "extra" ? "Орлуулах ээлжит цагийг хадгалах"
            : confirmation.payload.kind === "day-move" ? "Орлуулах өдрийг хадгалах" : "Орлуулах цагийг хадгалах";
        container.innerHTML = `<h2>${escape(confirmation.title)}</h2><p>${intro}</p>${compactChanges}${unscheduled}${preview.warnings?.length ? `<p class="staff-calendar-warning">Тухайн товлолтод хамаарах анхааруулга: ${preview.warnings.map(escape).join(", ")}</p>` : ""}<div class="staff-inline-actions"><button id="day-confirm-edit" class="button secondary" type="button" ${applying() ? "disabled" : ""}>Засах</button><button id="day-confirm-abandon" class="button secondary" type="button" ${applying() ? "disabled" : ""}>Болих</button><button id="day-confirm-save" class="button ${destructive ? "danger" : "primary"}" type="button" data-day-confirm-label="${escape(finalLabel)}" ${busy() ? "disabled" : ""}>${escape(finalLabel)}</button></div>${feedback("confirmation")}`;
        container.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function render() {
        renderDay(); renderConfirmation();
        if (state.loading || state.loadError) {
          q("#day-date").disabled = applying();
          q("#day-today").disabled = applying();
          return;
        }
        const previewButton = q("[data-day-preview-submit]");
        setStaffButtonBusy(previewButton, state.pending === "preview", "Тооцоолж байна…");
        const confirmButton = q("#day-confirm-save");
        if (confirmButton) setStaffButtonBusy(confirmButton, state.pending === "apply", "Хадгалж байна…");
        q("#day-date").disabled = applying();
        q("#day-today").disabled = applying();
        const selected = selectedOccurrence();
        if (state.savedReplacements.length) {
          q("#day-list").insertAdjacentHTML("beforeend", `<section class="staff-day-result" role="status"><strong>Орлуулах ээлжит цаг товлогдлоо.</strong>${state.savedReplacements.map((entry) => `<p>${escape(entry.classLabel)} · ${formatDate(entry.localDate)} · ${escape(entry.startTime)}–${escape(entry.endTime)}${entry.lessonSequence ? ` · ${entry.lessonSequence}. ${escape(entry.lessonTitle || "")}` : ""}<br /><a href="/staff/attendance/?date=${encodeURIComponent(entry.localDate)}&occurrence=${encodeURIComponent(entry.slotId)}">Орлуулах хичээл рүү очих</a></p>`).join("")}</section>`);
        }
        if (state.savedAutomaticEndAdditions.length) {
          q("#day-list").insertAdjacentHTML("beforeend", `<section class="staff-day-result" role="status"><strong>Хичээлийн бүрэн дарааллыг хадгалах эцсийн ээлжит цаг нэмэгдлээ.</strong>${state.savedAutomaticEndAdditions.map((entry) => `<p>${escape(entry.classLabel)} · ${formatDate(entry.localDate)} · ${escape(entry.startTime)}–${escape(entry.endTime)}${entry.lessonSequence ? ` · ${entry.lessonSequence}. ${escape(entry.lessonTitle || "")}` : ""}<br /><a href="/staff/attendance/?date=${encodeURIComponent(entry.localDate)}&occurrence=${encodeURIComponent(entry.slotId)}">Нэмэгдсэн хичээл рүү очих</a></p>`).join("")}</section>`);
        }
        if (state.savedUnscheduledLessons.length && selected) {
          q("#day-list").insertAdjacentHTML("beforeend", `<p class="staff-calendar-warning"><strong>Өөрчлөлт хадгалагдсан.</strong> Дараах хичээл одоогоор товлогдоогүй: ${state.savedUnscheduledLessons.map((entry) => `${escape(entry.classLabel)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}`).join(", ")}.</p>`);
        }
      }

      async function preview(payload, title) {
        if (busy()) return;
        const requestEpoch = ++state.requestEpoch;
        state.operationId = ""; state.confirmation = null; state.pending = "preview"; state.feedback = { text: "Тооцоолж байна…", tone: "busy" }; message(""); render();
        try {
          const result = await postDailyChange("day-change.preview", payload);
          if (requestEpoch !== state.requestEpoch) return;
          state.confirmation = { payload, title, preview: result, editor: { action: state.action, actionValues: { ...state.actionValues }, selectedSlotId: state.selectedSlotId } }; state.feedback = null;
        } catch (error) {
          if (requestEpoch !== state.requestEpoch) return;
          state.feedback = { text: error.message || "Өөрчлөлтийг шалгаж чадсангүй.", tone: "error" };
        } finally {
          if (requestEpoch === state.requestEpoch) { state.pending = ""; render(); }
        }
      }

      async function applyConfirmed() {
        if (!state.confirmation || busy()) return;
        const requestEpoch = ++state.requestEpoch;
        state.pending = "apply"; state.feedback = { text: "Хадгалж байна…", tone: "busy" }; message(""); render();
        try {
          const result = await postDailyChange("day-change.apply", { ...state.confirmation.payload, previewFingerprint: state.confirmation.preview.previewFingerprint, operationId: state.operationId ||= crypto.randomUUID() });
          if (requestEpoch !== state.requestEpoch) return;
          state.confirmation = null; state.operationId = ""; state.action = ""; state.actionValues = {}; state.savedUnscheduledLessons = result.unscheduledLessons || []; state.savedReplacements = result.replacements || []; state.savedAutomaticEndAdditions = result.automaticEndAdditions || [];
          const success = "Өдрийн хуваарийн өөрчлөлтийг хадгаллаа.";
          state.feedback = { text: "Өөрчлөлт хадгалагдлаа.", tone: "success" };
          try { await refresh(success); }
          catch {
            render();
            message(`${success} Хуваарийг дахин ачаалж чадсангүй. Ижил баталгаажуулалтыг дахин бүү дарна уу.`, true);
          }
        } catch (error) {
          if (requestEpoch !== state.requestEpoch) return;
          state.feedback = error.responseReceived
            ? { text: error.message || "Өөрчлөлтийг хадгалж чадсангүй.", tone: "error" }
            : { text: "Хадгалсан эсэх тодорхойгүй байна. Ижил баталгаажуулалтыг дахин дарж шалгана уу.", tone: "error" };
        } finally {
          if (requestEpoch === state.requestEpoch) { state.pending = ""; render(); }
        }
      }

      q("#tool-app").addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button || button.type === "submit" || applying()) return;
        if (button.id === "day-today") { invalidateRequest(); state.date = state.data.today; state.selectedSlotId = ""; state.action = ""; resetReview(); refresh(); return; }
        if (button.id === "day-confirm-edit") {
          const editor = state.confirmation?.editor;
          invalidateRequest(); state.confirmation = null; state.operationId = ""; state.feedback = null;
          if (editor) { state.action = editor.action; state.actionValues = { ...editor.actionValues }; state.selectedSlotId = editor.selectedSlotId; }
          render();
          requestAnimationFrame(() => q("[data-day-change-form] input, [data-day-change-form] button")?.focus());
          return;
        }
        if (button.id === "day-confirm-abandon") { invalidateRequest(); state.confirmation = null; state.operationId = ""; state.action = ""; state.actionValues = {}; state.feedback = null; render(); return; }
        if (button.id === "day-confirm-save") { applyConfirmed(); return; }
        if (button.dataset.dayRetry !== undefined) { invalidateRequest(); refresh(); return; }
        if (button.dataset.daySlot) { invalidateRequest(); state.selectedSlotId = button.dataset.daySlot; state.action = ""; state.actionValues = {}; resetReview(); render(); return; }
        if (button.dataset.dayAction !== undefined) { invalidateRequest(); state.action = button.dataset.dayAction; state.actionValues = {}; resetReview(); render(); }
      });

      q("#tool-app").addEventListener("submit", (event) => {
        event.preventDefault();
        const form = event.target;
        if (applying() || !form.reportValidity()) return;
        if (form.id === "day-date-form") { invalidateRequest(); state.date = q("#day-date").value; state.selectedSlotId = ""; state.action = ""; state.actionValues = {}; resetReview(); refresh(); return; }
        if (!form.matches("[data-day-change-form]")) return;
        const values = new FormData(form);
        const kind = form.dataset.changeKind;
        const selected = selectedOccurrence();
        state.actionValues = Object.fromEntries(values.entries());
        if (kind === "single-cancel" && selected) { const replacementDate = values.get("replacementDate") || ""; preview({ kind, slotId: selected.slotId, replacementDate, replacementStartTime: values.get("replacementStartTime") || "" }, replacementDate ? "Цуцлаад орлуулах цаг товлох" : "Энэ хичээлийг цуцлах"); return; }
        if (kind === "extra" && selected) { preview({ kind, sourceSlotId: selected.slotId, classSessionId: selected.classSessionId, localDate: values.get("localDate"), startTime: values.get("startTime"), note: "Орлуулах хичээл" }, "Орлуулах ээлжит цаг оруулах"); return; }
        if (kind === "day-cancel") { preview({ kind, sourceDate: state.date }, `${formatDate(state.date)}-ний бүх хичээлийг цуцлах`); return; }
        if (kind === "day-move") { preview({ kind, sourceDate: state.date, replacementDate: values.get("replacementDate") }, `${formatDate(state.date)}-ний хичээлүүдийг цуцлаад орлуулах өдөр товлох`); }
      });

      q("#tool-app").addEventListener("input", (event) => {
        const form = event.target.closest("[data-day-change-form]");
        if (!form || busy()) return;
        state.actionValues = Object.fromEntries(new FormData(form).entries());
        if (state.confirmation) { state.confirmation = null; state.operationId = ""; state.feedback = null; render(); }
      });
      q("#day-date").addEventListener("change", () => { if (applying()) return; invalidateRequest(); state.date = q("#day-date").value; state.selectedSlotId = ""; state.action = ""; state.actionValues = {}; resetReview(); refresh(); });
      (async () => { if (!(await hasDayChangeAccess())) { show("tool-denied"); return; } const query = new URLSearchParams(location.search); state.date = query.get("date") || ""; state.selectedSlotId = query.get("occurrence") || ""; await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
