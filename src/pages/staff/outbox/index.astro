---
import { siteIdentity } from "../../../content/homepage";
import "../../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><meta name="theme-color" content="#073aaf" /><title>Илгээсэн и-мэйл | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Илгээсэн и-мэйл</span></span></a></header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Илгээсэн и-мэйл</p><h1>Түр хүлээнэ үү</h1></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Илгээсэн и-мэйл</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Удирдлага</p><h1>Илгээсэн и-мэйл</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <form id="outbox-filter" class="staff-compact-form staff-settings-secondary"><label>Хайх <input id="outbox-search" type="search" placeholder="Хүлээн авагч эсвэл гарчиг" /></label><label>Төлөв <select id="outbox-status"><option value="all">Бүгд</option><option value="sent">Илгээгдсэн</option><option value="queued">Хүлээгдэж буй</option><option value="failed">Амжилтгүй</option></select></label><div class="staff-form-actions"><button class="button secondary" type="submit">Шүүх</button></div></form>
        <section id="outbox-list" class="staff-operation-section"></section>
        <section id="outbox-detail" class="staff-operation-section" hidden></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      const q = (selector) => document.querySelector(selector);
      const escapeHtml = (value) => String(value ?? "").replace(/[&<>\"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[character]);
      const dateTime = (value) => value ? new Intl.DateTimeFormat("mn-MN", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "—";
      const status = (value) => ({ sent: "Илгээгдсэн", queued: "Хүлээгдэж буй", failed: "Амжилтгүй" })[value] || value;
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; };
      function message(value = "") { const node = q("#tool-message"); node.textContent = value; node.hidden = !value; }
      async function load() {
        const params = new URLSearchParams({ status: q("#outbox-status").value, q: q("#outbox-search").value });
        const response = await fetch(`/api/staff/outbox?${params}`, { credentials: "same-origin", cache: "no-store" });
        if (!response.ok) throw new Error((await response.json().catch(() => null))?.error?.message || "И-мэйлийн бүртгэлийг авч чадсангүй.");
        const data = await response.json();
        q("#outbox-list").innerHTML = data.emails.length ? `<div class="staff-list">${data.emails.map((email) => `<article class="staff-list-row"><p><strong>${escapeHtml(email.subject)}</strong><br><span class="staff-muted">${escapeHtml(email.intendedToEmail)} · ${escapeHtml(status(email.status))}</span><br><span class="staff-muted">${escapeHtml(dateTime(email.sentAt || email.failedAt || email.queuedAt))} · ${escapeHtml(email.messageType)}</span></p><button class="button secondary" type="button" data-email-id="${escapeHtml(email.id)}">Харах</button></article>`).join("")}</div>` : `<p class="staff-empty">Тохирох и-мэйл олдсонгүй.</p>`;
      }
      async function detail(id) {
        const response = await fetch(`/api/staff/outbox?email=${encodeURIComponent(id)}`, { credentials: "same-origin", cache: "no-store" });
        if (!response.ok) throw new Error("И-мэйлийн бүртгэлийг авч чадсангүй.");
        const { email } = await response.json(); const context = [email.context?.guardianName, email.context?.childName, email.context?.classLabel].filter(Boolean).join(" · ");
        const node = q("#outbox-detail"); node.hidden = false;
        const text = typeof email.text === "string" && email.text.trim() ? email.text : "Энэ и-мэйлийн аюулгүй агуулга хадгалагдаагүй байна.";
        node.innerHTML = `<div class="staff-page-heading"><h2>${escapeHtml(email.subject)}</h2><button id="close-detail" class="button secondary" type="button">Хаах</button></div><dl class="staff-summary-list"><div><dt>Зориулсан хаяг</dt><dd>${escapeHtml(email.intendedToEmail)}</dd></div>${email.actualDeliveryEmail ? `<div><dt>Бодит хүргэлтийн хаяг</dt><dd>${escapeHtml(email.actualDeliveryEmail)}</dd></div>` : ""}<div><dt>Төлөв</dt><dd>${escapeHtml(status(email.status))}</dd></div><div><dt>Төрөл</dt><dd>${escapeHtml(email.messageType)}</dd></div><div><dt>Үүсгэсэн</dt><dd>${escapeHtml(dateTime(email.queuedAt))}</dd></div>${email.sentAt ? `<div><dt>Илгээсэн</dt><dd>${escapeHtml(dateTime(email.sentAt))}</dd></div>` : ""}${context ? `<div><dt>Холбогдох мэдээлэл</dt><dd>${escapeHtml(context)}</dd></div>` : ""}<div><dt>Оролдлого</dt><dd>${escapeHtml(email.attemptCount)}</dd></div>${email.bccRecipients?.length ? `<div><dt>Дотоод хуулбар</dt><dd>${escapeHtml(email.bccRecipients.join(", "))}</dd></div>` : ""}</dl><h3>Аюулгүй агуулга</h3><p class="staff-muted">${escapeHtml(text).replace(/\\n/g, "<br>")}</p>`;
        q("#close-detail").addEventListener("click", () => { node.hidden = true; node.innerHTML = ""; });
      }
      q("#outbox-list").addEventListener("click", (event) => {
        const button = event.target.closest("[data-email-id]"); if (!button) return;
        message(); detail(button.dataset.emailId).catch((error) => message(error.message || "И-мэйлийн дэлгэрэнгүйг авч чадсангүй."));
      });
      q("#outbox-filter").addEventListener("submit", (event) => { event.preventDefault(); message(); load().catch((error) => message(error.message)); });
      (async () => {
        const sessionResponse = await fetch("/api/staff/session", { credentials: "same-origin" });
        const session = await sessionResponse.json();
        if (!session.authenticated || !(session.capabilities || []).includes("admin.settings.manage")) { show("tool-denied"); return; }
        show("tool-app");
        try { await load(); } catch (error) { message(error.message || "И-мэйлийн бүртгэлийг авч чадсангүй."); }
      })().catch(() => { show("tool-app"); message("Нэвтрэх эрхийг шалгаж чадсангүй."); });
    </script>
  </body>
</html>
