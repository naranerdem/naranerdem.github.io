---
import { siteIdentity } from "../../content/homepage";
import { currentGradeOptions, guardianRelationshipOptions, registrationFormCopy } from "../../content/registration";
import "../../styles/global.css";
---

<html lang="mn">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Шинэ бүртгэл оруулах | {siteIdentity.name}</title></head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header"><a class="brand-link" href="/staff/payments/"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>Бүртгэл, төлбөр</span></span></a></header>
    <main class="staff-shell">
      <section id="intake-booting" class="staff-state" role="status"><p class="eyebrow">Бүртгэл, төлбөр</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="intake-denied" class="staff-state" hidden><p class="eyebrow">Бүртгэл, төлбөр</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="staff-back-link" href="/staff/payments/">Буцах</a></section>
      <section id="intake-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Бүртгэл, төлбөр</p><h1>Шинэ бүртгэл оруулах</h1><p class="staff-muted">Утас, цаасан маягт эсвэл биечлэн авсан бүртгэл</p></div><a class="staff-back-link" href="/staff/payments/">Буцах</a></div>
        <p id="intake-status" class="staff-error" role="status" aria-live="polite" hidden></p>
        <form id="staff-registration-intake" class="staff-payment-form staff-registration-intake" novalidate>
          <h2 class="staff-wide">Бүртгэл авсан хэлбэр</h2>
          <label><span class="staff-intake-label">Хэлбэр<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="intakeChannel" required><option value="">Сонгоно уу</option><option value="paper_form">Цаасан маягт</option><option value="phone">Утсаар</option><option value="in_person">Биечлэн</option></select></label>
          <p id="intake-channel-help" class="staff-muted staff-wide">Бүртгэл авсан хэлбэрээ сонгоно уу.</p>
          <h2 class="staff-wide">Асран хамгаалагч</h2>
          <label><span class="staff-intake-label">Нэр<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="guardianName" required maxlength="160" /></label><label><span class="staff-intake-label">Харилцаа<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="guardianRelationship" required><option value="">{registrationFormCopy.selectPlaceholder}</option>{guardianRelationshipOptions.map((option) => <option value={option}>{option}</option>)}</select></label>
          <label><span class="staff-intake-label">И-мэйл<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="guardianEmail" type="email" required maxlength="254" /></label><label><span class="staff-intake-label">Үндсэн утас<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="guardianPhone" type="tel" required maxlength="40" /></label>
          <label><span class="staff-intake-label">Facebook нэр<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="guardianFacebook" required maxlength="160" /></label><label>Нэмэлт утас<input name="guardianSecondaryPhone" type="tel" maxlength="40" /></label>
          <label class="staff-wide"><span class="staff-intake-label">Хаяг<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><textarea name="guardianAddress" rows="2" required maxlength="500"></textarea></label>
          <h2 class="staff-wide">Хүүхэд</h2>
          <label><span class="staff-intake-label">Овог<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="surname" required maxlength="100" /></label><label><span class="staff-intake-label">Нэр<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="givenName" required maxlength="100" /></label>
          <label><span class="staff-intake-label">Төрсөн огноо<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><input name="dateOfBirth" type="date" required /></label><label><span class="staff-intake-label">Хүйс<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="gender" required><option value="not_specified" selected>Тодруулаагүй</option><option value="female">Эмэгтэй</option><option value="male">Эрэгтэй</option></select></label>
          <label><span class="staff-intake-label">Одоогийн анги<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="currentGrade" required><option value="">{registrationFormCopy.selectPlaceholder}</option>{currentGradeOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select></label><label>Сургууль<input name="currentSchool" maxlength="160" /></label>
          <label><span class="staff-intake-label">Сургалтын шат<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="stage" required></select></label><label><span class="staff-intake-label">Анги, цаг<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="classSessionId" required></select></label>
          <label><span class="staff-intake-label">Төлбөрийн сонголт<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span><select name="paymentPlanCode" required></select></label><label>Урилгын код<input name="codeInput" maxlength="120" /></label>
          <label>Өмнө сурч байсан эсэх<select name="returningStatus"><option value="new">Үгүй</option><option value="returning">Тийм</option></select></label><label id="previous-stage-field" hidden>Өмнө дүүргэсэн шат<select name="previousStageCode"><option value="">Сонгоно уу</option><option value="stage_1">1-р шат</option><option value="stage_2">2-р шат</option><option value="stage_3">3-р шат</option><option value="unknown">Тодорхойгүй</option></select></label>
          <section class="staff-wide staff-intake-rules"><h2>Журам, зөвшөөрөл</h2><div id="guardian-rule-link" class="staff-muted"></div><label class="staff-check"><input name="parentRulesAcknowledged" type="checkbox" required /><span>Эцэг эх / асран хамгаалагч бүртгэлийн нөхцөлийг зөвшөөрсөн.<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span></label><div id="student-rule-link" class="staff-muted"></div><label class="staff-check"><input name="studentRulesAcknowledged" type="checkbox" required /><span>Хүүхэд бүртгүүлэхээ мэдэж, зөвшөөрсөн.<span class="required-marker" aria-hidden="true">*</span><span class="visually-hidden">Заавал бөглөнө</span></span></label><hr class="staff-intake-consent-separator" /></section>
          <label class="staff-check staff-wide"><input name="sendReceipt" type="checkbox" /><span>Төлбөрийн мэдээллийг и-мэйлээр илгээх</span></label>
          <p class="staff-intake-email-help staff-wide">Сонгоогүй бол одоо и-мэйл илгээхгүй боловч төлбөрийн хугацааны сануулга хэвийн ажиллана.</p>
          <div class="staff-inline-actions staff-wide"><button id="intake-submit" class="button primary" type="submit">Бүртгэл үүсгэх</button></div>
        </form>
      </section>
    </main>
    <script is:inline type="module">
      // @ts-nocheck
      import { renderPublicProse } from "/scripts/public-prose.js";
      const q = (selector) => document.querySelector(selector);
      const form = q("#staff-registration-intake");
      const status = q("#intake-status");
      const submit = q("#intake-submit");
      const state = { catalog: null, rules: [], pending: false, idempotencyKey: crypto.randomUUID() };
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #intake-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("intake-", ""); };
      const feedback = (text = "", success = false) => { status.textContent = text; status.hidden = !text; status.classList.toggle("staff-success", success); };
      const selected = (name) => form.elements.namedItem(name).value;
      const escape = (value) => String(value ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
      const option = (value, label) => `<option value="${String(value).replaceAll('"', '&quot;')}">${String(label).replaceAll("<", "&lt;")}</option>`;
      function sessions() { return state.catalog?.academicYears?.flatMap((year) => year.classSessions || []) || []; }
      function renderClasses() { const stage = selected("stage"); const classes = sessions().filter((item) => item.stageCode === stage && item.availability !== "unavailable"); const classField = form.elements.namedItem("classSessionId"); classField.innerHTML = option("", "Сонгоно уу") + classes.map((item) => option(item.id, item.label)).join(""); renderPlans(); }
      function renderPlans() { const entry = sessions().find((item) => item.id === selected("classSessionId")); const field = form.elements.namedItem("paymentPlanCode"); field.innerHTML = option("", "Сонгоно уу") + (entry?.paymentOptions || []).map((item) => option(item.code, item.code === "single" ? `Нэг удаа · ${Number(item.totalAmountMnt).toLocaleString("en-US")} ₮` : `Хоёр хувааж · ${Number(item.initialAmountMnt).toLocaleString("en-US")} ₮`)).join(""); }
      function readPayload() { return { guardian: { fullName: selected("guardianName"), relationship: selected("guardianRelationship"), primaryPhone: selected("guardianPhone"), secondaryPhone: selected("guardianSecondaryPhone"), email: selected("guardianEmail"), facebookName: selected("guardianFacebook"), homeAddress: selected("guardianAddress") }, children: [{ surname: selected("surname"), givenName: selected("givenName"), gender: selected("gender"), dateOfBirth: selected("dateOfBirth"), currentGrade: selected("currentGrade"), currentSchool: selected("currentSchool"), returningStatus: selected("returningStatus"), previousStageCode: selected("previousStageCode") || undefined, selectedStageCode: selected("stage"), selectedClassSessionId: selected("classSessionId"), codeInput: selected("codeInput"), paymentPlanCode: selected("paymentPlanCode") }], parentRulesAcknowledged: form.elements.namedItem("parentRulesAcknowledged").checked, studentRulesAcknowledged: form.elements.namedItem("studentRulesAcknowledged").checked, parentRulesVersion: state.rules.find((rule) => rule.code === "guardian")?.versionId, studentRulesVersion: state.rules.find((rule) => rule.code === "student")?.versionId, intakeChannel: selected("intakeChannel"), sendReceipt: form.elements.namedItem("sendReceipt").checked }; }
      async function boot() { const session = await fetch("/api/staff/session", { credentials: "same-origin", cache: "no-store" }).then((response) => response.json()); if (!session.authenticated || !session.capabilities.includes("registration.manage")) { show("intake-denied"); return; } const response = await fetch("/api/staff/registration-intake", { credentials: "same-origin", cache: "no-store" }); if (!response.ok) { show("intake-denied"); return; } const data = await response.json(); state.catalog = data.catalog; state.rules = data.courseRules; const stages = [...new Set(sessions().map((item) => item.stageCode))]; form.elements.namedItem("stage").innerHTML = option("", "Сонгоно уу") + stages.map((value) => option(value, ({ stage_1: "1-р шат", stage_2: "2-р шат", stage_3: "3-р шат" })[value])).join(""); for (const [code, target] of [["guardian", "#guardian-rule-link"], ["student", "#student-rule-link"]]) { const rule = state.rules.find((entry) => entry.code === code); q(target).innerHTML = rule ? `<details class="staff-intake-rule"><summary>${escape(rule.title)}</summary><div class="public-prose">${renderPublicProse(rule.bodyText)}</div></details>` : ""; } show("intake-app"); }
      form.addEventListener("change", (event) => { if (event.target.name === "stage") renderClasses(); if (event.target.name === "classSessionId") renderPlans(); if (event.target.name === "returningStatus") q("#previous-stage-field").hidden = selected("returningStatus") !== "returning"; if (event.target.name === "intakeChannel") { const labels = { paper_form: "Эцэг эх / асран хамгаалагч болон хүүхдийн гарын үсэгтэй маягтаас оруулж байна.", phone: "Эцэг эх / асран хамгаалагч болон хүүхдийн зөвшөөрлийг утсаар баталгаажуулсан.", in_person: "Эцэг эх / асран хамгаалагч болон хүүхдийн зөвшөөрлийг биечлэн баталгаажуулсан." }; q("#intake-channel-help").textContent = labels[selected("intakeChannel")] || "Бүртгэл авсан хэлбэрээ сонгоно уу."; } });
      form.addEventListener("submit", async (event) => { event.preventDefault(); if (state.pending) return; if (!form.reportValidity()) return; state.pending = true; submit.disabled = true; submit.textContent = "Үүсгэж байна…"; feedback(""); try { const response = await fetch("/api/staff/registration-intake", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", "Idempotency-Key": state.idempotencyKey }, body: JSON.stringify(readPayload()) }); const body = await response.json().catch(() => null); if (!response.ok) throw new Error(body?.error?.message || "Бүртгэл үүсгэж чадсангүй."); const anchor = body.registrationDraftChildId ? `?registration=${encodeURIComponent(body.registrationDraftChildId)}&created=1` : "?created=1"; window.location.assign(`/staff/payments/${anchor}`); } catch (error) { feedback(error.message || "Бүртгэл үүсгэж чадсангүй."); state.pending = false; submit.disabled = false; submit.textContent = "Бүртгэл үүсгэх"; } });
      boot().catch(() => { show("intake-denied"); });
    </script>
  </body>
</html>
