---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Ирц | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Ирц</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Ирц</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1>Ирц</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <form id="attendance-date-form" class="staff-attendance-date-form">
          <label>Өдөр <input id="attendance-date" type="date" required /></label>
          <button id="attendance-today" class="button secondary" type="button">Өнөөдөр</button>
        </form>
        <section aria-labelledby="attendance-list-title">
          <h2 id="attendance-list-title" class="staff-list-heading">Энэ өдрийн хичээлүүд</h2>
          <div id="attendance-list" class="staff-attendance-list"></div>
        </section>
        <section id="attendance-detail" class="staff-attendance-detail" hidden></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { escape, formatDate, getAttendanceDay, hasAttendanceAccess, postAttendanceAction } from "../../scripts/staff-setup.js";

      const params = new URLSearchParams(location.search);
      const state = { data: null, date: params.get("date") || "", selectedSlotId: params.get("occurrence") || "", noticeEnrollmentId: "", bulkConfirm: false };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const isFuture = () => state.data && state.data.localDate > state.data.today;
      const isPast = () => state.data && state.data.localDate < state.data.today;
      const dateQuery = () => { const next = new URLSearchParams({ date: state.date }); if (state.selectedSlotId) next.set("occurrence", state.selectedSlotId); return `?${next.toString()}`; };

      async function refresh(success = "") {
        state.data = await getAttendanceDay(state.date, state.selectedSlotId);
        state.date = state.data.localDate;
        if (state.selectedSlotId && !state.data.selected) state.selectedSlotId = "";
        q("#attendance-date").value = state.date;
        history.replaceState(null, "", dateQuery());
        render();
        message(success, Boolean(success));
      }

      function renderList() {
        const container = q("#attendance-list");
        const entries = state.data.occurrences || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Энэ өдөр хичээлгүй.</p>`; return; }
        container.innerHTML = entries.map((entry) => `<article class="staff-attendance-occurrence ${entry.slotId === state.selectedSlotId ? "selected" : ""}"><div><strong>${escape(entry.classLabel)}</strong><p>${escape(entry.offeringTitle)} · ${entry.lessonSequence}. ${escape(entry.lessonTitle)}</p><p>${escape(entry.startTime)}–${escape(entry.endTime)}${entry.holidayLabel ? ` · <span class="staff-calendar-warning-inline">${escape(entry.holidayLabel)}</span>` : ""}</p></div><button class="button secondary" type="button" data-open-occurrence="${escape(entry.slotId)}">Нээх</button></article>`).join("");
        container.querySelectorAll("[data-open-occurrence]").forEach((button) => button.onclick = () => {
          state.selectedSlotId = button.dataset.openOccurrence; state.noticeEnrollmentId = ""; state.bulkConfirm = false; refresh().then(() => q("#attendance-detail").scrollIntoView({ behavior: "smooth", block: "start" }));
        });
      }

      function attendanceControls(entry) {
        if (isFuture()) return `<p class="staff-muted staff-attendance-future-note">Ирцийг хичээл болох өдрөөс эхэлж тэмдэглэнэ.</p>`;
        const status = entry.attendanceStatus || "";
        const control = (value, label) => `<button class="staff-attendance-status ${status === value ? "selected" : ""}" type="button" data-mark-status="${value}" data-enrollment="${escape(entry.enrollmentId)}" aria-pressed="${status === value}">${label}</button>`;
        return `<div class="staff-attendance-statuses" role="group" aria-label="${escape(entry.displayName)}-ийн ирц">${control("present", "Ирсэн")}${control("late", "Хоцорсон")}${control("absent", "Ирээгүй")}${status ? `<button class="staff-attendance-clear" type="button" data-clear-attendance="${escape(entry.enrollmentId)}">Тэмдэглэгээг арилгах</button>` : ""}</div>`;
      }

      function noticeControls(entry) {
        const editing = state.noticeEnrollmentId === entry.enrollmentId;
        if (isPast()) return entry.hasAbsenceNotice ? `<span class="staff-attendance-notice">Урьдчилж мэдэгдсэн</span>` : "";
        if (!editing) return `<div class="staff-attendance-notice-row">${entry.hasAbsenceNotice ? `<span class="staff-attendance-notice">Урьдчилж мэдэгдсэн</span>` : ""}<button class="text-button" type="button" data-edit-notice="${escape(entry.enrollmentId)}">${entry.hasAbsenceNotice ? "Мэдэгдэл засах" : "Ирэхгүйг мэдэгдэх"}</button></div>`;
        return `<form class="staff-attendance-notice-form" data-notice-form="${escape(entry.enrollmentId)}"><label>Тэмдэглэл <textarea data-notice-text maxlength="600" placeholder="Байвал товч оруулна уу">${escape(entry.absenceNoticeNote || "")}</textarea></label><div class="staff-inline-actions"><button class="button secondary" type="button" data-notice-close>Болих</button>${entry.hasAbsenceNotice ? `<button class="button secondary" type="button" data-notice-cancel="${escape(entry.enrollmentId)}">Цуцлах</button>` : ""}<button class="button primary" type="submit">Мэдэгдэх</button></div></form>`;
      }

      function bindRoster(detail) {
        detail.querySelectorAll("[data-mark-status]").forEach((button) => button.onclick = () => run(
          () => postAttendanceAction("attendance.mark", { slotId: state.selectedSlotId, enrollmentId: button.dataset.enrollment, status: button.dataset.markStatus }),
          "Ирцийг тэмдэглэлээ.",
        ));
        detail.querySelectorAll("[data-clear-attendance]").forEach((button) => button.onclick = () => run(
          () => postAttendanceAction("attendance.clear", { slotId: state.selectedSlotId, enrollmentId: button.dataset.clearAttendance }),
          "Тэмдэглэгээг арилгалаа.",
        ));
        detail.querySelectorAll("[data-edit-notice]").forEach((button) => button.onclick = () => { state.noticeEnrollmentId = button.dataset.editNotice; renderDetail(); detail.querySelector("[data-notice-text]")?.focus(); });
        detail.querySelectorAll("[data-notice-close]").forEach((button) => button.onclick = () => { state.noticeEnrollmentId = ""; renderDetail(); });
        detail.querySelectorAll("[data-notice-cancel]").forEach((button) => button.onclick = () => run(async () => { await postAttendanceAction("absence-notice.cancel", { slotId: state.selectedSlotId, enrollmentId: button.dataset.noticeCancel }); state.noticeEnrollmentId = ""; }, "Мэдэгдлийг цуцаллаа."));
        detail.querySelectorAll("[data-notice-form]").forEach((form) => form.onsubmit = (event) => { event.preventDefault(); run(async () => { await postAttendanceAction("absence-notice.save", { slotId: state.selectedSlotId, enrollmentId: form.dataset.noticeForm, note: form.querySelector("[data-notice-text]").value }); state.noticeEnrollmentId = ""; }, "Мэдэгдлийг хадгаллаа."); });
      }

      function renderDetail() {
        const detail = q("#attendance-detail"); const selected = state.data.selected;
        if (!selected) { detail.hidden = true; detail.innerHTML = ""; return; }
        detail.hidden = false;
        const complete = selected.rosterCount > 0 && selected.markedCount === selected.rosterCount;
        const unmarked = selected.rosterCount - selected.markedCount;
        const bulk = !isFuture() && unmarked > 0
          ? state.bulkConfirm
            ? `<div class="staff-attendance-bulk-confirm"><p>Одоогоор тэмдэглээгүй ${unmarked} сурагчийг ирсэн гэж тэмдэглэх үү?</p><div class="staff-inline-actions"><button id="attendance-bulk-cancel" class="button secondary" type="button">Болих</button><button id="attendance-bulk-confirm" class="button primary" type="button">Бүгд ирсэн</button></div></div>`
            : `<button id="attendance-bulk-present" class="button secondary" type="button">Бүгд ирсэн</button>`
          : "";
        detail.innerHTML = `<div class="staff-section-heading"><div><p class="eyebrow">${escape(formatDate(selected.localDate))} · ${escape(selected.startTime)}</p><h2>${escape(selected.classLabel)}</h2><p>${selected.lessonSequence}. ${escape(selected.lessonTitle)}</p>${selected.holidayLabel ? `<p class="staff-calendar-warning">Анхааруулга: ${escape(selected.holidayLabel)} хугацаанд.</p>` : ""}</div><button id="close-attendance" class="button secondary" type="button">Хаах</button></div><div class="staff-attendance-summary"><strong>${selected.markedCount} / ${selected.rosterCount} тэмдэглэсэн${complete ? " · Дууссан" : ""}</strong>${bulk}</div>${selected.rosterCount ? `<div class="staff-attendance-roster">${selected.roster.map((entry) => `<article><div class="staff-attendance-student"><strong>${escape(entry.displayName)}</strong>${noticeControls(entry)}</div>${attendanceControls(entry)}</article>`).join("")}</div>` : `<p class="staff-empty">Бүртгэлтэй сурагч алга.</p>`}`;
        detail.querySelector("#close-attendance").onclick = () => { state.selectedSlotId = ""; state.noticeEnrollmentId = ""; state.bulkConfirm = false; refresh(); };
        detail.querySelector("#attendance-bulk-present")?.addEventListener("click", () => { state.bulkConfirm = true; renderDetail(); });
        detail.querySelector("#attendance-bulk-cancel")?.addEventListener("click", () => { state.bulkConfirm = false; renderDetail(); });
        detail.querySelector("#attendance-bulk-confirm")?.addEventListener("click", () => run(async () => { await postAttendanceAction("attendance.bulk-present", { slotId: state.selectedSlotId }); state.bulkConfirm = false; }, "Бүгдийг ирсэн гэж тэмдэглэлээ."));
        bindRoster(detail);
      }

      function render() { renderList(); renderDetail(); }
      async function run(work, success) { message(); try { await work(); await refresh(success); } catch (error) { message(error.message || "Ирцийг хадгалж чадсангүй."); } }

      q("#attendance-date-form").onsubmit = (event) => { event.preventDefault(); state.date = q("#attendance-date").value; state.selectedSlotId = ""; state.noticeEnrollmentId = ""; state.bulkConfirm = false; refresh(); };
      q("#attendance-date").onchange = () => { state.date = q("#attendance-date").value; state.selectedSlotId = ""; state.noticeEnrollmentId = ""; state.bulkConfirm = false; refresh(); };
      q("#attendance-today").onclick = () => { state.date = state.data.today; state.selectedSlotId = ""; state.noticeEnrollmentId = ""; state.bulkConfirm = false; refresh(); };
      (async () => { if (!(await hasAttendanceAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
