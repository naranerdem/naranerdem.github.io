---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Ирц | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Ирц</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Ирц</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading"><div><p class="eyebrow">Өдөр тутмын ажил</p><h1>Ирц</h1></div><a class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <form id="attendance-date-form" class="staff-attendance-date-form">
          <label>Өдөр <input id="attendance-date" type="date" required /></label>
          <button id="attendance-today" class="button secondary" type="button">Өнөөдөр</button>
        </form>
        <section aria-labelledby="attendance-list-title">
          <h2 id="attendance-list-title" class="staff-list-heading">Энэ өдрийн хичээлүүд</h2>
          <div id="attendance-list" class="staff-attendance-list"></div>
        </section>
        <section id="attendance-detail" class="staff-attendance-detail" hidden></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import { createStaffActionMenuController } from "../../scripts/staff-action-menus.js";
      import { createOptimisticRosterMutator, markedRosterCount } from "../../scripts/attendance-optimistic.js";
      import { escape, formatDate, getAttendanceDay, hasAttendanceAccess, postAttendanceAction } from "../../scripts/staff-setup.js";

      const params = new URLSearchParams(location.search);
      const state = { data: null, date: params.get("date") || "", selectedSlotId: params.get("occurrence") || "", bulkConfirm: false, bulkPending: false, rowErrorEnrollmentId: "", rowErrorMessage: "" };
      const q = (selector) => document.querySelector(selector);
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const isFuture = () => state.data && state.data.localDate > state.data.today;
      const isPast = () => state.data && state.data.localDate < state.data.today;
      const dateQuery = () => { const next = new URLSearchParams({ date: state.date }); if (state.selectedSlotId) next.set("occurrence", state.selectedSlotId); return `?${next.toString()}`; };
      createStaffActionMenuController(document);

      const optimistic = createOptimisticRosterMutator({
        onChange(entry) { patchRosterRow(entry.enrollmentId); },
        onError(entry, error) {
          state.rowErrorEnrollmentId = entry.enrollmentId;
          state.rowErrorMessage = error?.message || "Ирцийг хадгалж чадсангүй. Дахин оролдоно уу.";
        },
      });

      async function refresh() {
        state.data = await getAttendanceDay(state.date, state.selectedSlotId);
        state.date = state.data.localDate;
        if (state.selectedSlotId && !state.data.selected) state.selectedSlotId = "";
        q("#attendance-date").value = state.date;
        history.replaceState(null, "", dateQuery());
        render();
      }

      function renderList() {
        const container = q("#attendance-list");
        const entries = state.data.occurrences || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Энэ өдөр хичээлгүй.</p>`; return; }
        container.innerHTML = entries.map((entry) => `<article class="staff-attendance-occurrence ${entry.slotId === state.selectedSlotId ? "selected" : ""}"><div><strong>${escape(entry.startTime)}–${escape(entry.endTime)} · ${escape(entry.offeringTitle)}</strong><p>${entry.lessonSequence}. ${escape(entry.lessonTitle)}</p><p>${entry.markedCount} / ${entry.rosterCount} тэмдэглэсэн${entry.holidayLabel ? ` · <span class="staff-calendar-warning-inline">${escape(entry.holidayLabel)}</span>` : ""}</p></div><button class="button secondary" type="button" data-open-occurrence="${escape(entry.slotId)}">Нээх</button></article>`).join("");
        container.querySelectorAll("[data-open-occurrence]").forEach((button) => button.onclick = () => {
          state.selectedSlotId = button.dataset.openOccurrence;
          state.bulkConfirm = false;
          state.rowErrorEnrollmentId = "";
          refresh().then(() => q("#attendance-detail").scrollIntoView({ behavior: "smooth", block: "start" }));
        });
      }

      function attendanceControls(entry) {
        if (isFuture()) return `<p class="staff-muted staff-attendance-future-note">Ирцийг хичээл болох өдрөөс эхэлж тэмдэглэнэ.</p>`;
        const status = entry.attendanceStatus || "";
        const pending = optimistic.isPending(entry.enrollmentId);
        const control = (value, label) => `<button class="staff-attendance-status ${status === value ? "selected" : ""}" type="button" data-mark-status="${value}" data-enrollment="${escape(entry.enrollmentId)}" aria-pressed="${status === value}" ${pending ? "disabled" : ""}>${label}</button>`;
        return `<div class="staff-attendance-statuses" role="group" aria-label="${escape(entry.displayName)}-ийн ирц">${control("present", "Ирсэн")}${control("late", "Хоцорсон")}${control("absent", "Ирээгүй")}</div>`;
      }

      function noticeControls(entry) {
        if (isPast()) return entry.hasAbsenceNotice ? `<span class="staff-attendance-notice">Урьдчилж мэдэгдсэн</span>` : "";
        const pending = optimistic.isPending(entry.enrollmentId);
        return `<label class="staff-attendance-notice-toggle"><input type="checkbox" data-toggle-notice="${escape(entry.enrollmentId)}" ${entry.hasAbsenceNotice ? "checked" : ""} ${pending ? "disabled" : ""} />Урьдчилж мэдэгдсэн</label>`;
      }

      function rowActions(entry) {
        if (!entry.attendanceStatus || isFuture()) return "";
        return `<details class="staff-attendance-menu" data-staff-action-menu><summary aria-label="${escape(entry.displayName)}-ийн нэмэлт үйлдэл" title="Үйлдэл">⋯</summary><div class="staff-attendance-menu-actions"><button type="button" data-staff-action-menu-item data-clear-attendance="${escape(entry.enrollmentId)}" ${optimistic.isPending(entry.enrollmentId) ? "disabled" : ""}>Тэмдэглэгээг арилгах</button></div></details>`;
      }

      function rosterRow(entry) {
        const pending = optimistic.isPending(entry.enrollmentId);
        const error = state.rowErrorEnrollmentId === entry.enrollmentId ? `<p class="staff-attendance-row-error" role="status">${escape(state.rowErrorMessage)}</p>` : "";
        return `<article data-attendance-row="${escape(entry.enrollmentId)}" class="${pending ? "staff-attendance-row-pending" : ""}"><div class="staff-attendance-student"><strong>${escape(entry.displayName)}</strong>${attendanceControls(entry)}<div class="staff-attendance-row-actions">${noticeControls(entry)}${rowActions(entry)}</div>${error}</div></article>`;
      }

      function bulkMarkup(selected) {
        const unmarked = selected.rosterCount - selected.markedCount;
        if (isFuture() || unmarked <= 0) return "";
        if (state.bulkPending) return `<span class="staff-muted">Тэмдэглэж байна…</span>`;
        if (state.bulkConfirm) return `<div class="staff-attendance-bulk-confirm"><p>Одоогоор тэмдэглээгүй ${unmarked} сурагчийг ирсэн гэж тэмдэглэх үү?</p><div class="staff-inline-actions"><button id="attendance-bulk-cancel" class="button secondary" type="button">Болих</button><button id="attendance-bulk-confirm" class="button primary" type="button">Бүгд ирсэн</button></div></div>`;
        return `<button id="attendance-bulk-present" class="button secondary" type="button">Бүгд ирсэн</button>`;
      }

      function renderSummary() {
        const selected = state.data?.selected;
        const summary = q("#attendance-summary");
        if (!selected || !summary) return;
        selected.markedCount = markedRosterCount(selected.roster);
        const occurrence = state.data.occurrences.find((entry) => entry.slotId === selected.slotId);
        if (occurrence) occurrence.markedCount = selected.markedCount;
        const complete = selected.rosterCount > 0 && selected.markedCount === selected.rosterCount;
        summary.innerHTML = `<strong>${selected.markedCount} / ${selected.rosterCount} тэмдэглэсэн${complete ? " · Дууссан" : ""}</strong>${bulkMarkup(selected)}`;
      }

      function patchRosterRow(enrollmentId) {
        const selected = state.data?.selected;
        const detail = q("#attendance-detail");
        const entry = selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        const row = [...detail.querySelectorAll("[data-attendance-row]")].find((node) => node.dataset.attendanceRow === enrollmentId);
        if (entry && row) row.outerHTML = rosterRow(entry);
        renderSummary();
        renderList();
      }

      function renderDetail() {
        const detail = q("#attendance-detail"); const selected = state.data.selected;
        if (!selected) { detail.hidden = true; detail.innerHTML = ""; return; }
        detail.hidden = false;
        detail.innerHTML = `<div class="staff-section-heading"><div><p class="eyebrow">${escape(formatDate(selected.localDate))} · ${escape(selected.startTime)}–${escape(selected.endTime)}</p><h2>${escape(selected.offeringTitle)}</h2><p>${selected.lessonSequence}. ${escape(selected.lessonTitle)}</p>${selected.holidayLabel ? `<p class="staff-calendar-warning">Анхааруулга: ${escape(selected.holidayLabel)} хугацаанд.</p>` : ""}</div><button id="close-attendance" class="button secondary" type="button">Хаах</button></div><div id="attendance-summary" class="staff-attendance-summary"></div>${selected.rosterCount ? `<div class="staff-attendance-roster">${selected.roster.map(rosterRow).join("")}</div>` : `<p class="staff-empty">Бүртгэлтэй сурагч алга.</p>`}`;
        renderSummary();
      }

      async function mutateRow(enrollmentId, next, action, payload, success) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry) return;
        state.rowErrorEnrollmentId = "";
        const saved = await optimistic.mutate(entry, next, () => postAttendanceAction(action, { slotId: state.selectedSlotId, enrollmentId, ...payload }));
        if (saved) message(success, true);
      }

      async function markAttendance(enrollmentId, status) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry || entry.attendanceStatus === status) return;
        await mutateRow(enrollmentId, { attendanceStatus: status }, "attendance.mark", { status }, "Ирцийг тэмдэглэлээ.");
      }

      async function clearAttendance(enrollmentId) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry || !entry.attendanceStatus) return;
        await mutateRow(enrollmentId, { attendanceStatus: null }, "attendance.clear", {}, "Тэмдэглэгээг арилгалаа.");
      }

      async function toggleNotice(enrollmentId, checked) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry || entry.hasAbsenceNotice === checked) return;
        await mutateRow(enrollmentId, { hasAbsenceNotice: checked }, checked ? "absence-notice.save" : "absence-notice.cancel", checked ? { note: entry.absenceNoticeNote || "" } : {}, checked ? "Урьдчилсан мэдэгдлийг тэмдэглэлээ." : "Урьдчилсан мэдэгдлийг арилгалаа.");
      }

      async function bulkPresent() {
        const selected = state.data?.selected;
        if (!selected || state.bulkPending) return;
        state.bulkPending = true;
        renderSummary();
        try {
          await postAttendanceAction("attendance.bulk-present", { slotId: state.selectedSlotId });
          selected.roster.filter((entry) => !entry.attendanceStatus).forEach((entry) => { entry.attendanceStatus = "present"; patchRosterRow(entry.enrollmentId); });
          state.bulkConfirm = false;
          message("Бүгдийг ирсэн гэж тэмдэглэлээ.", true);
        } catch (error) {
          message(error.message || "Ирцийг хадгалж чадсангүй.");
        } finally {
          state.bulkPending = false;
          renderSummary();
        }
      }

      q("#attendance-detail").addEventListener("click", (event) => {
        const target = event.target.closest("button");
        if (!target || target.disabled) return;
        if (target.id === "close-attendance") { state.selectedSlotId = ""; state.bulkConfirm = false; refresh(); return; }
        if (target.id === "attendance-bulk-present") { state.bulkConfirm = true; renderSummary(); return; }
        if (target.id === "attendance-bulk-cancel") { state.bulkConfirm = false; renderSummary(); return; }
        if (target.id === "attendance-bulk-confirm") { bulkPresent(); return; }
        if (target.dataset.markStatus) markAttendance(target.dataset.enrollment, target.dataset.markStatus);
        if (target.dataset.clearAttendance) clearAttendance(target.dataset.clearAttendance);
      });
      q("#attendance-detail").addEventListener("change", (event) => {
        const target = event.target;
        if (target.matches("[data-toggle-notice]")) toggleNotice(target.dataset.toggleNotice, target.checked);
      });

      function render() { renderList(); renderDetail(); }
      q("#attendance-date-form").onsubmit = (event) => { event.preventDefault(); state.date = q("#attendance-date").value; state.selectedSlotId = ""; state.bulkConfirm = false; refresh(); };
      q("#attendance-date").onchange = () => { state.date = q("#attendance-date").value; state.selectedSlotId = ""; state.bulkConfirm = false; refresh(); };
      q("#attendance-today").onclick = () => { state.date = state.data.today; state.selectedSlotId = ""; state.bulkConfirm = false; refresh(); };
      (async () => { if (!(await hasAttendanceAccess())) { show("tool-denied"); return; } await refresh(); show("tool-app"); })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
