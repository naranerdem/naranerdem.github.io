---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#073aaf" />
    <title>Ирц | {siteIdentity.name}</title>
  </head>
  <body class="staff-page" data-staff-tool-surface="booting">
    <header class="site-header">
      <a class="brand-link" href="/staff/" aria-label="Ажилтны хэсэг">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span><strong>{siteIdentity.name}</strong><span>Ирц</span></span>
      </a>
    </header>
    <main class="staff-shell" aria-live="polite">
      <section id="tool-booting" class="staff-state"><p class="eyebrow">Өдөр тутмын ажил</p><h1>Түр хүлээнэ үү</h1><p class="staff-muted">Нэвтрэх эрхийг шалгаж байна.</p></section>
      <section id="tool-denied" class="staff-state" hidden><p class="eyebrow">Ирц</p><h1>Энэ хэсгийг нээх эрх алга</h1><a class="button secondary" href="/staff/">Ажилтны хэсэг рүү буцах</a></section>
      <section id="tool-app" hidden>
        <div class="staff-page-heading staff-attendance-page-heading"><h1>Ирц</h1><a id="attendance-back" class="staff-back-link" href="/staff/">Буцах</a></div>
        <p id="tool-message" class="staff-error" role="status" hidden></p>
        <form id="attendance-date-form" class="staff-attendance-date-form">
          <label class="visually-hidden" for="attendance-date">Өдөр сонгох</label>
          <input id="attendance-date" type="date" aria-label="Өдөр сонгох" required />
          <button id="attendance-today" class="button secondary" type="button">Өнөөдөр</button>
        </form>
        <nav id="attendance-list" class="staff-attendance-list" aria-label="Өдрийн хичээл сонгох"></nav>
        <section id="attendance-detail" class="staff-attendance-detail" hidden></section>
      </section>
    </main>
    <script>
      // @ts-nocheck
      import {
        attendanceCheckboxState,
        attendanceIsComplete,
        attendanceProgressCount,
        attendanceStatusAfterToggle,
        createOptimisticRosterMutator,
        effectiveAttendanceStatus,
        markedRosterCount,
      } from "../../scripts/attendance-optimistic.js";
      import { escape, formatDate, getAttendanceDay, getStaffCapabilities, postAttendanceAction, postCourseMakeupAction } from "../../scripts/staff-setup.js";

      const params = new URLSearchParams(location.search);
      const safeHomeDate = (value) => /^\d{4}-\d{2}-\d{2}$/.test(value || "") ? value : "";
      const homeReturn = new URLSearchParams();
      const homeWeek = safeHomeDate(params.get("homeWeek"));
      const homeDate = safeHomeDate(params.get("homeDate"));
      const homeDay = safeHomeDate(params.get("homeDay"));
      if (homeWeek) homeReturn.set("week", homeWeek);
      if (homeDate) homeReturn.set("date", homeDate);
      if (homeDay) homeReturn.set("day", homeDay);
      const returnTo = homeReturn.size ? `/staff/?${homeReturn.toString()}` : "/staff/";
      const state = { data: null, date: params.get("date") || "", selectedSlotId: params.get("occurrence") || "", invalidOccurrence: false, bulkConfirm: false, bulkPending: false, rowErrorEnrollmentId: "", rowErrorMessage: "", refreshVersion: 0, canManageAttendance: false, canManageMakeups: false, makeupPicker: null, makeupPickerVersion: 0 };
      const q = (selector) => document.querySelector(selector);
      q("#attendance-back").href = returnTo;
      q("#attendance-back").addEventListener("click", (event) => {
        if (returnTo === "/staff/") return;
        event.preventDefault();
        window.location.assign(returnTo);
      });
      const show = (id) => { for (const node of document.querySelectorAll(".staff-state, #tool-app")) node.hidden = node.id !== id; document.body.dataset.staffToolSurface = id.replace("tool-", ""); };
      const message = (value = "", success = false) => { const node = q("#tool-message"); node.textContent = value; node.classList.toggle("staff-success", success); node.hidden = !value; };
      const isFuture = () => state.data && state.data.localDate > state.data.today;
      const dateQuery = () => { const next = new URLSearchParams({ date: state.date }); if (state.selectedSlotId) next.set("occurrence", state.selectedSlotId); return `?${next.toString()}`; };
      const optimistic = createOptimisticRosterMutator({
        onChange(entry) { patchRosterRow(entry.enrollmentId); },
        onError(entry, error) {
          state.rowErrorEnrollmentId = entry.enrollmentId;
          state.rowErrorMessage = error?.message || "Ирцийг хадгалж чадсангүй. Дахин оролдоно уу.";
        },
      });

      async function refresh() {
        const version = ++state.refreshVersion;
        const requestedSlotId = state.selectedSlotId;
        if (state.makeupPicker?.slotId !== requestedSlotId) { ++state.makeupPickerVersion; state.makeupPicker = null; }
        const data = await getAttendanceDay(state.date, requestedSlotId);
        if (version !== state.refreshVersion) return;
        state.data = data;
        state.date = data.localDate;
        state.invalidOccurrence = Boolean(requestedSlotId && !data.selected);
        if (data.selected) state.selectedSlotId = data.selected.slotId;
        q("#attendance-date").value = state.date;
        history.replaceState(null, "", dateQuery());
        render();
      }

      function renderList() {
        const container = q("#attendance-list");
        const entries = state.data.occurrences || [];
        if (!entries.length) { container.innerHTML = `<p class="staff-empty">Энэ өдөр хичээлгүй.</p>`; return; }
        const invalid = state.invalidOccurrence ? `<p class="staff-error">Сонгосон хичээл энэ өдөр байхгүй байна. Өөр цаг сонгоно уу.</p>` : "";
        container.innerHTML = `${invalid}<div class="staff-attendance-selector" role="tablist" aria-label="Хичээлийн цаг">${entries.map((entry) => `<a class="staff-attendance-tab ${entry.slotId === state.selectedSlotId ? "selected" : ""}" role="tab" aria-selected="${entry.slotId === state.selectedSlotId}" href="/staff/attendance/?date=${encodeURIComponent(state.date)}&occurrence=${encodeURIComponent(entry.slotId)}" data-open-occurrence="${escape(entry.slotId)}">${escape(entry.startTime)}–${escape(entry.endTime)}</a>`).join("")}</div>`;
        const selected = container.querySelector(".staff-attendance-tab.selected");
        const selector = container.querySelector(".staff-attendance-selector");
        if (selected && selector) requestAnimationFrame(() => { selector.scrollLeft = Math.max(0, selected.offsetLeft - (selector.clientWidth - selected.offsetWidth) / 2); });
      }

      function canChangeOccurrence(event) {
        if (!state.bulkPending && !optimistic.hasPending()) return true;
        event?.preventDefault();
        message("Ирцийг хадгалж дууссаны дараа өөр хичээл сонгоно уу.");
        return false;
      }

      function attendanceControls(entry) {
        if (isFuture() || !state.canManageAttendance) return "";
        const status = entry.recordedAttendanceStatus || "";
        const checked = attendanceCheckboxState(status);
        const pending = optimistic.isPending(entry.enrollmentId);
        const effective = effectiveAttendanceStatus(status, state.data.selected.occurrenceEnded);
        const assignment = entry.makeupAssignmentId ? ` data-makeup-assignment="${escape(entry.makeupAssignmentId)}"` : "";
        const control = (value, label) => `<label class="staff-attendance-check ${checked[value] ? "selected" : ""}"><input type="checkbox" data-attendance-control="${value}" data-enrollment="${escape(entry.enrollmentId)}"${assignment} ${checked[value] ? "checked" : ""} ${pending ? "disabled" : ""} />${label}</label>`;
        const absent = entry.attendanceKind === "makeup" ? `<button type="button" class="staff-text-action" data-attendance-absent="${escape(entry.enrollmentId)}"${pending ? " disabled" : ""}>Ирээгүй</button>` : "";
        return `<div class="staff-attendance-statuses" role="group" aria-label="${escape(entry.displayName)}-ийн ирц">${control("present", "Ирсэн")}${control("late", "Хоцорсон")}${absent}</div>`;
      }

      function noticeControls(entry) {
        if (entry.attendanceKind === "makeup") return "";
        if (!state.canManageAttendance) return entry.hasAbsenceNotice ? `<span class="staff-attendance-notice">Мэдэгдсэн</span>` : "";
        if (!isFuture()) return entry.hasAbsenceNotice ? `<span class="staff-attendance-notice">Мэдэгдсэн</span>` : "";
        const pending = optimistic.isPending(entry.enrollmentId);
        return `<label class="staff-attendance-notice-toggle"><input type="checkbox" data-toggle-notice="${escape(entry.enrollmentId)}" ${entry.hasAbsenceNotice ? "checked" : ""} ${pending ? "disabled" : ""} />Урьдчилж мэдэгдсэн</label>`;
      }

      function rosterRow(entry) {
        const pending = optimistic.isPending(entry.enrollmentId);
        const error = state.rowErrorEnrollmentId === entry.enrollmentId ? `<p class="staff-attendance-row-error" role="status">${escape(state.rowErrorMessage)}</p>` : "";
        const notice = noticeControls(entry);
        const source = entry.makeupSource;
        const sourceDate = source?.localDate ? source.localDate.slice(5).replace("-", "/") : "";
        const sourceText = ["Тасалсан хичээл", sourceDate].filter(Boolean).join(" · ");
        const sourceLink = source?.slotId && source?.localDate
          ? `<a class="staff-text-action" href="/staff/attendance/?date=${encodeURIComponent(source.localDate)}&occurrence=${encodeURIComponent(source.slotId)}">${escape(sourceText)}</a>`
          : escape(sourceText);
        const makeup = entry.attendanceKind === "makeup" ? `<p class="staff-attendance-makeup-source"><span class="staff-kind-label">Нөхөх</span>${sourceLink}</p>` : "";
        return `<article data-attendance-row="${escape(entry.enrollmentId)}" class="${pending ? "staff-attendance-row-pending" : ""}"><div class="staff-attendance-student"><div class="staff-attendance-identity"><div class="staff-attendance-student-name"><strong>${escape(entry.displayName)}</strong>${isFuture() ? "" : notice}</div>${makeup}</div><div class="staff-attendance-checklist">${attendanceControls(entry)}${isFuture() ? notice : ""}</div>${error}</div></article>`;
      }

      function bulkMarkup(selected) {
        const unmarked = selected.rosterCount - markedRosterCount(selected.roster);
        if (isFuture() || !state.canManageAttendance || unmarked <= 0) return "";
        if (state.bulkPending) return `<span class="staff-muted">Тэмдэглэж байна…</span>`;
        if (state.bulkConfirm) return `<div class="staff-attendance-bulk-confirm"><p>Одоогоор тэмдэглээгүй ${unmarked} сурагчийг ирсэн гэж тэмдэглэх үү?</p><div class="staff-inline-actions"><button id="attendance-bulk-cancel" class="button secondary" type="button">Болих</button><button id="attendance-bulk-confirm" class="button primary" type="button">Бүгд ирсэн</button></div></div>`;
        return `<button id="attendance-bulk-present" class="button secondary" type="button">Бүгд ирсэн</button>`;
      }

      function renderSummary() {
        const selected = state.data?.selected;
        const summary = q("#attendance-summary");
        if (!selected || !summary) return;
        selected.markedCount = markedRosterCount(selected.roster);
        selected.progressCount = attendanceProgressCount(selected.roster);
        selected.attendanceComplete = attendanceIsComplete(selected.roster);
        const occurrence = state.data.occurrences.find((entry) => entry.slotId === selected.slotId);
        if (occurrence) {
          occurrence.markedCount = selected.markedCount;
          occurrence.progressCount = selected.progressCount;
        }
        const progressLabel = selected.attendanceComplete
          ? (selected.occurrenceEnded ? "ирц бүрдсэн · Дууссан" : "ирц бүрдсэн")
          : (selected.occurrenceEnded ? "тэмдэглэсэн · Хичээл дууссан" : "тэмдэглэсэн");
        summary.innerHTML = `<strong>${selected.progressCount} / ${selected.rosterCount} ${progressLabel}</strong>${bulkMarkup(selected)}`;
      }

      function patchRosterRow(enrollmentId) {
        const selected = state.data?.selected;
        const detail = q("#attendance-detail");
        const entry = selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        const row = [...detail.querySelectorAll("[data-attendance-row]")].find((node) => node.dataset.attendanceRow === enrollmentId);
        if (entry && row) row.outerHTML = rosterRow(entry);
        renderSummary();
        renderList();
      }

      function renderDetail() {
        const detail = q("#attendance-detail"); const selected = state.data.selected;
        if (!selected) { detail.hidden = true; detail.innerHTML = ""; return; }
        detail.hidden = false;
        const add = canAddMakeup(selected) ? `<button type="button" class="button secondary" data-open-makeup-picker>Сурагч нэмэх</button>` : "";
        detail.innerHTML = `<div class="staff-section-heading"><div><p class="eyebrow">${escape(formatDate(selected.localDate))} · ${escape(selected.startTime)}–${escape(selected.endTime)}</p><h2>${escape(selected.offeringTitle)}</h2><p>${escape(selected.classLabel)} · ${selected.lessonSequence}. ${escape(selected.lessonTitle)}</p>${selected.holidayLabel ? `<p class="staff-calendar-warning">Анхааруулга: ${escape(selected.holidayLabel)} хугацаанд.</p>` : ""}</div>${add}</div><div id="attendance-summary" class="staff-attendance-summary"></div>${makeupPickerMarkup(selected)}${selected.rosterCount ? `<div class="staff-attendance-roster">${selected.roster.map(rosterRow).join("")}</div>` : `<p class="staff-empty">Бүртгэлтэй сурагч алга.</p>`}`;
        renderSummary();
      }

      const makeupSourceKey = (entry) => `${entry.enrollmentId}|${entry.classSessionId}|${entry.curriculumLessonId}`;
      const makeupSourcePayload = (entry) => ({ enrollmentId: entry.enrollmentId, classSessionId: entry.classSessionId, curriculumLessonId: entry.curriculumLessonId });
      function makeupTargetPayload(selected) {
        return selected.occurrenceKind === "special"
          ? { targetKind: "special", targetSpecialOccurrenceId: selected.specialOccurrenceId || selected.slotId }
          : { targetKind: "normal_class", targetClassSessionId: selected.classSessionId, targetSlotId: selected.slotId };
      }
      function canAddMakeup(selected) {
        return state.canManageMakeups && !selected.occurrenceEnded;
      }
      function makeupPickerMarkup(selected) {
        const picker = state.makeupPicker;
        if (!picker || picker.slotId !== selected.slotId) return "";
        if (picker.status === "loading") return `<section class="staff-makeup-detail" aria-live="polite"><p class="staff-muted" role="status">Тохирох сурагчдыг ачаалж байна…</p></section>`;
        if (picker.status === "error") return `<section class="staff-makeup-detail" aria-live="polite"><p class="staff-error-inline">${escape(picker.error)}</p><button class="button secondary" type="button" data-retry-makeup-picker>Дахин шалгах</button></section>`;
        if (picker.status === "empty") return `<section class="staff-makeup-detail" aria-live="polite"><p class="staff-empty">Нэмэх боломжтой сурагч алга.</p><button class="button secondary" type="button" data-close-makeup-picker>Болих</button></section>`;
        const selectedKeys = picker.selected || new Set();
        if (picker.status === "review") return `<section class="staff-makeup-detail" aria-live="polite"><div class="staff-section-heading"><div><p class="eyebrow">Сурагч нэмэх</p><h2>${picker.preview.sources.length} сурагч</h2><p>${escape(formatDate(picker.preview.target.localDate))} · ${escape(picker.preview.target.startTime)}–${escape(picker.preview.target.endTime)}</p><p class="staff-muted">Сул суудал: ${picker.preview.target.remainingCapacity}. Баталгаажуулахад дахин шалгана.</p></div></div><div class="staff-inline-actions"><button class="button primary" type="button" data-confirm-makeup-picker>Баталгаажуулах</button><button class="button secondary" type="button" data-edit-makeup-picker>Засах</button></div></section>`;
        const target = picker.target;
        return `<section class="staff-makeup-detail" aria-live="polite"><div class="staff-section-heading"><div><p class="eyebrow">Сурагч нэмэх</p><h2>${escape(formatDate(target.localDate))} · ${escape(target.startTime)}–${escape(target.endTime)}</h2><p class="staff-muted">${target.kind === "special" ? "Тусгай нөхөх цаг" : escape(target.classLabel)} · Сул суудал: ${target.remainingCapacity}</p></div><button class="button secondary" type="button" data-close-makeup-picker>Болих</button></div>${picker.error ? `<p class="staff-error-inline" role="status">${escape(picker.error)}</p>` : ""}${picker.sources.length ? `<div class="staff-makeup-case-list">${picker.sources.map((entry) => `<label class="staff-makeup-case"><input type="checkbox" data-attendance-makeup-source value="${escape(makeupSourceKey(entry))}" ${selectedKeys.has(makeupSourceKey(entry)) ? "checked" : ""}/><span><strong>${escape(entry.studentName)}</strong><small>${escape([entry.classLabel, entry.sourceLocalDate, entry.sourceStartTime && entry.sourceEndTime ? `${entry.sourceStartTime}–${entry.sourceEndTime}` : ""].filter(Boolean).join(" · "))}</small></span></label>`).join("")}</div><div class="staff-makeup-selection-info"><strong>${selectedKeys.size ? `${selectedKeys.size} сурагч сонгосон` : "Сурагч сонгоно уу"}</strong>${selectedKeys.size > target.remainingCapacity ? `<span class="staff-muted">Энэ цагт бүх сонголт багтахгүй.</span>` : ""}</div><div class="staff-inline-actions"><button class="button primary" type="button" data-preview-makeup-picker ${selectedKeys.size && selectedKeys.size <= target.remainingCapacity ? "" : "disabled"}>Урьдчилан харах</button></div>` : `<p class="staff-empty">Нэмэх боломжтой сурагч алга.</p>`}</section>`;
      }

      async function loadMakeupPicker(retry = false) {
        const selected = state.data?.selected;
        if (!selected || !canAddMakeup(selected)) return;
        const version = ++state.makeupPickerVersion;
        state.makeupPicker = { slotId: selected.slotId, status: "loading", selected: new Set() };
        renderDetail();
        try {
          const result = await postCourseMakeupAction("makeup.destination-candidates", makeupTargetPayload(selected));
          if (version !== state.makeupPickerVersion || state.data?.selected?.slotId !== selected.slotId) return;
          state.makeupPicker = { slotId: selected.slotId, status: result.sources.length ? "ready" : "empty", selected: new Set(), ...result };
        } catch (error) {
          if (version !== state.makeupPickerVersion || state.data?.selected?.slotId !== selected.slotId) return;
          state.makeupPicker = { slotId: selected.slotId, status: "error", selected: new Set(), error: error.message || "Сурагчдын жагсаалтыг ачаалж чадсангүй." };
        }
        renderDetail();
      }

      async function mutateRow(enrollmentId, next, action, payload, success) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry) return;
        state.rowErrorEnrollmentId = "";
        const saved = await optimistic.mutate(entry, next, () => postAttendanceAction(action, { slotId: state.selectedSlotId, enrollmentId, makeupAssignmentId: entry.makeupAssignmentId || undefined, ...payload }));
        if (saved) message(success, true);
      }

      async function setAttendance(enrollmentId, status) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry || entry.recordedAttendanceStatus === status) return;
        await mutateRow(
          enrollmentId,
          { recordedAttendanceStatus: status },
          status ? "attendance.mark" : "attendance.clear",
          status ? { status } : {},
          "Ирцийг хадгаллаа.",
        );
      }

      async function toggleNotice(enrollmentId, checked) {
        const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === enrollmentId);
        if (!entry || entry.hasAbsenceNotice === checked) return;
        await mutateRow(enrollmentId, { hasAbsenceNotice: checked }, checked ? "absence-notice.save" : "absence-notice.cancel", checked ? { note: entry.absenceNoticeNote || "" } : {}, checked ? "Урьдчилсан мэдэгдлийг тэмдэглэлээ." : "Урьдчилсан мэдэгдлийг арилгалаа.");
      }

      async function bulkPresent() {
        const selected = state.data?.selected;
        if (!selected || state.bulkPending) return;
        state.bulkPending = true;
        renderSummary();
        try {
          await postAttendanceAction("attendance.bulk-present", { slotId: state.selectedSlotId });
          selected.roster.filter((entry) => !entry.recordedAttendanceStatus).forEach((entry) => { entry.recordedAttendanceStatus = "present"; patchRosterRow(entry.enrollmentId); });
          state.bulkConfirm = false;
          message("Бүгдийг ирсэн гэж тэмдэглэлээ.", true);
        } catch (error) {
          message(error.message || "Ирцийг хадгалж чадсангүй.");
        } finally {
          state.bulkPending = false;
          renderSummary();
        }
      }

      q("#attendance-detail").addEventListener("click", async (event) => {
        const target = event.target.closest("button");
        if (!target || target.disabled) return;
        if (target.dataset.openMakeupPicker !== undefined || target.dataset.retryMakeupPicker !== undefined) { loadMakeupPicker(target.dataset.retryMakeupPicker !== undefined); return; }
        if (target.dataset.closeMakeupPicker !== undefined) { ++state.makeupPickerVersion; state.makeupPicker = null; renderDetail(); return; }
        if (target.dataset.editMakeupPicker !== undefined) {
          const picker = state.makeupPicker;
          if (picker?.status === "review") { state.makeupPicker = { ...picker, status: "ready", preview: null }; renderDetail(); }
          return;
        }
        if (target.dataset.previewMakeupPicker !== undefined) {
          const picker = state.makeupPicker; const selected = state.data?.selected;
          if (!picker || !selected || picker.status !== "ready") return;
          const sources = picker.sources.filter((entry) => picker.selected.has(makeupSourceKey(entry)));
          if (!sources.length || sources.length > picker.target.remainingCapacity) return;
          target.disabled = true; target.textContent = "Урьдчилан харж байна…";
          try {
            const preview = await postCourseMakeupAction("makeup.group-destination-preview", { sources: sources.map(makeupSourcePayload), ...makeupTargetPayload(selected) });
            if (state.makeupPicker !== picker || state.data?.selected?.slotId !== selected.slotId) return;
            state.makeupPicker = { ...picker, status: "review", preview, selected: new Set(sources.map(makeupSourceKey)) };
            renderDetail();
          } catch (error) {
            if (state.makeupPicker === picker) { picker.error = error.message || "Урьдчилан харах боломжгүй."; renderDetail(); }
          }
          return;
        }
        if (target.dataset.confirmMakeupPicker !== undefined) {
          const picker = state.makeupPicker; const selected = state.data?.selected;
          if (!picker?.preview || !selected) return;
          target.disabled = true; target.textContent = "Хадгалж байна…";
          try {
            await postCourseMakeupAction("makeup.group-destination-book", {
              sources: picker.preview.sources.map(makeupSourcePayload), expectedFingerprint: picker.preview.fingerprint,
              ...makeupTargetPayload(selected), operationId: picker.operationId ||= crypto.randomUUID(),
            });
            ++state.makeupPickerVersion; state.makeupPicker = null; await refresh(); message("Нөхөх хичээлийн товыг хадгаллаа.", true);
          } catch (error) {
            if (state.makeupPicker === picker) { picker.error = error.message || "Товыг хадгалж чадсангүй."; target.disabled = false; target.textContent = "Баталгаажуулах"; }
          }
          return;
        }
        if (target.id === "attendance-bulk-present") { state.bulkConfirm = true; renderSummary(); return; }
        if (target.id === "attendance-bulk-cancel") { state.bulkConfirm = false; renderSummary(); return; }
        if (target.id === "attendance-bulk-confirm") { bulkPresent(); return; }
        if (target.dataset.attendanceAbsent) { setAttendance(target.dataset.attendanceAbsent, "absent"); return; }
      });
      q("#attendance-detail").addEventListener("change", (event) => {
        const target = event.target;
        if (target.matches("[data-attendance-makeup-source]") && state.makeupPicker?.status === "ready") {
          const selected = new Set(state.makeupPicker.selected || []);
          target.checked ? selected.add(target.value) : selected.delete(target.value);
          state.makeupPicker.selected = selected; renderDetail(); return;
        }
        if (target.matches("[data-attendance-control]")) {
          const entry = state.data?.selected?.roster.find((row) => row.enrollmentId === target.dataset.enrollment);
          if (entry) setAttendance(entry.enrollmentId, attendanceStatusAfterToggle(entry.recordedAttendanceStatus, target.dataset.attendanceControl, target.checked));
        }
        if (target.matches("[data-toggle-notice]")) toggleNotice(target.dataset.toggleNotice, target.checked);
      });

      q("#attendance-list").addEventListener("click", (event) => {
        const target = event.target.closest("[data-open-occurrence]");
        if (!target || !canChangeOccurrence(event)) return;
      });
      function render() { renderList(); renderDetail(); }
      q("#attendance-date-form").onsubmit = (event) => { event.preventDefault(); if (!canChangeOccurrence(event)) return; ++state.makeupPickerVersion; state.makeupPicker = null; state.date = q("#attendance-date").value; state.selectedSlotId = ""; state.invalidOccurrence = false; state.bulkConfirm = false; refresh(); };
      q("#attendance-date").onchange = (event) => { if (!canChangeOccurrence(event)) { q("#attendance-date").value = state.date; return; } ++state.makeupPickerVersion; state.makeupPicker = null; state.date = q("#attendance-date").value; state.selectedSlotId = ""; state.invalidOccurrence = false; state.bulkConfirm = false; refresh(); };
      q("#attendance-today").onclick = (event) => { if (!canChangeOccurrence(event)) return; ++state.makeupPickerVersion; state.makeupPicker = null; state.date = state.data.today; state.selectedSlotId = ""; state.invalidOccurrence = false; state.bulkConfirm = false; refresh(); };
      (async () => {
        const capabilities = await getStaffCapabilities();
        if (!capabilities.includes("attendance.view")) { show("tool-denied"); return; }
        state.canManageAttendance = capabilities.includes("attendance.manage");
        state.canManageMakeups = capabilities.includes("makeup.manage");
        await refresh(); show("tool-app");
        if (params.get("makeupAdd") === "1") void loadMakeupPicker();
      })().catch(() => show("tool-denied"));
    </script>
  </body>
</html>
