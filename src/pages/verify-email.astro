---
import { siteIdentity } from "../content/homepage";
import { emailVerificationCopy } from "../content/registration";
import "../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>И-мэйл баталгаажуулах | {siteIdentity.name}</title>
  </head>
  <body class="register-page">
    <main class="register-shell verification-page">
      <section class="verification-card" aria-live="polite">
        <h1 id="verification-title">{emailVerificationCopy.processingTitle}</h1>
        <p id="verification-status">{emailVerificationCopy.processingStatus}</p>
        <p id="verification-hint" hidden></p>
        <p id="verification-return" hidden><a class="button secondary" href="/register/">{emailVerificationCopy.returnToRegistration}</a></p>
      </section>
    </main>
    <script id="verification-copy" type="application/json" is:inline set:html={JSON.stringify(emailVerificationCopy)} />
    <script is:inline type="module">
      const copy = JSON.parse(document.getElementById("verification-copy").textContent);
      const status = document.getElementById("verification-status");
      const title = document.getElementById("verification-title");
      const hint = document.getElementById("verification-hint");
      const returnLink = document.getElementById("verification-return");
      const token = new URLSearchParams(window.location.hash.slice(1)).get("token") || "";
      window.history.replaceState(null, "", window.location.pathname);

      function showInvalidLink() {
        title.textContent = copy.invalidTitle;
        status.textContent = copy.invalidStatus;
        hint.textContent = copy.invalidResendHint;
        hint.hidden = false;
        returnLink.hidden = false;
      }

      if (!token) {
        showInvalidLink();
      } else {
        try {
          const response = await fetch("/api/auth/email/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ token }),
            credentials: "same-origin",
          });
          if (!response.ok) throw new Error("Verification failed");
          window.location.replace(response.url);
        } catch {
          showInvalidLink();
        }
      }
    </script>
  </body>
</html>
