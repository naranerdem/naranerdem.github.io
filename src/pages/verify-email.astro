---
import { siteIdentity } from "../content/homepage";
import "../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>И-мэйл баталгаажуулах | {siteIdentity.name}</title>
  </head>
  <body class="register-page">
    <main class="register-shell verification-page">
      <section class="verification-card" aria-live="polite">
        <h1 id="verification-title">И-мэйл баталгаажуулж байна…</h1>
        <p id="verification-status">Түр хүлээнэ үү.</p>
        <p id="verification-return" hidden><a class="button secondary" href="/register/">Бүртгэл рүү буцах</a></p>
      </section>
    </main>
    <script is:inline type="module">
      const status = document.getElementById("verification-status");
      const title = document.getElementById("verification-title");
      const returnLink = document.getElementById("verification-return");
      const token = new URLSearchParams(window.location.hash.slice(1)).get("token") || "";
      window.history.replaceState(null, "", window.location.pathname);

      if (!token) {
        title.textContent = "Холбоос хүчинтэй биш байна";
        status.textContent = "Энэ холбоос ашиглагдсан эсвэл хүчинтэй хугацаа нь дууссан байна.";
        returnLink.hidden = false;
      } else {
        try {
          const response = await fetch("/api/auth/email/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ token }),
            credentials: "same-origin",
          });
          if (!response.ok) throw new Error("Verification failed");
          window.location.replace(response.url);
        } catch {
          title.textContent = "Холбоос хүчинтэй биш байна";
          status.textContent = "Энэ холбоос ашиглагдсан эсвэл хүчинтэй хугацаа нь дууссан байна.";
          returnLink.hidden = false;
        }
      }
    </script>
  </body>
</html>
