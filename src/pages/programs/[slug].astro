---
import { siteIdentity } from "../../content/homepage";
import "../../styles/global.css";
export function getStaticPaths() { return Object.entries({ "stage-1": { code: "stage_1", title: "1-р шат" }, "stage-2": { code: "stage_2", title: "2-р шат" }, "stage-3": { code: "stage_3", title: "3-р шат" } }).map(([slug, program]) => ({ params: { slug }, props: { program } })); }
const { program } = Astro.props as { program: { code: string; title: string } };
---
<html lang="mn"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={`${program.title} | Наран Эрдэм`} /><title>{program.title} | {siteIdentity.name}</title></head><body class="program-page"><header class="site-header"><a class="brand-link" href="/"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>{siteIdentity.shortProgramLabel}</span></span></a></header><main class="section-shell"><a class="staff-back-link" href="/">Буцах</a><section class="section-heading" id="program-detail" data-stage={program.code}><p class="eyebrow">Үндсэн хөтөлбөр</p><h1>{program.title}</h1><p id="program-grade"></p><p id="program-short">Шинжлэх ухааныг туршилтаар танин мэдэх шаталсан сургалт.</p><p id="program-meta"></p><a id="program-register" class="button primary" hidden>Бүртгүүлэх</a></section></main><footer class="site-footer"><p>{siteIdentity.name}</p></footer><script>
// @ts-nocheck
const stage = document.querySelector("#program-detail").dataset.stage; const grade = (p) => !p.recommendedGradeMin && !p.recommendedGradeMax ? "" : p.recommendedGradeMin === p.recommendedGradeMax ? `${p.recommendedGradeMin}-р анги` : `${p.recommendedGradeMin || p.recommendedGradeMax}–${p.recommendedGradeMax || p.recommendedGradeMin}-р анги`;
fetch("/api/public-site", { headers: { Accept: "application/json" } }).then((r) => r.ok ? r.json() : Promise.reject()).then((data) => { const p = (data.programs || []).find((item) => item.stageCode === stage); if (!p) return; document.querySelector("h1").textContent = p.title; document.querySelector("#program-grade").textContent = grade(p); document.querySelector("#program-short").textContent = p.shortDescription || ""; document.querySelector("#program-meta").textContent = p.lessonCount ? `${p.lessonCount} хичээл` : ""; const register = document.querySelector("#program-register"); if (p.current) { register.href = p.registerHref; register.hidden = false; } }).catch(() => {});
</script><script is:inline type="module">import { loadPublicFont } from "/scripts/public-font.js"; loadPublicFont();</script></body></html>
