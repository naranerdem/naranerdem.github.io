---
import { contact } from "../content/contact";
import { siteIdentity } from "../content/homepage";
import "../styles/global.css";
---
<html lang="mn" data-public-font="sans"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={siteIdentity.description} /><title>{siteIdentity.title}</title><script is:inline>try { const value = localStorage.getItem("naranerdem.public-font"); if (value === "sans" || value === "serif") document.documentElement.dataset.publicFont = value; } catch {}</script></head>
<body class="public-page"><header class="site-header"><a class="brand-link" href="/"><img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} /><span><strong>{siteIdentity.name}</strong><span>{siteIdentity.shortProgramLabel}</span></span></a></header>
<main class="simple-home section-shell">
  <section class="simple-hero"><h1>Наран Эрдэм</h1><p class="simple-subtitle">ХҮҮХДИЙН ШИНЖЛЭХ УХААНЫ ЛАБОРАТОРИ</p><p id="homepage-intro" hidden></p><div class="action-row"><a class="button primary" href="/register/?new=1">Бүртгүүлэх</a><a id="homepage-facebook-top" class="button secondary" href={contact.facebook.href} target="_blank" rel="noreferrer">Facebook</a></div></section>
  <section id="homepage-program" class="public-prose" hidden></section>
  <section id="homepage-introduction" class="public-prose" hidden></section>
  <div class="action-row homepage-secondary-actions"><a class="button primary" href="/register/?new=1">Бүртгүүлэх</a><a id="homepage-facebook-bottom" class="button secondary" href={contact.facebook.href} target="_blank" rel="noreferrer">Facebook</a></div>
  <section id="contact" class="contact-section" aria-labelledby="contact-title"><h2 id="contact-title">Холбоо барих</h2><div id="contact-list" class="contact-grid"><a class="contact-card" href={contact.phone.href}><span>Утас</span><strong>{contact.phone.label}</strong></a><a class="contact-card" href={contact.facebook.href} target="_blank" rel="noreferrer"><span>Facebook</span><strong>{contact.facebook.label}</strong></a><address class="contact-card address-card"><span>Байршил</span>{contact.locationLines.map((line) => <strong>{line}</strong>)}</address></div></section>
</main>
<script is:inline type="module">
  import { applyPublicFont } from "/scripts/public-font.js";
  const escape = (value) => String(value ?? "").replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"})[c]);
  const prose = (value) => String(value || "").replace(/\r\n?/g, "\n").split("\n").map((line) => line.trimEnd()).filter(Boolean).map((line) => line.startsWith("## ") ? `<h2>${escape(line.slice(3))}</h2>` : `<p>${escape(line)}</p>`).join("");
  const showProse = (id, value) => { const node = document.querySelector(id); const html = prose(value); node.hidden = !html; node.innerHTML = html; };
  fetch("/api/public-site", { headers: { Accept: "application/json" } }).then((r) => r.ok ? r.json() : Promise.reject()).then((data) => {
    const center = data.center || {}; applyPublicFont(data.publicSiteFont);
    const intro = document.querySelector("#homepage-intro"); intro.hidden = !center.homepageIntro; intro.textContent = center.homepageIntro || "";
    showProse("#homepage-program", center.aboutCenterText); showProse("#homepage-introduction", center.teacherBio);
    for (const node of document.querySelectorAll("#homepage-facebook-top, #homepage-facebook-bottom")) if (center.facebookPageUrl) node.href = center.facebookPageUrl;
    const contacts = []; if (center.phone) contacts.push(`<a class="contact-card" href="tel:${escape(center.phone).replace(/[^+0-9]/g, "")}"><span>Утас</span><strong>${escape(center.phone)}</strong></a>`); if (center.publicEmail) contacts.push(`<a class="contact-card" href="mailto:${escape(center.publicEmail)}"><span>И-мэйл</span><strong>${escape(center.publicEmail)}</strong></a>`); if (center.facebookPageUrl) contacts.push(`<a class="contact-card" href="${escape(center.facebookPageUrl)}" target="_blank" rel="noreferrer"><span>Facebook</span><strong>Facebook</strong></a>`); if (center.physicalAddress) contacts.push(`<address class="contact-card address-card"><span>Байршил</span><strong>${escape(center.physicalAddress)}</strong></address>`); if (contacts.length) document.querySelector("#contact-list").innerHTML = contacts.join("");
  }).catch(() => {});
</script></body></html>
