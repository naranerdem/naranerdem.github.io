---
import {
  distinctivePoints,
  hero,
  navigation,
  programStages,
  siteIdentity,
  studyAreas,
  teacherNote,
} from "../content/homepage";
import { contact } from "../content/contact";
import { registrationCopy } from "../content/registration";
import "../styles/global.css";
---

<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteIdentity.description} />
    <title>{siteIdentity.title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand-link" href="/" aria-label="Нүүр хуудас">
        <img class="brand-logo" src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        <span>
          <strong>{siteIdentity.name}</strong>
          <span>{siteIdentity.shortProgramLabel}</span>
        </span>
      </a>
      <nav class="top-nav" aria-label="Гол цэс">
        {
          navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </header>

    <main>
      <section class="hero-section section-shell" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">{hero.kicker}</p>
          <h1 id="page-title">{hero.heading}</h1>
          <p class="hero-summary">{hero.summary}</p>
          <div class="action-row" aria-label="Гол үйлдлүүд">
            <a class="button primary" href={hero.primaryAction.href}>
              {hero.primaryAction.label}
            </a>
            <a class="button secondary" href={hero.secondaryAction.href} target="_blank" rel="noreferrer">
              {hero.secondaryAction.label}
            </a>
          </div>
        </div>
        <div class="hero-logo" aria-label="Наран Эрдэм лого">
          <img src={siteIdentity.logo.src} alt={siteIdentity.logo.alt} />
        </div>
      </section>

      <section id="program" class="section-shell" aria-labelledby="program-title">
        <div class="section-heading">
          <p class="eyebrow">Шаталсан хөтөлбөр</p>
          <h2 id="program-title">Гурван шаттай туршилт-лаборатори сургалт</h2>
          <p>
            Хичээлийн жилийн турш үргэлжлэх энэ хөтөлбөр нь хүүхдийг шат дараатайгаар
            практик туршилтын ажилд дасгадаг.
          </p>
        </div>
        <div class="stage-list">
          {
            programStages.map((stage) => (
              <article class="stage-item">
                <div>
                  <p class="stage-title">{stage.title}</p>
                  <h3>{stage.level}</h3>
                  <p>{stage.audience}</p>
                </div>
                <dl class="stage-meta">
                  <div>
                    <dt>Хичээл</dt>
                    <dd>{stage.lessons}</dd>
                  </div>
                  <div>
                    <dt>Давтамж</dt>
                    <dd>{stage.rhythm}</dd>
                  </div>
                </dl>
                <a class="stage-registration-link" href={stage.registrationHref}>Бүртгүүлэх</a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="study-band" aria-labelledby="study-title">
        <div class="section-shell study-layout">
          <div>
            <p class="eyebrow">Юу судлах вэ?</p>
            <h2 id="study-title">Бодитоор туршиж, ажиглаж, тайлбарлаж сурна</h2>
            <p>
              Хүүхдүүд хэд хэдэн байгалийн шинжлэх ухааны чиглэлээр лабораторийн
              туршилт, практик ажлаар дамжин өөрийн сонирхлоо нээх боломжтой.
            </p>
          </div>
          <ul class="area-list" aria-label="Судлах чиглэлүүд">
            {studyAreas.map((area) => <li>{area}</li>)}
          </ul>
        </div>
      </section>

      <section class="section-shell" aria-labelledby="distinctive-title">
        <div class="section-heading">
          <p class="eyebrow">Онцлог</p>
          <h2 id="distinctive-title">Дулаан уур амьсгалтай, нухацтай туршилтын орчин</h2>
        </div>
        <div class="feature-layout">
          <ul class="check-list">
            {distinctivePoints.map((point) => <li>{point}</li>)}
          </ul>
          <aside class="teacher-note" aria-labelledby="teacher-title">
            <h3 id="teacher-title">{teacherNote.heading}</h3>
            <p>{teacherNote.body}</p>
          </aside>
        </div>
      </section>

      <section id="registration-info" class="registration-section" aria-labelledby="registration-title">
        <div class="section-shell registration-box">
          <div>
            <p class="eyebrow">Бүртгэл</p>
            <h2 id="registration-title">{registrationCopy.heading}</h2>
            <p>{registrationCopy.intro}</p>
            <p class="quiet-note">{registrationCopy.statusLabel}</p>
          </div>
          <a class="button primary" href={registrationCopy.actionHref}>
            {registrationCopy.actionLabel}
          </a>
        </div>
      </section>

      <section id="contact" class="section-shell contact-section" aria-labelledby="contact-title">
        <div class="section-heading">
          <p class="eyebrow">{contact.section.kicker}</p>
          <h2 id="contact-title">{contact.section.heading}</h2>
        </div>
        <div class="contact-grid">
          <a class="contact-card" href={contact.phone.href}>
            <span>{contact.section.phoneLabel}</span>
            <strong>{contact.phone.label}</strong>
          </a>
          <a class="contact-card" href={contact.facebook.href} target="_blank" rel="noreferrer">
            <span>{contact.section.facebookLabel}</span>
            <strong>{contact.facebook.label}</strong>
          </a>
          <address class="contact-card address-card">
            <span>{contact.section.locationLabel}</span>
            {contact.locationLines.map((line) => <strong>{line}</strong>)}
            <em>{contact.locationNote}</em>
          </address>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>{siteIdentity.name} · {siteIdentity.programLabel}</p>
      <a href={contact.facebook.href} target="_blank" rel="noreferrer">{contact.facebook.label}</a>
    </footer>
  </body>
</html>
